@startuml
skinparam monochrome true
skinparam shadowing false
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
autonumber "<b>0</b> : "

mainframe sd Payment

actor Buyer
participant Client
participant Controller
database Database
participant PayPal

Buyer -> Client: Open /Order Payment Center
Client -> Controller: GET pending orders
Controller -> Database: Load pending_payment orders
Database --> Controller: Orders
Controller --> Client: Return list
Client --> Buyer: Show invoices
Buyer -> Client: Enter shipping + choose PayPal/COD
Buyer -> Client: Click Complete
Client -> Controller: POST /Order/Complete
Controller -> Controller: Validate + CompleteOrderAsync
alt Invalid
  Controller --> Client: PaymentFailed
  Client --> Buyer: Show error
else COD
  Controller -> Database: Mark orders paid + auction completed
  Database --> Controller: OK
  Controller --> Client: Success
  Client --> Buyer: Payment success
else PayPal
  Controller -> PayPal: InitiatePayPalCheckoutAsync
  PayPal --> Controller: approvalUrl
  Controller --> Client: Redirect PayPal
  Client --> Buyer: Pay on PayPal
  Buyer -> Client: PayPalReturn
  Client -> Controller: Capture payment
  Controller -> PayPal: Capture
  PayPal --> Controller: Captured
  Controller -> Database: Mark paid + complete auction
  Controller --> Client: Confirmation
  Client --> Buyer: Payment confirmation
end

@enduml