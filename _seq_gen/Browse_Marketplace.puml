@startuml
skinparam monochrome true
skinparam shadowing false
skinparam style strictuml
skinparam sequenceMessageAlign left
skinparam responseMessageBelowArrow true
autonumber "<b>0</b> : "

mainframe sd Browse Marketplace

actor User
participant Client
participant Controller
database Database

User -> Client: Open Home / Auction / BuyNow
Client -> Controller: GET listings
Controller -> Database: Query public auctions / buynow
Database --> Controller: Listing list
Controller --> Client: Return listings + facets
Client --> User: Show marketplace
User -> Client: Search / Filter / Sort
Client -> Client: Apply client-side filters
Client --> User: Update listing cards
User -> Client: Open listing detail
Client -> Controller: GET /Auction/Detail/{id}
Controller -> Database: Load auction + product + media
Database --> Controller: Detail data
Controller --> Client: Return detail
Client --> User: Show listing detail

@enduml