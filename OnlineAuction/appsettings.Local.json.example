{
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=online_auction;user=root;password=YOUR_MYSQL_PASSWORD;"
  },
  "PayPal": {
    "ClientId": "YOUR_SANDBOX_CLIENT_ID",
    "ClientSecret": "YOUR_SANDBOX_CLIENT_SECRET"
  },
  "PasswordResetOtp": {
    "UseMockOtpSender": true
  },
  "BidFraudDetection": {
    "Enabled": true,
    "RateLimitingEnabled": true,
    "MaxBidsPerMinutePerUser": 10,
    "MaxBidsPerMinutePerAuction": 30,
    "SameIpAccountThreshold": 2,
    "RapidBidWindowSeconds": 60,
    "RapidBidCountThreshold": 5,
    "CollusionRoundTripThreshold": 3,
    "AbnormalJumpPercent": 50,
    "NewAccountHoursThreshold": 24,
    "AntiSnipeThresholdMinutes": 5,
    "AntiSnipeExtensionMinutes": 5
  },
  "Email": {
    "Gmail": {
      "ClientId": "YOUR_GOOGLE_OAUTH_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_OAUTH_CLIENT_SECRET",
      "RefreshToken": "YOUR_GMAIL_REFRESH_TOKEN",
      "SenderEmail": "your-sender@gmail.com",
      "SenderName": "RareCard Auction House"
      
    }
  },
  "FirebaseSettings": {
    "ProjectId": "YOUR_FIREBASE_PROJECT_ID",
    "ClientEmail": "firebase-adminsdk-xxxxx@YOUR_FIREBASE_PROJECT_ID.iam.gserviceaccount.com",
    "PrivateKey": "-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n",
    "WebApiKey": "YOUR_WEB_API_KEY",
    "MessagingSenderId": "YOUR_MESSAGING_SENDER_ID",
    "AppId": "1:YOUR_MESSAGING_SENDER_ID:web:YOUR_APP_HASH",
    "VapidKey": "YOUR_WEB_PUSH_VAPID_KEY"
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "online-auction.direct",
    "PrefetchCount": 10
  },
  "PlatformFee": {
    "RegistrationDepositPercent": 10.00,
    "BuyerCheckoutFeePercent": 2.50,
    "SellerSuccessFeePercent": 10.00,
    "MinimumRegistrationDeposit": 1.00
  }
}
