@model BuyNowListViewModel

@{
    var currentPage = Model.Filter.Page <= 0 ? 1 : Model.Filter.Page;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);

    string FormatStatus(string status) => status.Replace('_', ' ');
}

<div class="mb-4 flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03] sm:flex-row sm:items-center sm:justify-between">
    <div class="text-theme-sm text-gray-500">
        Total: <span class="font-medium text-gray-800 dark:text-white/90">@Model.TotalItems</span>
        · Listing type: <span class="font-medium text-gray-800 dark:text-white/90">buy_now only</span>
    </div>
</div>

<div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
    <div class="max-w-full overflow-x-auto">
        <table class="w-full min-w-[1100px]">
            <thead>
            <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Product</th>
                <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Category</th>
                <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Seller</th>
                <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Buy Now Price</th>
                <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Status</th>
                <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Availability</th>
                <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Created / Verified</th>
                <th class="px-5 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">Actions</th>
            </tr>
            </thead>

            <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
            @if (Model.Listings.Count == 0)
            {
                <tr>
                    <td colspan="8" class="px-5 py-10 text-center text-theme-sm text-gray-500">
                        No Buy Now listings found.
                    </td>
                </tr>
            }
            else
            {
                @foreach (var listing in Model.Listings)
                {
                    <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                        <td class="px-5 py-4">
                            <div class="flex items-center gap-3">
                                @if (!string.IsNullOrWhiteSpace(listing.ImageUrl))
                                {
                                    <img src="@listing.ImageUrl"
                                         alt="@listing.ProductName"
                                         class="h-12 w-12 rounded-lg object-cover" />
                                }
                                <div>
                                    <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">@listing.ProductName</p>
                                    <p class="text-theme-xs text-gray-500">ID: @listing.Id</p>
                                </div>
                            </div>
                        </td>
                        <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@listing.CategoryName</td>
                        <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@listing.SellerName</td>
                        <td class="px-5 py-4 text-theme-sm font-medium text-gray-800 dark:text-white/90">$@listing.BuyNowPrice.ToString("N0")</td>
                        <td class="px-5 py-4">
                            <span class="rounded-full bg-brand-50 px-2.5 py-0.5 text-theme-xs font-medium capitalize text-brand-700 dark:bg-brand-500/15 dark:text-brand-400">
                                @FormatStatus(listing.Status)
                            </span>
                        </td>
                        <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@listing.AvailabilityLabel</td>
                        <td class="px-5 py-4">
                            <p class="text-theme-sm text-gray-700 dark:text-gray-300">@listing.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                            <p class="text-theme-xs text-gray-500">
                                @(listing.VerifiedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Not verified")
                            </p>
                        </td>
                        <td class="px-5 py-4">
                            <div class="admin-icon-action-group">
                                <a asp-area="Admin"
                                   asp-controller="BuyNow"
                                   asp-action="Details"
                                   asp-route-id="@listing.Id"
                                   class="admin-icon-action admin-icon-action--view"
                                   title="Details"
                                   aria-label="Details">
                                    <partial name="_AdminIcon" model='"eye"' />
                                </a>

                                @if (Model.CanManage && listing.CanEdit)
                                {
                                    <a asp-area="Admin"
                                       asp-controller="BuyNow"
                                       asp-action="Edit"
                                       asp-route-id="@listing.Id"
                                       class="admin-icon-action admin-icon-action--edit"
                                       title="Edit"
                                       aria-label="Edit">
                                        <partial name="_AdminIcon" model='"pencil"' />
                                    </a>
                                }

                                @if (listing.IsPublicLive)
                                {
                                    <a href="@Url.Action("Detail", "BuyNow", new { area = "", id = listing.Id })"
                                       target="_blank"
                                       rel="noopener"
                                       class="admin-icon-action admin-icon-action--neutral"
                                       title="View public listing"
                                       aria-label="View public listing">
                                        <partial name="_AdminIcon" model='"external"' />
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-theme-sm text-gray-500">
        Page <span class="font-medium text-gray-800 dark:text-white/90">@currentPage</span>
        of <span class="font-medium text-gray-800 dark:text-white/90">@totalPages</span>
    </p>

    <nav class="flex flex-wrap items-center gap-2">
        <a asp-area="Admin"
           asp-controller="BuyNow"
           asp-action="Index"
           asp-route-Search="@Model.Filter.Search"
           asp-route-Status="@Model.Filter.Status"
           asp-route-CategoryId="@Model.Filter.CategoryId"
           asp-route-SellerId="@Model.Filter.SellerId"
           asp-route-SortOrder="@Model.Filter.SortOrder"
           asp-route-Page="@(currentPage - 1)"
           class="admin-icon-action admin-icon-action--pagination @(currentPage <= 1 ? "is-disabled" : "js-admin-page")"
           title="Previous"
           aria-label="Previous">
            <partial name="_AdminIcon" model='"chevron-left"' />
        </a>

        @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
        {
            <a asp-area="Admin"
               asp-controller="BuyNow"
               asp-action="Index"
               asp-route-Search="@Model.Filter.Search"
               asp-route-Status="@Model.Filter.Status"
               asp-route-CategoryId="@Model.Filter.CategoryId"
               asp-route-SellerId="@Model.Filter.SellerId"
               asp-route-SortOrder="@Model.Filter.SortOrder"
               asp-route-Page="@pageNumber"
               class="js-admin-page rounded-lg border px-3 py-2 text-theme-sm font-medium @(pageNumber == currentPage ? "border-brand-500 bg-brand-500 text-white" : "border-gray-300 text-gray-700 hover:bg-gray-50")">
                @pageNumber
            </a>
        }

        <a asp-area="Admin"
           asp-controller="BuyNow"
           asp-action="Index"
           asp-route-Search="@Model.Filter.Search"
           asp-route-Status="@Model.Filter.Status"
           asp-route-CategoryId="@Model.Filter.CategoryId"
           asp-route-SellerId="@Model.Filter.SellerId"
           asp-route-SortOrder="@Model.Filter.SortOrder"
           asp-route-Page="@(currentPage + 1)"
           class="admin-icon-action admin-icon-action--pagination @(currentPage >= totalPages ? "is-disabled" : "js-admin-page")"
           title="Next"
           aria-label="Next">
            <partial name="_AdminIcon" model='"chevron-right"' />
        </a>
    </nav>
</div>
