@model BuyNowListViewModel

@{
    var currentPage = Model.Filter.Page <= 0 ? 1 : Model.Filter.Page;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
    var filterStatus = Model.Filter.Status;
    var filterOnCatalogOnly = Model.Filter.OnCatalogOnly;
    var filterSearch = Model.Filter.Search;
    var filterDateRange = Model.Filter.DateRange;
    var filterCategoryId = Model.Filter.CategoryId;
    var filterSellerId = Model.Filter.SellerId;
    var filterSortOrder = Model.Filter.SortOrder;

    string FormatStatus(string status) => status switch
    {
        "confirming" or "pending_review" => "Confirming",
        "live" or "ending_soon" => "In stock",
        "awaiting_payment" => "Awaiting payment",
        "completed" => "Sold",
        _ => status.Replace('_', ' ')
    };
}

<form id="buyNowBulkDeleteForm"
      asp-area="Admin"
      asp-controller="BuyNow"
      asp-action="BulkDelete"
      method="post">
    @Html.AntiForgeryToken()

    <div class="mb-4 flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03] sm:flex-row sm:items-center sm:justify-between">
        @if (Model.CanManage)
        {
            <button type="submit"
                    data-bulk-delete="true"
                    class="admin-icon-action admin-icon-action--delete admin-icon-action--lg"
                    title="Delete selected"
                    aria-label="Delete selected">
                <partial name="_AdminIcon" model='"trash"' />
            </button>
        }

        <div class="text-theme-sm text-gray-500">
            Total: <span class="font-medium text-gray-800 dark:text-white/90">@Model.TotalItems</span>
            · Listing type: <span class="font-medium text-gray-800 dark:text-white/90">buy_now only</span>
        </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="max-w-full overflow-x-auto">
            <table class="admin-auction-table">
                <thead>
                <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                    <th class="w-10 text-left">
                        <input id="selectAllBuyNow" type="checkbox" aria-label="Select all Buy Now listings" @(Model.CanManage ? null : "disabled") />
                    </th>
                    <th class="text-left font-medium uppercase text-gray-500">Product</th>
                    <th class="text-left font-medium uppercase text-gray-500">Category</th>
                    <th class="text-left font-medium uppercase text-gray-500">Seller</th>
                    <th class="text-left font-medium uppercase text-gray-500">Price</th>
                    <th class="text-left font-medium uppercase text-gray-500">Status</th>
                    <th class="text-left font-medium uppercase text-gray-500">Availability</th>
                    <th class="text-left font-medium uppercase text-gray-500">Created / Verified</th>
                    <th class="text-right font-medium uppercase text-gray-500">Actions</th>
                </tr>
                </thead>

                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @if (Model.Listings.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="px-4 py-8 text-center text-sm text-gray-500">
                            No Buy Now listings found.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var listing in Model.Listings)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                            <td>
                                <input class="buynow-checkbox"
                                       type="checkbox"
                                       name="SelectedBuyNowIds"
                                       value="@listing.Id"
                                       @(Model.CanManage ? null : "disabled") />
                            </td>
                            <td class="admin-auction-product">
                                <div class="flex items-center gap-2.5">
                                    @if (!string.IsNullOrWhiteSpace(listing.ImageUrl))
                                    {
                                        <img src="@listing.ImageUrl"
                                             alt="@listing.ProductName"
                                             class="admin-auction-product__thumb" />
                                    }
                                    <div class="admin-auction-product__body">
                                        <p class="admin-auction-product__name text-gray-800 dark:text-white/90" title="@listing.ProductName">@listing.ProductName</p>
                                        <p class="admin-auction-muted">#@listing.Id</p>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <p class="admin-auction-meta text-gray-700 dark:text-gray-300">@listing.CategoryName</p>
                            </td>
                            <td>
                                <p class="admin-auction-meta text-gray-700 dark:text-gray-300" title="@listing.SellerName">@listing.SellerName</p>
                            </td>
                            <td>
                                <p class="admin-auction-price text-gray-800 dark:text-white/90">$@listing.BuyNowPrice.ToString("N0")</p>
                            </td>
                            <td>
                                <p class="admin-auction-meta capitalize text-gray-700 dark:text-gray-300">@FormatStatus(listing.Status)</p>
                            </td>
                            <td>
                                <p class="admin-auction-meta text-gray-700 dark:text-gray-300">@listing.AvailabilityLabel</p>
                            </td>
                            <td>
                                <p class="admin-auction-meta text-gray-700 dark:text-gray-300">@listing.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="admin-auction-muted">
                                    @(listing.VerifiedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Not verified")
                                </p>
                            </td>
                            <td class="admin-auction-actions">
                                <div class="admin-icon-action-group">
                                    <a asp-area="Admin"
                                       asp-controller="BuyNow"
                                       asp-action="Details"
                                       asp-route-id="@listing.Id"
                                       class="admin-icon-action admin-icon-action--view"
                                       title="Details"
                                       aria-label="Details">
                                        <partial name="_AdminIcon" model='"eye"' />
                                    </a>

                                    @if (Model.CanManage && listing.CanEdit)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="BuyNow"
                                           asp-action="Edit"
                                           asp-route-id="@listing.Id"
                                           class="admin-icon-action admin-icon-action--edit"
                                           title="Edit"
                                           aria-label="Edit">
                                            <partial name="_AdminIcon" model='"pencil"' />
                                        </a>
                                    }

                                    @if (listing.IsPublicLive)
                                    {
                                        <a href="@Url.Action("Detail", "BuyNow", new { area = "", id = listing.Id })"
                                           target="_blank"
                                           rel="noopener"
                                           class="admin-icon-action admin-icon-action--neutral"
                                           title="View public listing"
                                           aria-label="View public listing">
                                            <partial name="_AdminIcon" model='"external"' />
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</form>

<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-theme-sm text-gray-500">
        Page <span class="font-medium text-gray-800 dark:text-white/90">@currentPage</span>
        of <span class="font-medium text-gray-800 dark:text-white/90">@totalPages</span>
    </p>

    <nav class="flex flex-wrap items-center gap-2">
        <a asp-area="Admin"
           asp-controller="BuyNow"
           asp-action="Index"
           asp-route-Search="@filterSearch"
           asp-route-DateRange="@filterDateRange"
           asp-route-CategoryId="@filterCategoryId"
           asp-route-SellerId="@filterSellerId"
           asp-route-Status="@filterStatus"
           asp-route-OnCatalogOnly="@filterOnCatalogOnly"
           asp-route-SortOrder="@filterSortOrder"
           asp-route-Page="@(currentPage - 1)"
           class="admin-icon-action admin-icon-action--pagination @(currentPage <= 1 ? "is-disabled" : "js-admin-page")"
           title="Previous"
           aria-label="Previous">
            <partial name="_AdminIcon" model='"chevron-left"' />
        </a>

        @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
        {
            <a asp-area="Admin"
               asp-controller="BuyNow"
               asp-action="Index"
               asp-route-Search="@filterSearch"
               asp-route-DateRange="@filterDateRange"
               asp-route-CategoryId="@filterCategoryId"
               asp-route-SellerId="@filterSellerId"
               asp-route-Status="@filterStatus"
               asp-route-OnCatalogOnly="@filterOnCatalogOnly"
               asp-route-SortOrder="@filterSortOrder"
               asp-route-Page="@pageNumber"
               class="js-admin-page rounded-lg border px-3 py-2 text-theme-sm font-medium @(pageNumber == currentPage ? "border-brand-500 bg-brand-500 text-white" : "border-gray-300 text-gray-700 hover:bg-gray-50")">
                @pageNumber
            </a>
        }

        <a asp-area="Admin"
           asp-controller="BuyNow"
           asp-action="Index"
           asp-route-Search="@filterSearch"
           asp-route-DateRange="@filterDateRange"
           asp-route-CategoryId="@filterCategoryId"
           asp-route-SellerId="@filterSellerId"
           asp-route-Status="@filterStatus"
           asp-route-OnCatalogOnly="@filterOnCatalogOnly"
           asp-route-SortOrder="@filterSortOrder"
           asp-route-Page="@(currentPage + 1)"
           class="admin-icon-action admin-icon-action--pagination @(currentPage >= totalPages ? "is-disabled" : "js-admin-page")"
           title="Next"
           aria-label="Next">
            <partial name="_AdminIcon" model='"chevron-right"' />
        </a>
    </nav>
</div>
