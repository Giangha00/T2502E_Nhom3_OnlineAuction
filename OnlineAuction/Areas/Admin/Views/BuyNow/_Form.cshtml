@model BuyNowFormViewModel

<div asp-validation-summary="ModelOnly" class="mb-4 text-theme-sm text-error-600"></div>

@if (Model.Id > 0 && Model.HasOrders)
{
    <div class="mb-4 rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-700">
        This listing has related orders. Buy Now price changes may be restricted for data integrity.
    </div>
}

<div class="grid grid-cols-1 gap-5 md:grid-cols-2">
    <div class="md:col-span-2">
        <label asp-for="ProductName" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        <input asp-for="ProductName" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
        <span asp-validation-for="ProductName" class="text-theme-xs text-error-600"></span>
    </div>

    <div class="md:col-span-2">
        <label asp-for="Description" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        <textarea asp-for="Description" rows="5" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
        <span asp-validation-for="Description" class="text-theme-xs text-error-600"></span>
    </div>

    <div>
        <label asp-for="CategoryId" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
            <option value="">Select category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-theme-xs text-error-600"></span>
    </div>

    <div>
        <label asp-for="SellerId" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        <select asp-for="SellerId" asp-items="Model.SellerOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
            <option value="">Select seller</option>
        </select>
        <span asp-validation-for="SellerId" class="text-theme-xs text-error-600"></span>
    </div>

    <div>
        <label asp-for="BuyNowPrice" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        <input asp-for="BuyNowPrice" type="number" step="0.01" min="0.01" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
        <span asp-validation-for="BuyNowPrice" class="text-theme-xs text-error-600"></span>
    </div>

    <div>
        <label asp-for="Status" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        <select asp-for="Status" asp-items="Model.StatusOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></select>
        <span asp-validation-for="Status" class="text-theme-xs text-error-600"></span>
    </div>

    <div>
        <label asp-for="StartDate" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        <input asp-for="StartDate" type="datetime-local" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
        <span asp-validation-for="StartDate" class="text-theme-xs text-error-600"></span>
    </div>

    <div>
        <label asp-for="EndDate" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        <input asp-for="EndDate" type="datetime-local" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
        <span asp-validation-for="EndDate" class="text-theme-xs text-error-600"></span>
    </div>

    <div class="md:col-span-2">
        <label asp-for="ImageFile" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="Current product image" class="mb-3 h-24 w-24 rounded-lg object-cover" />
        }
        <input asp-for="ImageFile" type="file" accept="image/*" class="block w-full text-theme-sm text-gray-600" />
        <span asp-validation-for="ImageFile" class="text-theme-xs text-error-600"></span>
    </div>
</div>
