@model BuyNowFormViewModel

<div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-600"></div>

@if (Model.Id > 0 && Model.HasOrders)
{
    <div class="mb-4 rounded-lg border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-700">
        This listing has related orders. Buy Now price changes may be restricted for data integrity.
    </div>
}

<div class="space-y-6">
    <div class="sell-section overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-5">
            <h2 class="flex items-center gap-3 text-base font-semibold text-slate-900">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">1</span>
                Product Details
            </h2>
            <p class="mt-1 pl-10 text-sm text-slate-500">Basic information customers see on the buy now page.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 p-6 md:grid-cols-2">
            <div class="md:col-span-2">
                <label asp-for="ProductName" class="mb-1.5 block text-sm font-medium text-slate-700"></label>
                <input asp-for="ProductName" class="w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
                <span asp-validation-for="ProductName" class="text-xs text-red-600"></span>
            </div>

            <div class="md:col-span-2">
                <label asp-for="Description" class="mb-1.5 block text-sm font-medium text-slate-700"></label>
                <textarea asp-for="Description" rows="4" class="w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"></textarea>
                <span asp-validation-for="Description" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="CategoryId" class="mb-1.5 block text-sm font-medium text-slate-700"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="h-11 w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                    <option value="">Select category</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="SellerId" class="mb-1.5 block text-sm font-medium text-slate-700"></label>
                <select asp-for="SellerId" asp-items="Model.SellerOptions" class="h-11 w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
                    <option value="">Select seller</option>
                </select>
                <span asp-validation-for="SellerId" class="text-xs text-red-600"></span>
            </div>
        </div>
    </div>

    <div class="sell-section overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-5">
            <h2 class="flex items-center gap-3 text-base font-semibold text-slate-900">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">2</span>
                Pricing
            </h2>
            <p class="mt-1 pl-10 text-sm text-slate-500">Set fixed Buy Now price for this listing.</p>
        </div>
        <div class="grid grid-cols-1 gap-4 p-6 md:grid-cols-2">
            <div class="md:col-span-2 max-w-sm">
                <label asp-for="BuyNowPrice" class="mb-1.5 block text-sm font-medium text-slate-700"></label>
                <div class="relative">
                    <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400">$</span>
                    <input asp-for="BuyNowPrice" type="number" step="0.01" min="0.01" class="h-11 w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-7 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100" />
                </div>
                <span asp-validation-for="BuyNowPrice" class="text-xs text-red-600"></span>
            </div>
        </div>
    </div>

    <div class="sell-section overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        <div class="border-b border-slate-100 px-6 py-5">
            <h2 class="flex items-center gap-3 text-base font-semibold text-slate-900">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">3</span>
                Product Images
            </h2>
            <p class="mt-1 pl-10 text-sm text-slate-500">Upload multiple images — JPG, PNG, WEBP (max 1.5MB each).</p>
        </div>
        <div class="p-6">
            <div id="imageDropZone"
                 class="buynow-edit__dropzone flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-200 bg-slate-50/60 px-6 py-10 transition hover:border-blue-400 hover:bg-blue-50/40">
                <svg class="h-10 w-10 text-blue-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"/>
                </svg>
                <p class="mt-3 text-sm font-semibold text-slate-800">Upload Product Images</p>
                <p class="mt-1 text-sm text-slate-500">Drag &amp; Drop files here or click to browse</p>
                <p class="mt-2 text-xs text-slate-400">This image will be uploaded to Cloudinary and saved as the listing cover.</p>
                <input type="file" id="imageInput" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple class="sr-only" />
            </div>
            <p id="imageError" class="mt-2 hidden text-xs text-red-600"></p>

            @* Synced by JS on submit *@
            <input asp-for="ImageFile" type="file" accept="image/*" class="sr-only" tabindex="-1" aria-hidden="true" />
            <input asp-for="GalleryImageFiles" type="file" multiple accept="image/*" class="sr-only" tabindex="-1" aria-hidden="true" />
            <div id="removeGalleryImageIdsContainer"></div>

            <div id="imagePreviewGrid" class="mt-6 hidden">
                <div class="mb-3 flex items-center justify-between">
                    <p class="text-sm font-medium text-slate-700">Uploaded Images <span id="imageCount" class="text-slate-400">(0)</span></p>
                    <button type="button" id="clearAllImages" class="cursor-pointer text-xs font-semibold text-red-600 hover:text-red-700">Remove all</button>
                </div>
                <div id="imagePreviewList" class="buynow-edit__image-row"></div>
            </div>
        </div>
    </div>
</div>
