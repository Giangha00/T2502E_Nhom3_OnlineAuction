@model BuyNowFormViewModel

@{
    ViewData["Title"] = "Edit Buy Now Listing";
    ViewData["AdminPage"] = "buy-now";
}

<div class="mx-auto max-w-(--breakpoint-7xl) p-4 md:p-6">
    <div class="mb-6">
        <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Edit Buy Now Listing</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">Update Buy Now listing #@Model.Id.</p>
    </div>

    <form asp-area="Admin"
          asp-controller="BuyNow"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data"
          class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
        @Html.AntiForgeryToken()
        <input asp-for="Id" type="hidden" />
        <input asp-for="ProductId" type="hidden" />

        <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            <partial name="_Form" model="Model" />

            <div class="mt-6 flex justify-end gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
                <a asp-area="Admin" asp-controller="BuyNow" asp-action="Details" asp-route-id="@Model.Id" class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg" title="Cancel" aria-label="Cancel">
                    <partial name="_AdminIcon" model='"x-mark"' />
                </a>
                <button type="submit" class="admin-icon-action admin-icon-action--primary admin-icon-action--lg" title="Save Changes" aria-label="Save Changes">
                    <partial name="_AdminIcon" model='"save"' />
                </button>
            </div>
        </div>

        <aside class="space-y-4 xl:sticky xl:top-24 xl:self-start">
            <partial name="_PreviewCard" model="Model" />
        </aside>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            var nameInput = document.getElementById('ProductName');
            var priceInput = document.getElementById('BuyNowPrice');
            var statusInput = document.getElementById('Status');
            var imageInput = document.getElementById('ImageFile');
            var previewName = document.getElementById('buyNowPreviewName');
            var previewPrice = document.getElementById('buyNowPreviewPrice');
            var previewMeta = document.getElementById('buyNowPreviewMeta');
            var previewImage = document.getElementById('buyNowPreviewImage');

            function refresh() {
                if (previewName) previewName.textContent = nameInput && nameInput.value ? nameInput.value : 'Product name';
                var value = priceInput && priceInput.value ? Number(priceInput.value) : 0;
                if (previewPrice) previewPrice.textContent = '$' + value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                if (previewMeta) previewMeta.textContent = 'Status: ' + (statusInput && statusInput.value ? statusInput.value : 'n/a');
            }

            if (nameInput) nameInput.addEventListener('input', refresh);
            if (priceInput) priceInput.addEventListener('input', refresh);
            if (statusInput) statusInput.addEventListener('change', refresh);
            if (imageInput) {
                imageInput.addEventListener('change', function () {
                    var file = imageInput.files && imageInput.files[0];
                    if (!file || !previewImage) return;
                    previewImage.src = URL.createObjectURL(file);
                });
            }
            refresh();
        })();
    </script>
}
