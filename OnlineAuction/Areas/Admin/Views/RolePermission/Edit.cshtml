@model RolePermissionEditViewModel

@{
    ViewData["Title"] = $"Edit Permissions — {Model.RoleName}";
    ViewData["AdminPage"] = "role-permissions";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Edit Permissions</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">Role: @Model.RoleName</p>
        </div>
        <a asp-action="Index"
           class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
            Back
        </a>
    </div>

    <form asp-action="Edit" method="post" class="space-y-6">
        @Html.AntiForgeryToken()
        <input type="hidden" name="RoleId" value="@Model.RoleId" />

        @foreach (var module in Model.Modules)
        {
            <section class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <h3 class="mb-4 text-lg font-semibold text-gray-800 dark:text-white/90">@module.Module</h3>
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                    @foreach (var permission in module.Permissions)
                    {
                        <label class="flex items-start gap-3 rounded-lg border border-gray-200 px-4 py-3 dark:border-gray-800">
                            <input type="checkbox"
                                   name="PermissionIds"
                                   value="@permission.Id"
                                   checked="@permission.IsSelected"
                                   class="mt-1 h-4 w-4 rounded border-gray-300" />
                            <span>
                                <span class="block text-theme-sm font-medium text-gray-800 dark:text-white/90">@permission.Name</span>
                                <span class="block text-theme-xs text-gray-500">@permission.Code</span>
                                @if (!string.IsNullOrWhiteSpace(permission.Description))
                                {
                                    <span class="mt-1 block text-theme-xs text-gray-400">@permission.Description</span>
                                }
                            </span>
                        </label>
                    }
                </div>
            </section>
        }

        <div class="flex justify-end">
            <button type="submit"
                    class="inline-flex rounded-lg bg-brand-500 px-5 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
                Save permissions
            </button>
        </div>
    </form>
</div>
