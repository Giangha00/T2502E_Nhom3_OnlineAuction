@model UserDetailViewModel

@{
    ViewData["Title"] = "User Details";
    ViewData["AdminPage"] = "users";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">User Details</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">View account profile and activity summary.</p>
        </div>

        <div class="flex gap-3">
            <a asp-area="Admin"
               asp-controller="User"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
                Edit
            </a>

            <a asp-area="Admin"
               asp-controller="User"
               asp-action="Index"
               class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                Back
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="mb-6 flex items-center gap-4">
            <img src="@(Model.AvatarUrl ?? "/admin/images/user/user-01.jpg")"
                 alt="@Model.FullName"
                 class="h-20 w-20 rounded-full object-cover" />

            <div>
                <h3 class="text-xl font-semibold text-gray-800 dark:text-white/90">@Model.FullName</h3>
                <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Model.Email</p>
            </div>
        </div>

        <dl class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Phone</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.PhoneNumber</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Role</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.Role</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Status</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.Status</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Gender</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.Gender</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Created Date</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.CreatedDate.ToString("dd/MM/yyyy HH:mm")</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Updated Date</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">
                    @(Model.UpdatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "Not updated")
                </dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Auction Count</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.AuctionCount</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Active Auction / Transaction</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">
                    @(Model.HasActiveAuctionOrTransaction ? "Yes" : "No")
                </dd>
            </div>
        </dl>
    </div>
</div>
