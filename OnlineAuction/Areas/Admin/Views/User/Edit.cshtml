@model UserFormViewModel

@{
    ViewData["Title"] = "Edit User";
    ViewData["AdminPage"] = "users";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6">
        <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Edit User</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">Update user profile, role, and account status.</p>
    </div>

    <form asp-area="Admin"
          asp-controller="User"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data"
          class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        @Html.AntiForgeryToken()

        <div class="mb-6 flex items-center gap-4">
            <img src="@(Model.CurrentAvatarUrl ?? "/admin/images/user/user-01.jpg")"
                 alt="@Model.FullName"
                 class="h-16 w-16 rounded-full object-cover" />
            <div>
                <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">@Model.FullName</p>
                <p class="text-theme-xs text-gray-500 dark:text-gray-400">@Model.Email</p>
            </div>
        </div>

        <partial name="_UserFormFields" model="Model" />

        <div class="mt-6 flex justify-end gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
            <a asp-area="Admin"
               asp-controller="User"
               asp-action="Details"
               asp-route-id="@Model.Id"
               class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
               title="Cancel"
               aria-label="Cancel">
                <partial name="_AdminIcon" model='"x-mark"' />
            </a>

            <button type="submit"
                    class="admin-icon-action admin-icon-action--primary admin-icon-action--lg cursor-pointer"
                    title="Save Changes"
                    aria-label="Save Changes">
                <partial name="_AdminIcon" model='"save"' />
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
