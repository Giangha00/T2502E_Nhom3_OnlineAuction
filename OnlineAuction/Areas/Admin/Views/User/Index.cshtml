@model UserListViewModel

@{
    ViewData["Title"] = "User Management";
    ViewData["AdminPage"] = "users";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<link rel="stylesheet" href="~/admin/css/daterangepicker-admin.css" asp-append-version="true" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6" data-e2e-page="admin-user">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">User Management</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">Manage user accounts, roles, status, and profile information.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Create"
           class="admin-icon-action admin-icon-action--primary admin-icon-action--lg"
           title="Create User"
           aria-label="Create User">
            <partial name="_AdminIcon" model='"plus"' />
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <form id="userFilterForm" method="get" class="flex flex-wrap items-end gap-3 2xl:flex-nowrap">
            <input type="hidden" name="Page" value="@(Model.Filter.Page <= 0 ? 1 : Model.Filter.Page)" />

            <div class="min-w-[220px] flex-1">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Search</label>
                <input id="userSearchInput"
                       name="Search"
                       value="@Model.Filter.Search"
                       placeholder="Name, email, phone"
                       autocomplete="off"
                       class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[130px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Role</label>
                <select name="Role" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    <option value="User" selected="@(Model.Filter.Role == UserRole.User)">User</option>
                    <option value="Admin" selected="@(Model.Filter.Role == UserRole.Admin)">Admin</option>
                </select>
            </div>

            <div class="w-[140px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Status</label>
                <select name="Status" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    <option value="Active" selected="@(Model.Filter.Status == UserStatus.Active)">Active</option>
                    <option value="Inactive" selected="@(Model.Filter.Status == UserStatus.Inactive)">Inactive</option>
                </select>
            </div>

            <div class="w-[300px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Date range</label>
                @{
                    ViewData["DateRangeId"] = "userDateRangePicker";
                    ViewData["DateRangeHiddenId"] = "userDateRangeValue";
                    ViewData["DateRangeName"] = "DateRange";
                    ViewData["DateRangeValue"] = Model.Filter.DateRange;
                    ViewData["DateRangePlaceholder"] = "Select date range";
                }
                @await Html.PartialAsync("_DateRangeTrigger")
            </div>

            <div class="w-[150px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Sort</label>
                <select name="SortOrder" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Filter.SortOrder))">Name A-Z</option>
                    <option value="name_desc" selected="@(Model.Filter.SortOrder == "name_desc")">Name Z-A</option>
                    <option value="date_desc" selected="@(Model.Filter.SortOrder == "date_desc")">Newest</option>
                    <option value="date_asc" selected="@(Model.Filter.SortOrder == "date_asc")">Oldest</option>
                </select>
            </div>
        </form>
    </div>

    <div id="userListResults" class="transition-opacity duration-200">
        <partial name="_UserList" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/admin/js/admin-list-filter.js" asp-append-version="true"></script>
    <script>
        function bindUserBulkActions(container) {
            const selectAll = container.querySelector('#selectAllUsers');
            const bulkActionForm = container.querySelector('#userBulkActionForm');
            const checkboxes = container.querySelectorAll('.user-checkbox');

            if (selectAll) {
                selectAll.onchange = function () {
                    checkboxes.forEach(function (checkbox) {
                        checkbox.checked = selectAll.checked;
                    });
                };
            }

            if (bulkActionForm) {
                bulkActionForm.onsubmit = function (event) {
                    if (bulkActionForm.dataset.confirmAccepted === '1') {
                        delete bulkActionForm.dataset.confirmAccepted;
                        return;
                    }

                    if (event.submitter?.dataset.bulkSubmit !== 'true') {
                        return;
                    }

                    const action = bulkActionForm.querySelector('select[name="Action"]')?.value;
                    const selectedCount = bulkActionForm.querySelectorAll('.user-checkbox:checked').length;

                    if (!action) {
                        event.preventDefault();
                        return;
                    }

                    if (selectedCount === 0) {
                        event.preventDefault();
                        alert('Please select at least one user.');
                        return;
                    }

                    if (action !== '@UserBulkActions.Delete') {
                        return;
                    }

                    event.preventDefault();
                    const submitter = event.submitter;
                    const confirmFn = typeof window.showConfirmModal === 'function'
                        ? window.showConfirmModal
                        : function (options) {
                            return Promise.resolve(window.confirm(options.message || ''));
                        };

                    confirmFn({
                        title: 'Delete selected users?',
                        message: 'Are you sure you want to delete selected users?',
                        confirmText: 'Delete',
                        variant: 'danger'
                    }).then(function (confirmed) {
                        if (!confirmed) {
                            return;
                        }

                        bulkActionForm.dataset.confirmAccepted = '1';
                        if (typeof bulkActionForm.requestSubmit === 'function') {
                            bulkActionForm.requestSubmit(submitter || undefined);
                        } else {
                            HTMLFormElement.prototype.submit.call(bulkActionForm);
                        }
                    });
                };
            }
        }

        AdminListFilter.init({
            formId: 'userFilterForm',
            resultsId: 'userListResults',
            searchInputId: 'userSearchInput',
            listUrl: '@Url.Action("Index", "User", new { area = "Admin" })',
            setupDateRange: function (submitCallback) {
                AdminListFilter.setupDateRangePicker('#userDateRangePicker', submitCallback);
            },
            onUpdated: bindUserBulkActions
        });
    </script>
}
