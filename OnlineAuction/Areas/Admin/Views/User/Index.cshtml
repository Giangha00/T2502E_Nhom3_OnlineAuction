@model UserListViewModel

@{
    ViewData["Title"] = "User Management";
    ViewData["AdminPage"] = "users";

    var currentPage = Model.Filter.Page <= 0 ? 1 : Model.Filter.Page;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);

    string StatusClass(UserStatus status)
    {
        return status switch
        {
            UserStatus.Active => "bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-500",
            UserStatus.Inactive => "bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-warning-400",
            _ => "bg-gray-100 text-gray-700 dark:bg-white/5 dark:text-gray-400"
        };
    }

    string RoleClass(UserRole role)
    {
        return role == UserRole.Admin
            ? "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-400"
            : "bg-gray-100 text-gray-700 dark:bg-white/5 dark:text-gray-400";
    }
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">User Management</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">Manage user accounts, roles, status, and profile information.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Create"
           class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
            Create User
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <form method="get" class="flex flex-wrap items-end gap-3 2xl:flex-nowrap">
            <input type="hidden" name="Page" value="1" />

            <div class="min-w-[220px] flex-1">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Search</label>
                <input name="Search"
                       value="@Model.Filter.Search"
                       placeholder="Name, email, phone"
                       class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[130px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Role</label>
                <select name="Role" class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    <option value="User" selected="@(Model.Filter.Role == UserRole.User)">User</option>
                    <option value="Admin" selected="@(Model.Filter.Role == UserRole.Admin)">Admin</option>
                </select>
            </div>

            <div class="w-[140px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Status</label>
                <select name="Status" class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    <option value="Active" selected="@(Model.Filter.Status == UserStatus.Active)">Active</option>
                    <option value="Inactive" selected="@(Model.Filter.Status == UserStatus.Inactive)">Inactive</option>
                </select>
            </div>

            <div class="w-[220px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Date range</label>
                <input id="dateRangePicker"
                       name="DateRange"
                       value="@Model.Filter.DateRange"
                       placeholder="MM/DD/YYYY - MM/DD/YYYY"
                       autocomplete="off"
                       class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[150px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Sort</label>
                <select name="SortOrder" class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Filter.SortOrder))">Name A-Z</option>
                    <option value="name_desc" selected="@(Model.Filter.SortOrder == "name_desc")">Name Z-A</option>
                    <option value="date_desc" selected="@(Model.Filter.SortOrder == "date_desc")">Newest</option>
                    <option value="date_asc" selected="@(Model.Filter.SortOrder == "date_asc")">Oldest</option>
                </select>
            </div>

            <div class="flex gap-2">
                <button type="submit" class="h-10 rounded-lg bg-brand-500 px-4 text-theme-sm font-medium text-white hover:bg-brand-600">
                    Filter
                </button>

                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   class="inline-flex h-10 items-center rounded-lg border border-gray-300 bg-white px-4 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                    Reset
                </a>
            </div>
        </form>
    </div>

    <form id="userBulkActionForm"
          asp-area="Admin"
          asp-controller="User"
          asp-action="BulkAction"
          method="post">
        @Html.AntiForgeryToken()

        <div class="mb-4 flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03] lg:flex-row lg:items-center lg:justify-between">
            <div class="flex flex-col gap-3 sm:flex-row">
                <select name="Action" class="h-10 rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">Bulk action</option>
                    <option value="@UserBulkActions.Delete">Delete selected</option>
                    <option value="@UserBulkActions.ChangeStatus">Change status</option>
                    <option value="@UserBulkActions.ChangeRole">Change role</option>
                </select>

                <select name="Status" class="h-10 rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">Status</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                </select>

                <select name="Role" class="h-10 rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">Role</option>
                    <option value="User">User</option>
                    <option value="Admin">Admin</option>
                </select>

                <button type="submit"
                        data-bulk-submit="true"
                        class="h-10 rounded-lg border border-gray-300 bg-white px-4 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                    Apply
                </button>
            </div>

            <div class="text-theme-sm text-gray-500">
                Total: <span class="font-medium text-gray-800 dark:text-white/90">@Model.TotalItems</span>
            </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="max-w-full overflow-x-auto">
                <table class="w-full min-w-[1080px]">
                    <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                        <th class="w-12 px-5 py-3 text-left">
                            <input id="selectAllUsers" type="checkbox" />
                        </th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">User</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Contact</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Role</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Status</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Username</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Created</th>
                        <th class="px-5 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">Actions</th>
                    </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    @if (Model.Users.Count == 0)
                    {
                        <tr>
                            <td colspan="8" class="px-5 py-10 text-center text-theme-sm text-gray-500">No users found.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                                <td class="px-5 py-4">
                                    <input class="user-checkbox" type="checkbox" name="SelectedUserIds" value="@user.Id" />
                                </td>

                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <img src="@(user.AvatarUrl ?? "/admin/images/user/user-01.jpg")"
                                             alt="@user.FullName"
                                             class="h-10 w-10 rounded-full object-cover" />
                                        <div>
                                            <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">@user.FullName</p>
                                            <p class="text-theme-xs text-gray-500">ID: @user.Id</p>
                                        </div>
                                    </div>
                                </td>

                                <td class="px-5 py-4">
                                    <p class="text-theme-sm text-gray-800 dark:text-white/90">@user.Email</p>
                                    <p class="text-theme-xs text-gray-500">@user.PhoneNumber</p>
                                </td>

                                <td class="px-5 py-4">
                                    <span class="rounded-full px-2.5 py-0.5 text-theme-xs font-medium @RoleClass(user.Role)">
                                        @user.Role
                                    </span>
                                </td>

                                <td class="px-5 py-4">
                                    <span class="rounded-full px-2.5 py-0.5 text-theme-xs font-medium @StatusClass(user.Status)">
                                        @user.Status
                                    </span>
                                </td>

                                <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@user.Username</td>
                                <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@user.CreatedAt.ToString("dd/MM/yyyy")</td>

                                <td class="px-5 py-4">
                                    <div class="flex justify-end gap-3">
                                        <a asp-area="Admin"
                                           asp-controller="User"
                                           asp-action="Details"
                                           asp-route-id="@user.Id"
                                           class="text-theme-sm font-medium text-brand-500 hover:underline">
                                            Details
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="User"
                                           asp-action="Edit"
                                           asp-route-id="@user.Id"
                                           class="text-theme-sm font-medium text-warning-600 hover:underline">
                                            Edit
                                        </a>

                                        <button type="submit"
                                                formaction="@Url.Action("Delete", "User", new { area = "Admin", id = user.Id })"
                                                class="text-theme-sm font-medium text-error-600 hover:underline"
                                                onclick="return confirm('Are you sure you want to delete this user?');">
                                            Delete
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </form>

    <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-theme-sm text-gray-500">
            Page <span class="font-medium text-gray-800 dark:text-white/90">@currentPage</span>
            of <span class="font-medium text-gray-800 dark:text-white/90">@totalPages</span>
        </p>

        <nav class="flex flex-wrap items-center gap-2">
            <a asp-area="Admin"
               asp-controller="User"
               asp-action="Index"
               asp-route-Search="@Model.Filter.Search"
               asp-route-DateRange="@Model.Filter.DateRange"
               asp-route-SortOrder="@Model.Filter.SortOrder"
               asp-route-Role="@Model.Filter.Role"
               asp-route-Status="@Model.Filter.Status"
               asp-route-Page="@(currentPage - 1)"
               class="rounded-lg border border-gray-300 px-3 py-2 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 @(currentPage <= 1 ? "pointer-events-none opacity-50" : "")">
                Previous
            </a>

            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                <a asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   asp-route-Search="@Model.Filter.Search"
                   asp-route-DateRange="@Model.Filter.DateRange"
                   asp-route-SortOrder="@Model.Filter.SortOrder"
                   asp-route-Role="@Model.Filter.Role"
                   asp-route-Status="@Model.Filter.Status"
                   asp-route-Page="@pageNumber"
                   class="rounded-lg border px-3 py-2 text-theme-sm font-medium @(pageNumber == currentPage ? "border-brand-500 bg-brand-500 text-white" : "border-gray-300 text-gray-700 hover:bg-gray-50")">
                    @pageNumber
                </a>
            }

            <a asp-area="Admin"
               asp-controller="User"
               asp-action="Index"
               asp-route-Search="@Model.Filter.Search"
               asp-route-DateRange="@Model.Filter.DateRange"
               asp-route-SortOrder="@Model.Filter.SortOrder"
               asp-route-Role="@Model.Filter.Role"
               asp-route-Status="@Model.Filter.Status"
               asp-route-Page="@(currentPage + 1)"
               class="rounded-lg border border-gray-300 px-3 py-2 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 @(currentPage >= totalPages ? "pointer-events-none opacity-50" : "")">
                Next
            </a>
        </nav>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script>
        const selectAll = document.getElementById('selectAllUsers');
        const checkboxes = document.querySelectorAll('.user-checkbox');
        const bulkActionForm = document.getElementById('userBulkActionForm');

        if (selectAll) {
            selectAll.addEventListener('change', function () {
                checkboxes.forEach(function (checkbox) {
                    checkbox.checked = selectAll.checked;
                });
            });
        }

        function confirmBulkAction(form) {
            const action = form.querySelector('select[name="Action"]')?.value;
            const selectedCount = form.querySelectorAll('.user-checkbox:checked').length;

            if (!action) {
                return false;
            }

            if (selectedCount === 0) {
                alert('Please select at least one user.');
                return false;
            }

            if (action === '@UserBulkActions.Delete') {
                return confirm('Are you sure you want to delete selected users?');
            }

            return true;
        }

        if (bulkActionForm) {
            bulkActionForm.addEventListener('submit', function (event) {
                if (event.submitter?.dataset.bulkSubmit !== 'true') {
                    return;
                }

                if (!confirmBulkAction(bulkActionForm)) {
                    event.preventDefault();
                }
            });
        }

        $(function () {
            $('#dateRangePicker').daterangepicker({
                autoUpdateInput: false,
                locale: {
                    cancelLabel: 'Clear',
                    format: 'MM/DD/YYYY'
                }
            });

            $('#dateRangePicker').on('apply.daterangepicker', function (event, picker) {
                $(this).val(picker.startDate.format('MM/DD/YYYY') + ' - ' + picker.endDate.format('MM/DD/YYYY'));
            });

            $('#dateRangePicker').on('cancel.daterangepicker', function () {
                $(this).val('');
            });
        });
    </script>
}
