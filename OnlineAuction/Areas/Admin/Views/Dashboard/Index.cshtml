                    <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">1,245</h4>
                </div>
                <span class="flex items-center gap-1 rounded-full bg-success-50 py-0.5 pl-2 pr-2.5 text-sm font-medium text-success-600 dark:bg-success-500/15 dark:text-success-500">+18.1%</span>
            </div>
        </div>

