@model AdminDashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Dashboard";
    ViewData["AdminPage"] = "dashboard";

    var jsonOptions = new JsonSerializerOptions
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase
    };

    var chartDataJson = Model.HasValidFilter
        ? JsonSerializer.Serialize(new
        {
            registration = new
            {
                day = Model.UserSection.RegistrationByDay,
                week = Model.UserSection.RegistrationByWeek,
                month = Model.UserSection.RegistrationByMonth
            },
            categoryBreakdown = Model.AuctionSection.CategoryBreakdown,
            filter = new
            {
                dateFrom = Model.Filter.DateFrom.ToString("yyyy-MM-dd"),
                dateTo = Model.Filter.DateTo.ToString("yyyy-MM-dd"),
                registrationGranularity = Model.Filter.RegistrationGranularity
            }
        }, jsonOptions)
        : "{}";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<link rel="stylesheet" href="~/admin/css/daterangepicker-admin.css" asp-append-version="true" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_Title"]</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Subtitle"]</p>
        </div>
    </div>

    @await Html.PartialAsync("_DashboardFilterBar", Model)

    @if (Model.HasValidFilter)
    {
        @await Html.PartialAsync("_DashboardRevenueSection", Model)
        @await Html.PartialAsync("_DashboardUserSection", Model)
        @await Html.PartialAsync("_DashboardAuctionSection", Model)
    }
</div>

@if (Model.HasValidFilter)
{
<script type="application/json" id="dashboard-chart-data">@Html.Raw(chartDataJson)</script>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/admin/js/admin-list-filter.js" asp-append-version="true"></script>
    <script src="~/admin/js/dashboard-filter.js" asp-append-version="true"></script>
    @if (Model.HasValidFilter)
    {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.54.1/dist/apexcharts.min.js"></script>
    <script src="~/admin/js/dashboard.js" asp-append-version="true"></script>
    }
}
