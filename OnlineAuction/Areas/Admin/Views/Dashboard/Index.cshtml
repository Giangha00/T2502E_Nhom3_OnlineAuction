                    <path fill-rule="evenodd" clip-rule="evenodd" d="M10.268 2.90805C10.1187 2.80204 9.88127 2.80204 9.73199 2.90805L3.73199 7.10805C3.59628 7.20481 3.5 7.36013 3.5 7.52805V16.4719C3.5 16.6398 3.59628 16.7951 3.73199 16.8919L9.73199 21.0919C9.88127 21.1979 10.1187 21.1979 10.268 21.0919L16.268 16.8919C16.4037 16.7951 16.5 16.6398 16.5 16.4719V7.52805C16.5 7.36013 16.4037 7.20481 16.268 7.10805L10.268 2.90805ZM8.99999 4.53305L5.49999 7.03305V16.9669L8.99999 19.4669L12.5 16.9669V7.03305L8.99999 4.53305Z" fill="" />
