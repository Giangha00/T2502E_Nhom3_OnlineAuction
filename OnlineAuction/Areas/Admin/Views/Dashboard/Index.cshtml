                <svg class="fill-gray-800 dark:fill-white/90" width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M8.80443 5.60156C7.59109 5.60156 6.60749 6.58517 6.60749 7.79851C6.60749 9.01185 7.59109 9.99545 8.80443 9.99545C10.0178 9.99545 11.0014 9.01185 11.0014 7.79851C11.0014 6.58517 10.0178 5.60156 8.80443 5.60156ZM4.07591 19.8987H13.4249C14.6071 19.8987 15.7658 18.8971 15.4446 17.5202C15.2207 16.5607 14.7397 15.2906 13.6937 14.2549C12.6292 13.2009 11.0448 12.455 8.75042 12.455C6.45602 12.455 4.87163 13.2009 3.8071 14.2549C2.89369 19.8987 4.07591 19.8987Z" fill="" />
                </svg>
            </div>
