                <div>
                    <span class="text-sm text-gray-500 dark:text-gray-400">Registered Users</span>
                    <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">3,782</h4>
                </div>
                <span class="flex items-center gap-1 rounded-full bg-success-50 py-0.5 pl-2 pr-2.5 text-sm font-medium text-success-600 dark:bg-success-500/15 dark:text-success-500">+8.2%</span>
            </div>
        </div>

        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
