            </div>
            <div class="mt-5 flex items-end justify-between">
                <div>
                    <span class="text-sm text-gray-500 dark:text-gray-400">Revenue (USD)</span>
                    <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">$84,320</h4>
                </div>
                <span class="flex items-center gap-1 rounded-full bg-error-50 py-0.5 pl-2 pr-2.5 text-sm font-medium text-error-600 dark:bg-error-500/15 dark:text-error-500">-2.4%</span>
            </div>
        </div>
    </div>

    <div class="mt-6 overflow-hidden rounded-2xl border border-gray-200 bg-white px-4 pb-3 pt-4 dark:border-gray-800 dark:bg-white/[0.03] sm:px-6">
        <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Recent Auctions</h3>
                <p class="text-theme-sm text-gray-500 dark:text-gray-400">Latest listings and bidding status</p>
            </div>
            <button class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 shadow-theme-xs hover:bg-gray-50 hover:text-gray-800 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-400 dark:hover:bg-white/[0.03] dark:hover:text-gray-200">
                View All
            </button>
        </div>

        <div class="max-w-full overflow-x-auto">
            <table class="w-full min-w-[720px]">
                <thead>
                    <tr class="border-y border-gray-100 dark:border-gray-800">
                        <th class="py-3 text-left text-theme-xs font-medium text-gray-500 dark:text-gray-400">Product</th>
                        <th class="py-3 text-left text-theme-xs font-medium text-gray-500 dark:text-gray-400">Seller</th>
                        <th class="py-3 text-left text-theme-xs font-medium text-gray-500 dark:text-gray-400">Current Bid</th>
                        <th class="py-3 text-left text-theme-xs font-medium text-gray-500 dark:text-gray-400">Status</th>
                        <th class="py-3 text-left text-theme-xs font-medium text-gray-500 dark:text-gray-400">Ends In</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    <tr>
                        <td class="py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">Vintage Oil Painting</td>
                        <td class="py-3 text-theme-sm text-gray-500 dark:text-gray-400">art_collector_01</td>
                        <td class="py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">$2,450</td>
                        <td class="py-3"><span class="rounded-full bg-success-50 px-2.5 py-0.5 text-theme-xs font-medium text-success-600 dark:bg-success-500/15 dark:text-success-500">Live</span></td>
                        <td class="py-3 text-theme-sm text-gray-500 dark:text-gray-400">2h 15m</td>
                    </tr>
                    <tr>
                        <td class="py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">Antique Pocket Watch</td>
                        <td class="py-3 text-theme-sm text-gray-500 dark:text-gray-400">timekeeper_vn</td>
                        <td class="py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">$890</td>
                        <td class="py-3"><span class="rounded-full bg-warning-50 px-2.5 py-0.5 text-theme-xs font-medium text-warning-600 dark:bg-warning-500/15 dark:text-warning-400">Ending Soon</span></td>
                        <td class="py-3 text-theme-sm text-gray-500 dark:text-gray-400">35m</td>
                    </tr>
                    <tr>
                        <td class="py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">Signed Baseball Jersey</td>
                        <td class="py-3 text-theme-sm text-gray-500 dark:text-gray-400">sports_fan_88</td>
                        <td class="py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">$1,120</td>
                        <td class="py-3"><span class="rounded-full bg-success-50 px-2.5 py-0.5 text-theme-xs font-medium text-success-600 dark:bg-success-500/15 dark:text-success-500">Live</span></td>
                        <td class="py-3 text-theme-sm text-gray-500 dark:text-gray-400">5h 40m</td>
                    </tr>
                    <tr>
                        <td class="py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">Rare Vinyl Record</td>
                        <td class="py-3 text-theme-sm text-gray-500 dark:text-gray-400">vinyl_hunter</td>
                        <td class="py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">$320</td>
                        <td class="py-3"><span class="rounded-full bg-gray-100 px-2.5 py-0.5 text-theme-xs font-medium text-gray-600 dark:bg-white/5 dark:text-gray-400">Closed</span></td>
                        <td class="py-3 text-theme-sm text-gray-500 dark:text-gray-400">Ended</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>
