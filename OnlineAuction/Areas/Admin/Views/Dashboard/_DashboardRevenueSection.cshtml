@model AdminDashboardViewModel

@{
    var gmv = Math.Max(Model.RevenueSection.GmvKpi.NumericValue, 0);
    var commission = Math.Max(Model.RevenueSection.CommissionKpi.NumericValue, 0);
    var buyerFee = Math.Max(Model.RevenueSection.BuyerFeeKpi.NumericValue, 0);
    var sellerFee = Math.Max(Model.RevenueSection.SellerFeeKpi.NumericValue, 0);
    var sellerProceeds = Math.Max(Model.RevenueSection.SellerProceedsKpi.NumericValue, 0);

    decimal Share(decimal value) => gmv <= 0 ? 0 : Math.Round(value / gmv * 100m, 1);

    var revenueRows = new[]
    {
        new { Label = Localizer["Admin_Dashboard_Kpi_Commission"].Value, Value = commission, Color = "#465fff", Share = Share(commission) },
        new { Label = Localizer["Admin_Dashboard_Revenue_Donut_BuyerCheckoutFees"].Value, Value = buyerFee, Color = "#12b76a", Share = Share(buyerFee) },
        new { Label = Localizer["Admin_Dashboard_Revenue_Donut_SellerSuccessFees"].Value, Value = sellerFee, Color = "#f79009", Share = Share(sellerFee) },
        new { Label = Localizer["Admin_Dashboard_Kpi_SellerProceeds"].Value, Value = sellerProceeds, Color = "#7a5af8", Share = Share(sellerProceeds) }
    };
}

<section id="dashboard-revenue-section" class="admin-dashboard-layout">
    <div class="admin-dashboard-panel">
        <div class="admin-dashboard-panel__header">
            <div>
                <h2 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_RevenueSection_Title"]</h2>
                <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_RevenueSection_Description"]</p>
            </div>
        </div>

        <div class="admin-dashboard-note" title="@Localizer["Admin_Dashboard_Revenue_Rules_Tooltip"]">
            @Localizer["Admin_Dashboard_Revenue_Rules_Short"]
        </div>

        <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
            @await Html.PartialAsync("_DashboardKpiCard", Model.RevenueSection.CommissionKpi, new ViewDataDictionary(ViewData) { ["Label"] = Localizer["Admin_Dashboard_Kpi_Commission"].Value, ["Tone"] = "brand" })
            @await Html.PartialAsync("_DashboardKpiCard", Model.RevenueSection.BuyerFeeKpi, new ViewDataDictionary(ViewData) { ["Label"] = Localizer["Admin_Dashboard_Revenue_Donut_BuyerCheckoutFees"].Value, ["Tone"] = "success" })
            @await Html.PartialAsync("_DashboardKpiCard", Model.RevenueSection.SellerFeeKpi, new ViewDataDictionary(ViewData) { ["Label"] = Localizer["Admin_Dashboard_Revenue_Donut_SellerSuccessFees"].Value, ["Tone"] = "warning" })
            @await Html.PartialAsync("_DashboardKpiCard", Model.RevenueSection.SellerProceedsKpi, new ViewDataDictionary(ViewData) { ["Label"] = Localizer["Admin_Dashboard_Kpi_SellerProceeds"].Value, ["Tone"] = "purple" })
        </div>
    </div>

    <div class="admin-dashboard-layout__charts">
        <div class="admin-dashboard-panel">
            <div class="admin-dashboard-panel__header">
                <div>
                    <h3 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_RevenueDonutChart_Title"]</h3>
                    <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_RevenueDonutChart_Description"]</p>
                </div>
            </div>
            <div id="dashboard-revenue-donut-chart" class="min-h-[300px]"></div>
            <p id="dashboard-revenue-donut-empty" class="admin-dashboard-empty hidden">@Localizer["Admin_Dashboard_Revenue_NoFeeData"]</p>
        </div>

        <div class="admin-dashboard-panel">
            <div class="admin-dashboard-panel__header">
                <div>
                    <h3 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_RevenueChart_Title"]</h3>
                    <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_RevenueDetail_Description"]</p>
                </div>
            </div>

            @if (gmv <= 0)
            {
                <p class="admin-dashboard-empty">@Localizer["Admin_Dashboard_NoData"]</p>
            }
            else
            {
                <div class="admin-dashboard-revenue-stack">
                    @foreach (var row in revenueRows)
                    {
                        <div class="admin-dashboard-revenue-stack__row">
                            <span class="admin-dashboard-revenue-stack__label">@row.Label</span>
                            <div class="admin-dashboard-revenue-stack__bar">
                                <div class="admin-dashboard-revenue-stack__fill"
                                     style="width: @(Math.Max(row.Share, row.Value > 0 ? 4 : 0))%; background: @row.Color;"></div>
                            </div>
                            <span class="admin-dashboard-revenue-stack__value">@row.Value.ToString("C0") (@row.Share%)</span>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
