@model AdminDashboardViewModel

<section class="admin-dashboard__hero" aria-label="@Localizer["Admin_Dashboard_Section1_Title"]">
    @await Html.PartialAsync("_DashboardKpiCard", Model.RevenueSection.GmvKpi, new ViewDataDictionary(ViewData)
    {
        ["Label"] = Localizer["Admin_Dashboard_Kpi_Gmv"].Value,
        ["Tone"] = "revenue",
        ["Hero"] = true,
        ["Hint"] = Localizer["Admin_Dashboard_Gmv_Hint"].Value
    })

    @await Html.PartialAsync("_DashboardKpiCard", Model.AuctionSection.SuccessRateKpi, new ViewDataDictionary(ViewData)
    {
        ["Label"] = Localizer["Admin_Dashboard_Kpi_SuccessRate"].Value,
        ["Tone"] = "success",
        ["Hint"] = Localizer["Admin_Dashboard_SuccessRate_Hint"].Value
    })
</section>
