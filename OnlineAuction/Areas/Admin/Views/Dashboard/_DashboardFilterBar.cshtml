@model AdminDashboardViewModel

<form method="get"
      id="dashboardFilterForm"
      asp-area="Admin"
      asp-controller="Dashboard"
      asp-action="Index"
      class="mb-6 rounded-2xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03] md:p-5">
    <input type="hidden" name="status" value="@Model.Filter.StatusFilter" />
    <input type="hidden" name="categoryId" value="@Model.Filter.CategoryIdFilter" />
    <input type="hidden" name="registrationDate" value="@Model.Filter.RegistrationDateFilter?.ToString("yyyy-MM-dd")" />
    <input type="hidden" name="registrationGranularity" value="@Model.Filter.RegistrationGranularity" />
    <input type="hidden" name="section" value="@Model.Filter.SectionFilter" />
    <input type="hidden" name="revenueType" value="@Model.Filter.RevenueTypeFilter" />

    <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
        <div>
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_Filter_Title"]</h3>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Filter_Description"]</p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
            <div class="w-[220px]">
                <label for="dashboardDateRangePicker" class="mb-1 block text-theme-xs font-medium uppercase text-gray-500">Date range</label>
                <input id="dashboardDateRangePicker"
                       name="dateRange"
                       value="@Model.Filter.DateRange"
                       placeholder="MM/DD/YYYY - MM/DD/YYYY"
                       autocomplete="off"
                       class="h-10 w-full rounded-lg border border-gray-300 bg-white px-3 text-theme-sm text-gray-800 dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <button type="submit"
                    class="h-10 rounded-lg bg-brand-500 px-4 text-theme-sm font-medium text-white hover:bg-brand-600">
                @Localizer["Admin_Dashboard_Filter_Apply"]
            </button>

            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Export"
               asp-route-dateRange="@Model.Filter.DateRange"
               class="inline-flex h-10 items-center justify-center rounded-lg border border-gray-300 bg-white px-4 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                @Localizer["Admin_Dashboard_Filter_Export"]
            </a>
        </div>
    </div>
</form>
