@model AdminDashboardViewModel

@{
    var dateRangeDisplay = AdminDateRangeHelper.Format(Model.Filter.DateFrom, Model.Filter.DateTo);
}

<form method="get"
      id="dashboardFilterForm"
      asp-area="Admin"
      asp-controller="Dashboard"
      asp-action="Index"
      class="admin-dashboard-filter mb-6">
    <input type="hidden" name="registrationGranularity" value="@Model.Filter.RegistrationGranularity" />
    <input type="hidden" id="dashboardDateFrom" name="dateFrom" value="@Model.Filter.DateFrom.ToString("yyyy-MM-dd")" />
    <input type="hidden" id="dashboardDateTo" name="dateTo" value="@Model.Filter.DateTo.ToString("yyyy-MM-dd")" />
    <input type="hidden" id="dashboardDateRangeValue" value="@dateRangeDisplay" />

    <div class="flex flex-col gap-4">
        <div class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between">
            <div>
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_Filter_Title"]</h3>
                <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Filter_Description"]</p>
            </div>
            <span class="admin-dashboard-period-badge">
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M6 2a1 1 0 011 1v1h6V3a1 1 0 112 0v1h1a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2h1V3a1 1 0 011-1zm10 7H4v7h12V9z" clip-rule="evenodd" /></svg>
                @dateRangeDisplay
            </span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.FilterValidationErrorKey))
        {
            <div class="rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700 dark:border-error-500/30 dark:bg-error-500/10 dark:text-error-400"
                 role="alert">
                @Localizer[Model.FilterValidationErrorKey]
            </div>
        }

        <div class="admin-dashboard-filter__presets" role="group" aria-label="@Localizer["Admin_Dashboard_Filter_Title"]">
            <button type="button" class="admin-dashboard-filter__preset" data-dashboard-preset="7">@Localizer["Admin_Dashboard_Filter_Preset_7Days"]</button>
            <button type="button" class="admin-dashboard-filter__preset" data-dashboard-preset="30">@Localizer["Admin_Dashboard_Filter_Preset_30Days"]</button>
            <button type="button" class="admin-dashboard-filter__preset" data-dashboard-preset="this-month">@Localizer["Admin_Dashboard_Filter_Preset_ThisMonth"]</button>
            <button type="button" class="admin-dashboard-filter__preset" data-dashboard-preset="last-month">@Localizer["Admin_Dashboard_Filter_Preset_LastMonth"]</button>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-end">
            <div class="w-full sm:w-auto sm:min-w-[300px]">
                <label class="mb-1 block text-theme-xs font-medium uppercase text-gray-500">
                    @Localizer["Admin_Dashboard_Filter_From"] – @Localizer["Admin_Dashboard_Filter_To"]
                </label>
                <div id="dashboardDateRangePicker"
                     class="admin-daterange-trigger"
                     data-target-input="#dashboardDateRangeValue"
                     data-placeholder="Select date range"
                     role="button"
                     tabindex="0">
                    <svg class="admin-daterange-icon" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M6 2a1 1 0 011 1v1h6V3a1 1 0 112 0v1h1a2 2 0 012 2v10a2 2 0 01-2 2H4a2 2 0 01-2-2V6a2 2 0 012-2h1V3a1 1 0 011-1zm10 7H4v7h12V9z" clip-rule="evenodd" />
                    </svg>
                    <span class="admin-daterange-label">@dateRangeDisplay</span>
                    <svg class="admin-daterange-caret" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                    </svg>
                </div>
            </div>

            <button type="submit"
                    id="dashboardFilterApply"
                    class="admin-icon-action admin-icon-action--primary admin-icon-action--lg disabled:cursor-not-allowed disabled:opacity-70"
                    title="@Localizer["Admin_Dashboard_Filter_Apply"]"
                    aria-label="@Localizer["Admin_Dashboard_Filter_Apply"]">
                <span id="dashboardFilterApplySpinner" class="hidden h-4 w-4 animate-spin rounded-full border-2 border-white/30 border-t-white"></span>
                <span id="dashboardFilterApplyLabel"><partial name="_AdminIcon" model='"apply"' /></span>
            </button>

            <a id="dashboardExportLink"
               asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Export"
               asp-route-dateFrom="@Model.Filter.DateFrom.ToString("yyyy-MM-dd")"
               asp-route-dateTo="@Model.Filter.DateTo.ToString("yyyy-MM-dd")"
               class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
               title="@Localizer["Admin_Dashboard_Filter_Export"]"
               aria-label="@Localizer["Admin_Dashboard_Filter_Export"]">
                <partial name="_AdminIcon" model='"export"' />
            </a>
        </div>
    </div>
</form>
