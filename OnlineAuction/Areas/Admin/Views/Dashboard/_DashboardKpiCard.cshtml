@model DashboardKpiCardViewModel

@{
    var tone = ViewData["Tone"] as string ?? "brand";
    var hint = ViewData["Hint"] as string;
    var isHero = ViewData["Hero"] as bool? == true;
    var hasLink = !string.IsNullOrWhiteSpace(Model.LinkUrl);
    var accent = tone switch
    {
        "success" => "#12b76a",
        "warning" => "#f79009",
        "danger" => "#f04438",
        "purple" => "#7a5af8",
        _ => "#465fff"
    };

    string changeClass;
    if (string.IsNullOrEmpty(Model.ChangeDisplay))
    {
        changeClass = "admin-dashboard-kpi__change--neutral";
    }
    else if (Model.ChangeDisplay is "0%" or "+0%")
    {
        changeClass = "admin-dashboard-kpi__change--neutral";
    }
    else
    {
        changeClass = Model.IsPositiveChange
            ? "admin-dashboard-kpi__change--up"
            : "admin-dashboard-kpi__change--down";
    }

    var cardClass = "admin-dashboard-kpi"
                    + (isHero ? " admin-dashboard-kpi--hero" : string.Empty)
                    + (hasLink ? " admin-dashboard-kpi--link" : string.Empty);
}

@if (hasLink)
{
    <a href="@Model.LinkUrl"
       class="@cardClass"
       style="--dash-accent: @accent"
       aria-label="@ViewData["Label"]">
        @await Html.PartialAsync("_DashboardKpiCardBody", Model, new ViewDataDictionary(ViewData)
        {
            ["Tone"] = tone,
            ["Hint"] = hint,
            ["ChangeClass"] = changeClass
        })
    </a>
}
else
{
    <article class="@cardClass" style="--dash-accent: @accent">
        @await Html.PartialAsync("_DashboardKpiCardBody", Model, new ViewDataDictionary(ViewData)
        {
            ["Tone"] = tone,
            ["Hint"] = hint,
            ["ChangeClass"] = changeClass
        })
    </article>
}
