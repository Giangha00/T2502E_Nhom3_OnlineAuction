@model DashboardKpiCardViewModel

@{
    var tone = ViewData["Tone"] as string ?? "brand";
    var hint = ViewData["Hint"] as string;
    var isHero = ViewData["Hero"] as bool? == true;
    var accent = tone switch
    {
        "success" => "#12b76a",
        "warning" => "#f79009",
        "danger" => "#f04438",
        "purple" => "#7a5af8",
        _ => "#465fff"
    };

    string changeClass;
    if (string.IsNullOrEmpty(Model.ChangeDisplay) || Model.ChangeDisplay == "N/A")
    {
        changeClass = "admin-dashboard-kpi__change--neutral";
    }
    else
    {
        changeClass = Model.IsPositiveChange
            ? "admin-dashboard-kpi__change--up"
            : "admin-dashboard-kpi__change--down";
    }
}

<article class="admin-dashboard-kpi @(isHero ? "admin-dashboard-kpi--hero" : string.Empty)"
         style="--dash-accent: @accent">
    <div class="admin-dashboard-kpi__head">
        <div>
            <p class="admin-dashboard-kpi__label">@ViewData["Label"]</p>
        </div>
        <span class="admin-dashboard-kpi__icon" aria-hidden="true">
            @switch (tone)
            {
                case "success":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                    break;
                case "warning":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" /></svg>
                    break;
                case "danger":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z" /></svg>
                    break;
                case "purple":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" /></svg>
                    break;
                case "revenue":
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z" /></svg>
                    break;
                default:
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" /></svg>
                    break;
            }
        </span>
    </div>

    <p class="admin-dashboard-kpi__value">@Model.DisplayValue</p>

    <div class="admin-dashboard-kpi__meta">
        @if (!string.IsNullOrEmpty(Model.ChangeDisplay))
        {
            <span class="admin-dashboard-kpi__change @changeClass">
                @Model.ChangeDisplay
                @if (Model.ChangeDisplay != "N/A")
                {
                    <span class="font-normal opacity-80">@Localizer["Admin_Dashboard_ChangeVsPrevious"]</span>
                }
            </span>
        }

        @if (!string.IsNullOrWhiteSpace(hint))
        {
            <span class="admin-dashboard-kpi__hint">@hint</span>
        }
    </div>
</article>
