@model AdminDashboardViewModel

<section id="dashboard-auction-section" class="mt-8">
    <div class="mb-4">
        <h2 class="text-title-sm font-bold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_Section3_Title"]</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Section3_Description"]</p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-4 md:gap-6">
        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
            <span class="text-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Kpi_OngoingAuctions"]</span>
            <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">@Model.AuctionSection.OngoingKpi.DisplayValue</h4>
            <p class="mt-2 text-theme-xs text-gray-400">@Localizer["Admin_Dashboard_Snapshot_Note"]</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
            <span class="text-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Kpi_EndedAuctions"]</span>
            <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">@Model.AuctionSection.EndedKpi.DisplayValue</h4>
            <p class="mt-2 text-theme-xs text-gray-400">@Localizer["Admin_Dashboard_Snapshot_Note"]</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
            <span class="text-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Kpi_CancelledAuctions"]</span>
            <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">@Model.AuctionSection.CancelledKpi.DisplayValue</h4>
            <p class="mt-2 text-theme-xs text-gray-400">@Localizer["Admin_Dashboard_Snapshot_Note"]</p>
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
            <span class="text-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Kpi_SuccessRate"]</span>
            <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">@Model.AuctionSection.SuccessRateKpi.DisplayValue</h4>
            <p class="mt-2 text-theme-xs text-gray-400">@Localizer["Admin_Dashboard_Snapshot_Note"]</p>
            <p class="mt-1 text-theme-xs text-gray-400" title="@Localizer["Admin_Dashboard_SuccessRate_Tooltip"]">@Localizer["Admin_Dashboard_SuccessRate_Hint"]</p>
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
        <div class="mb-4">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_CategoryChart_Title"]</h3>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_CategoryChart_Description"]</p>
        </div>
        <div id="dashboard-category-chart" class="mx-auto min-h-[320px] max-w-xl"></div>
        <p id="dashboard-category-empty" class="hidden py-10 text-center text-theme-sm text-gray-500">@Localizer["Admin_Dashboard_NoData"]</p>
    </div>
</section>
