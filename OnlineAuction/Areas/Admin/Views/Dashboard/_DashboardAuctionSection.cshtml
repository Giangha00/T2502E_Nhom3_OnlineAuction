@model AdminDashboardViewModel

<section id="dashboard-auction-section" class="admin-dashboard-layout">
    <div class="admin-dashboard-panel">
        <div class="admin-dashboard-panel__header">
            <div>
                <h2 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_Section3_Title"]</h2>
                <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_Section3_Description"]</p>
            </div>
            <span class="admin-dashboard-period-badge">@Localizer["Admin_Dashboard_Snapshot_Note"]</span>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
            @await Html.PartialAsync("_DashboardKpiCard", Model.AuctionSection.OngoingKpi, new ViewDataDictionary(ViewData) { ["Label"] = Localizer["Admin_Dashboard_Kpi_OngoingAuctions"].Value, ["Tone"] = "brand", ["Hint"] = Localizer["Admin_Dashboard_Snapshot_Note"].Value })
            @await Html.PartialAsync("_DashboardKpiCard", Model.AuctionSection.EndedKpi, new ViewDataDictionary(ViewData) { ["Label"] = Localizer["Admin_Dashboard_Kpi_EndedAuctions"].Value, ["Tone"] = "success", ["Hint"] = Localizer["Admin_Dashboard_Snapshot_Note"].Value })
            @await Html.PartialAsync("_DashboardKpiCard", Model.AuctionSection.CancelledKpi, new ViewDataDictionary(ViewData) { ["Label"] = Localizer["Admin_Dashboard_Kpi_CancelledAuctions"].Value, ["Tone"] = "danger", ["Hint"] = Localizer["Admin_Dashboard_Snapshot_Note"].Value })
            @await Html.PartialAsync("_DashboardKpiCard", Model.AuctionSection.PendingVerificationKpi, new ViewDataDictionary(ViewData) { ["Label"] = Localizer["Admin_Dashboard_Kpi_PendingVerification"].Value, ["Tone"] = "warning", ["Hint"] = Localizer["Admin_Dashboard_Snapshot_Note"].Value })
        </div>
    </div>

    <div class="admin-dashboard-layout__charts">
        <div class="admin-dashboard-panel">
            <div class="admin-dashboard-panel__header">
                <div>
                    <h3 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_StatusChart_Title"]</h3>
                    <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_Snapshot_Note"]</p>
                </div>
            </div>
            <div id="dashboard-auction-status-chart" class="min-h-[280px]"></div>
            <p id="dashboard-auction-status-empty" class="admin-dashboard-empty hidden">@Localizer["Admin_Dashboard_NoData"]</p>
        </div>

        <div class="admin-dashboard-panel">
            <div class="admin-dashboard-panel__header">
                <div>
                    <h3 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_CategoryChart_Title"]</h3>
                    <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_CategoryChart_Description"]</p>
                </div>
            </div>
            <div id="dashboard-category-chart" class="min-h-[300px]"></div>
            <p id="dashboard-category-empty" class="admin-dashboard-empty hidden">@Localizer["Admin_Dashboard_NoData"]</p>
        </div>
    </div>
</section>
