@model AdminDashboardViewModel

@{
    var topBuyerMax = Model.UserSection.TopBuyers.Count == 0
        ? 0m
        : Model.UserSection.TopBuyers.Max(buyer => buyer.TotalBidAmount);
    var topSellerMax = Model.UserSection.TopSellers.Count == 0
        ? 0m
        : Model.UserSection.TopSellers.Max(seller => seller.TotalSales);
}

<section id="dashboard-user-section" class="admin-dashboard-layout">
    <div class="admin-dashboard-panel">
        <div class="admin-dashboard-panel__header">
            <div>
                <h2 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_Section2_Title"]</h2>
                <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_Section2_Description"]</p>
            </div>
        </div>

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            @await Html.PartialAsync("_DashboardKpiCard", Model.UserSection.NewRegistrationsKpi, new ViewDataDictionary(ViewData)
            {
                ["Label"] = Localizer["Admin_Dashboard_Kpi_NewRegistrations"].Value,
                ["Tone"] = "purple",
                ["Hint"] = Localizer["Admin_Dashboard_FilteredPeriod_Note"].Value
            })
            @await Html.PartialAsync("_DashboardKpiCard", Model.UserSection.ActiveUsersKpi, new ViewDataDictionary(ViewData)
            {
                ["Label"] = Localizer["Admin_Dashboard_Kpi_ActiveUsers"].Value,
                ["Tone"] = "brand",
                ["Hint"] = Localizer["Admin_Dashboard_FilteredPeriod_Note"].Value
            })
        </div>
    </div>

    <div class="admin-dashboard-panel">
        <div class="admin-dashboard-panel__header">
            <div>
                <h3 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_RegistrationChart_Title"]</h3>
                <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_RegistrationChart_Description"]</p>
            </div>
            <div class="admin-dashboard-tabs" role="tablist" aria-label="@Localizer["Admin_Dashboard_RegistrationChart_Title"]">
                <button type="button" data-registration-granularity="day" class="dashboard-registration-tab admin-dashboard-tabs__btn is-active">@Localizer["Admin_Dashboard_Granularity_Day"]</button>
                <button type="button" data-registration-granularity="week" class="dashboard-registration-tab admin-dashboard-tabs__btn">@Localizer["Admin_Dashboard_Granularity_Week"]</button>
                <button type="button" data-registration-granularity="month" class="dashboard-registration-tab admin-dashboard-tabs__btn">@Localizer["Admin_Dashboard_Granularity_Month"]</button>
            </div>
        </div>
        <div id="dashboard-registration-chart" class="min-h-[300px]"></div>
        <p id="dashboard-registration-empty" class="admin-dashboard-empty hidden">@Localizer["Admin_Dashboard_NoData"]</p>
    </div>

    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2">
        <div class="admin-dashboard-panel !p-0 overflow-hidden">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
                <h3 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_TopBuyers_Title"]</h3>
                <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_FilteredPeriod_Note"]</p>
            </div>
            <div class="max-w-full overflow-x-auto">
                <table class="w-full min-w-[480px]">
                    <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">#</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_Name"]</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_BidCount"]</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_TotalBid"]</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    @if (Model.UserSection.TopBuyers.Count == 0)
                    {
                        <tr><td colspan="4" class="px-5 py-8 text-center text-theme-sm text-gray-500">@Localizer["Admin_Dashboard_NoData"]</td></tr>
                    }
                    else
                    {
                        var rank = 0;
                        foreach (var buyer in Model.UserSection.TopBuyers)
                        {
                            rank++;
                            var progress = topBuyerMax <= 0 ? 0 : (int)Math.Round(buyer.TotalBidAmount / topBuyerMax * 100m);
                            <tr>
                                <td class="px-5 py-3"><span class="admin-dashboard-rank @(rank <= 3 ? $"admin-dashboard-rank--{rank}" : string.Empty)">@rank</span></td>
                                <td class="px-5 py-3 text-theme-sm">
                                    <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@buyer.UserId" class="font-medium text-brand-600 hover:underline">@buyer.FullName</a>
                                    <div class="admin-dashboard-progress"><div class="admin-dashboard-progress__fill" style="width: @progress%"></div></div>
                                </td>
                                <td class="px-5 py-3 text-theme-sm text-gray-600 dark:text-gray-300">@buyer.BidCount</td>
                                <td class="px-5 py-3 text-theme-sm font-semibold text-gray-900 dark:text-white/90">@buyer.TotalBidAmount.ToString("C2")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="admin-dashboard-panel !p-0 overflow-hidden">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
                <h3 class="admin-dashboard-panel__title">@Localizer["Admin_Dashboard_TopSellers_Title"]</h3>
                <p class="admin-dashboard-panel__desc">@Localizer["Admin_Dashboard_FilteredPeriod_Note"]</p>
            </div>
            <div class="max-w-full overflow-x-auto">
                <table class="w-full min-w-[480px]">
                    <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">#</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_Name"]</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_Listings"]</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_NetProceeds"]</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    @if (Model.UserSection.TopSellers.Count == 0)
                    {
                        <tr><td colspan="4" class="px-5 py-8 text-center text-theme-sm text-gray-500">@Localizer["Admin_Dashboard_NoData"]</td></tr>
                    }
                    else
                    {
                        var rank = 0;
                        foreach (var seller in Model.UserSection.TopSellers)
                        {
                            rank++;
                            var progress = topSellerMax <= 0 ? 0 : (int)Math.Round(seller.TotalSales / topSellerMax * 100m);
                            <tr>
                                <td class="px-5 py-3"><span class="admin-dashboard-rank @(rank <= 3 ? $"admin-dashboard-rank--{rank}" : string.Empty)">@rank</span></td>
                                <td class="px-5 py-3 text-theme-sm">
                                    <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@seller.UserId" class="font-medium text-brand-600 hover:underline">@seller.FullName</a>
                                    <div class="admin-dashboard-progress"><div class="admin-dashboard-progress__fill" style="width: @progress%"></div></div>
                                </td>
                                <td class="px-5 py-3 text-theme-sm text-gray-600 dark:text-gray-300">@seller.ListingCount</td>
                                <td class="px-5 py-3 text-theme-sm font-semibold text-gray-900 dark:text-white/90">@seller.TotalSales.ToString("C2")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
