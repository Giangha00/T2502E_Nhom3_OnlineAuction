@model AdminDashboardViewModel

<section id="dashboard-user-section" class="mt-8">
    <div class="mb-4">
        <h2 class="text-title-sm font-bold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_Section2_Title"]</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Section2_Description"]</p>
    </div>

    <div class="grid grid-cols-1 gap-4 md:grid-cols-2 md:gap-6">
        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
            <span class="text-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Kpi_NewRegistrations"]</span>
            <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">@Model.UserSection.NewRegistrationsKpi.DisplayValue</h4>
            @if (!string.IsNullOrEmpty(Model.UserSection.NewRegistrationsKpi.ChangeDisplay))
            {
                var changeClass = Model.UserSection.NewRegistrationsKpi.IsPositiveChange
                    ? "text-success-600 dark:text-success-500"
                    : "text-error-600 dark:text-error-500";
                <p class="mt-2 text-theme-xs @changeClass">@Model.UserSection.NewRegistrationsKpi.ChangeDisplay @Localizer["Admin_Dashboard_ChangeVsPrevious"]</p>
            }
        </div>
        <div class="rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
            <span class="text-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_Kpi_ActiveUsers"]</span>
            <h4 class="mt-2 text-title-sm font-bold text-gray-800 dark:text-white/90">@Model.UserSection.ActiveUsersKpi.DisplayValue</h4>
            <p class="mt-2 text-theme-xs text-gray-400">@Localizer["Admin_Dashboard_FilteredPeriod_Note"]</p>
        </div>
    </div>

    <div class="mt-6 rounded-2xl border border-gray-200 bg-white p-5 dark:border-gray-800 dark:bg-white/[0.03] md:p-6">
        <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_RegistrationChart_Title"]</h3>
                <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["Admin_Dashboard_RegistrationChart_Description"]</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <button type="button" data-registration-granularity="day" class="dashboard-registration-tab rounded-lg border border-brand-500 bg-brand-500 px-3 py-1.5 text-theme-xs font-medium text-white">@Localizer["Admin_Dashboard_Granularity_Day"]</button>
                <button type="button" data-registration-granularity="week" class="dashboard-registration-tab rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs font-medium text-gray-700 dark:border-gray-700 dark:text-gray-300">@Localizer["Admin_Dashboard_Granularity_Week"]</button>
                <button type="button" data-registration-granularity="month" class="dashboard-registration-tab rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs font-medium text-gray-700 dark:border-gray-700 dark:text-gray-300">@Localizer["Admin_Dashboard_Granularity_Month"]</button>
            </div>
        </div>
        <div id="dashboard-registration-chart" class="min-h-[280px]"></div>
        <p id="dashboard-registration-empty" class="hidden py-10 text-center text-theme-sm text-gray-500">@Localizer["Admin_Dashboard_NoData"]</p>
    </div>

    <div class="mt-6 grid grid-cols-1 gap-4 xl:grid-cols-2 md:gap-6">
        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_TopBuyers_Title"]</h3>
            </div>
            <div class="max-w-full overflow-x-auto">
                <table class="w-full min-w-[480px]">
                    <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_Name"]</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_BidCount"]</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_TotalBid"]</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    @if (Model.UserSection.TopBuyers.Count == 0)
                    {
                        <tr><td colspan="3" class="px-5 py-8 text-center text-theme-sm text-gray-500">@Localizer["Admin_Dashboard_NoData"]</td></tr>
                    }
                    else
                    {
                        @foreach (var buyer in Model.UserSection.TopBuyers)
                        {
                            <tr>
                                <td class="px-5 py-3 text-theme-sm">
                                    <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@buyer.UserId" class="font-medium text-brand-600 hover:underline">@buyer.FullName</a>
                                </td>
                                <td class="px-5 py-3 text-theme-sm text-gray-600 dark:text-gray-300">@buyer.BidCount</td>
                                <td class="px-5 py-3 text-theme-sm font-semibold text-gray-900 dark:text-white/90">@buyer.TotalBidAmount.ToString("C2")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="border-b border-gray-100 px-5 py-4 dark:border-gray-800">
                <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["Admin_Dashboard_TopSellers_Title"]</h3>
            </div>
            <div class="max-w-full overflow-x-auto">
                <table class="w-full min-w-[480px]">
                    <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_Name"]</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_Listings"]</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["Admin_Dashboard_Col_Sales"]</th>
                    </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    @if (Model.UserSection.TopSellers.Count == 0)
                    {
                        <tr><td colspan="3" class="px-5 py-8 text-center text-theme-sm text-gray-500">@Localizer["Admin_Dashboard_NoData"]</td></tr>
                    }
                    else
                    {
                        @foreach (var seller in Model.UserSection.TopSellers)
                        {
                            <tr>
                                <td class="px-5 py-3 text-theme-sm">
                                    <a asp-area="Admin" asp-controller="User" asp-action="Details" asp-route-id="@seller.UserId" class="font-medium text-brand-600 hover:underline">@seller.FullName</a>
                                </td>
                                <td class="px-5 py-3 text-theme-sm text-gray-600 dark:text-gray-300">@seller.ListingCount</td>
                                <td class="px-5 py-3 text-theme-sm font-semibold text-gray-900 dark:text-white/90">@seller.TotalSales.ToString("C2")</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>
