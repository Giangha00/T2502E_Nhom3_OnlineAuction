@model AuctionListViewModel
@using OnlineAuction.Configurations
@using OnlineAuction.Helpers

@{
    ViewData["Title"] = "Auctions";
    ViewData["AdminPage"] = "auctions";
    var canManage = AdminPermissionHelper.Can(User, PermissionCodes.AuctionsManage);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<link rel="stylesheet" href="~/admin/css/daterangepicker-admin.css" asp-append-version="true" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6" data-e2e-page="admin-auction">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Auction Management</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">View and manage all platform auctions.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Auction"
           asp-action="CreateAuction"
           class="admin-icon-action admin-icon-action--primary admin-icon-action--lg @(canManage ? string.Empty : "hidden")"
           title="Create Auction"
           aria-label="Create Auction">
            <partial name="_AdminIcon" model='"plus"' />
        </a>
    </div>

    <partial name="_AdminFlashMessages" />

    <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <form id="auctionFilterForm" method="get" class="flex flex-wrap items-end gap-3 2xl:flex-nowrap">
            <input type="hidden" name="Page" value="@(Model.Filter.Page <= 0 ? 1 : Model.Filter.Page)" />

            <div class="min-w-[220px] flex-1">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Search</label>
                <input id="auctionSearchInput"
                       name="Search"
                       value="@Model.Filter.Search"
                       placeholder="Product, category, or seller"
                       autocomplete="off"
                       class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[190px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Listing Phase</label>
                <select name="ListingPhase" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    <option value="@AuctionListingPhases.Upcoming" selected="@(Model.Filter.ListingPhase == AuctionListingPhases.Upcoming)">@Localizer["Auction_Phase_upcoming"]</option>
                    <option value="@AuctionListingPhases.RegistrationOpen" selected="@(Model.Filter.ListingPhase == AuctionListingPhases.RegistrationOpen)">@Localizer["Auction_Phase_registration_open"]</option>
                    <option value="@AuctionListingPhases.RegistrationClosed" selected="@(Model.Filter.ListingPhase == AuctionListingPhases.RegistrationClosed)">@Localizer["Auction_Phase_registration_closed"]</option>
                    <option value="@AuctionListingPhases.LiveAuction" selected="@(Model.Filter.ListingPhase == AuctionListingPhases.LiveAuction)">@Localizer["Auction_Phase_live_auction"]</option>
                    <option value="@AuctionListingPhases.LiveEndingSoon" selected="@(Model.Filter.ListingPhase == AuctionListingPhases.LiveEndingSoon)">@Localizer["Auction_Phase_live_ending_soon"]</option>
                    <option value="@AuctionListingPhases.Ended" selected="@(Model.Filter.ListingPhase == AuctionListingPhases.Ended)">@Localizer["Auction_Phase_ended"]</option>
                    <option value="@AuctionListingPhases.NotListed" selected="@(Model.Filter.ListingPhase == AuctionListingPhases.NotListed)">@Localizer["Auction_Phase_not_listed"]</option>
                </select>
            </div>

            <div class="w-[180px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Category</label>
                <select name="CategoryId" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    @foreach (var category in Model.CategoryOptions)
                    {
                        <option value="@category.Value" selected="@category.Selected">@category.Text</option>
                    }
                </select>
            </div>

            <div class="w-[300px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Date range</label>
                @{
                    ViewData["DateRangeId"] = "auctionDateRangePicker";
                    ViewData["DateRangeHiddenId"] = "auctionDateRangeValue";
                    ViewData["DateRangeName"] = "DateRange";
                    ViewData["DateRangeValue"] = Model.Filter.DateRange;
                    ViewData["DateRangePlaceholder"] = "Select date range";
                }
                @await Html.PartialAsync("_DateRangeTrigger")
            </div>

            <div class="w-[170px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Sort</label>
                <select name="SortOrder" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Filter.SortOrder))">Newest</option>
                    <option value="date_asc" selected="@(Model.Filter.SortOrder == "date_asc")">Oldest</option>
                    <option value="price_desc" selected="@(Model.Filter.SortOrder == "price_desc")">Price high-low</option>
                    <option value="price_asc" selected="@(Model.Filter.SortOrder == "price_asc")">Price low-high</option>
                    <option value="end_asc" selected="@(Model.Filter.SortOrder == "end_asc")">Ending soonest</option>
                    <option value="end_desc" selected="@(Model.Filter.SortOrder == "end_desc")">Ending latest</option>
                    <option value="name_desc" selected="@(Model.Filter.SortOrder == "name_desc")">Name Z-A</option>
                </select>
            </div>
        </form>
    </div>

    <div id="auctionListResults" class="transition-opacity duration-200">
        <partial name="_AuctionList" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/admin/js/admin-list-filter.js" asp-append-version="true"></script>
    <script>
        function bindAuctionBulkActions(container) {
            AdminListFilter.bindBulkDelete(container, {
                formId: 'auctionBulkDeleteForm',
                selectAllId: 'selectAllAuctions',
                checkboxClass: 'auction-checkbox',
                emptyMessage: 'Please select at least one auction.',
                confirmMessage: 'Are you sure you want to delete selected auctions?'
            });
        }

        AdminListFilter.init({
            formId: 'auctionFilterForm',
            resultsId: 'auctionListResults',
            searchInputId: 'auctionSearchInput',
            listUrl: '@Url.Action("Index", "Auction", new { area = "Admin" })',
            setupDateRange: function (submitCallback) {
                AdminListFilter.setupDateRangePicker('#auctionDateRangePicker', submitCallback);
            },
            onUpdated: bindAuctionBulkActions
        });
    </script>
}
