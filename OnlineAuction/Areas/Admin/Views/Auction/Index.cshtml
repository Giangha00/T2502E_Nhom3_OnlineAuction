@{
    ViewData["Title"] = "Auctions";
    ViewData["AdminPage"] = "auctions";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Auction Management</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">View and manage all platform auctions.</p>
        </div>
        <a asp-area="Admin" asp-controller="Auction" asp-action="Create"
           class="rounded-lg bg-brand-500 px-4 py-2.5 text-sm font-medium text-white transition hover:bg-brand-600">
            Create Auction
        </a>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-sm text-gray-500 dark:text-gray-400">Auction list will be displayed here.</p>
    </div>
</div>
