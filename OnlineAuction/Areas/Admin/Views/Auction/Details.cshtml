@model AuctionDetailViewModel

@{
    ViewData["Title"] = "Auction Details";
    ViewData["AdminPage"] = "auctions";

    string FormatStatus(string status) => status switch
    {
        "confirming" or "pending_review" => "Confirming",
        "rejected" => "Rejected",
        "scheduled" => "Scheduled",
        "live" => "Live",
        "ending_soon" => "Ending soon",
        "ended" => "Ended",
        "awaiting_payment" => "Awaiting payment",
        "completed" => "Completed",
        "cancelled" => "Cancelled",
        _ => status.Replace('_', ' ')
    };

    string PhaseLabel(string phase)
    {
        var key = $"Auction_Phase_{phase}";
        var label = Localizer[key];

        if (!label.ResourceNotFound)
        {
            return label.Value;
        }

        return phase switch
        {
            AuctionListingPhases.RegistrationOpen => "Registration Open",
            AuctionListingPhases.RegistrationClosed => "Awaiting Live",
            AuctionListingPhases.LiveAuction => "Live Now",
            AuctionListingPhases.LiveEndingSoon => "Ending Soon",
            AuctionListingPhases.Upcoming => "Upcoming",
            AuctionListingPhases.Ended => "Ended",
            AuctionListingPhases.NotListed => "Not listed",
            _ => phase.Replace('_', ' ')
        };
    }

    string PhaseBadgeClass(string phase) => phase switch
    {
        AuctionListingPhases.RegistrationOpen => "bg-sky-600 text-white",
        AuctionListingPhases.RegistrationClosed => "bg-amber-500 text-white",
        AuctionListingPhases.LiveAuction => "bg-emerald-600 text-white",
        AuctionListingPhases.LiveEndingSoon => "bg-red-600 text-white",
        AuctionListingPhases.Ended => "bg-gray-600 text-white",
        AuctionListingPhases.NotListed => "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300",
        _ => "bg-slate-600 text-white"
    };

    string StatusBadgeClass(string status) => status switch
    {
        "confirming" or "pending_review" => "bg-amber-50 text-amber-700 dark:bg-amber-500/15 dark:text-amber-400",
        "rejected" or "cancelled" => "bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-400",
        "live" => "bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400",
        "ending_soon" => "bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-400",
        "awaiting_payment" => "bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-warning-400",
        "completed" => "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-400",
        _ => "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300"
    };
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Auction Details</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">Viewing auction #@Model.Id.</p>
        </div>

        <div class="flex gap-3">
            @if (Model.IsPubliclyListed)
            {
                <a asp-area=""
                   asp-controller="Auction"
                   asp-action="Detail"
                   asp-route-id="@Model.Id"
                   class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
                   title="View on site"
                   aria-label="View on site"
                   target="_blank"
                   rel="noopener">
                    <partial name="_AdminIcon" model='"external"' />
                </a>
            }

            <a asp-area="Admin"
               asp-controller="Auction"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="admin-icon-action admin-icon-action--edit admin-icon-action--lg"
               title="Edit"
               aria-label="Edit">
                <partial name="_AdminIcon" model='"pencil"' />
            </a>

            <a asp-area="Admin"
               asp-controller="Auction"
               asp-action="Index"
               class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
               title="Back"
               aria-label="Back">
                <partial name="_AdminIcon" model='"arrow-left"' />
            </a>
        </div>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="flex flex-col gap-6 md:flex-row">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl"
                     alt="@Model.ProductName"
                     class="h-40 w-40 rounded-xl object-cover" />
            }

            <div class="flex-1">
                <h3 class="text-xl font-semibold text-gray-800 dark:text-white/90">@Model.ProductName</h3>
                <p class="mt-1 text-theme-sm capitalize text-gray-500 dark:text-gray-400">@Model.ListingType · @Model.CategoryName</p>
                <div class="mt-3 flex flex-wrap items-center gap-2">
                    <span class="rounded-full px-2.5 py-0.5 text-theme-xs font-medium capitalize @StatusBadgeClass(Model.Status)">
                        DB: @FormatStatus(Model.Status)
                    </span>
                    <span class="rounded-md px-2 py-1 text-[11px] font-bold uppercase tracking-wide @PhaseBadgeClass(Model.ListingPhase)">
                        @PhaseLabel(Model.ListingPhase)
                    </span>
                    <span class="rounded-full px-2.5 py-0.5 text-theme-xs font-medium @(Model.IsPubliclyListed ? "bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400" : "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300")">
                        Public: @(Model.IsPubliclyListed ? "Yes" : "No")
                    </span>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="prose prose-sm mt-6 max-w-none rounded-xl border border-gray-100 bg-gray-50 p-4 text-theme-sm text-gray-700 dark:border-gray-800 dark:bg-white/[0.02] dark:text-gray-300">
                @Html.Raw(Model.Description)
            </div>
        }

        <dl class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Seller</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.SellerName</dd>
                <dd class="text-theme-xs text-gray-500">@Model.SellerEmail</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Pricing</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">
                    Current: @Model.CurrentPrice.ToString("N0") · Start: @Model.StartingPrice.ToString("N0") · Step: @Model.BidStep.ToString("N0")
                </dd>
                @if (Model.BuyNowPrice.HasValue)
                {
                    <dd class="text-theme-xs text-gray-500">Buy now: @Model.BuyNowPrice.Value.ToString("N0")</dd>
                }
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Registration Schedule</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">
                    @Model.RegistrationStartDate.ToString("dd/MM/yyyy HH:mm") - @Model.RegistrationEndDate.ToString("dd/MM/yyyy HH:mm")
                </dd>
                <dd class="text-theme-xs text-gray-500">@Model.RegistrationCount registration(s)</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Live Schedule</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">
                    @Model.StartDate.ToString("dd/MM/yyyy HH:mm") - @Model.EndDate.ToString("dd/MM/yyyy HH:mm")
                </dd>
                <dd class="text-theme-xs text-gray-500">@Model.TimeRemaining</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Visibility</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">
                    @(Model.IsPubliclyListed ? "Visible on /Auction" : "Not listed on /Auction")
                </dd>
                @if (Model.IsPubliclyListed)
                {
                    <dd>
                        <a asp-area=""
                           asp-controller="Auction"
                           asp-action="Detail"
                           asp-route-id="@Model.Id"
                           class="text-theme-xs font-medium text-brand-600 hover:text-brand-700"
                           target="_blank"
                           rel="noopener">Open public detail</a>
                    </dd>
                }
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Bids</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.BidCount</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Winner</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.WinnerName ?? "Not assigned")</dd>
                @if (Model.OrderId.HasValue)
                {
                    <dd class="text-theme-xs text-gray-500">
                        Order: @(Model.OrderReference ?? $"#{Model.OrderId.Value}") · @(Model.OrderStatus ?? "unknown")
                    </dd>
                    @if (Model.PaymentDeadline.HasValue)
                    {
                        <dd class="text-theme-xs text-gray-500">Payment deadline: @Model.PaymentDeadline.Value.ToString("dd/MM/yyyy HH:mm")</dd>
                    }
                }
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Verification</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">
                    @(Model.VerifiedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Not verified")
                </dd>
                <dd class="text-theme-xs text-gray-500">By: @(Model.VerifiedByName ?? "n/a")</dd>
                @if (!string.IsNullOrWhiteSpace(Model.RejectReason))
                {
                    <dd class="text-theme-xs text-error-600">Reject reason: @Model.RejectReason</dd>
                }
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Product ID</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.ProductId</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Created Date</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
            </div>

            <div>
                <dt class="text-theme-xs font-medium uppercase text-gray-400">Updated Date</dt>
                <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">
                    @(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Not updated")
                </dd>
            </div>
        </dl>
    </div>

    @await Html.PartialAsync("_FraudAlertsSection", Model)

    @await Html.PartialAsync("_WinnerNonPaymentSection", Model)

    @await Html.PartialAsync("_BidHistorySection", Model)
</div>
