@model AuctionFormViewModel

@{
    var previewPartial = ViewBag.PreviewPartial as string ?? "~/Views/Sell/Partials/_PreviewCard.cshtml";
    var formAction = ViewBag.FormAction as string ?? (Model.IsEdit ? "Edit" : "CreateAuction");
    var submitLabel = ViewBag.SubmitLabel as string ?? (Model.IsEdit ? "Save Changes" : "Create Listing");
    var pageTitle = ViewData["Title"] as string ?? (Model.IsEdit ? "Edit Listing" : "Create Listing");
    var cancelController = Model.IsBuyNow ? "BuyNow" : "Auction";
    var pageSubtitle = Model.IsEdit
        ? (Model.IsBuyNow
            ? $"Update listing #{Model.Id} with product specs, media, and fixed price."
            : $"Update auction #{Model.Id} with pricing, schedule, and card details.")
        : (Model.IsBuyNow
            ? "Buy Now listing with product specs, media, and fixed price."
            : "Auction listing with registration schedule, pricing, and card details.");
}

<style>
    .auction-detail {
        background: #f8fafc;
        padding: 18px;
    }
    .auction-detail .site-shell {
        margin: 0 auto;
        width: 100%;
        max-width: 1280px;
    }
    .auction-detail .auction-detail__layout {
        display: grid;
        gap: 2rem;
    }
    .auction-detail .auction-detail__hero h1 {
        margin: 0;
        font-size: 30px;
        line-height: 1.2;
        font-weight: 700;
        color: #0f172a;
    }
    .auction-detail .auction-detail__hero p {
        margin-top: 8px;
        color: #64748b;
        font-size: 14px;
    }
    .auction-detail .sell-section {
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        background: #fff;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }
    .auction-detail .sell-footer-bar {
        border-radius: 0.75rem;
        border: 1px solid #e2e8f0;
        background: #fff;
        box-shadow: 0 1px 2px rgba(15, 23, 42, 0.06);
    }
    .auction-detail .sell-section input[type="text"],
    .auction-detail .sell-section input[type="number"],
    .auction-detail .sell-section input[type="datetime-local"],
    .auction-detail .sell-section input[type="file"],
    .auction-detail .sell-section select,
    .auction-detail .sell-section textarea {
        width: 100%;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 10px 12px;
        font-size: 14px;
        background: #fff;
        color: #0f172a;
    }
    .auction-detail .sell-section input[readonly],
    .auction-detail .sell-section select:disabled {
        background: #f8fafc;
        color: #475569;
    }
    .auction-detail .sell-section label {
        display: block;
        margin-bottom: 6px;
        color: #334155;
        font-size: 14px;
        font-weight: 500;
    }
    .auction-detail .rarecard-card {
        position: relative;
    }
    .auction-detail .rarecard-card__shell {
        overflow: hidden;
        border-radius: 1rem;
        border: 1px solid #e7e5e4;
        background: #fff;
    }
    .auction-detail .rarecard-card__image-wrap {
        position: relative;
        aspect-ratio: 1 / 1;
        background: #f5f5f4;
    }
    .auction-detail .rarecard-card__image {
        height: 100%;
        width: 100%;
        object-fit: contain;
    }
    .auction-detail .rarecard-card__body {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
    }
    .auction-detail .rarecard-card__price-row {
        margin-top: auto;
    }
    .auction-detail .auction-detail__actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .auction-detail .auction-detail__btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 10px;
        padding: 10px 18px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
    }
    .auction-detail .auction-detail__btn--cancel {
        border: 1px solid #e2e8f0;
        color: #334155;
        background: #fff;
    }
    .auction-detail .auction-detail__btn--save {
        border: 1px solid #1d4ed8;
        color: #fff;
        background: #1d4ed8;
    }
    .auction-detail .auction-detail__dropzone.is-dragover {
        border-color: #3b82f6;
        background: rgba(239, 246, 255, 0.8);
    }
    .auction-detail .auction-detail__image-row {
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        gap: 0.75rem;
        overflow-x: auto;
        padding-bottom: 0.25rem;
    }
    .auction-detail .auction-detail__image-card {
        position: relative;
        flex: 0 0 auto;
        width: 5.5rem;
        height: 5.5rem;
        overflow: hidden;
        border-radius: 0.5rem;
        border: 1px solid #e2e8f0;
        background: #f1f5f9;
    }
    .auction-detail .auction-detail__image-card img {
        height: 100%;
        width: 100%;
        object-fit: cover;
    }
    .auction-detail .auction-detail__image-card .auction-detail__cover-badge {
        position: absolute;
        left: 0.375rem;
        top: 0.375rem;
        border-radius: 0.375rem;
        background: rgba(29, 78, 216, 0.92);
        padding: 0.2rem 0.45rem;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        color: #fff;
    }
    .auction-detail .auction-detail__image-card .auction-detail__image-remove {
        position: absolute;
        right: 0.375rem;
        top: 0.375rem;
        border-radius: 0.5rem;
        background: rgba(220, 38, 38, 0.9);
        padding: 0.25rem 0.5rem;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        color: #fff;
        opacity: 0;
        transition: opacity 0.15s ease;
        cursor: pointer;
        border: 0;
    }
    .auction-detail .auction-detail__image-card:hover .auction-detail__image-remove {
        opacity: 1;
    }
    .auction-detail .sell-section input[type="file"].sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
    }
    @@media (min-width: 1024px) {
        .auction-detail .auction-detail__layout {
            grid-template-columns: minmax(0, 1fr) 340px;
        }
        .auction-detail .auction-detail__aside {
            position: sticky;
            top: 96px;
            align-self: start;
        }
    }
</style>

<div class="sell-page auction-detail min-h-screen bg-slate-50">
    <section class="site-shell px-4 py-8 sm:px-6 lg:py-10">
        <div class="mb-8 auction-detail__hero">
            <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@pageTitle</h1>
            <p class="mt-2 text-sm text-slate-500 sm:text-base">@pageSubtitle</p>
        </div>

        <form id="adminListingForm"
              asp-area="Admin"
              asp-controller="Auction"
              asp-action="@formAction"
              method="post"
              enctype="multipart/form-data"
              novalidate
              data-listing-type="@Model.ListingType"
              data-is-edit="@(Model.IsEdit ? "true" : "false")"
              class="grid gap-8 lg:grid-cols-[1fr_340px] xl:grid-cols-[1fr_380px] auction-detail__layout">
            @Html.AntiForgeryToken()

            @if (Model.IsEdit)
            {
                <input asp-for="Id" type="hidden" />
                <input asp-for="ProductId" type="hidden" />
                <input asp-for="ListingType" type="hidden" />
            }

            <div class="space-y-6 auction-detail__main">
                <div class="rounded-xl border border-blue-200 bg-blue-50 px-5 py-3 text-sm text-blue-800">
                    Fill in required fields and review the live preview before saving.
                </div>

                @if (Model.IsScheduleLocked)
                {
                    <div class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-3 text-sm text-amber-800">
                        @Localizer["Admin_Auction_LiveLockBanner"]
                    </div>
                }

                @if (Model.Id > 0 && Model.BidCount > 0)
                {
                    <div class="rounded-xl border border-amber-200 bg-amber-50 px-5 py-3 text-sm text-amber-800">
                        This listing has @Model.BidCount bid(s). Starting price cannot exceed the current price.
                    </div>
                }

                <partial name="_Form" model="Model" />

                <div class="sell-footer-bar rounded-xl border border-slate-200 bg-white px-5 py-4 shadow-sm sm:px-6">
                    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                        <p class="text-sm text-slate-500">
                            <span class="font-medium text-slate-700">Ready to save?</span> Review the preview card and submit updates.
                        </p>
                        <div class="auction-detail__actions">
                            @if (Model.IsEdit)
                            {
                                <a asp-area="Admin"
                                   asp-controller="@cancelController"
                                   asp-action="Details"
                                   asp-route-id="@Model.Id"
                                   class="auction-detail__btn auction-detail__btn--cancel">
                                    Cancel
                                </a>
                            }
                            else
                            {
                                <a asp-area="Admin"
                                   asp-controller="@cancelController"
                                   asp-action="Index"
                                   class="auction-detail__btn auction-detail__btn--cancel">
                                    Cancel
                                </a>
                            }
                            <button type="submit" class="auction-detail__btn auction-detail__btn--save">
                                @submitLabel
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <aside class="space-y-4 auction-detail__aside">
                @if (Model.IsEdit)
                {
                    <div class="sell-section overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
                        <div class="border-b border-slate-100 px-6 py-5">
                            <h2 class="text-base font-semibold text-slate-900">Listing Info</h2>
                        </div>
                        <dl class="space-y-2 p-6 text-sm">
                            <div class="grid grid-cols-[110px_1fr] items-start gap-2">
                                <dt class="text-slate-500">@(Model.IsBuyNow ? "Listing ID" : "Auction ID")</dt>
                                <dd class="font-medium text-slate-800">#@Model.Id</dd>
                            </div>
                            <div class="grid grid-cols-[110px_1fr] items-start gap-2">
                                <dt class="text-slate-500">Product ID</dt>
                                <dd class="font-medium text-slate-800">@Model.ProductId</dd>
                            </div>
                            <div class="grid grid-cols-[110px_1fr] items-start gap-2">
                                <dt class="text-slate-500">Type</dt>
                                <dd class="font-medium text-slate-800">@Model.ListingType</dd>
                            </div>
                            @if (!Model.IsBuyNow)
                            {
                                <div class="grid grid-cols-[110px_1fr] items-start gap-2">
                                    <dt class="text-slate-500">Bids</dt>
                                    <dd class="font-medium text-slate-800">@Model.BidCount</dd>
                                </div>
                                <div class="grid grid-cols-[110px_1fr] items-start gap-2">
                                    <dt class="text-slate-500">Current</dt>
                                    <dd class="font-medium text-blue-700">$@Model.CurrentPrice.ToString("N0")</dd>
                                </div>
                            }
                        </dl>
                    </div>
                }

                <div>
                    @await Html.PartialAsync(previewPartial)
                </div>
            </aside>
        </form>
    </section>
</div>
