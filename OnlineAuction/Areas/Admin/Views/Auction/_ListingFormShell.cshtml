@model AuctionFormViewModel

@{
    var previewPartial = ViewBag.PreviewPartial as string ?? "~/Views/Sell/Partials/_PreviewCard.cshtml";
    var formAction = ViewBag.FormAction as string ?? (Model.IsEdit ? "Edit" : "CreateAuction");
    var submitLabel = ViewBag.SubmitLabel as string ?? (Model.IsEdit ? "Save Changes" : "Create Listing");
    var pageTitle = ViewData["Title"] as string ?? (Model.IsEdit ? "Edit Listing" : "Create Listing");
}

<div class="mx-auto max-w-(--breakpoint-7xl) p-4 md:p-6">
    <div class="mb-6">
        <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@pageTitle</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">
            @(Model.IsBuyNow ? "Buy Now listing with product specs, media, and fixed price." : "Auction listing with registration schedule, pricing, and card details.")
        </p>
    </div>

    <form id="adminListingForm"
          asp-area="Admin"
          asp-controller="Auction"
          asp-action="@formAction"
          method="post"
          enctype="multipart/form-data"
          novalidate
          data-listing-type="@Model.ListingType"
          data-is-edit="@(Model.IsEdit ? "true" : "false")"
          class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_360px]">
        @Html.AntiForgeryToken()

        @if (Model.IsEdit)
        {
            <input asp-for="Id" type="hidden" />
            <input asp-for="ProductId" type="hidden" />
            <input asp-for="ListingType" type="hidden" />
        }

        <div class="space-y-6 rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
            @if (Model.IsScheduleLocked)
            {
                <div class="rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-800">
                    @Localizer["Admin_Auction_LiveLockBanner"]
                </div>
            }

            @if (Model.Id > 0 && Model.BidCount > 0)
            {
                <div class="rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-700">
                    This listing has @Model.BidCount bid(s). Starting price cannot exceed the current price.
                </div>
            }

            <partial name="_Form" model="Model" />

            <div class="flex justify-end gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
                <a asp-area="Admin"
                   asp-controller="@(Model.IsBuyNow ? "BuyNow" : "Auction")"
                   asp-action="Index"
                   class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
                   title="Cancel"
                   aria-label="Cancel">
                    <partial name="_AdminIcon" model='"x-mark"' />
                </a>

                <button type="submit"
                        class="admin-icon-action admin-icon-action--primary admin-icon-action--lg"
                        title="@submitLabel"
                        aria-label="@submitLabel">
                    <partial name="_AdminIcon" model='"save"' />
                </button>
            </div>
        </div>

        <aside class="space-y-4 xl:sticky xl:top-24 xl:self-start">
            @await Html.PartialAsync(previewPartial)
        </aside>
    </form>
</div>
