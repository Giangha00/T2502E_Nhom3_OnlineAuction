@model AuctionFormViewModel

@{
    ViewData["Title"] = "Edit Auction";
    ViewData["AdminPage"] = "auctions";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6">
        <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Edit Auction</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">Update auction details for listing #@Model.Id.</p>
    </div>

    <form asp-area="Admin"
          asp-controller="Auction"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data"
          class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />
        <input asp-for="ProductId" type="hidden" />

        <partial name="_Form" model="Model" />

        <div class="mt-6 flex justify-end gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
            <a asp-area="Admin"
               asp-controller="Auction"
               asp-action="Index"
               class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
               title="Cancel"
               aria-label="Cancel">
                <partial name="_AdminIcon" model='"x-mark"' />
            </a>

            <button type="submit"
                    class="admin-icon-action admin-icon-action--primary admin-icon-action--lg"
                    title="Save Changes"
                    aria-label="Save Changes">
                <partial name="_AdminIcon" model='"save"' />
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
