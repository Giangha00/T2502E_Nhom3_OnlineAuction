@{
    ViewData["Title"] = "Edit Auction";
    ViewData["AdminPage"] = "auctions";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6">
        <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Edit Auction</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">Update auction details for listing #@ViewContext.RouteData.Values["id"].</p>
    </div>

    <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        <p class="text-sm text-gray-500 dark:text-gray-400">Auction edit form will be displayed here.</p>
        <a asp-area="Admin" asp-controller="Auction" asp-action="Index"
           class="mt-4 inline-block text-sm font-medium text-brand-500 hover:text-brand-600">← Back to list</a>
    </div>
</div>
