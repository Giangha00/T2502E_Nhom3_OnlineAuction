@model AuctionFormViewModel

@{
    ViewData["Title"] = Model.IsBuyNow ? "Edit Buy Now" : "Edit Auction";
    ViewData["AdminPage"] = Model.IsBuyNow ? "buynow" : "auctions";
    ViewBag.PreviewPartial = Model.IsBuyNow
        ? "~/Views/Sell/Partials/_BuyNowPreviewCard.cshtml"
        : "~/Views/Sell/Partials/_PreviewCard.cshtml";
    ViewBag.FormAction = "Edit";
    ViewBag.SubmitLabel = "Save Changes";
}

<partial name="_ListingFormShell" model="Model" />

@section Scripts {
    <partial name="_ListingFormScripts" model="Model" />
}
