@model AuctionListViewModel

@{
    var currentPage = Model.Filter.Page <= 0 ? 1 : Model.Filter.Page;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);

    string FormatStatus(string status) => status switch
    {
        "confirming" or "pending_review" => "Confirming",
        "rejected" => "Rejected",
        "scheduled" => "Scheduled",
        "live" => "Live",
        "ending_soon" => "Ending soon",
        "ended" => "Ended",
        "awaiting_payment" => "Awaiting payment",
        "completed" => "Completed",
        "cancelled" => "Cancelled",
        _ => status.Replace('_', ' ')
    };

    string PhaseLabel(string phase)
    {
        var key = $"Auction_Phase_{phase}";
        var label = Localizer[key];

        if (!label.ResourceNotFound)
        {
            return label.Value;
        }

        return phase switch
        {
            AuctionListingPhases.RegistrationOpen => "Registration Open",
            AuctionListingPhases.RegistrationClosed => "Awaiting Live",
            AuctionListingPhases.LiveAuction => "Live Now",
            AuctionListingPhases.LiveEndingSoon => "Ending Soon",
            AuctionListingPhases.Upcoming => "Upcoming",
            AuctionListingPhases.Ended => "Ended",
            AuctionListingPhases.NotListed => "Not listed",
            _ => phase.Replace('_', ' ')
        };
    }

    string PhaseBadgeClass(string phase) => phase switch
    {
        AuctionListingPhases.RegistrationOpen => "bg-sky-600 text-white",
        AuctionListingPhases.RegistrationClosed => "bg-amber-500 text-white",
        AuctionListingPhases.LiveAuction => "bg-emerald-600 text-white",
        AuctionListingPhases.LiveEndingSoon => "bg-red-600 text-white",
        AuctionListingPhases.Ended => "bg-gray-600 text-white",
        AuctionListingPhases.NotListed => "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300",
        _ => "bg-slate-600 text-white"
    };

    string StatusBadgeClass(string status) => status switch
    {
        "confirming" or "pending_review" => "bg-amber-50 text-amber-700 dark:bg-amber-500/15 dark:text-amber-400",
        "rejected" or "cancelled" => "bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-400",
        "live" => "bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400",
        "ending_soon" => "bg-error-50 text-error-700 dark:bg-error-500/15 dark:text-error-400",
        "awaiting_payment" => "bg-warning-50 text-warning-700 dark:bg-warning-500/15 dark:text-warning-400",
        "completed" => "bg-brand-50 text-brand-700 dark:bg-brand-500/15 dark:text-brand-400",
        _ => "bg-gray-100 text-gray-700 dark:bg-gray-800 dark:text-gray-300"
    };
}

<form id="auctionBulkDeleteForm"
      asp-area="Admin"
      asp-controller="Auction"
      asp-action="BulkDelete"
      method="post">
    @Html.AntiForgeryToken()

    <div class="mb-4 flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03] sm:flex-row sm:items-center sm:justify-between">
        <button type="submit"
                data-bulk-delete="true"
                class="admin-icon-action admin-icon-action--delete admin-icon-action--lg"
                title="Delete selected"
                aria-label="Delete selected">
            <partial name="_AdminIcon" model='"trash"' />
        </button>

        <div class="text-theme-sm text-gray-500">
            Total: <span class="font-medium text-gray-800 dark:text-white/90">@Model.TotalItems</span>
        </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="max-w-full overflow-x-auto">
            <table class="w-full min-w-[1450px]">
                <thead>
                <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                    <th class="w-12 px-5 py-3 text-left">
                        <input id="selectAllAuctions" type="checkbox" aria-label="Select all auctions" />
                    </th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Product</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Category</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Seller</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Prices</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">DB Status</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Listing Phase</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Schedule</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Bids</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Public</th>
                    <th class="px-5 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">Actions</th>
                </tr>
                </thead>

                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @if (Model.Auctions.Count == 0)
                {
                    <tr>
                        <td colspan="11" class="px-5 py-10 text-center text-theme-sm text-gray-500">No auctions found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var auction in Model.Auctions)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                            <td class="px-5 py-4">
                                <input class="auction-checkbox" type="checkbox" name="SelectedAuctionIds" value="@auction.Id" />
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(auction.ImageUrl))
                                    {
                                        <img src="@auction.ImageUrl"
                                             alt="@auction.ProductName"
                                             class="h-12 w-12 rounded-lg object-cover" />
                                    }
                                    <div>
                                        <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">@auction.ProductName</p>
                                        <p class="text-theme-xs text-gray-500">ID: @auction.Id</p>
                                        <span class="mt-1 inline-flex rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium capitalize text-gray-700 dark:bg-gray-800 dark:text-gray-300">@auction.ListingType</span>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@auction.CategoryName</td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@auction.SellerName</td>
                            <td class="px-5 py-4">
                                <p class="text-theme-sm text-gray-800 dark:text-white/90">Current: @auction.CurrentPrice.ToString("N0")</p>
                                <p class="text-theme-xs text-gray-500">Start: @auction.StartingPrice.ToString("N0")</p>
                                <p class="text-theme-xs text-gray-500">Step: @auction.BidStep.ToString("N0")</p>
                            </td>
                            <td class="px-5 py-4">
                                <span class="rounded-full px-2.5 py-0.5 text-theme-xs font-medium capitalize @StatusBadgeClass(auction.Status)">
                                    @FormatStatus(auction.Status)
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                <span class="rounded-md px-2 py-1 text-[11px] font-bold uppercase tracking-wide @PhaseBadgeClass(auction.ListingPhase)">
                                    @PhaseLabel(auction.ListingPhase)
                                </span>
                                @if (!string.IsNullOrWhiteSpace(auction.TimeRemaining) && auction.ListingPhase != AuctionListingPhases.NotListed)
                                {
                                    <p class="mt-1 text-theme-xs text-gray-500">@auction.TimeRemaining</p>
                                }
                            </td>
                            <td class="px-5 py-4">
                                <p class="text-theme-xs text-gray-500">Reg: @auction.RegistrationStartDate.ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="text-theme-xs text-gray-500">to @auction.RegistrationEndDate.ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="mt-1 text-theme-xs text-gray-700 dark:text-gray-300">Live: @auction.StartDate.ToString("dd/MM/yyyy HH:mm")</p>
                                <p class="text-theme-xs text-gray-500">to @auction.EndDate.ToString("dd/MM/yyyy HH:mm")</p>
                            </td>
                            <td class="px-5 py-4">
                                <p class="text-theme-sm text-gray-700 dark:text-gray-300">@auction.BidCount</p>
                                <p class="text-theme-xs text-gray-500">@auction.RegistrationCount reg.</p>
                            </td>
                            <td class="px-5 py-4">
                                <span class="rounded-full px-2.5 py-0.5 text-theme-xs font-medium @(auction.IsPubliclyListed ? "bg-success-50 text-success-700 dark:bg-success-500/15 dark:text-success-400" : "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300")">
                                    @(auction.IsPubliclyListed ? "Yes" : "No")
                                </span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="admin-icon-action-group">
                                    @if (auction.IsPubliclyListed)
                                    {
                                        <a asp-area=""
                                           asp-controller="Auction"
                                           asp-action="Detail"
                                           asp-route-id="@auction.Id"
                                           class="admin-icon-action admin-icon-action--neutral"
                                           title="View on site"
                                           aria-label="View on site"
                                           target="_blank"
                                           rel="noopener">
                                            <partial name="_AdminIcon" model='"external"' />
                                        </a>
                                    }

                                    <a asp-area="Admin"
                                       asp-controller="Auction"
                                       asp-action="Details"
                                       asp-route-id="@auction.Id"
                                       class="admin-icon-action admin-icon-action--view"
                                       title="Details"
                                       aria-label="Details">
                                        <partial name="_AdminIcon" model='"eye"' />
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="Auction"
                                       asp-action="Edit"
                                       asp-route-id="@auction.Id"
                                       class="admin-icon-action admin-icon-action--edit"
                                       title="Edit"
                                       aria-label="Edit">
                                        <partial name="_AdminIcon" model='"pencil"' />
                                    </a>

                                    <button type="submit"
                                            formaction="@Url.Action("Delete", "Auction", new { area = "Admin", id = auction.Id })"
                                            class="admin-icon-action admin-icon-action--delete"
                                            title="Delete"
                                            aria-label="Delete"
                                            data-confirm
                                            data-confirm-variant="danger"
                                            data-confirm-title="Delete auction?"
                                            data-confirm-message="Are you sure you want to delete this auction?"
                                            data-confirm-confirm="Delete">
                                        <partial name="_AdminIcon" model='"trash"' />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</form>

<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-theme-sm text-gray-500">
        Page <span class="font-medium text-gray-800 dark:text-white/90">@currentPage</span>
        of <span class="font-medium text-gray-800 dark:text-white/90">@totalPages</span>
    </p>

    <nav class="flex flex-wrap items-center gap-2">
        <a asp-area="Admin"
           asp-controller="Auction"
           asp-action="Index"
           asp-route-Search="@Model.Filter.Search"
           asp-route-Status="@Model.Filter.Status"
           asp-route-ListingPhase="@Model.Filter.ListingPhase"
           asp-route-ListingType="@Model.Filter.ListingType"
           asp-route-CategoryId="@Model.Filter.CategoryId"
           asp-route-SortOrder="@Model.Filter.SortOrder"
           asp-route-Page="@(currentPage - 1)"
           class="admin-icon-action admin-icon-action--pagination @(currentPage <= 1 ? "is-disabled" : "js-admin-page")"
           title="Previous"
           aria-label="Previous">
            <partial name="_AdminIcon" model='"chevron-left"' />
        </a>

        @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
        {
            <a asp-area="Admin"
               asp-controller="Auction"
               asp-action="Index"
               asp-route-Search="@Model.Filter.Search"
               asp-route-Status="@Model.Filter.Status"
               asp-route-ListingPhase="@Model.Filter.ListingPhase"
               asp-route-ListingType="@Model.Filter.ListingType"
               asp-route-CategoryId="@Model.Filter.CategoryId"
               asp-route-SortOrder="@Model.Filter.SortOrder"
               asp-route-Page="@pageNumber"
               class="js-admin-page rounded-lg border px-3 py-2 text-theme-sm font-medium @(pageNumber == currentPage ? "border-brand-500 bg-brand-500 text-white" : "border-gray-300 text-gray-700 hover:bg-gray-50")">
                @pageNumber
            </a>
        }

        <a asp-area="Admin"
           asp-controller="Auction"
           asp-action="Index"
           asp-route-Search="@Model.Filter.Search"
           asp-route-Status="@Model.Filter.Status"
           asp-route-ListingPhase="@Model.Filter.ListingPhase"
           asp-route-ListingType="@Model.Filter.ListingType"
           asp-route-CategoryId="@Model.Filter.CategoryId"
           asp-route-SortOrder="@Model.Filter.SortOrder"
           asp-route-Page="@(currentPage + 1)"
           class="admin-icon-action admin-icon-action--pagination @(currentPage >= totalPages ? "is-disabled" : "js-admin-page")"
           title="Next"
           aria-label="Next">
            <partial name="_AdminIcon" model='"chevron-right"' />
        </a>
    </nav>
</div>
