@{
    ViewData["Title"] = "Create Listing";
    ViewData["AdminPage"] = "auctions";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6">
        <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Create Listing</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">Choose the listing type to create.</p>
    </div>

    <div class="grid gap-6 md:grid-cols-2">
        <a asp-area="Admin"
           asp-controller="Auction"
           asp-action="CreateAuction"
           class="rounded-2xl border border-gray-200 bg-white p-6 transition hover:border-brand-500 hover:shadow-md dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Auction</h3>
            <p class="mt-2 text-theme-sm text-gray-500 dark:text-gray-400">
                Registration window, live bidding schedule, starting price and bid step.
            </p>
        </a>

        <a asp-area="Admin"
           asp-controller="Auction"
           asp-action="CreateBuyNow"
           class="rounded-2xl border border-gray-200 bg-white p-6 transition hover:border-brand-500 hover:shadow-md dark:border-gray-800 dark:bg-white/[0.03]">
            <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Buy Now</h3>
            <p class="mt-2 text-theme-sm text-gray-500 dark:text-gray-400">
                Fixed price listing without registration or auction schedule fields.
            </p>
        </a>
    </div>
</div>
