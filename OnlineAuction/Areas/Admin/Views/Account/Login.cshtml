@model LoginViewModel
@{
    Layout = "_AdminLoginLayout";
    ViewData["Title"] = "Admin Login";
}

<div class="flex min-h-screen items-center justify-center px-4 py-10">
    <div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white p-8 shadow-theme-lg dark:border-gray-800 dark:bg-gray-900">
        <div class="mb-8 text-center">
            <img class="mx-auto h-12 dark:hidden" src="~/admin/images/logo/auth-logo.svg" alt="Auction House" />
            <img class="mx-auto hidden h-12 dark:block" src="~/admin/images/logo/logo-dark.svg" alt="Auction House" />
            <h1 class="mt-6 text-2xl font-semibold text-gray-800 dark:text-white/90">Admin Sign In</h1>
            <p class="mt-2 text-sm text-gray-500 dark:text-gray-400">Enter your credentials to access the admin panel</p>
        </div>

        <div asp-validation-summary="ModelOnly" class="mb-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

        <form asp-area="Admin" asp-controller="Account" asp-action="Login" method="post" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />

            <div>
                <label asp-for="Email" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
                <input asp-for="Email"
                       type="email"
                       autocomplete="username"
                       placeholder="admin@auctionhouse.com"
                       class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-800 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white/90" />
                <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="mb-2 block text-sm font-medium text-gray-700 dark:text-gray-300">Password</label>
                <input asp-for="Password"
                       type="password"
                       autocomplete="current-password"
                       placeholder="Enter your password"
                       class="w-full rounded-lg border border-gray-200 bg-white px-4 py-3 text-sm text-gray-800 outline-none transition focus:border-brand-500 focus:ring-2 focus:ring-brand-500/20 dark:border-gray-700 dark:bg-gray-800 dark:text-white/90" />
                <span asp-validation-for="Password" class="mt-1 block text-xs text-red-600"></span>
            </div>

            <label class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                <input asp-for="RememberMe" type="checkbox" class="rounded border-gray-300 text-brand-500 focus:ring-brand-500" />
                <span>Remember Me</span>
            </label>

            <button type="submit"
                    class="w-full rounded-lg bg-brand-500 px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-600">
                Sign In
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
