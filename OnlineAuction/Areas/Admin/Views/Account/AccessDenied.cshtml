@{
    Layout = "_AdminLoginLayout";
    ViewData["Title"] = "Access Denied";
}

<div class="flex min-h-screen items-center justify-center px-4 py-10">
    <div class="w-full max-w-md rounded-2xl border border-gray-200 bg-white p-8 text-center shadow-theme-lg dark:border-gray-800 dark:bg-gray-900">
        <h1 class="text-2xl font-semibold text-gray-800 dark:text-white/90">Access Denied</h1>
        <p class="mt-3 text-sm text-gray-500 dark:text-gray-400">
            You do not have permission to access the admin panel.
        </p>
        <a asp-area="Admin" asp-controller="Account" asp-action="Login"
           class="admin-icon-action admin-icon-action--primary admin-icon-action--lg mx-auto"
           title="Back to Login"
           aria-label="Back to Login">
            <partial name="_AdminIcon" model='"arrow-left"' />
        </a>
    </div>
</div>
