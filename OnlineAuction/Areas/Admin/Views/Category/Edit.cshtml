@model OnlineAuction.Models.Category

<div class="max-w-3xl mx-auto p-6">

    <div class="bg-white rounded-xl shadow-md p-8">

        <h1 class="text-3xl font-bold mb-6">
            Edit Category
        </h1>

        <form asp-action="Edit"
              method="post"
              enctype="multipart/form-data">

            <input asp-for="Id" type="hidden" />

            <div class="mb-5">

                <label asp-for="Name"
                       class="block mb-2 font-medium text-gray-700">
                    Category Name
                </label>

                <input asp-for="Name"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-500" />

                <span asp-validation-for="Name"
                      class="text-red-500"></span>

            </div>

            <div class="mb-5">

                <label asp-for="Description"
                       class="block mb-2 font-medium text-gray-700">
                    Description
                </label>

                <textarea asp-for="Description"
                          rows="5"
                          class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-yellow-500"></textarea>

                <span asp-validation-for="Description"
                      class="text-red-500"></span>

            </div>

            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div class="mb-5">

                    <label class="block mb-2 font-medium text-gray-700">
                        Current Image
                    </label>

                    <img src="@Model.ImageUrl"
                         class="w-40 h-40 rounded-lg object-cover border" />

                </div>
            }

            <div class="mb-5">

                <label class="block mb-2 font-medium text-gray-700">
                    New Image
                </label>

                <input type="file"
                       name="imageFile"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3" />

            </div>

            <div class="flex gap-3">

                <button
                    type="submit"
                    class="inline-flex items-center justify-center rounded-md bg-brand-500 px-5 py-3 text-white hover:bg-brand-600">
                    Update Category
                </button>

                <a asp-action="Index"
                   class="bg-gray-500 hover:bg-gray-600 text-white px-6 py-3 rounded-lg">
                    Back
                </a>

            </div>

        </form>

    </div>

</div>