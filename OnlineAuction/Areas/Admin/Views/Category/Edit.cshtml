@model CategoryFormViewModel

@{
    ViewData["Title"] = "Edit Category";
    ViewData["AdminPage"] = "categories";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6">
        <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Edit Category</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">Update category details and visibility.</p>
    </div>

    <form asp-area="Admin"
          asp-controller="Category"
          asp-action="Edit"
          method="post"
          class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        @Html.AntiForgeryToken()

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="mb-4 text-theme-sm text-error-600"></div>

        @if (Model.ProductCount > 0)
        {
            <div class="mb-4 rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-700">
                This category is used by @Model.ProductCount product(s). Deleting it is blocked while products are linked.
            </div>
        }

        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label asp-for="Name" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="Name" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="Name" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="Slug" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="Slug" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="Slug" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="SortOrder" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="SortOrder" type="number" min="0" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="SortOrder" class="text-theme-xs text-error-600"></span>
            </div>

            <div class="flex items-center gap-3 pt-8">
                <input asp-for="IsActive" class="h-4 w-4 rounded border-gray-300 text-brand-500 focus:ring-brand-500" />
                <label asp-for="IsActive" class="text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
            </div>
        </div>

        <div class="mt-6 flex justify-end gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
            <a asp-area="Admin"
               asp-controller="Category"
               asp-action="Index"
               class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
               title="Cancel"
               aria-label="Cancel">
                <partial name="_AdminIcon" model='"x-mark"' />
            </a>

            <button type="submit"
                    class="admin-icon-action admin-icon-action--primary admin-icon-action--lg"
                    title="Save Changes"
                    aria-label="Save Changes">
                <partial name="_AdminIcon" model='"save"' />
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
