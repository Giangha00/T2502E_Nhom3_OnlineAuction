@model OnlineAuction.Models.Category

<div class="max-w-3xl mx-auto p-6">

    <div class="bg-white rounded-xl shadow-md p-8">

        <h1 class="text-3xl font-bold mb-6">
            Add New Category
        </h1>

        <form asp-action="Create"
              method="post"
              enctype="multipart/form-data">

            <div class="mb-5">

                <label asp-for="Name"
                       class="block mb-2 font-medium text-gray-700">
                    Category Name
                </label>

                <input asp-for="Name"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3" />

                <span asp-validation-for="Name"
                      class="text-red-500"></span>

            </div>

            <div class="mb-5">

                <label asp-for="Description"
                       class="block mb-2 font-medium text-gray-700">
                    Description
                </label>

                <textarea asp-for="Description"
                          rows="5"
                          class="w-full border border-gray-300 rounded-lg px-4 py-3"></textarea>

                <span asp-validation-for="Description"
                      class="text-red-500"></span>

            </div>

            <div class="mb-5">

                <label class="block mb-2 font-medium text-gray-700">
                    Category Image
                </label>

                <input type="file"
                       name="imageFile"
                       class="w-full border border-gray-300 rounded-lg px-4 py-3" />

            </div>

            <div class="flex gap-3">

                <button type="submit"
                        style="background:#465fff;
                               color:white;
                               padding:12px 24px;
                               border:none;
                               border-radius:8px;
                               font-weight:600;
                               cursor:pointer;">
                    Save Category
                </button>

                <a asp-action="Index"
                   style="background:#6b7280;
                          color:white;
                          padding:12px 24px;
                          border-radius:8px;
                          text-decoration:none;
                          display:inline-block;">
                    Back
                </a>

            </div>

        </form>

    </div>

</div>