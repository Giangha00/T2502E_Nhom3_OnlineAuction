@model CategoryListViewModel

@{
    ViewData["Title"] = "Category Management";
    ViewData["AdminPage"] = "categories";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Category Management</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">Manage product categories used across listings.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Category"
           asp-action="Create"
           class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
            Create Category
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <form id="categoryFilterForm" method="get" class="flex flex-wrap items-end gap-3 2xl:flex-nowrap">
            <input type="hidden" name="Page" value="@(Model.Filter.Page <= 0 ? 1 : Model.Filter.Page)" />

            <div class="min-w-[220px] flex-1">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Search</label>
                <input id="categorySearchInput"
                       name="Search"
                       value="@Model.Filter.Search"
                       placeholder="Name or slug"
                       autocomplete="off"
                       class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[140px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Status</label>
                <select name="IsActive" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    <option value="true" selected="@(Model.Filter.IsActive == true)">Active</option>
                    <option value="false" selected="@(Model.Filter.IsActive == false)">Inactive</option>
                </select>
            </div>

            <div class="w-[170px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Sort</label>
                <select name="SortOrder" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Filter.SortOrder))">Sort order</option>
                    <option value="name_desc" selected="@(Model.Filter.SortOrder == "name_desc")">Name Z-A</option>
                    <option value="sort_asc" selected="@(Model.Filter.SortOrder == "sort_asc")">Sort low-high</option>
                    <option value="sort_desc" selected="@(Model.Filter.SortOrder == "sort_desc")">Sort high-low</option>
                    <option value="date_desc" selected="@(Model.Filter.SortOrder == "date_desc")">Newest</option>
                    <option value="date_asc" selected="@(Model.Filter.SortOrder == "date_asc")">Oldest</option>
                </select>
            </div>
        </form>
    </div>

    <div id="categoryListResults" class="transition-opacity duration-200">
        <partial name="_CategoryList" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/admin-list-filter.js" asp-append-version="true"></script>
    <script>
        function bindCategoryBulkActions(container) {
            AdminListFilter.bindBulkDelete(container, {
                formId: 'categoryBulkDeleteForm',
                selectAllId: 'selectAllCategories',
                checkboxClass: 'category-checkbox',
                emptyMessage: 'Please select at least one category.',
                confirmMessage: 'Are you sure you want to delete selected categories?'
            });
        }

        AdminListFilter.init({
            formId: 'categoryFilterForm',
            resultsId: 'categoryListResults',
            searchInputId: 'categorySearchInput',
            listUrl: '@Url.Action("Index", "Category", new { area = "Admin" })',
            onUpdated: bindCategoryBulkActions
        });
    </script>
}
