@model IReadOnlyList<OnlineAuction.Areas.Admin.ViewModels.Products.ProductDocumentItemViewModel>
@{
    var editProductUrl = ViewData["EditProductUrl"] as string;
    var sectionTitle = ViewData["SectionTitle"] as string ?? Localizer["AdminProduct.CertificatesAndDocuments"];
}

<div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
  <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
    <h4 class="text-lg font-semibold text-gray-800 dark:text-white/90">@sectionTitle</h4>
    @if (!string.IsNullOrWhiteSpace(editProductUrl))
    {
      <a href="@editProductUrl" class="admin-icon-action admin-icon-action--edit admin-icon-action--sm" title="@Localizer["AdminProduct.EditProduct"]" aria-label="@Localizer["AdminProduct.EditProduct"]"><partial name="_AdminIcon" model='"pencil"' /></a>
    }
  </div>

  @if (Model.Count == 0)
  {
    <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["AdminProduct.EmptyDocuments"]</p>
  }
  else
  {
    <div class="max-w-full overflow-x-auto">
      <table class="w-full min-w-[720px]">
        <thead>
          <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
            <th class="px-4 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Name"]</th>
            <th class="px-4 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Type"]</th>
            <th class="px-4 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Uploaded"]</th>
            <th class="px-4 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Actions"]</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
          @foreach (var document in Model)
          {
            <tr>
              <td class="px-4 py-3 text-theme-sm font-medium text-gray-800 dark:text-white/90">@document.Name</td>
              <td class="px-4 py-3 text-theme-sm text-gray-600 dark:text-gray-300">@document.FileType</td>
              <td class="px-4 py-3 text-theme-sm text-gray-600 dark:text-gray-300">@document.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <a href="@document.FileUrl" target="_blank" rel="noopener"
                     class="admin-icon-action admin-icon-action--view"
                     title="@Localizer["AdminProduct.View"]"
                     aria-label="@Localizer["AdminProduct.View"]">
                    <partial name="_AdminIcon" model='"eye"' />
                  </a>
                  <a asp-area="Admin" asp-controller="Product" asp-action="DownloadDocument" asp-route-id="@document.Id"
                     class="admin-icon-action admin-icon-action--neutral"
                     title="@Localizer["AdminProduct.Download"]"
                     aria-label="@Localizer["AdminProduct.Download"]">
                    <partial name="_AdminIcon" model='"download"' />
                  </a>
                  <button type="button"
                          class="admin-icon-action admin-icon-action--review"
                          title="@Localizer["AdminProduct.PreviewDocument"]"
                          aria-label="@Localizer["AdminProduct.PreviewDocument"]"
                          data-doc-preview
                          data-doc-url="@document.FileUrl"
                          data-doc-name="@document.Name">
                    <partial name="_AdminIcon" model='"preview"' />
                  </button>
                </div>
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  }
</div>

<div id="adminDocumentPreviewModal" class="fixed inset-0 z-99999 hidden items-center justify-center bg-black/60 p-4">
  <div class="flex h-[min(90vh,820px)] w-full max-w-5xl flex-col overflow-hidden rounded-2xl bg-white shadow-xl dark:bg-gray-900">
    <div class="flex items-center justify-between border-b border-gray-200 px-5 py-4 dark:border-gray-800">
      <h3 id="adminDocumentPreviewTitle" class="text-base font-semibold text-gray-900 dark:text-white"></h3>
      <button type="button" id="adminDocumentPreviewClose" class="admin-icon-action admin-icon-action--neutral admin-icon-action--sm" title="@Localizer["AdminProduct.Close"]" aria-label="@Localizer["AdminProduct.Close"]"><partial name="_AdminIcon" model='"x-mark"' /></button>
    </div>
    <iframe id="adminDocumentPreviewFrame" title="@Localizer["AdminProduct.DocumentPreview"]" class="h-full w-full border-0 bg-white"></iframe>
  </div>
</div>

<script>
  (function () {
    var modal = document.getElementById('adminDocumentPreviewModal');
    var frame = document.getElementById('adminDocumentPreviewFrame');
    var title = document.getElementById('adminDocumentPreviewTitle');
    var closeBtn = document.getElementById('adminDocumentPreviewClose');
    if (!modal || !frame || !title || !closeBtn) return;

    function closeModal() {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      frame.removeAttribute('src');
    }

    document.querySelectorAll('[data-doc-preview]').forEach(function (button) {
      button.addEventListener('click', function () {
        var url = button.getAttribute('data-doc-url');
        var name = button.getAttribute('data-doc-name') || '@Localizer["AdminProduct.Document"]';
        if (!url) return;
        title.textContent = name;
        frame.src = url;
        modal.classList.remove('hidden');
        modal.classList.add('flex');
      });
    });

    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', function (event) {
      if (event.target === modal) closeModal();
    });
  })();
</script>
