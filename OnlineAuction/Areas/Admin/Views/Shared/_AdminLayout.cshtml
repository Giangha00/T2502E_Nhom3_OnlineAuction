<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CardMaket Admin</title>
    <link rel="icon" href="~/admin/images/favicon-settings.svg" type="image/svg+xml" asp-append-version="true" />
    <link rel="alternate icon" href="~/admin/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/style.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/admin-icon-actions.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/admin/css/admin-sidebar.css" asp-append-version="true" />
</head>
<body
    x-data="{ page: '@(ViewData["AdminPage"] ?? "dashboard")', loaded: true, darkMode: false, stickyMenu: false, sidebarToggle: false, scrollTop: false }"
    x-init="darkMode = JSON.parse(localStorage.getItem('darkMode')); $watch('darkMode', value => localStorage.setItem('darkMode', JSON.stringify(value)))"
    :class="{'dark bg-gray-900': darkMode === true}">
    <div
        x-show="loaded"
        x-init="window.addEventListener('DOMContentLoaded', () => { setTimeout(() => loaded = false, 500) })"
        class="fixed left-0 top-0 z-999999 flex h-screen w-screen items-center justify-center bg-white dark:bg-black">
        <div class="h-16 w-16 animate-spin rounded-full border-4 border-solid border-brand-500 border-t-transparent"></div>
    </div>

    <div class="flex h-screen overflow-hidden">
        <partial name="_AdminSidebar" />

        <div class="relative flex min-w-0 flex-1 flex-col overflow-y-auto">
            <div
                @@click="sidebarToggle = false"
                :class="sidebarToggle ? 'block lg:hidden' : 'hidden'"
                class="fixed z-9 h-screen w-full bg-gray-900/50"></div>

            <partial name="_AdminHeader" />

            <main>
                @RenderBody()
            </main>
        </div>
    </div>

    <partial name="_ConfirmModal" />
    <script>
        window.confirmModalConfig = {
            i18n: {
                confirm: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConfirmModal_Confirm"].Value)),
                cancel: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConfirmModal_Cancel"].Value)),
                title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["ConfirmModal_Confirm"].Value))
            }
        };
    </script>
    <script src="~/js/confirm-modal.js" asp-append-version="true"></script>
    <script src="~/admin/js/bundle.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
