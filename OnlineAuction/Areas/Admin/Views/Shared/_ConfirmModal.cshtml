<div id="confirmModalOverlay"
     class="fixed inset-0 z-99999 hidden items-center justify-center bg-gray-900/50 px-4"
     aria-hidden="true"
     hidden>
  <div id="confirmModalDialog"
       class="w-full max-w-md rounded-2xl border border-gray-200 bg-white p-6 shadow-theme-lg dark:border-gray-800 dark:bg-gray-900"
       role="dialog"
       aria-modal="true"
       aria-labelledby="confirmModalTitle"
       aria-describedby="confirmModalMessage">
    <div id="confirmModalIconWrap"
         data-class-default="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 dark:bg-brand-500/15"
         data-class-danger="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-error-50 dark:bg-error-500/15"
         class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-brand-50 dark:bg-brand-500/15">
      <svg id="confirmModalIconInfo" class="h-7 w-7 text-brand-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"/>
      </svg>
      <svg id="confirmModalIconDanger" class="hidden h-7 w-7 text-error-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126ZM12 15.75h.007v.008H12v-.008Z"/>
      </svg>
    </div>

    <h2 id="confirmModalTitle" class="mt-4 text-center text-xl font-bold text-gray-800 dark:text-white/90"></h2>
    <p id="confirmModalMessage" class="mt-2 text-center text-theme-sm leading-relaxed text-gray-500 dark:text-gray-400"></p>
    <p id="confirmModalNote" class="mt-3 hidden rounded-lg bg-gray-50 px-3 py-2 text-center text-theme-xs leading-relaxed text-gray-500 dark:bg-white/5 dark:text-gray-400"></p>

    <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-center">
      <button type="button"
              id="confirmModalCancelBtn"
              class="inline-flex w-full items-center justify-center rounded-lg border border-gray-300 px-4 py-3 text-theme-sm font-semibold text-gray-700 transition hover:bg-gray-50 sm:w-auto sm:min-w-[7.5rem] dark:border-gray-700 dark:text-gray-300 dark:hover:bg-white/5">
        Cancel
      </button>
      <button type="button"
              id="confirmModalConfirmBtn"
              data-class-default="inline-flex w-full items-center justify-center rounded-lg bg-gray-900 px-4 py-3 text-theme-sm font-semibold text-white transition hover:bg-gray-800 sm:w-auto sm:min-w-[7.5rem] dark:bg-white/90 dark:text-gray-900 dark:hover:bg-white"
              data-class-danger="inline-flex w-full items-center justify-center rounded-lg bg-error-500 px-4 py-3 text-theme-sm font-semibold text-white transition hover:bg-error-500 sm:w-auto sm:min-w-[7.5rem]"
              class="inline-flex w-full items-center justify-center rounded-lg bg-gray-900 px-4 py-3 text-theme-sm font-semibold text-white transition hover:bg-gray-800 sm:w-auto sm:min-w-[7.5rem] dark:bg-white/90 dark:text-gray-900 dark:hover:bg-white">
        Confirm
      </button>
    </div>
  </div>
</div>
