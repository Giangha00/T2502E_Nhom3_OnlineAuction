@model OnlineAuction.Areas.Admin.ViewModels.Products.ProductDetailViewModel

@{
    ViewData["Title"] = "Product Details";
    ViewData["AdminPage"] = "products";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-4 flex flex-wrap items-center gap-4">
        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="text-theme-sm font-medium text-brand-500 hover:underline">
            ← Back to card types
        </a>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Template"
           asp-route-id="@Model.ProductTemplateId"
           class="text-theme-sm font-medium text-brand-500 hover:underline">
            Open @Model.ProductTemplateName instances
        </a>
    </div>

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Product Details</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                Product #: @Model.ProductCode · ID: @Model.Id
            </p>
        </div>

        <div class="flex gap-3">
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
                Edit
            </a>

            @if (Model.CanDelete)
            {
                <form asp-area="Admin"
                      asp-controller="Product"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      asp-route-returnTemplateId="@Model.ProductTemplateId"
                      method="post"
                      onsubmit="return confirm('Are you sure you want to delete this product?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="rounded-lg border border-error-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-error-600 hover:bg-error-50 dark:border-error-500/30 dark:bg-gray-800">
                        Delete
                    </button>
                </form>
            }

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Template"
               asp-route-id="@Model.ProductTemplateId"
               class="rounded-lg border border-gray-300 bg-white px-4 py-2.5 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                Back
            </a>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="lg:col-span-1">
            <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <img src="@Model.PrimaryImage" alt="@Model.Name" class="mb-4 w-full rounded-xl border border-gray-200 object-cover dark:border-gray-700" />

                @if (Model.GalleryImages.Count > 0)
                {
                    <p class="mb-2 text-theme-xs font-medium uppercase text-gray-400">Gallery</p>
                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var image in Model.GalleryImages)
                        {
                            <img src="@image.ImageUrl" alt="Gallery" class="h-20 w-full rounded-lg border border-gray-200 object-cover dark:border-gray-700" />
                        }
                    </div>
                }
            </div>
        </div>

        <div class="lg:col-span-2 space-y-6">
            <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <h3 class="text-xl font-semibold text-gray-800 dark:text-white/90">@Model.Name</h3>
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                {
                    <p class="mt-1 text-theme-sm text-gray-500">@Model.Subtitle</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="mt-3 text-theme-sm text-gray-700 dark:text-gray-300">@Model.ShortDescription</p>
                }

                <dl class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Category</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.CategoryName</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Seller</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.SellerName (@Model.SellerEmail)</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Condition</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.Condition</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Grade</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.GradeLabel ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Cert Number</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.CertNumber ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Card Number</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.CardNumber ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Year</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.Year?.ToString() ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Set Name</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.SetName ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Language</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.Language ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Product Origin</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.ProductOrigin ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Estimated Value</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.EstimatedValue?.ToString("N2") ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Import Price</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.ImportPrice?.ToString("N2") ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Created</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">Updated</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? "Not updated")</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.GradingCentering) || !string.IsNullOrWhiteSpace(Model.GradingCorners) || !string.IsNullOrWhiteSpace(Model.GradingEdges) || !string.IsNullOrWhiteSpace(Model.GradingSurface))
                {
                    <div class="mt-6 border-t border-gray-100 pt-6 dark:border-gray-800">
                        <p class="mb-3 text-theme-xs font-medium uppercase text-gray-400">Grading Sub-scores</p>
                        <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
                            <div><span class="text-theme-xs text-gray-500">Centering</span><p class="text-theme-sm font-medium">@(Model.GradingCentering ?? "—")</p></div>
                            <div><span class="text-theme-xs text-gray-500">Corners</span><p class="text-theme-sm font-medium">@(Model.GradingCorners ?? "—")</p></div>
                            <div><span class="text-theme-xs text-gray-500">Edges</span><p class="text-theme-sm font-medium">@(Model.GradingEdges ?? "—")</p></div>
                            <div><span class="text-theme-xs text-gray-500">Surface</span><p class="text-theme-sm font-medium">@(Model.GradingSurface ?? "—")</p></div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
                {
                    <div class="mt-6 border-t border-gray-100 pt-6 dark:border-gray-800">
                        <p class="mb-2 text-theme-xs font-medium uppercase text-gray-400">Description</p>
                        <div class="prose prose-sm max-w-none text-theme-sm text-gray-700 dark:text-gray-300">@Html.Raw(Model.DescriptionHtml)</div>
                    </div>
                }
            </div>

            @{
                ViewData["EditProductUrl"] = Url.Action("Edit", "Product", new { area = "Admin", id = Model.Id });
                ViewData["SectionTitle"] = "Certificates & Documents";
            }
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_ProductDocumentsSection.cshtml", Model.Documents)

            <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
                    <h4 class="text-lg font-semibold text-gray-800 dark:text-white/90">Linked Auctions</h4>
                </div>

                <div class="max-w-full overflow-x-auto">
                    <table class="w-full min-w-[800px]">
                        <thead>
                        <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">ID</th>
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Status</th>
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Starting</th>
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Current</th>
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Dates</th>
                            <th class="px-5 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">Links</th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                        @if (Model.LinkedAuctions.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="px-5 py-8 text-center text-theme-sm text-gray-500">No auctions linked to this product.</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var auction in Model.LinkedAuctions)
                            {
                                <tr>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">#@auction.Id</td>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@auction.Status.Replace('_', ' ')</td>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@auction.StartingPrice.ToString("N2")</td>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@auction.CurrentPrice.ToString("N2")</td>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                        @auction.StartDate.ToString("dd/MM/yyyy") – @auction.EndDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="px-5 py-4">
                                        <div class="flex justify-end gap-3">
                                            <a asp-area="Admin"
                                               asp-controller="Auction"
                                               asp-action="Details"
                                               asp-route-id="@auction.Id"
                                               class="text-theme-sm font-medium text-brand-500 hover:underline">
                                                Admin
                                            </a>
                                            @if (!string.IsNullOrWhiteSpace(auction.PublicDetailUrl))
                                            {
                                                <a href="@auction.PublicDetailUrl"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="text-theme-sm font-medium text-success-600 hover:underline">
                                                    Public
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
