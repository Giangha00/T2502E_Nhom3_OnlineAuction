@model OnlineAuction.Areas.Admin.ViewModels.Products.ProductDetailViewModel
@using OnlineAuction.Entities
@using System.Net
@using System.Text.RegularExpressions

@{
    ViewData["Title"] = Localizer["AdminProduct.ProductDetails"];
    ViewData["AdminPage"] = "products";

    var shortDescription = NormalizeText(Model.ShortDescription);
    var descriptionHtml = SanitizeDescriptionHtml(Model.DescriptionHtml, Model);

    string NormalizeText(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return string.Empty;
        }

        var normalized = value.Trim();
        return normalized.Equals("N/A", StringComparison.OrdinalIgnoreCase)
               || normalized.Equals("NA", StringComparison.OrdinalIgnoreCase)
            ? string.Empty
            : normalized;
    }

    string? SanitizeDescriptionHtml(string? html, OnlineAuction.Areas.Admin.ViewModels.Products.ProductDetailViewModel model)
    {
        if (string.IsNullOrWhiteSpace(html))
        {
            return null;
        }

        var plain = WebUtility.HtmlDecode(Regex.Replace(html, "<[^>]+>", " "));
        plain = Regex.Replace(plain, @"\s+", " ").Trim();

        if (string.IsNullOrWhiteSpace(plain)
            || plain.Equals("—", StringComparison.Ordinal)
            || plain.StartsWith("Item specifics", StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        var structuredValues = new[]
        {
            model.Name,
            model.Condition,
            model.GradeLabel,
            model.CardNumber,
            model.CertNumber,
            model.SetName,
            model.Language,
            model.Year?.ToString()
        }
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Select(value => value!.Trim())
        .ToList();

        if (structuredValues.Count > 0
            && structuredValues.Count(value => plain.Contains(value, StringComparison.OrdinalIgnoreCase))
                >= Math.Min(3, structuredValues.Count))
        {
            return null;
        }

        if (!string.IsNullOrWhiteSpace(shortDescription)
            && plain.Equals(shortDescription, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        return html;
    }

    string DisplayValue(string? value) =>
        string.IsNullOrWhiteSpace(NormalizeText(value)) ? "—" : NormalizeText(value)!;
}

<link rel="stylesheet" href="~/admin/css/admin-product-detail.css" asp-append-version="true" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-4 flex flex-wrap items-center gap-3">
        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="admin-icon-action admin-icon-action--neutral admin-icon-action--sm"
           title="@Localizer["AdminProduct.BackToTemplates"]"
           aria-label="@Localizer["AdminProduct.BackToTemplates"]">
            <partial name="_AdminIcon" model='"arrow-left"' />
        </a>

        @if (Model.ProductTemplateId.HasValue)
        {
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Template"
               asp-route-id="@Model.ProductTemplateId"
               class="admin-icon-action admin-icon-action--view admin-icon-action--sm"
               title="@Localizer["AdminProduct.OpenTemplateProducts", Model.ProductTemplateName ?? string.Empty]"
               aria-label="@Localizer["AdminProduct.OpenTemplateProducts", Model.ProductTemplateName ?? string.Empty]">
                <partial name="_AdminIcon" model='"layers"' />
            </a>
        }
    </div>

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Localizer["AdminProduct.ProductDetails"]</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                @Localizer["AdminProduct.ProductCode"]: @Model.ProductCode · ID: @Model.Id
            </p>
        </div>

        <div class="flex gap-3">
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="admin-icon-action admin-icon-action--edit admin-icon-action--lg"
               title="@Localizer["AdminProduct.Edit"]"
               aria-label="@Localizer["AdminProduct.Edit"]">
                <partial name="_AdminIcon" model='"pencil"' />
            </a>

            @if (Model.CanDelete)
            {
                <form asp-area="Admin"
                      asp-controller="Product"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      asp-route-returnTemplateId="@Model.ProductTemplateId"
                      method="post"
                      data-confirm
                      data-confirm-variant="danger"
                      data-confirm-title="@Localizer["AdminProduct.Delete"]"
                      data-confirm-message="@Localizer["AdminProduct.ConfirmDeleteProduct"]"
                      data-confirm-confirm="@Localizer["AdminProduct.Delete"]">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="admin-icon-action admin-icon-action--delete admin-icon-action--lg"
                            title="@Localizer["AdminProduct.Delete"]"
                            aria-label="@Localizer["AdminProduct.Delete"]">
                        <partial name="_AdminIcon" model='"trash"' />
                    </button>
                </form>
            }

            @if (Model.ProductTemplateId.HasValue)
            {
                <a asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Template"
                   asp-route-id="@Model.ProductTemplateId"
                   class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
                   title="@Localizer["AdminProduct.Back"]"
                   aria-label="@Localizer["AdminProduct.Back"]">
                    <partial name="_AdminIcon" model='"arrow-left"' />
                </a>
            }
        </div>
    </div>

    <partial name="_AdminFlashMessages" />

    @if (!Model.CanDelete && !string.IsNullOrWhiteSpace(Model.DeleteBlockReason))
    {
        <div class="mb-4 rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-800">
            @Localizer["Admin_Product_CannotDeleteBecause", Model.DeleteBlockReason]
        </div>
    }

    <div class="admin-product-detail grid grid-cols-1 gap-6 xl:grid-cols-12">
        <div class="space-y-6 xl:col-span-4">
            <section class="admin-product-detail__card">
                <img src="@Model.PrimaryImage" alt="@Model.Name" class="admin-product-detail__hero" />

                @if (Model.GalleryImages.Count > 0)
                {
                    <p class="admin-product-detail__section-label">@Localizer["AdminProduct.Gallery"]</p>
                    <div class="admin-product-detail__gallery">
                        @foreach (var image in Model.GalleryImages)
                        {
                            <img src="@image.ImageUrl" alt="@Localizer["AdminProduct.GalleryImage"]" />
                        }
                    </div>
                }
            </section>

            <section class="admin-product-detail__card">
                <p class="admin-product-detail__section-label">@Localizer["AdminProduct.Price"]</p>
                <div class="admin-product-detail__price-grid">
                    <div>
                        <span>@Localizer["AdminProduct.EstimatedValue"]</span>
                        <strong>@(Model.EstimatedValue?.ToString("N2") ?? "—")</strong>
                    </div>
                    <div>
                        <span>@Localizer["AdminProduct.ImportPrice"]</span>
                        <strong>@(Model.ImportPrice?.ToString("N2") ?? "—")</strong>
                    </div>
                </div>
            </section>
        </div>

        <div class="space-y-6 xl:col-span-8">
            <section class="admin-product-detail__card">
                <div class="admin-product-detail__header">
                    <div>
                        <h3>@Model.Name</h3>
                        @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                        {
                            <p class="admin-product-detail__subtitle">@Model.Subtitle</p>
                        }
                        @if (!string.IsNullOrWhiteSpace(shortDescription))
                        {
                            <p class="admin-product-detail__lead">@shortDescription</p>
                        }
                    </div>
                    <span class="admin-product-detail__badge">@DisplayValue(Model.Condition)</span>
                </div>

                <div class="admin-product-detail__meta-grid">
                    <div>
                        <span>@Localizer["AdminProduct.Category"]</span>
                        <strong>@DisplayValue(Model.CategoryName)</strong>
                    </div>
                    <div>
                        <span>@Localizer["AdminProduct.Seller"]</span>
                        <strong>@DisplayValue(Model.SellerName)</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.SellerEmail))
                        {
                            <em>@Model.SellerEmail</em>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(NormalizeText(Model.ProductTemplateName)))
                    {
                        <div>
                            <span>@Localizer["AdminProduct.Template"]</span>
                            <strong>@DisplayValue(Model.ProductTemplateName)</strong>
                        </div>
                    }
                    <div>
                        <span>@Localizer["AdminProduct.Created"]</span>
                        <strong>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div>
                        <span>@Localizer["AdminProduct.Updated"]</span>
                        <strong>@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? Localizer["AdminProduct.NotUpdated"].Value)</strong>
                    </div>
                </div>
            </section>

            <section class="admin-product-detail__card">
                <p class="admin-product-detail__section-label">@Localizer["AdminProduct.CardCert"]</p>
                <div class="admin-product-detail__meta-grid">
                    <div>
                        <span>@Localizer["AdminProduct.Grade"]</span>
                        <strong>@DisplayValue(Model.GradeLabel)</strong>
                    </div>
                    <div>
                        <span>@Localizer["AdminProduct.CertificateNumber"]</span>
                        <strong>@DisplayValue(Model.CertNumber)</strong>
                    </div>
                    <div>
                        <span>@Localizer["AdminProduct.CardNumber"]</span>
                        <strong>@DisplayValue(Model.CardNumber)</strong>
                    </div>
                    <div>
                        <span>@Localizer["AdminProduct.SetName"]</span>
                        <strong>@DisplayValue(Model.SetName)</strong>
                    </div>
                    <div>
                        <span>@Localizer["AdminProduct.Year"]</span>
                        <strong>@(Model.Year?.ToString() ?? "—")</strong>
                    </div>
                    <div>
                        <span>@Localizer["AdminProduct.Language"]</span>
                        <strong>@DisplayValue(Model.Language)</strong>
                    </div>
                </div>

            </section>

            @if (!string.IsNullOrWhiteSpace(descriptionHtml))
            {
                <section class="admin-product-detail__card">
                    <p class="admin-product-detail__section-label">@Localizer["AdminProduct.Description"]</p>
                    <div class="admin-product-detail__description">@Html.Raw(descriptionHtml)</div>
                </section>
            }

            @{
                ViewData["EditProductUrl"] = Url.Action("Edit", "Product", new { area = "Admin", id = Model.Id });
                ViewData["SectionTitle"] = Localizer["AdminProduct.CertificatesAndDocuments"];
            }
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_ProductDocumentsSection.cshtml", Model.Documents)

            <section class="admin-product-detail__card admin-product-detail__card--flush">
                <div class="admin-product-detail__table-head">
                    <h4>@Localizer["AdminProduct.LinkedAuctions"]</h4>
                </div>

                <div class="max-w-full overflow-x-auto">
                    <table class="admin-product-detail__table w-full min-w-[760px]">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>@Localizer["AdminProduct.Status"]</th>
                            <th>@Localizer["AdminProduct.StartingPrice"]</th>
                            <th>@Localizer["AdminProduct.CurrentPrice"]</th>
                            <th>@Localizer["AdminProduct.Dates"]</th>
                            <th class="text-right">@Localizer["AdminProduct.Links"]</th>
                        </tr>
                        </thead>
                        <tbody>
                        @if (Model.LinkedAuctions.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="admin-product-detail__empty">@Localizer["AdminProduct.EmptyLinkedAuctions"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var auction in Model.LinkedAuctions)
                            {
                                <tr>
                                    <td>#@auction.Id</td>
                                    <td>@auction.Status.Replace('_', ' ')</td>
                                    <td>@auction.StartingPrice.ToString("N2")</td>
                                    <td>@auction.CurrentPrice.ToString("N2")</td>
                                    <td>@auction.StartDate.ToString("dd/MM/yyyy") – @auction.EndDate.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <div class="admin-icon-action-group">
                                            <a asp-area="Admin"
                                               asp-controller="Auction"
                                               asp-action="Details"
                                               asp-route-id="@auction.Id"
                                               class="admin-icon-action admin-icon-action--view"
                                               title="@Localizer["AdminProduct.Admin"]"
                                               aria-label="@Localizer["AdminProduct.Admin"]">
                                                <partial name="_AdminIcon" model='"eye"' />
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="@(auction.ListingType == ListingTypes.BuyNow ? "BuyNow" : "Auction")"
                                               asp-action="Edit"
                                               asp-route-id="@auction.Id"
                                               class="admin-icon-action admin-icon-action--edit"
                                               title="@Localizer["AdminProduct.Edit"]"
                                               aria-label="@Localizer["AdminProduct.Edit"]">
                                                <partial name="_AdminIcon" model='"pencil"' />
                                            </a>

                                            @if (!string.IsNullOrWhiteSpace(auction.PublicDetailUrl))
                                            {
                                                <a href="@auction.PublicDetailUrl"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="admin-icon-action admin-icon-action--create"
                                                   title="@Localizer["AdminProduct.Public"]"
                                                   aria-label="@Localizer["AdminProduct.Public"]">
                                                    <partial name="_AdminIcon" model='"external"' />
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>
    </div>
</div>
