@model OnlineAuction.Areas.Admin.ViewModels.Products.ProductDetailViewModel
@using OnlineAuction.Entities

@{
    ViewData["Title"] = Localizer["AdminProduct.ProductDetails"];
    ViewData["AdminPage"] = "products";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-4 flex flex-wrap items-center gap-3">
        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="admin-icon-action admin-icon-action--neutral admin-icon-action--sm"
           title="@Localizer["AdminProduct.BackToTemplates"]"
           aria-label="@Localizer["AdminProduct.BackToTemplates"]">
            <partial name="_AdminIcon" model='"arrow-left"' />
        </a>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Template"
           asp-route-id="@Model.ProductTemplateId"
           class="admin-icon-action admin-icon-action--view admin-icon-action--sm"
           title="@Localizer["AdminProduct.OpenTemplateProducts", Model.ProductTemplateName ?? string.Empty]"
           aria-label="@Localizer["AdminProduct.OpenTemplateProducts", Model.ProductTemplateName ?? string.Empty]">
            <partial name="_AdminIcon" model='"layers"' />
        </a>
    </div>

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Localizer["AdminProduct.ProductDetails"]</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                @Localizer["AdminProduct.ProductCode"]: @Model.ProductCode · ID: @Model.Id
            </p>
        </div>

        <div class="flex gap-3">
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Edit"
               asp-route-id="@Model.Id"
               class="admin-icon-action admin-icon-action--edit admin-icon-action--lg"
               title="@Localizer["AdminProduct.Edit"]"
               aria-label="@Localizer["AdminProduct.Edit"]">
                <partial name="_AdminIcon" model='"pencil"' />
            </a>

            @if (Model.CanDelete)
            {
                <form asp-area="Admin"
                      asp-controller="Product"
                      asp-action="Delete"
                      asp-route-id="@Model.Id"
                      asp-route-returnTemplateId="@Model.ProductTemplateId"
                      method="post"
                      onsubmit="return confirm('@Localizer["AdminProduct.ConfirmDeleteProduct"]');">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="admin-icon-action admin-icon-action--delete admin-icon-action--lg"
                            title="@Localizer["AdminProduct.Delete"]"
                            aria-label="@Localizer["AdminProduct.Delete"]">
                        <partial name="_AdminIcon" model='"trash"' />
                    </button>
                </form>
            }

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Template"
               asp-route-id="@Model.ProductTemplateId"
               class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
               title="@Localizer["AdminProduct.Back"]"
               aria-label="@Localizer["AdminProduct.Back"]">
                <partial name="_AdminIcon" model='"arrow-left"' />
            </a>
        </div>
    </div>

    <partial name="_AdminFlashMessages" />

    @if (!Model.CanDelete && !string.IsNullOrWhiteSpace(Model.DeleteBlockReason))
    {
        <div class="mb-4 rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-800">
            Không thể xóa sản phẩm này vì @Model.DeleteBlockReason
        </div>
    }

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        <div class="lg:col-span-1">
            <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <img src="@Model.PrimaryImage" alt="@Model.Name" class="mb-4 w-full rounded-xl border border-gray-200 object-cover dark:border-gray-700" />

                @if (Model.GalleryImages.Count > 0)
                {
                    <p class="mb-2 text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Gallery"]</p>
                    <div class="grid grid-cols-2 gap-2">
                        @foreach (var image in Model.GalleryImages)
                        {
                            <img src="@image.ImageUrl" alt="@Localizer["AdminProduct.GalleryImage"]" class="h-20 w-full rounded-lg border border-gray-200 object-cover dark:border-gray-700" />
                        }
                    </div>
                }
            </div>
        </div>

        <div class="lg:col-span-2 space-y-6">
            <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <h3 class="text-xl font-semibold text-gray-800 dark:text-white/90">@Model.Name</h3>
                @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                {
                    <p class="mt-1 text-theme-sm text-gray-500">@Model.Subtitle</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="mt-3 text-theme-sm text-gray-700 dark:text-gray-300">@Model.ShortDescription</p>
                }

                <dl class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Category"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.CategoryName</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Seller"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.SellerName (@Model.SellerEmail)</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Condition"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.Condition</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Grade"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.GradeLabel ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.CertificateNumber"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.CertNumber ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.CardNumber"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.CardNumber ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Year"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.Year?.ToString() ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.SetName"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.SetName ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Language"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.Language ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.ProductOrigin"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.ProductOrigin ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.EstimatedValue"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.EstimatedValue?.ToString("N2") ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.ImportPrice"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.ImportPrice?.ToString("N2") ?? "—")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Created"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Updated"]</dt>
                        <dd class="mt-1 text-theme-sm text-gray-800 dark:text-white/90">@(Model.UpdatedAt?.ToString("dd/MM/yyyy HH:mm") ?? Localizer["AdminProduct.NotUpdated"])</dd>
                    </div>
                </dl>

                @if (!string.IsNullOrWhiteSpace(Model.GradingCentering) || !string.IsNullOrWhiteSpace(Model.GradingCorners) || !string.IsNullOrWhiteSpace(Model.GradingEdges) || !string.IsNullOrWhiteSpace(Model.GradingSurface))
                {
                    <div class="mt-6 border-t border-gray-100 pt-6 dark:border-gray-800">
                        <p class="mb-3 text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.GradingSubScores"]</p>
                        <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
                            <div><span class="text-theme-xs text-gray-500">@Localizer["AdminProduct.Centering"]</span><p class="text-theme-sm font-medium">@(Model.GradingCentering ?? "—")</p></div>
                            <div><span class="text-theme-xs text-gray-500">@Localizer["AdminProduct.Corners"]</span><p class="text-theme-sm font-medium">@(Model.GradingCorners ?? "—")</p></div>
                            <div><span class="text-theme-xs text-gray-500">@Localizer["AdminProduct.Edges"]</span><p class="text-theme-sm font-medium">@(Model.GradingEdges ?? "—")</p></div>
                            <div><span class="text-theme-xs text-gray-500">@Localizer["AdminProduct.Surface"]</span><p class="text-theme-sm font-medium">@(Model.GradingSurface ?? "—")</p></div>
                        </div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
                {
                    <div class="mt-6 border-t border-gray-100 pt-6 dark:border-gray-800">
                        <p class="mb-2 text-theme-xs font-medium uppercase text-gray-400">@Localizer["AdminProduct.Description"]</p>
                        <div class="prose prose-sm max-w-none text-theme-sm text-gray-700 dark:text-gray-300">@Html.Raw(Model.DescriptionHtml)</div>
                    </div>
                }
            </div>

            @{
                ViewData["EditProductUrl"] = Url.Action("Edit", "Product", new { area = "Admin", id = Model.Id });
                ViewData["SectionTitle"] = Localizer["AdminProduct.CertificatesAndDocuments"];
            }
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_ProductDocumentsSection.cshtml", Model.Documents)

            <div class="rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="border-b border-gray-100 px-6 py-4 dark:border-gray-800">
                    <h4 class="text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["AdminProduct.LinkedAuctions"]</h4>
                </div>

                <div class="max-w-full overflow-x-auto">
                    <table class="w-full min-w-[800px]">
                        <thead>
                        <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">ID</th>
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Status"]</th>
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.StartingPrice"]</th>
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.CurrentPrice"]</th>
                            <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Dates"]</th>
                            <th class="px-5 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Links"]</th>
                        </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                        @if (Model.LinkedAuctions.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="px-5 py-8 text-center text-theme-sm text-gray-500">@Localizer["AdminProduct.EmptyLinkedAuctions"]</td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var auction in Model.LinkedAuctions)
                            {
                                <tr>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">#@auction.Id</td>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@auction.Status.Replace('_', ' ')</td>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@auction.StartingPrice.ToString("N2")</td>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@auction.CurrentPrice.ToString("N2")</td>
                                    <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                        @auction.StartDate.ToString("dd/MM/yyyy") – @auction.EndDate.ToString("dd/MM/yyyy")
                                    </td>
                                    <td class="px-5 py-4">
                                        <div class="admin-icon-action-group">
                                            <a asp-area="Admin"
                                               asp-controller="Auction"
                                               asp-action="Details"
                                               asp-route-id="@auction.Id"
                                               class="admin-icon-action admin-icon-action--view"
                                               title="@Localizer["AdminProduct.Admin"]"
                                               aria-label="@Localizer["AdminProduct.Admin"]">
                                                <partial name="_AdminIcon" model='"eye"' />
                                            </a>

                                            <a asp-area="Admin"
                                               asp-controller="@(auction.ListingType == ListingTypes.BuyNow ? "BuyNow" : "Auction")"
                                               asp-action="Edit"
                                               asp-route-id="@auction.Id"
                                               class="admin-icon-action admin-icon-action--edit"
                                               title="@Localizer["AdminProduct.Edit"]"
                                               aria-label="@Localizer["AdminProduct.Edit"]">
                                                <partial name="_AdminIcon" model='"pencil"' />
                                            </a>

                                            @if (!string.IsNullOrWhiteSpace(auction.PublicDetailUrl))
                                            {
                                                <a href="@auction.PublicDetailUrl"
                                                   target="_blank"
                                                   rel="noopener"
                                                   class="admin-icon-action admin-icon-action--create"
                                                   title="@Localizer["AdminProduct.Public"]"
                                                   aria-label="@Localizer["AdminProduct.Public"]">
                                                    <partial name="_AdminIcon" model='"external"' />
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
