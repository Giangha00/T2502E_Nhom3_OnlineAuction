<div data-admin-image-lightbox
     class="fixed inset-0 z-99999 hidden items-center justify-center bg-gray-900/80 p-4"
     role="dialog"
     aria-modal="true"
     aria-hidden="true">
    <div data-lightbox-backdrop class="absolute inset-0"></div>
    <div class="relative z-10 max-h-[90vh] max-w-5xl">
        <button type="button"
                data-lightbox-close
                aria-label="@Localizer["AdminProduct.ImageUploader.CloseLightbox"]"
                class="absolute -right-2 -top-2 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white text-gray-700 shadow-theme-md hover:bg-gray-100 dark:bg-gray-800 dark:text-gray-200">
            <span aria-hidden="true">&times;</span>
        </button>
        <img data-lightbox-image
             alt=""
             class="max-h-[85vh] max-w-full rounded-xl border border-white/10 object-contain shadow-theme-xl" />
    </div>
</div>
