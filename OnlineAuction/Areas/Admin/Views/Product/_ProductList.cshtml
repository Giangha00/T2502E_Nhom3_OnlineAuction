@model ProductListViewModel

@{
    var currentPage = Model.Filter.Page <= 0 ? 1 : Model.Filter.Page;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
    var templateId = Model.ContextTemplateId ?? 0;

    string DisplayOrDash(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "—";
        }

        var normalized = value.Trim();
        return normalized.Equals("N/A", StringComparison.OrdinalIgnoreCase)
               || normalized.Equals("NA", StringComparison.OrdinalIgnoreCase)
               || normalized.Equals("N a", StringComparison.OrdinalIgnoreCase)
            ? "—"
            : normalized;
    }
}

<form id="productBulkDeleteForm"
      asp-area="Admin"
      asp-controller="Product"
      asp-action="BulkDelete"
      method="post">
    @Html.AntiForgeryToken()
    <input type="hidden" name="ReturnTemplateId" value="@templateId" />

    <div class="mb-4 flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03] sm:flex-row sm:items-center sm:justify-between">
        <button type="submit"
                data-bulk-delete="true"
                class="admin-icon-action admin-icon-action--delete admin-icon-action--lg"
                title="@Localizer["AdminProduct.DeleteSelected"]"
                aria-label="@Localizer["AdminProduct.DeleteSelected"]">
            <partial name="_AdminIcon" model='"trash"' />
        </button>

        <div class="text-theme-sm text-gray-500">
            @Localizer["AdminProduct.Total"]: <span class="font-medium text-gray-800 dark:text-white/90">@Model.TotalItems</span>
        </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="max-w-full overflow-x-auto">
            <table class="admin-product-template-table w-full min-w-[1280px]">
                <thead>
                <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                    <th class="w-12 px-5 py-3 text-left">
                        <input id="selectAllProducts" type="checkbox" aria-label="@Localizer["AdminProduct.SelectAllProducts"]" />
                    </th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Product"]</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Seller"]</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Condition"]</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Price"]</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Quantity"]</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.CardCert"]</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Auctions"]</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Created"]</th>
                    <th class="px-5 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">@Localizer["AdminProduct.Actions"]</th>
                </tr>
                </thead>

                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @if (Model.Products.Count == 0)
                {
                    <tr>
                        <td colspan="10" class="px-5 py-10 text-center text-theme-sm text-gray-500">
                            @Localizer["AdminProduct.EmptyProducts"]
                            @if (templateId > 0)
                            {
                                <a asp-area="Admin" asp-controller="Product" asp-action="Create" asp-route-templateId="@templateId" class="admin-icon-action admin-icon-action--create admin-icon-action--sm ml-2" title="@Localizer["AdminProduct.CreateProduct"]" aria-label="@Localizer["AdminProduct.CreateProduct"]"><partial name="_AdminIcon" model='"plus"' /></a>
                            }
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model.Products)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                            <td class="px-5 py-4">
                                <input class="product-checkbox" type="checkbox" name="SelectedProductIds" value="@product.Id" />
                            </td>
                            <td class="px-5 py-4 product-template-col-product">
                                <div class="flex items-center gap-3">
                                    <img src="@product.ThumbnailUrl"
                                         alt="@product.Name"
                                         class="h-12 w-12 rounded-lg border border-gray-200 object-cover dark:border-gray-700" />
                                    <div class="min-w-0">
                                        <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90 product-template-line-clamp-2" title="@product.Name">@product.Name</p>
                                        @if (!string.IsNullOrWhiteSpace(product.Subtitle))
                                        {
                                            <p class="text-theme-xs text-gray-500 product-template-line-clamp-1" title="@product.Subtitle">@product.Subtitle</p>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(product.ShortDescription))
                                        {
                                            <p class="text-theme-xs text-gray-500 product-template-line-clamp-2" title="@product.ShortDescription">@product.ShortDescription</p>
                                        }
                                        <p class="text-theme-xs text-gray-500">@Localizer["AdminProduct.ProductCode"]: @product.ProductCode · ID: @product.Id</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4 product-template-col-seller">
                                <p class="text-theme-sm text-gray-800 dark:text-white/90 product-template-line-clamp-1" title="@product.SellerName">@product.SellerName</p>
                                <p class="text-theme-xs text-gray-500 product-template-line-clamp-1" title="@product.SellerEmail">@product.SellerEmail</p>
                            </td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                <p>@product.Condition</p>
                                @if (!string.IsNullOrWhiteSpace(product.GradeLabel))
                                {
                                    <p class="text-theme-xs text-gray-500">@product.GradeLabel</p>
                                }
                                <p class="text-theme-xs text-gray-500">
                                    @DisplayOrDash(product.SetName)
                                    · @DisplayOrDash(product.Language)
                                    · @(product.Year?.ToString() ?? "—")
                                </p>
                            </td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                <p>@Localizer["AdminProduct.EstimatedShort"]: @(product.EstimatedValue?.ToString("N2") ?? "—")</p>
                                <p class="text-theme-xs text-gray-500">@Localizer["AdminProduct.ImportShort"]: @(product.ImportPrice?.ToString("N2") ?? "—")</p>
                            </td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">1</td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                <p>@DisplayOrDash(product.CardNumber)</p>
                                @if (!string.IsNullOrWhiteSpace(product.CertNumber))
                                {
                                    <p class="text-theme-xs text-gray-500">@DisplayOrDash(product.CertNumber)</p>
                                }
                            </td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@product.AuctionCount</td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@product.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="px-5 py-4">
                                <div class="admin-icon-action-group">
                                    <a asp-area="Admin"
                                       asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="admin-icon-action admin-icon-action--view"
                                       title="@Localizer["AdminProduct.Details"]"
                                       aria-label="@Localizer["AdminProduct.Details"]">
                                        <partial name="_AdminIcon" model='"eye"' />
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="Product"
                                       asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="admin-icon-action admin-icon-action--edit"
                                       title="@Localizer["AdminProduct.Edit"]"
                                       aria-label="@Localizer["AdminProduct.Edit"]">
                                        <partial name="_AdminIcon" model='"pencil"' />
                                    </a>

                                    @if (product.CanDelete)
                                    {
                                        <button type="submit"
                                                formaction="@Url.Action("Delete", "Product", new { area = "Admin", id = product.Id, returnTemplateId = templateId })"
                                                class="admin-icon-action admin-icon-action--delete"
                                                title="@Localizer["AdminProduct.Delete"]"
                                                aria-label="@Localizer["AdminProduct.Delete"]"
                                                data-confirm
                                                data-confirm-variant="danger"
                                                data-confirm-title="@Localizer["AdminProduct.Delete"]"
                                                data-confirm-message="@Localizer["AdminProduct.ConfirmDeleteProduct"]"
                                                data-confirm-confirm="@Localizer["AdminProduct.Delete"]">
                                            <partial name="_AdminIcon" model='"trash"' />
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</form>

<div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-theme-sm text-gray-500">
        @Localizer["AdminProduct.Page"] <span class="font-medium text-gray-800 dark:text-white/90">@currentPage</span>
        @Localizer["AdminProduct.Of"] <span class="font-medium text-gray-800 dark:text-white/90">@totalPages</span>
    </p>

    <nav class="flex flex-wrap items-center gap-2">
        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Template"
           asp-route-id="@templateId"
           asp-route-Search="@Model.Filter.Search"
           asp-route-SellerId="@Model.Filter.SellerId"
           asp-route-Condition="@Model.Filter.Condition"
           asp-route-DateRange="@Model.Filter.DateRange"
           asp-route-MinEstimatedValue="@Model.Filter.MinEstimatedValue"
           asp-route-MaxEstimatedValue="@Model.Filter.MaxEstimatedValue"
           asp-route-SortOrder="@Model.Filter.SortOrder"
           asp-route-Page="@(currentPage - 1)"
           class="admin-icon-action admin-icon-action--pagination @(currentPage <= 1 ? "is-disabled" : "js-admin-page")"
           title="@Localizer["AdminProduct.Previous"]"
           aria-label="@Localizer["AdminProduct.Previous"]">
            <partial name="_AdminIcon" model='"chevron-left"' />
        </a>

        @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
        {
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Template"
               asp-route-id="@templateId"
               asp-route-Search="@Model.Filter.Search"
               asp-route-SellerId="@Model.Filter.SellerId"
               asp-route-Condition="@Model.Filter.Condition"
               asp-route-DateRange="@Model.Filter.DateRange"
               asp-route-MinEstimatedValue="@Model.Filter.MinEstimatedValue"
               asp-route-MaxEstimatedValue="@Model.Filter.MaxEstimatedValue"
               asp-route-SortOrder="@Model.Filter.SortOrder"
               asp-route-Page="@pageNumber"
               class="js-admin-page rounded-lg border px-3 py-2 text-theme-sm font-medium @(pageNumber == currentPage ? "border-brand-500 bg-brand-500 text-white" : "border-gray-300 text-gray-700 hover:bg-gray-50")">
                @pageNumber
            </a>
        }

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Template"
           asp-route-id="@templateId"
           asp-route-Search="@Model.Filter.Search"
           asp-route-SellerId="@Model.Filter.SellerId"
           asp-route-Condition="@Model.Filter.Condition"
           asp-route-DateRange="@Model.Filter.DateRange"
           asp-route-MinEstimatedValue="@Model.Filter.MinEstimatedValue"
           asp-route-MaxEstimatedValue="@Model.Filter.MaxEstimatedValue"
           asp-route-SortOrder="@Model.Filter.SortOrder"
           asp-route-Page="@(currentPage + 1)"
           class="admin-icon-action admin-icon-action--pagination @(currentPage >= totalPages ? "is-disabled" : "js-admin-page")"
           title="@Localizer["AdminProduct.Next"]"
           aria-label="@Localizer["AdminProduct.Next"]">
            <partial name="_AdminIcon" model='"chevron-right"' />
        </a>
    </nav>
</div>
