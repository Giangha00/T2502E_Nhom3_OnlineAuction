@model ProductListViewModel

@{
    ViewData["Title"] = Model.ContextTemplateName ?? Localizer["AdminProduct.ProductsByTemplate"];
    ViewData["AdminPage"] = "products";
    var templateId = Model.ContextTemplateId ?? 0;
    var template = Model.ContextTemplate;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<link rel="stylesheet" href="~/admin/css/daterangepicker-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/admin/css/admin-product-template.css" asp-append-version="true" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-4">
        <a asp-area="Admin" asp-controller="Product" asp-action="Index" class="admin-icon-action admin-icon-action--neutral admin-icon-action--sm" title="@Localizer["AdminProduct.BackToTemplates"]" aria-label="@Localizer["AdminProduct.BackToTemplates"]">
            <partial name="_AdminIcon" model='"arrow-left"' />
        </a>
    </div>

    <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div class="flex items-center gap-4">
            @if (template is not null)
            {
                <img src="@template.PrimaryImage" alt="@template.Name" class="h-20 w-20 rounded-lg border border-gray-200 object-cover dark:border-gray-700" />
            }
            <div>
                <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Model.ContextTemplateName</h2>
                <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                    @template?.CategoryName
                    @if (!string.IsNullOrWhiteSpace(template?.SetName) || !string.IsNullOrWhiteSpace(template?.CardNumber))
                    {
                        <span> · @template?.SetName · @template?.CardNumber</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(template?.GradeLabel))
                    {
                        <span> · @template?.GradeLabel</span>
                    }
                </p>
                <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                    @Localizer["AdminProduct.TemplateSummary", template?.InstanceCount ?? Model.TotalItems, template?.SellerCount ?? 0]
                </p>
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Product" asp-action="Create" asp-route-templateId="@templateId" class="admin-icon-action admin-icon-action--primary admin-icon-action--lg" title="@Localizer["AdminProduct.CreateProduct"]" aria-label="@Localizer["AdminProduct.CreateProduct"]">
            <partial name="_AdminIcon" model='"plus"' />
        </a>
    </div>



    @if (template is not null)
    {
        <div class="mb-6 grid gap-4 lg:grid-cols-3">
            <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
                <p class="text-theme-xs uppercase text-gray-500">Language / Year</p>
                <p class="mt-1 text-theme-sm font-medium text-gray-800 dark:text-white/90">@(!string.IsNullOrWhiteSpace(template.Language) ? template.Language : "—") · @(template.Year?.ToString() ?? "—")</p>
            </div>
            <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
                <p class="text-theme-xs uppercase text-gray-500">Set / Card Number</p>
                <p class="mt-1 text-theme-sm font-medium text-gray-800 dark:text-white/90">@(!string.IsNullOrWhiteSpace(template.SetName) ? template.SetName : "—") · @(!string.IsNullOrWhiteSpace(template.CardNumber) ? template.CardNumber : "—")</p>
            </div>
            <div class="rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
                <p class="text-theme-xs uppercase text-gray-500">Grade</p>
                <p class="mt-1 text-theme-sm font-medium text-gray-800 dark:text-white/90">@(!string.IsNullOrWhiteSpace(template.GradeLabel) ? template.GradeLabel : "—")</p>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(template.ShortDescription) || !string.IsNullOrWhiteSpace(template.DescriptionHtml))
        {
            <div class="mb-6 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
                @if (!string.IsNullOrWhiteSpace(template.ShortDescription))
                {
                    <p class="mb-3 text-theme-sm text-gray-700 dark:text-gray-300">@template.ShortDescription</p>
                }
                @if (!string.IsNullOrWhiteSpace(template.DescriptionHtml))
                {
                    <div class="prose prose-sm max-w-none text-gray-700 dark:text-gray-300">@Html.Raw(template.DescriptionHtml)</div>
                }
            </div>
        }
    }

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <form id="productFilterForm" method="get" class="flex flex-wrap items-end gap-3 2xl:flex-nowrap">
            <input type="hidden" name="Page" value="@(Model.Filter.Page <= 0 ? 1 : Model.Filter.Page)" />

            <div class="min-w-[220px] flex-1">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">@Localizer["AdminProduct.Search"]</label>
                <input id="productSearchInput" name="Search" value="@Model.Filter.Search" placeholder="@Localizer["AdminProduct.ProductSearchPlaceholder"]" autocomplete="off" class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[180px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">@Localizer["AdminProduct.Seller"]</label>
                <select name="SellerId" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">@Localizer["AdminProduct.All"]</option>
                    @foreach (var option in Model.SellerOptions)
                    {
                        <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                    }
                </select>
            </div>

            <div class="w-[140px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">@Localizer["AdminProduct.Condition"]</label>
                <select name="Condition" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">@Localizer["AdminProduct.All"]</option>
                    @foreach (var option in Model.ConditionOptions)
                    {
                        <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                    }
                </select>
            </div>

            <div class="w-[130px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">@Localizer["AdminProduct.MinPrice"]</label>
                <input name="MinEstimatedValue" value="@Model.Filter.MinEstimatedValue" type="number" step="0.01" min="0" class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[130px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">@Localizer["AdminProduct.MaxPrice"]</label>
                <input name="MaxEstimatedValue" value="@Model.Filter.MaxEstimatedValue" type="number" step="0.01" min="0" class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[300px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Date range</label>
                @{
                    ViewData["DateRangeId"] = "productDateRangePicker";
                    ViewData["DateRangeHiddenId"] = "productDateRangeValue";
                    ViewData["DateRangeName"] = "DateRange";
                    ViewData["DateRangeValue"] = Model.Filter.DateRange;
                    ViewData["DateRangePlaceholder"] = "Select date range";
                }
                @await Html.PartialAsync("_DateRangeTrigger")
            </div>

            <div class="w-[150px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">@Localizer["AdminProduct.Sort"]</label>
                <select name="SortOrder" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="price_asc" selected="@(string.IsNullOrWhiteSpace(Model.Filter.SortOrder) || Model.Filter.SortOrder == "price_asc")">@Localizer["AdminProduct.SortPriceAsc"]</option>
                    <option value="price_desc" selected="@(Model.Filter.SortOrder == "price_desc")">@Localizer["AdminProduct.SortPriceDesc"]</option>
                    <option value="date_desc" selected="@(Model.Filter.SortOrder == "date_desc")">@Localizer["AdminProduct.SortNewest"]</option>
                    <option value="seller_asc" selected="@(Model.Filter.SortOrder == "seller_asc")">@Localizer["AdminProduct.SortSellerAsc"]</option>
                </select>
            </div>
        </form>
    </div>

    <div id="productListResults" class="transition-opacity duration-200">
        <partial name="_ProductList" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/admin/js/admin-list-filter.js" asp-append-version="true"></script>
    <script>
        function bindProductBulkActions(container) {
            const selectAllProducts = container.querySelector('#selectAllProducts');
            const bulkDeleteForm = container.querySelector('#productBulkDeleteForm');
            const productCheckboxes = container.querySelectorAll('.product-checkbox');

            if (selectAllProducts) {
                selectAllProducts.onchange = function () {
                    productCheckboxes.forEach(function (checkbox) {
                        checkbox.checked = selectAllProducts.checked;
                    });
                };
            }

            if (bulkDeleteForm) {
                bulkDeleteForm.onsubmit = function (event) {
                    if (bulkDeleteForm.dataset.confirmAccepted === '1') {
                        delete bulkDeleteForm.dataset.confirmAccepted;
                        return;
                    }

                    if (event.submitter?.dataset.bulkDelete !== 'true') {
                        return;
                    }

                    const selectedCount = bulkDeleteForm.querySelectorAll('.product-checkbox:checked').length;
                    if (selectedCount === 0) {
                        event.preventDefault();
                        alert('@Localizer["AdminProduct.SelectAtLeastOneProduct"]');
                        return;
                    }

                    event.preventDefault();
                    const submitter = event.submitter;
                    const confirmFn = typeof window.showConfirmModal === 'function'
                        ? window.showConfirmModal
                        : function (options) {
                            return Promise.resolve(window.confirm(options.message || ''));
                        };

                    confirmFn({
                        title: '@Localizer["AdminProduct.Delete"]',
                        message: '@Localizer["AdminProduct.ConfirmBulkDeleteProducts"]',
                        confirmText: '@Localizer["AdminProduct.Delete"]',
                        variant: 'danger'
                    }).then(function (confirmed) {
                        if (!confirmed) {
                            return;
                        }

                        bulkDeleteForm.dataset.confirmAccepted = '1';
                        if (typeof bulkDeleteForm.requestSubmit === 'function') {
                            bulkDeleteForm.requestSubmit(submitter || undefined);
                        } else {
                            HTMLFormElement.prototype.submit.call(bulkDeleteForm);
                        }
                    });
                };
            }
        }

        AdminListFilter.init({
            formId: 'productFilterForm',
            resultsId: 'productListResults',
            searchInputId: 'productSearchInput',
            listUrl: '@Url.Action("Template", "Product", new { area = "Admin", id = templateId })',
            setupDateRange: function (submitCallback) {
                AdminListFilter.setupDateRangePicker('#productDateRangePicker', submitCallback);
            },
            onUpdated: bindProductBulkActions
        });
    </script>
}
