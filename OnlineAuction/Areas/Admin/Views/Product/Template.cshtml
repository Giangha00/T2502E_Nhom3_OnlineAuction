@model ProductTemplateInstancesViewModel

@{
    ViewData["Title"] = Model.TemplateName;
    ViewData["AdminPage"] = "products";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-start gap-4">
            @if (!string.IsNullOrWhiteSpace(Model.PrimaryImage))
            {
                <img src="@Model.PrimaryImage"
                     alt="@Model.TemplateName"
                     class="h-16 w-16 rounded-xl object-cover" />
            }
            <div>
                <a asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Index"
                   class="mb-2 inline-flex text-theme-sm text-brand-500 hover:underline">
                    ← Back to card types
                </a>
                <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Model.TemplateName</h2>
                <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                    @Model.CategoryName · @Model.InstanceCount instance@(Model.InstanceCount == 1 ? "" : "s")
                </p>
                @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                {
                    <p class="mt-1 text-theme-sm text-gray-600 dark:text-gray-300">@Model.ShortDescription</p>
                }
            </div>
        </div>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Create"
           class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
            Create Product
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
        <div class="max-w-full overflow-x-auto">
            <table class="w-full min-w-[1100px]">
                <thead>
                <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Product</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Seller</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Condition</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Price</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Qty</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Card / Cert</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Auctions</th>
                    <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Created</th>
                    <th class="px-5 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">Actions</th>
                </tr>
                </thead>

                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                @if (Model.Instances.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="px-5 py-10 text-center text-theme-sm text-gray-500">No product instances found.</td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model.Instances)
                    {
                        <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrWhiteSpace(product.PrimaryImage))
                                    {
                                        <img src="@product.PrimaryImage"
                                             alt="@product.Name"
                                             class="h-10 w-10 rounded-lg object-cover" />
                                    }
                                    <div>
                                        <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">@product.Name</p>
                                        <p class="text-theme-xs text-gray-500">Product #: @product.ProductNumber</p>
                                        <p class="text-theme-xs text-gray-500">ID: @product.Id</p>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                <p>@product.SellerName</p>
                                <p class="text-theme-xs text-gray-500">Seller ID: @product.SellerId</p>
                            </td>
                            <td class="px-5 py-4 text-theme-sm capitalize text-gray-700 dark:text-gray-300">@product.Condition</td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                @(product.Price.HasValue ? product.Price.Value.ToString("C") : "—")
                            </td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@product.Quantity</td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                <p>@(product.CardNumber ?? "—")</p>
                                <p class="text-theme-xs text-gray-500">@(product.CertNumber ?? "—")</p>
                            </td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@product.AuctionCount</td>
                            <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@product.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td class="px-5 py-4">
                                <div class="flex items-center justify-end gap-3">
                                    <a asp-area="Admin"
                                       asp-controller="Product"
                                       asp-action="Details"
                                       asp-route-id="@product.Id"
                                       class="text-theme-sm font-medium text-brand-500 hover:underline">
                                        Details
                                    </a>

                                    <a asp-area="Admin"
                                       asp-controller="Product"
                                       asp-action="Edit"
                                       asp-route-id="@product.Id"
                                       class="text-theme-sm font-medium text-warning-600 hover:underline">
                                        Edit
                                    </a>

                                    <form asp-area="Admin"
                                          asp-controller="Product"
                                          asp-action="Delete"
                                          asp-route-id="@product.Id"
                                          method="post"
                                          class="inline-flex items-center"
                                          onsubmit="return confirm('Are you sure you want to delete this product?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit"
                                                class="text-theme-sm font-medium text-error-600 hover:underline leading-none bg-transparent p-0">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
