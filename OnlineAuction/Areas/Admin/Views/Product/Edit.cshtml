@model ProductFormViewModel

@{
    ViewData["Title"] = Localizer["AdminProduct.EditProduct"];
    ViewData["AdminPage"] = "products";
}

<link rel="stylesheet" href="~/admin/css/admin-product-form.css" asp-append-version="true" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6">
        <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Localizer["AdminProduct.EditProduct"]</h2>
        <p class="text-theme-sm text-gray-500 dark:text-gray-400">@Localizer["AdminProduct.EditProductSubtitle"]</p>
    </div>

    <form asp-area="Admin"
          asp-controller="Product"
          asp-action="Edit"
          method="post"
          enctype="multipart/form-data"
          class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
        @Html.AntiForgeryToken()

        <partial name="_Form" model="Model" />

        <div class="mt-6 flex justify-end gap-3 border-t border-gray-100 pt-6 dark:border-gray-800">
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Index"
               class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
               title="@Localizer["AdminProduct.Cancel"]"
               aria-label="@Localizer["AdminProduct.Cancel"]">
                <partial name="_AdminIcon" model='"x-mark"' />
            </a>

            <button type="submit"
                    class="admin-icon-action admin-icon-action--primary admin-icon-action--lg"
                    title="@Localizer["AdminProduct.SaveChanges"]"
                    aria-label="@Localizer["AdminProduct.SaveChanges"]">
                <partial name="_AdminIcon" model='"save"' />
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_ProductImageLightbox" />
    <script src="~/admin/js/product-image-uploader.js" asp-append-version="true"></script>
}
