@model ProductListViewModel

@{
    ViewData["Title"] = Model.ContextCategoryName ?? "Category Products";
    ViewData["AdminPage"] = "products";

    var currentPage = Model.Filter.Page <= 0 ? 1 : Model.Filter.Page;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
    var categoryId = Model.ContextCategoryId ?? 0;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-4">
        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="inline-flex items-center text-theme-sm font-medium text-brand-500 hover:underline">
            ← Back to card types
        </a>
    </div>

    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Model.ContextCategoryName</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                @Model.ContextCategoryName · @Model.TotalItems instance@(Model.TotalItems == 1 ? "" : "s")
            </p>
        </div>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Create"
           asp-route-categoryId="@categoryId"
           class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
            Create Product
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <form id="productFilterForm" method="get" class="flex flex-wrap items-end gap-3 2xl:flex-nowrap">
            <input type="hidden" name="Page" value="1" />

            <div class="min-w-[220px] flex-1">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Search</label>
                <input id="productSearchInput"
                       name="Search"
                       value="@Model.Filter.Search"
                       placeholder="Name, PRD code, card #, cert #, seller"
                       autocomplete="off"
                       class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[180px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Seller</label>
                <select name="SellerId" class="product-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    @foreach (var option in Model.SellerOptions)
                    {
                        <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                    }
                </select>
            </div>

            <div class="w-[140px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Condition</label>
                <select name="Condition" class="product-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">All</option>
                    @foreach (var option in Model.ConditionOptions)
                    {
                        <option value="@option.Value" selected="@option.Selected">@option.Text</option>
                    }
                </select>
            </div>

            <div class="w-[220px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Date range</label>
                <input id="productDateRangePicker"
                       name="DateRange"
                       value="@Model.Filter.DateRange"
                       placeholder="MM/DD/YYYY - MM/DD/YYYY"
                       autocomplete="off"
                       class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[150px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Sort</label>
                <select name="SortOrder" class="product-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Filter.SortOrder))">Newest</option>
                    <option value="name_asc" selected="@(Model.Filter.SortOrder == "name_asc")">Name A-Z</option>
                    <option value="name_desc" selected="@(Model.Filter.SortOrder == "name_desc")">Name Z-A</option>
                    <option value="date_asc" selected="@(Model.Filter.SortOrder == "date_asc")">Oldest</option>
                    <option value="date_desc" selected="@(Model.Filter.SortOrder == "date_desc")">Newest</option>
                </select>
            </div>
        </form>
    </div>

    <form id="productBulkDeleteForm"
          asp-area="Admin"
          asp-controller="Product"
          asp-action="BulkDelete"
          method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="ReturnCategoryId" value="@categoryId" />

        <div class="mb-4 flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03] sm:flex-row sm:items-center sm:justify-between">
            <button type="submit"
                    data-bulk-delete="true"
                    class="h-10 rounded-lg border border-error-300 bg-white px-4 text-theme-sm font-medium text-error-600 hover:bg-error-50 dark:border-error-500/30 dark:bg-gray-800">
                Delete selected
            </button>

            <div class="text-theme-sm text-gray-500">
                Total: <span class="font-medium text-gray-800 dark:text-white/90">@Model.TotalItems</span>
            </div>
        </div>

        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-white/[0.03]">
            <div class="max-w-full overflow-x-auto">
                <table class="w-full min-w-[1200px]">
                    <thead>
                    <tr class="border-b border-gray-100 bg-gray-50 dark:border-gray-800 dark:bg-white/[0.02]">
                        <th class="w-12 px-5 py-3 text-left">
                            <input id="selectAllProducts" type="checkbox" aria-label="Select all products" />
                        </th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Product</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Seller</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Condition</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Price</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Qty</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Card / Cert</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Auctions</th>
                        <th class="px-5 py-3 text-left text-theme-xs font-medium uppercase text-gray-500">Created</th>
                        <th class="px-5 py-3 text-right text-theme-xs font-medium uppercase text-gray-500">Actions</th>
                    </tr>
                    </thead>

                    <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    @if (Model.Products.Count == 0)
                    {
                        <tr>
                            <td colspan="10" class="px-5 py-10 text-center text-theme-sm text-gray-500">
                                No products found in this category.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var product in Model.Products)
                        {
                            <tr class="hover:bg-gray-50 dark:hover:bg-white/[0.02]">
                                <td class="px-5 py-4">
                                    <input class="product-checkbox" type="checkbox" name="SelectedProductIds" value="@product.Id" />
                                </td>
                                <td class="px-5 py-4">
                                    <div class="flex items-center gap-3">
                                        <img src="@product.ThumbnailUrl"
                                             alt="@product.Name"
                                             class="h-12 w-12 rounded-lg border border-gray-200 object-cover dark:border-gray-700" />
                                        <div>
                                            <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">@product.Name</p>
                                            <p class="text-theme-xs text-gray-500">Product #: @product.ProductCode</p>
                                            <p class="text-theme-xs text-gray-500">ID: @product.Id</p>
                                        </div>
                                    </div>
                                </td>
                                <td class="px-5 py-4">
                                    <p class="text-theme-sm text-gray-800 dark:text-white/90">@product.SellerName</p>
                                    <p class="text-theme-xs text-gray-500">Seller ID: @product.SellerId</p>
                                </td>
                                <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                    @product.Condition
                                    @if (!string.IsNullOrWhiteSpace(product.GradeLabel))
                                    {
                                        <span class="text-theme-xs text-gray-500"> / @product.GradeLabel</span>
                                    }
                                </td>
                                <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                    @(product.EstimatedValue?.ToString("C") ?? "—")
                                </td>
                                <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">1</td>
                                <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">
                                    @(string.IsNullOrWhiteSpace(product.CardNumber) ? "—" : product.CardNumber)
                                    @if (!string.IsNullOrWhiteSpace(product.CertNumber))
                                    {
                                        <span class="text-theme-xs text-gray-500"> · @product.CertNumber</span>
                                    }
                                </td>
                                <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@product.AuctionCount</td>
                                <td class="px-5 py-4 text-theme-sm text-gray-700 dark:text-gray-300">@product.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td class="px-5 py-4">
                                    <div class="flex justify-end gap-3">
                                        <a asp-area="Admin"
                                           asp-controller="Product"
                                           asp-action="Details"
                                           asp-route-id="@product.Id"
                                           class="text-theme-sm font-medium text-brand-500 hover:underline">
                                            Details
                                        </a>

                                        <a asp-area="Admin"
                                           asp-controller="Product"
                                           asp-action="Edit"
                                           asp-route-id="@product.Id"
                                           class="text-theme-sm font-medium text-warning-600 hover:underline">
                                            Edit
                                        </a>

                                        @if (product.CanDelete)
                                        {
                                            <button type="submit"
                                                    formaction="@Url.Action("Delete", "Product", new { area = "Admin", id = product.Id, returnCategoryId = categoryId })"
                                                    class="text-theme-sm font-medium text-error-600 hover:underline"
                                                    onclick="return confirm('Are you sure you want to delete this product?');">
                                                Delete
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </form>

    <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-theme-sm text-gray-500">
            Page <span class="font-medium text-gray-800 dark:text-white/90">@currentPage</span>
            of <span class="font-medium text-gray-800 dark:text-white/90">@totalPages</span>
        </p>

        <nav class="flex flex-wrap items-center gap-2">
            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Category"
               asp-route-id="@categoryId"
               asp-route-Search="@Model.Filter.Search"
               asp-route-SellerId="@Model.Filter.SellerId"
               asp-route-Condition="@Model.Filter.Condition"
               asp-route-DateRange="@Model.Filter.DateRange"
               asp-route-SortOrder="@Model.Filter.SortOrder"
               asp-route-Page="@(currentPage - 1)"
               class="rounded-lg border border-gray-300 px-3 py-2 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 @(currentPage <= 1 ? "pointer-events-none opacity-50" : "")">
                Previous
            </a>

            @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
            {
                <a asp-area="Admin"
                   asp-controller="Product"
                   asp-action="Category"
                   asp-route-id="@categoryId"
                   asp-route-Search="@Model.Filter.Search"
                   asp-route-SellerId="@Model.Filter.SellerId"
                   asp-route-Condition="@Model.Filter.Condition"
                   asp-route-DateRange="@Model.Filter.DateRange"
                   asp-route-SortOrder="@Model.Filter.SortOrder"
                   asp-route-Page="@pageNumber"
                   class="rounded-lg border px-3 py-2 text-theme-sm font-medium @(pageNumber == currentPage ? "border-brand-500 bg-brand-500 text-white" : "border-gray-300 text-gray-700 hover:bg-gray-50")">
                    @pageNumber
                </a>
            }

            <a asp-area="Admin"
               asp-controller="Product"
               asp-action="Category"
               asp-route-id="@categoryId"
               asp-route-Search="@Model.Filter.Search"
               asp-route-SellerId="@Model.Filter.SellerId"
               asp-route-Condition="@Model.Filter.Condition"
               asp-route-DateRange="@Model.Filter.DateRange"
               asp-route-SortOrder="@Model.Filter.SortOrder"
               asp-route-Page="@(currentPage + 1)"
               class="rounded-lg border border-gray-300 px-3 py-2 text-theme-sm font-medium text-gray-700 hover:bg-gray-50 @(currentPage >= totalPages ? "pointer-events-none opacity-50" : "")">
                Next
            </a>
        </nav>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script>
        (function () {
            const filterForm = document.getElementById('productFilterForm');
            const bulkDeleteForm = document.getElementById('productBulkDeleteForm');
            const selectAllProducts = document.getElementById('selectAllProducts');
            const productCheckboxes = document.querySelectorAll('.product-checkbox');
            const searchInput = document.getElementById('productSearchInput');
            const filterControls = document.querySelectorAll('.product-filter-control');
            let searchDebounceTimer = null;

            if (selectAllProducts) {
                selectAllProducts.addEventListener('change', function () {
                    productCheckboxes.forEach(function (checkbox) {
                        checkbox.checked = selectAllProducts.checked;
                    });
                });
            }

            if (bulkDeleteForm) {
                bulkDeleteForm.addEventListener('submit', function (event) {
                    if (event.submitter?.dataset.bulkDelete !== 'true') {
                        return;
                    }

                    const selectedCount = bulkDeleteForm.querySelectorAll('.product-checkbox:checked').length;
                    if (selectedCount === 0) {
                        event.preventDefault();
                        alert('Please select at least one product.');
                        return;
                    }

                    if (!confirm('Are you sure you want to delete selected products?')) {
                        event.preventDefault();
                    }
                });
            }

            function submitFilterForm() {
                if (!filterForm) {
                    return;
                }

                filterForm.querySelector('input[name="Page"]').value = '1';
                filterForm.requestSubmit();
            }

            filterControls.forEach(function (control) {
                control.addEventListener('change', submitFilterForm);
            });

            if (searchInput) {
                searchInput.addEventListener('input', function () {
                    clearTimeout(searchDebounceTimer);

                    if (searchInput.value.trim() === '') {
                        submitFilterForm();
                        return;
                    }

                    searchDebounceTimer = setTimeout(submitFilterForm, 400);
                });
            }

            $(function () {
                const dateRangePicker = $('#productDateRangePicker');

                dateRangePicker.daterangepicker({
                    autoUpdateInput: false,
                    locale: {
                        cancelLabel: 'Clear',
                        format: 'MM/DD/YYYY'
                    }
                });

                dateRangePicker.on('apply.daterangepicker', function (event, picker) {
                    $(this).val(
                        picker.startDate.format('MM/DD/YYYY') + ' - ' + picker.endDate.format('MM/DD/YYYY')
                    );
                    submitFilterForm();
                });

                dateRangePicker.on('cancel.daterangepicker', function () {
                    $(this).val('');
                    submitFilterForm();
                });
            });
        })();
    </script>
}
