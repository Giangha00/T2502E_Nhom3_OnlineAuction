@model ProductTemplateFormViewModel
@using System.Text.Json

@{
    var imageUploaderLabels = JsonSerializer.Serialize(new
    {
        remove = Localizer["AdminProduct.Remove"].Value,
        clear = Localizer["AdminProduct.ClearSelection"].Value,
        undo = Localizer["AdminProduct.UndoRemove"].Value,
        markedForRemoval = Localizer["AdminProduct.MarkedForRemoval"].Value,
        invalidFormat = Localizer["AdminProduct.ImageUploader.TemplateInvalidFormat"].Value,
        sizeLimit = Localizer["AdminProduct.ImageUploader.TemplateSizeLimit"].Value,
        galleryLimit = Localizer["AdminProduct.ImageUploader.GalleryLimit"].Value,
        galleryPartial = Localizer["AdminProduct.ImageUploader.GalleryPartial"].Value
    });
}

<div asp-validation-summary="ModelOnly" class="mb-4 text-theme-sm text-error-600"></div>

@if (Model.HasInstances)
{
    <div class="mb-4 rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-700">
        @Localizer["AdminProduct.TemplateInstancesWarning"]
    </div>
}

<div class="space-y-8">
    <section>
        <h3 class="mb-4 text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["AdminProduct.TemplateInformation"]</h3>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div class="md:col-span-2">
                <label asp-for="Name" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="Name" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="Name" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="CategoryId" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="">@Localizer["AdminProduct.SelectCategory"]</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="GradeLabel" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <select asp-for="GradeLabel" asp-items="Model.GradeOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></select>
            </div>

            <div>
                <label asp-for="SetName" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="SetName" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="SetName" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="CardNumber" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="CardNumber" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="CardNumber" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="Year" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="Year" type="number" min="1800" max="2100" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="Year" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="Language" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <select asp-for="Language" asp-items="Model.LanguageOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></select>
            </div>
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["AdminProduct.Description"]</h3>
        <div class="grid grid-cols-1 gap-5">
            <div>
                <label asp-for="ShortDescription" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <textarea asp-for="ShortDescription" rows="2" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
            </div>

            <div>
                <label asp-for="DescriptionHtml" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <textarea asp-for="DescriptionHtml" rows="6" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
            </div>
        </div>
    </section>

    <section>
        <h3 class="mb-4 text-lg font-semibold text-gray-800 dark:text-white/90">@Localizer["AdminProduct.Media"]</h3>
        <div data-product-image-uploader
             data-mode="template"
             data-max-image-size="1572864"
             data-labels='@Html.Raw(imageUploaderLabels)'>
            <label asp-for="PrimaryImageFile" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
            <div class="mb-3 flex flex-wrap items-start gap-4">
                <div data-saved-primary-image class="@(string.IsNullOrWhiteSpace(Model.PrimaryImageUrl) ? "hidden" : string.Empty)">
                    <button type="button"
                            class="block cursor-zoom-in overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700">
                        <img data-saved-primary-thumb
                             src="@Model.PrimaryImageUrl"
                             alt="@Localizer["AdminProduct.TemplateImage"]"
                             class="h-40 w-40 object-cover" />
                    </button>
                    <p class="mt-1 text-theme-xs text-gray-500">@Localizer["AdminProduct.CurrentPrimary"]</p>
                </div>

                <div data-primary-preview-wrap class="relative hidden">
                    <button type="button"
                            class="block cursor-zoom-in overflow-hidden rounded-lg border border-brand-200 ring-2 ring-brand-100 dark:border-brand-700 dark:ring-brand-500/20">
                        <img data-primary-preview-img
                             alt="@Localizer["AdminProduct.Preview"]"
                             class="h-40 w-40 object-cover" />
                    </button>
                    <button type="button"
                            data-primary-clear
                            aria-label="@Localizer["AdminProduct.ClearSelection"]"
                            title="@Localizer["AdminProduct.ClearSelection"]"
                            class="admin-icon-action admin-icon-action--neutral admin-icon-action--sm mt-2">
                        <partial name="_AdminIcon" model='"x-mark"' />
                    </button>
                </div>
            </div>
            <input asp-for="PrimaryImageFile"
                   type="file"
                   accept=".jpg,.jpeg,.png"
                   data-primary-input
                   class="block w-full text-theme-sm text-gray-700 dark:text-gray-300" />
            <p class="mt-1 text-theme-xs text-gray-500">@Localizer["AdminProduct.TemplateImageHelp"]</p>
        </div>
    </section>
</div>

<input type="hidden" asp-for="Id" />
