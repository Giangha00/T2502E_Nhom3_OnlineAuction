@model ProductFormViewModel
@using System.Text.Json

@{
    var imageUploaderLabels = JsonSerializer.Serialize(new
    {
        remove = Localizer["AdminProduct.Remove"].Value,
        clear = Localizer["AdminProduct.ClearSelection"].Value,
        undo = Localizer["AdminProduct.UndoRemove"].Value,
        markedForRemoval = Localizer["AdminProduct.MarkedForRemoval"].Value,
        invalidFormat = Localizer["AdminProduct.ImageUploader.InvalidFormat"].Value,
        sizeLimit = Localizer["AdminProduct.ImageUploader.SizeLimit"].Value,
        galleryLimit = Localizer["AdminProduct.ImageUploader.GalleryLimit"].Value,
        galleryPartial = Localizer["AdminProduct.ImageUploader.GalleryPartial"].Value
    });
}

<div asp-validation-summary="ModelOnly" class="mb-4 text-theme-sm text-error-600"></div>

@if (Model.IsSellerLocked)
{
    <div class="mb-4 rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-700">
        @Localizer["AdminProduct.SellerLockedWarning"]
    </div>
}

<div class="space-y-8 admin-product-form">
    <section class="admin-product-form__section">
        <h3 class="admin-product-form__title">@Localizer["AdminProduct.Template"]</h3>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div class="md:col-span-2">
                <label asp-for="ProductTemplateId" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                @if (Model.IsTemplateLocked)
                {
                    <div class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-theme-sm text-gray-700 dark:border-gray-700 dark:bg-gray-800 dark:text-gray-300">
                        @Model.ProductTemplateName
                    </div>
                    <input type="hidden" asp-for="ProductTemplateId" />
                }
                else
                {
                    <select asp-for="ProductTemplateId" asp-items="Model.ProductTemplateOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                        <option value="">@Localizer["AdminProduct.SelectTemplate"]</option>
                    </select>
                }
                <span asp-validation-for="ProductTemplateId" class="text-theme-xs text-error-600"></span>
            </div>
        </div>
    </section>

    <section class="admin-product-form__section">
        <h3 class="admin-product-form__title">@Localizer["AdminProduct.BasicInformation"]</h3>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div class="md:col-span-2">
                <label asp-for="Name" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="Name" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="Name" class="text-theme-xs text-error-600"></span>
            </div>

            <div class="md:col-span-2">
                <label asp-for="ShortDescription" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <textarea asp-for="ShortDescription" rows="2" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
                <span asp-validation-for="ShortDescription" class="text-theme-xs text-error-600"></span>
            </div>

            <div class="md:col-span-2">
                <label asp-for="Subtitle" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="Subtitle" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="Subtitle" class="text-theme-xs text-error-600"></span>
            </div>

            <div class="md:col-span-2">
                <label asp-for="DescriptionHtml" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <textarea asp-for="DescriptionHtml" rows="6" class="w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
                <span asp-validation-for="DescriptionHtml" class="text-theme-xs text-error-600"></span>
            </div>
        </div>
    </section>

    <section class="admin-product-form__section">
        <h3 class="admin-product-form__title">@Localizer["AdminProduct.Classification"]</h3>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label asp-for="CategoryId" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <select asp-for="CategoryId" asp-items="Model.CategoryOptions" disabled class="h-11 w-full rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-800 dark:text-white/90">
                    <option value="">@Localizer["AdminProduct.SelectCategory"]</option>
                </select>
                <input type="hidden" asp-for="CategoryId" />
                <span asp-validation-for="CategoryId" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="SellerId" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                @if (Model.IsSellerLocked)
                {
                    <select asp-for="SellerId" asp-items="Model.SellerOptions" disabled class="h-11 w-full rounded-lg border border-gray-200 bg-gray-50 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-800 dark:text-white/90"></select>
                    <input type="hidden" asp-for="SellerId" />
                }
                else
                {
                    <select asp-for="SellerId" asp-items="Model.SellerOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                        <option value="">@Localizer["AdminProduct.SelectSeller"]</option>
                    </select>
                }
                <span asp-validation-for="SellerId" class="text-theme-xs text-error-600"></span>
            </div>
        </div>
    </section>

    <section class="admin-product-form__section">
        <h3 class="admin-product-form__title">@Localizer["AdminProduct.CardMetadata"]</h3>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label asp-for="Condition" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <select asp-for="Condition" asp-items="Model.ConditionOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></select>
                <span asp-validation-for="Condition" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="Year" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="Year" type="number" min="1800" max="2100" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="Year" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="SetName" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="SetName" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="SetName" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="Language" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <select asp-for="Language" asp-items="Model.LanguageOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></select>
            </div>

            <div>
                <label asp-for="CardNumber" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="CardNumber" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>
        </div>
    </section>

    <section class="admin-product-form__section">
        <h3 class="admin-product-form__title">@Localizer["AdminProduct.Grading"]</h3>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label asp-for="GradeLabel" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <select asp-for="GradeLabel" asp-items="Model.GradeOptions" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></select>
            </div>

            <div>
                <label asp-for="CertNumber" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="CertNumber" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

        </div>
    </section>

    <section class="admin-product-form__section">
        <h3 class="admin-product-form__title">@Localizer["AdminProduct.Value"]</h3>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div>
                <label asp-for="EstimatedValue" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="EstimatedValue" type="number" step="0.01" min="0" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="EstimatedValue" class="text-theme-xs text-error-600"></span>
            </div>

            <div>
                <label asp-for="ImportPrice" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <input asp-for="ImportPrice" type="number" step="0.01" min="0" class="h-11 w-full rounded-lg border border-gray-300 px-4 py-2.5 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
                <span asp-validation-for="ImportPrice" class="text-theme-xs text-error-600"></span>
            </div>
        </div>
    </section>

    <section class="admin-product-form__section">
        <h3 class="admin-product-form__title">@Localizer["AdminProduct.Media"]</h3>
        <div class="grid grid-cols-1 gap-5"
             data-product-image-uploader
             data-mode="product"
             data-max-gallery="4"
             data-max-image-size="1572864"
             data-labels='@Html.Raw(imageUploaderLabels)'>
            <div class="admin-product-form__upload-block">
                <label asp-for="PrimaryImageFile" class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400"></label>
                <div class="mb-3 flex flex-wrap items-start gap-4">
                    <div data-saved-primary-image class="@(string.IsNullOrWhiteSpace(Model.PrimaryImageUrl) ? "hidden" : string.Empty)">
                        <button type="button"
                                class="block cursor-zoom-in overflow-hidden rounded-lg border border-gray-200 dark:border-gray-700"
                                data-saved-primary-open>
                            <img data-saved-primary-thumb
                                 src="@Model.PrimaryImageUrl"
                                 alt="@Localizer["AdminProduct.PrimaryImage"]"
                                 class="h-28 w-28 object-cover" />
                        </button>
                        <p class="mt-1 text-theme-xs text-gray-500">@Localizer["AdminProduct.CurrentPrimary"]</p>
                    </div>

                    <div data-primary-preview-wrap class="relative hidden">
                        <button type="button"
                                class="block cursor-zoom-in overflow-hidden rounded-lg border border-brand-200 ring-2 ring-brand-100 dark:border-brand-700 dark:ring-brand-500/20">
                            <img data-primary-preview-img
                                 alt="@Localizer["AdminProduct.Preview"]"
                                 class="h-28 w-28 object-cover" />
                        </button>
                        <button type="button"
                                data-primary-clear
                                aria-label="@Localizer["AdminProduct.ClearSelection"]"
                                class="mt-2 inline-flex items-center gap-1 rounded-lg border border-gray-300 px-3 py-1.5 text-theme-xs font-medium text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-800">
                            @Localizer["AdminProduct.ClearSelection"]
                        </button>
                    </div>
                </div>
                <input asp-for="PrimaryImageFile"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp"
                       data-primary-input
                       class="sr-only"
                       id="primaryImageInput" />
                <label for="primaryImageInput" class="admin-product-form__upload-button">
                    @Localizer["AdminProduct.PrimaryImage"]
                </label>
                <p class="mt-1 text-theme-xs text-gray-500">@Localizer["AdminProduct.PrimaryImageHelp"]</p>
            </div>

            @if (Model.ExistingGalleryImages.Count > 0)
            {
                <div data-existing-gallery>
                    <p class="mb-2 text-theme-sm font-medium text-gray-700 dark:text-gray-400">@Localizer["AdminProduct.CurrentGallery"]</p>
                    <div class="admin-product-form__gallery-grid">
                        @foreach (var image in Model.ExistingGalleryImages)
                        {
                            <div class="relative overflow-hidden rounded-lg border border-gray-200 bg-white p-2 dark:border-gray-700 dark:bg-gray-900"
                                 data-existing-gallery-item
                                 data-image-id="@image.Id">
                                <button type="button" class="block w-full cursor-zoom-in">
                                    <img data-existing-gallery-thumb
                                         src="@image.ImageUrl"
                                         alt="@Localizer["AdminProduct.GalleryImage"]"
                                         class="h-20 w-full rounded object-cover" />
                                </button>
                                <input type="checkbox"
                                       name="RemoveGalleryImageIds"
                                       value="@image.Id"
                                       class="sr-only"
                                       data-remove-checkbox />
                                <span data-removal-badge
                                      class="absolute left-2 top-2 hidden rounded bg-error-600 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white">
                                    @Localizer["AdminProduct.MarkedForRemoval"]
                                </span>
                                <div class="mt-2 flex items-center gap-2">
                                    <button type="button"
                                            data-mark-remove
                                            aria-label="@Localizer["AdminProduct.Remove"]"
                                            title="@Localizer["AdminProduct.Remove"]"
                                            class="admin-icon-action admin-icon-action--delete admin-icon-action--sm">
                                        <partial name="_AdminIcon" model='"trash"' />
                                    </button>
                                    <button type="button"
                                            data-undo-remove
                                            title="@Localizer["AdminProduct.UndoRemove"]"
                                            aria-label="@Localizer["AdminProduct.UndoRemove"]"
                                            class="hidden admin-icon-action admin-icon-action--neutral admin-icon-action--sm">
                                        <partial name="_AdminIcon" model='"undo"' />
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="admin-product-form__upload-block">
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">@Localizer["AdminProduct.GalleryImages"]</label>
                <input name="GalleryImageFiles"
                       type="file"
                       accept=".jpg,.jpeg,.png,.webp"
                       multiple
                       data-gallery-input
                       class="sr-only"
                       id="galleryImageInput" />
                <label for="galleryImageInput" class="admin-product-form__upload-button">
                    @Localizer["AdminProduct.GalleryImages"]
                </label>
                <p class="mt-1 text-theme-xs text-gray-500">@Localizer["AdminProduct.GalleryImagesHelp"]</p>
                <div data-gallery-preview-grid class="admin-product-form__gallery-grid mt-3 hidden"></div>
            </div>

            @if (Model.ExistingDocuments.Count > 0)
            {
                <div>
                    <p class="mb-2 text-theme-sm font-medium text-gray-700 dark:text-gray-400">@Localizer["AdminProduct.CurrentDocuments"]</p>
                    <div class="space-y-2">
                        @foreach (var document in Model.ExistingDocuments)
                        {
                            <label class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-gray-200 px-4 py-3 dark:border-gray-700">
                                <div class="min-w-0">
                                    <p class="text-theme-sm font-medium text-gray-800 dark:text-white/90">@document.Name</p>
                                    <p class="text-theme-xs text-gray-500">@document.FileType · @document.CreatedAt.ToString("yyyy-MM-dd")</p>
                                    <div class="mt-2 flex flex-wrap gap-2">
                                        <a href="@document.FileUrl" target="_blank" rel="noopener" class="admin-icon-action admin-icon-action--view admin-icon-action--sm" title="@Localizer["AdminProduct.View"]" aria-label="@Localizer["AdminProduct.View"]"><partial name="_AdminIcon" model='"eye"' /></a>
                                        <a asp-area="Admin" asp-controller="Product" asp-action="DownloadDocument" asp-route-id="@document.Id"
                                           class="admin-icon-action admin-icon-action--neutral admin-icon-action--sm" title="@Localizer["AdminProduct.Download"]" aria-label="@Localizer["AdminProduct.Download"]"><partial name="_AdminIcon" model='"download"' /></a>
                                    </div>
                                </div>
                                <div class="flex items-center gap-2">
                                    <input type="checkbox" name="RemoveDocumentIds" value="@document.Id" class="h-4 w-4 rounded border-gray-300 text-brand-500" title="@Localizer["AdminProduct.Remove"]" aria-label="@Localizer["AdminProduct.Remove"]" />
                                </div>
                            </label>
                        }
                    </div>
                </div>
            }

            <div class="admin-product-form__upload-block">
                <label class="mb-1.5 block text-theme-sm font-medium text-gray-700 dark:text-gray-400">@Localizer["AdminProduct.CertificateDocuments"]</label>
                <input id="adminDocumentFiles" name="DocumentFiles" type="file" accept=".pdf,application/pdf" multiple class="sr-only" />
                <label for="adminDocumentFiles" class="admin-product-form__upload-button">
                    @Localizer["AdminProduct.CertificateDocuments"]
                </label>
                <p class="mt-1 text-theme-xs text-gray-500">@Localizer["AdminProduct.CertificateDocumentsHelp"]</p>
                <div id="adminDocumentNameFields" class="mt-3 space-y-2"></div>
            </div>
        </div>
    </section>
</div>

<input type="hidden" asp-for="Id" />
<input type="hidden" asp-for="ContextTemplateId" />

<script>
  (function () {
    var fileInput = document.getElementById('adminDocumentFiles');
    var nameFields = document.getElementById('adminDocumentNameFields');
    if (!fileInput || !nameFields) return;

    var docTypeOptions = [
      '@Localizer["AdminProduct.DocumentTypePsaCertificate"]',
      '@Localizer["AdminProduct.DocumentTypeBgsCertificate"]',
      '@Localizer["AdminProduct.DocumentTypeProductVerification"]',
      '@Localizer["AdminProduct.DocumentTypeWarranty"]'
    ];

    fileInput.addEventListener('change', function () {
      nameFields.innerHTML = '';
      Array.from(fileInput.files || []).forEach(function (file, index) {
        var row = document.createElement('div');
        row.className = 'flex flex-wrap items-center gap-3 rounded-lg border border-gray-200 px-3 py-2 dark:border-gray-700';

        var label = document.createElement('span');
        label.className = 'min-w-0 flex-1 truncate text-theme-xs text-gray-600 dark:text-gray-300';
        label.textContent = file.name;

        var select = document.createElement('select');
        select.name = 'DocumentNames';
        select.className = 'rounded-lg border border-gray-300 px-2 py-1 text-theme-xs dark:border-gray-700 dark:bg-gray-900';
        docTypeOptions.forEach(function (optionValue) {
          var option = document.createElement('option');
          option.value = optionValue;
          option.textContent = optionValue;
          select.appendChild(option);
        });
        if (file.name.toLowerCase().includes('bgs')) {
          select.value = '@Localizer["AdminProduct.DocumentTypeBgsCertificate"]';
        } else if (file.name.toLowerCase().includes('warranty')) {
          select.value = '@Localizer["AdminProduct.DocumentTypeWarranty"]';
        } else if (file.name.toLowerCase().includes('verification')) {
          select.value = '@Localizer["AdminProduct.DocumentTypeProductVerification"]';
        }

        row.appendChild(label);
        row.appendChild(select);
        nameFields.appendChild(row);
      });
    });
  })();
</script>
