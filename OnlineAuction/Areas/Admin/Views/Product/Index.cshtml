@model ProductTemplateListViewModel

@{
    ViewData["Title"] = "Product Management";
    ViewData["AdminPage"] = "products";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Quan ly mau san pham</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">Xem danh sach mau san pham va quan ly cac san pham cua seller trong tung mau.</p>
        </div>

        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="CreateTemplate"
           class="inline-flex items-center justify-center rounded-lg bg-brand-500 px-4 py-2.5 text-theme-sm font-medium text-white hover:bg-brand-600">
            Tao mau san pham
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="mb-4 rounded-xl border border-gray-200 bg-white p-4 dark:border-gray-800 dark:bg-white/[0.03]">
        <form id="productTemplateFilterForm" method="get" class="flex flex-wrap items-end gap-3 2xl:flex-nowrap">
            <input type="hidden" name="Page" value="@(Model.Filter.Page <= 0 ? 1 : Model.Filter.Page)" />

            <div class="min-w-[220px] flex-1">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Search</label>
                <input id="productTemplateSearchInput"
                       name="Search"
                       value="@Model.Filter.Search"
                       placeholder="Ten mau, set, card #, danh muc"
                       autocomplete="off"
                       class="h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90" />
            </div>

            <div class="w-[170px]">
                <label class="mb-1 block text-theme-xs font-medium text-gray-500">Sort</label>
                <select name="SortOrder" class="admin-filter-control h-10 w-full rounded-lg border border-gray-300 px-3 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Filter.SortOrder))">Name A-Z</option>
                    <option value="name_desc" selected="@(Model.Filter.SortOrder == "name_desc")">Name Z-A</option>
                    <option value="count_desc" selected="@(Model.Filter.SortOrder == "count_desc")">Nhieu san pham nhat</option>
                    <option value="date_desc" selected="@(Model.Filter.SortOrder == "date_desc")">Moi cap nhat</option>
                </select>
            </div>
        </form>
    </div>

    <div id="productTemplateListResults" class="transition-opacity duration-200">
        <partial name="_ProductTemplateList" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="~/admin/js/admin-list-filter.js" asp-append-version="true"></script>
    <script>
        AdminListFilter.init({
            formId: 'productTemplateFilterForm',
            resultsId: 'productTemplateListResults',
            searchInputId: 'productTemplateSearchInput',
            listUrl: '@Url.Action("Index", "Product", new { area = "Admin" })'
        });
    </script>
}
