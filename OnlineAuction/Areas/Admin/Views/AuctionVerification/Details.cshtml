@model AuctionVerificationDetailViewModel
@using OnlineAuction.Entities

@{
    ViewData["Title"] = "Review Listing";
    ViewData["AdminPage"] = "verify-auctions";

    var isBuyNow = Model.IsBuyNow;
    var listingBadgeClass = isBuyNow
        ? "av-badge av-badge--buynow"
        : "av-badge av-badge--auction";
    var listingBadgeText = isBuyNow ? "Buy Now" : "Auction";
    var statusText = AuctionStatuses.IsConfirming(Model.Status) ? "Pending review" : Model.Status;
    var allImages = new List<string>();
    if (!string.IsNullOrWhiteSpace(Model.PrimaryImage))
    {
        allImages.Add(Model.PrimaryImage);
    }
    foreach (var galleryImage in Model.GalleryImages)
    {
        if (!string.IsNullOrWhiteSpace(galleryImage)
            && !allImages.Contains(galleryImage, StringComparer.OrdinalIgnoreCase))
        {
            allImages.Add(galleryImage);
        }
    }

    var descriptionLong = !string.IsNullOrWhiteSpace(Model.DescriptionHtml)
        && Model.DescriptionHtml.Length > 400;

    var verificationDocuments = Model.Documents.Select(document => new OnlineAuction.Areas.Admin.ViewModels.Products.ProductDocumentItemViewModel
    {
        Id = document.Id,
        Name = document.Name,
        FileUrl = document.FileUrl,
        FileType = document.FileType,
        CreatedAt = document.CreatedAt
    }).ToList();
    ViewData["SectionTitle"] = "Documents";
}

<link rel="stylesheet" href="~/admin/css/admin-auction-verification.css" asp-append-version="true" />

<div class="av-review mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
        <div class="min-w-0">
            <div class="mb-2 flex flex-wrap items-center gap-2">
                <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">Review Listing</h2>
                <span class="@listingBadgeClass">@listingBadgeText</span>
                <span class="av-badge av-badge--status">@statusText</span>
            </div>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                #@Model.Id
                · submitted @(Model.SubmittedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
            </p>
        </div>
        <a asp-action="Index"
           class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg shrink-0"
           title="Back to queue"
           aria-label="Back to queue">
            <partial name="_AdminIcon" model='"arrow-left"' />
        </a>
    </div>

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700 dark:border-error-500/30 dark:bg-error-500/10 dark:text-error-400">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="av-review-layout">
        <div class="av-review-main space-y-5">
            @* Hero media *@
            <section class="av-panel">
                <div class="av-hero">
                    @if (allImages.Count > 0)
                    {
                        <button type="button"
                                class="av-hero-primary"
                                data-av-lightbox-src="@allImages[0]"
                                data-av-lightbox-alt="@Model.ProductName"
                                title="Enlarge image">
                            <img src="@allImages[0]" alt="@Model.ProductName" />
                        </button>
                        @if (allImages.Count > 1)
                        {
                            <div class="av-hero-thumbs">
                                @for (var i = 0; i < allImages.Count; i++)
                                {
                                    <button type="button"
                                            class="av-hero-thumb @(i == 0 ? "is-active" : "")"
                                            data-av-thumb-src="@allImages[i]"
                                            data-av-lightbox-src="@allImages[i]"
                                            data-av-lightbox-alt="@Model.ProductName — @(i + 1)"
                                            title="View image @(i + 1)">
                                        <img src="@allImages[i]" alt="" />
                                    </button>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <div class="av-hero-empty">No product image</div>
                    }
                </div>

                <div class="av-product-head">
                    <h3 class="av-product-name">@Model.ProductName</h3>
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                    {
                        <p class="av-product-subtitle">@Model.Subtitle</p>
                    }
                    <p class="av-product-meta">@Model.CategoryName · @Model.Condition</p>
                    @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
                    {
                        <p class="av-product-short">@Model.ShortDescription</p>
                    }
                </div>

                @* Compact catalog preview *@
                <div class="av-catalog-preview" aria-label="Catalog card preview">
                    <p class="av-section-label">Catalog preview</p>
                    <div class="av-mini-card">
                        <div class="av-mini-card__media">
                            @if (!string.IsNullOrWhiteSpace(Model.PrimaryImage))
                            {
                                <img src="@Model.PrimaryImage" alt="" />
                            }
                        </div>
                        <div class="av-mini-card__body">
                            <p class="av-mini-card__name">@Model.ProductName</p>
                            @if (!string.IsNullOrWhiteSpace(Model.GradeLabel))
                            {
                                <p class="av-mini-card__grade">@Model.GradeLabel</p>
                            }
                            <p class="av-mini-card__price">
                                @if (isBuyNow)
                                {
                                    <span>$@Model.DisplayPrice.ToString("N0")</span>
                                    <span class="av-mini-card__price-label">Buy Now</span>
                                }
                                else
                                {
                                    <span>$@Model.StartingPrice.ToString("N0")</span>
                                    <span class="av-mini-card__price-label">Starting</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </section>

            @* Card details *@
            <section class="av-panel">
                <h3 class="av-panel-title">Card details</h3>
                <dl class="av-spec-grid">
                    <div>
                        <dt>Year</dt>
                        <dd>@(Model.Year?.ToString() ?? "—")</dd>
                    </div>
                    <div>
                        <dt>Set</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.SetName) ? "—" : Model.SetName)</dd>
                    </div>
                    <div>
                        <dt>Language</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.Language) ? "—" : Model.Language)</dd>
                    </div>
                    <div>
                        <dt>Card #</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.CardNumber) ? "—" : Model.CardNumber)</dd>
                    </div>
                    <div>
                        <dt>Grade</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.GradeLabel) ? "—" : Model.GradeLabel)</dd>
                    </div>
                    <div>
                        <dt>Cert #</dt>
                        <dd>@(string.IsNullOrWhiteSpace(Model.CertNumber) ? "—" : Model.CertNumber)</dd>
                    </div>
                </dl>

                @if (Model.HasSubGrades)
                {
                    <div class="av-subgrades">
                        <p class="av-section-label">Sub-grades</p>
                        <div class="av-subgrades-grid">
                            @if (!string.IsNullOrWhiteSpace(Model.GradingCentering))
                            {
                                <div><span>Centering</span><strong>@Model.GradingCentering</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.GradingCorners))
                            {
                                <div><span>Corners</span><strong>@Model.GradingCorners</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.GradingEdges))
                            {
                                <div><span>Edges</span><strong>@Model.GradingEdges</strong></div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.GradingSurface))
                            {
                                <div><span>Surface</span><strong>@Model.GradingSurface</strong></div>
                            }
                        </div>
                    </div>
                }
            </section>

            @* Listing terms *@
            <section class="av-panel">
                <h3 class="av-panel-title">@(isBuyNow ? "Buy Now terms" : "Auction schedule")</h3>

                @if (isBuyNow)
                {
                    <dl class="av-spec-grid av-spec-grid--terms">
                        <div>
                            <dt>Price</dt>
                            <dd class="av-price">$@Model.DisplayPrice.ToString("N0")</dd>
                        </div>
                    </dl>
                    <p class="av-note mt-3">
                        Buy Now availability end date is system-managed (not collected on Sell). Seller submitted price only.
                    </p>
                }
                else
                {
                    <div class="av-timeline" aria-label="Auction phases">
                        <div class="av-timeline-step">
                            <span class="av-timeline-dot"></span>
                            <div>
                                <p class="av-timeline-label">Registration</p>
                                <p class="av-timeline-range">
                                    @Model.RegistrationStartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    →
                                    @Model.RegistrationEndDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                        </div>
                        <div class="av-timeline-step">
                            <span class="av-timeline-dot av-timeline-dot--live"></span>
                            <div>
                                <p class="av-timeline-label">Live auction</p>
                                <p class="av-timeline-range">
                                    @Model.StartDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                    →
                                    @Model.EndDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </p>
                            </div>
                        </div>
                    </div>

                    <dl class="av-spec-grid av-spec-grid--terms mt-5">
                        <div>
                            <dt>Starting price</dt>
                            <dd class="av-price">$@Model.StartingPrice.ToString("N0")</dd>
                        </div>
                        <div>
                            <dt>Bid step</dt>
                            <dd>$@Model.BidStep.ToString("N0")</dd>
                        </div>
                        @if (Model.BuyNowPrice.HasValue)
                        {
                            <div>
                                <dt>Buy now</dt>
                                <dd>$@Model.BuyNowPrice.Value.ToString("N0")</dd>
                            </div>
                        }
                        @if (Model.HasAuctionEvent)
                        {
                            <div>
                                <dt>Event</dt>
                                <dd>@Model.AuctionEventName</dd>
                            </div>
                        }
                    </dl>

                    <p class="av-note mt-3">
                        Visible on /Auction: <strong>@Model.AuctionPublicVisibility</strong>
                        @if (!string.IsNullOrWhiteSpace(Model.AuctionPublicVisibilityReason))
                        {
                            <span>— @Model.AuctionPublicVisibilityReason</span>
                        }
                    </p>
                }
            </section>

            @if (verificationDocuments.Count > 0)
            {
                @await Html.PartialAsync("~/Areas/Admin/Views/Shared/_ProductDocumentsSection.cshtml", verificationDocuments)
            }
            else
            {
                <section class="av-panel">
                    <h3 class="av-panel-title">Documents</h3>
                    <p class="text-theme-sm text-gray-500 dark:text-gray-400">No certificates or documents uploaded.</p>
                </section>
            }

            @if (!string.IsNullOrWhiteSpace(Model.DescriptionHtml))
            {
                <section class="av-panel">
                    @if (descriptionLong)
                    {
                        <details class="av-desc">
                            <summary class="av-panel-title av-desc-summary">
                                Full description
                                <span class="av-desc-hint">Expand</span>
                            </summary>
                            <div class="prose prose-sm mt-3 max-w-none text-theme-sm dark:prose-invert">
                                @Html.Raw(Model.DescriptionHtml)
                            </div>
                        </details>
                    }
                    else
                    {
                        <details class="av-desc" open>
                            <summary class="av-panel-title av-desc-summary">
                                Full description
                            </summary>
                            <div class="prose prose-sm mt-3 max-w-none text-theme-sm dark:prose-invert">
                                @Html.Raw(Model.DescriptionHtml)
                            </div>
                        </details>
                    }
                </section>
            }
        </div>

        <aside class="av-review-aside">
            <div class="av-decision sticky top-24">
                <h3 class="av-panel-title">Decision</h3>
                <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">
                    Approve to publish. Reject with a clear reason so the seller can fix and resubmit.
                </p>

                <div class="av-seller-compact mt-4">
                    <p class="av-section-label">Seller</p>
                    <p class="font-medium text-gray-800 dark:text-white/90">@Model.SellerName</p>
                    <p class="text-theme-xs text-gray-500">@Model.SellerEmail</p>
                    <a asp-area="Admin"
                       asp-controller="User"
                       asp-action="Details"
                       asp-route-id="@Model.SellerId"
                       class="av-link-text mt-1 inline-block text-theme-xs font-medium text-brand-600 hover:underline dark:text-brand-400">
                        User details →
                    </a>
                </div>

                <ul class="av-checklist mt-5" aria-label="Review checklist">
                    <li class="@(Model.HasRealPrimaryImage ? "is-ok" : "is-warn")">
                        <span class="av-check-icon" aria-hidden="true"></span>
                        @(Model.HasRealPrimaryImage ? "Real product image present" : "Image missing or looks like a placeholder")
                    </li>
                    <li class="@(Model.HasDescription ? "is-ok" : "is-warn")">
                        <span class="av-check-icon" aria-hidden="true"></span>
                        @(Model.HasDescription ? "Description provided" : "No short/full description")
                    </li>
                    <li class="@(Model.HasValidPricing ? "is-ok" : "is-warn")">
                        <span class="av-check-icon" aria-hidden="true"></span>
                        @(Model.HasValidPricing ? "Price / bid terms look valid" : "Check price / bid step")
                    </li>
                    @if (!isBuyNow)
                    {
                        <li class="@(Model.HasValidSchedule ? "is-ok" : "is-warn")">
                            <span class="av-check-icon" aria-hidden="true"></span>
                            @(Model.HasValidSchedule ? "Registration → Live schedule looks valid" : "Check registration / live dates")
                        </li>
                    }
                    <li class="@(Model.HasDocuments ? "is-ok" : "is-optional")">
                        <span class="av-check-icon" aria-hidden="true"></span>
                        @(Model.HasDocuments ? "Documents attached" : "No documents (optional unless policy requires)")
                    </li>
                </ul>

                <form asp-action="Approve"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="mt-5"
                      onsubmit="return confirm('Approve this listing?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="av-btn av-btn--approve w-full">
                        <partial name="_AdminIcon" model='"check"' />
                        Approve listing
                    </button>
                </form>

                <form asp-action="Reject"
                      asp-route-id="@Model.Id"
                      method="post"
                      class="mt-4 space-y-3"
                      onsubmit="return validateRejectReason();">
                    @Html.AntiForgeryToken()
                    <label for="rejectReason" class="block text-theme-xs font-medium text-gray-500 dark:text-gray-400">
                        Reject reason (min 10 characters)
                    </label>
                    <div class="av-reject-chips" role="group" aria-label="Quick reject reasons">
                        <button type="button" class="av-chip" data-reject-chip="Blurry or unclear photos — please re-upload sharper images.">Blurry photos</button>
                        <button type="button" class="av-chip" data-reject-chip="Missing or invalid certification / cert number.">Missing cert</button>
                        <button type="button" class="av-chip" data-reject-chip="Price or schedule looks incorrect — please revise listing terms.">Bad price/schedule</button>
                        <button type="button" class="av-chip" data-reject-chip="Product description is incomplete or does not match the images.">Incomplete description</button>
                        <button type="button" class="av-chip" data-reject-chip="Category, condition, or card details look wrong.">Wrong details</button>
                    </div>
                    <textarea id="rejectReason"
                              name="rejectReason"
                              rows="4"
                              required
                              minlength="10"
                              maxlength="500"
                              placeholder="Explain what needs to be fixed..."
                              class="w-full rounded-lg border border-gray-300 px-3 py-2 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
                    <button type="submit" class="av-btn av-btn--reject w-full">
                        <partial name="_AdminIcon" model='"x-mark"' />
                        Reject listing
                    </button>
                </form>
            </div>
        </aside>
    </div>
</div>

<partial name="~/Areas/Admin/Views/Product/_ProductImageLightbox.cshtml" />

@section Scripts {
    <script>
        function validateRejectReason() {
            const value = document.getElementById('rejectReason').value.trim();
            if (value.length < 10) {
                alert('Reject reason must be at least 10 characters.');
                return false;
            }
            return confirm('Reject this listing? The seller will see your reason.');
        }

        (function () {
            const lightbox = document.querySelector('[data-admin-image-lightbox]');
            const lightboxImg = lightbox && lightbox.querySelector('[data-lightbox-image]');
            const primaryImg = document.querySelector('.av-hero-primary img');

            function openLightbox(src, altText) {
                if (!lightbox || !lightboxImg || !src) return;
                lightboxImg.src = src;
                lightboxImg.alt = altText || '';
                lightbox.classList.remove('hidden');
                lightbox.classList.add('flex');
                lightbox.setAttribute('aria-hidden', 'false');
            }

            function closeLightbox() {
                if (!lightbox) return;
                lightbox.classList.add('hidden');
                lightbox.classList.remove('flex');
                lightbox.setAttribute('aria-hidden', 'true');
                if (lightboxImg) {
                    lightboxImg.removeAttribute('src');
                    lightboxImg.alt = '';
                }
            }

            document.querySelectorAll('[data-av-lightbox-src]:not([data-av-thumb-src])').forEach(function (el) {
                el.addEventListener('click', function () {
                    openLightbox(el.getAttribute('data-av-lightbox-src'), el.getAttribute('data-av-lightbox-alt'));
                });
            });

            document.querySelectorAll('[data-av-thumb-src]').forEach(function (thumb) {
                thumb.addEventListener('click', function () {
                    const src = thumb.getAttribute('data-av-thumb-src');
                    if (primaryImg && src) {
                        primaryImg.src = src;
                        const primaryBtn = primaryImg.closest('[data-av-lightbox-src]');
                        if (primaryBtn) {
                            primaryBtn.setAttribute('data-av-lightbox-src', src);
                        }
                    }
                    document.querySelectorAll('.av-hero-thumb').forEach(function (t) {
                        t.classList.toggle('is-active', t === thumb);
                    });
                });
            });

            if (lightbox) {
                lightbox.querySelectorAll('[data-lightbox-close]').forEach(function (btn) {
                    btn.addEventListener('click', closeLightbox);
                });
                lightbox.addEventListener('click', function (event) {
                    if (event.target === lightbox || event.target.hasAttribute('data-lightbox-backdrop')) {
                        closeLightbox();
                    }
                });
                document.addEventListener('keydown', function (event) {
                    if (event.key === 'Escape' && !lightbox.classList.contains('hidden')) {
                        closeLightbox();
                    }
                });
            }

            const reason = document.getElementById('rejectReason');
            document.querySelectorAll('[data-reject-chip]').forEach(function (chip) {
                chip.addEventListener('click', function () {
                    const text = chip.getAttribute('data-reject-chip') || '';
                    if (!reason) return;
                    const current = reason.value.trim();
                    reason.value = current ? (current + ' ' + text) : text;
                    reason.focus();
                });
            });
        })();
    </script>
}
