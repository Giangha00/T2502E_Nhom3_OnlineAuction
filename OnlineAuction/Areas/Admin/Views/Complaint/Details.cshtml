@model ComplaintDetailViewModel

@{
    ViewData["Title"] = "Complaint Details";
    ViewData["AdminPage"] = "complaints";

    var requestedAmountText = Model.RequestedAmount.HasValue
        ? $"${Model.RequestedAmount.Value:N2}"
        : "Full refund";
    var orderReferenceText = Model.OrderReference ?? "Not linked";
    var productNameText = string.IsNullOrWhiteSpace(Model.ProductName) ? "No product name" : Model.ProductName;
}

<link rel="stylesheet" href="~/admin/css/admin-complaints.css" asp-append-version="true" />

<div class="complaint-page mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="complaint-detail-hero">
        <div class="complaint-detail-hero__main">
            <a asp-action="Index" class="complaint-back-link">
                <partial name="_AdminIcon" model='"arrow-left"' />
                <span>Back to complaints</span>
            </a>
            <span class="complaint-kicker">@Model.ComplaintTypeLabel case</span>
            <div class="complaint-detail-hero__title">
                <h2>@Model.RequestReference</h2>
                <span class="inline-flex rounded-full border px-2.5 py-0.5 text-theme-xs font-medium @ComplaintDisplayHelper.GetStatusBadgeClass(Model.Status)">
                    @Model.StatusLabel
                </span>
            </div>
            <p>Submitted @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
        </div>

        <div class="complaint-detail-hero__facts">
            <div>
                <span>Requested amount</span>
                <strong>@requestedAmountText</strong>
            </div>
            <div>
                <span>Order</span>
                <strong>@orderReferenceText</strong>
            </div>
            <div>
                <span>Reason</span>
                <strong>@Model.ReasonLabel</strong>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="complaint-alert complaint-alert--success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="complaint-alert complaint-alert--error">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.OrderRefundEligibilityWarning))
    {
        <div class="complaint-alert complaint-alert--warning">
            @Model.OrderRefundEligibilityWarning
        </div>
    }

    @if (Model.HasApprovedComplaintForOrder)
    {
        <div class="complaint-alert complaint-alert--error">
            Another approved complaint already exists for this order. Approval is blocked.
        </div>
    }

    <div class="complaint-detail-layout">
        <div class="complaint-detail-main">
            <section class="complaint-section">
                <div class="complaint-section__header">
                    <div>
                        <span>Case details</span>
                        <h3>Complaint</h3>
                    </div>
                </div>

                <dl class="complaint-info-grid">
                    <div>
                        <dt>Type</dt>
                        <dd>@Model.ComplaintTypeLabel</dd>
                    </div>
                    <div>
                        <dt>Reason</dt>
                        <dd>@Model.ReasonLabel</dd>
                    </div>
                    <div>
                        <dt>Requested amount</dt>
                        <dd>@requestedAmountText</dd>
                    </div>
                    <div>
                        <dt>Contact</dt>
                        <dd>@Model.ContactName &lt;@Model.ContactEmail&gt;</dd>
                    </div>
                </dl>

                <div class="complaint-copy-block">
                    <span>Description</span>
                    <p>@Model.Description</p>
                </div>

                @if (Model.EvidenceUrls.Count > 0)
                {
                    <div class="complaint-link-list">
                        <span>Evidence</span>
                        @foreach (var url in Model.EvidenceUrls)
                        {
                            <a href="@url" target="_blank" rel="noopener">@url</a>
                        }
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ResolutionNote))
                {
                    <div class="complaint-copy-block complaint-copy-block--resolution">
                        <span>Buyer-facing resolution</span>
                        <p>@Model.ResolutionNote</p>
                    </div>
                }
            </section>

            @if (Model.OrderId.HasValue)
            {
                <section class="complaint-section">
                    <div class="complaint-section__header">
                        <div>
                            <span>Order context</span>
                            <h3>@orderReferenceText</h3>
                        </div>
                    </div>

                    <dl class="complaint-info-grid complaint-info-grid--three">
                        <div>
                            <dt>Status</dt>
                            <dd>@(Model.OrderStatus ?? "Unknown")</dd>
                        </div>
                        <div>
                            <dt>Product</dt>
                            <dd>@productNameText</dd>
                        </div>
                        <div>
                            <dt>Subtotal</dt>
                            <dd>@(Model.OrderSubtotal.HasValue ? $"${Model.OrderSubtotal.Value:N2}" : "Not available")</dd>
                        </div>
                        <div>
                            <dt>Total</dt>
                            <dd>@(Model.OrderTotal.HasValue ? $"${Model.OrderTotal.Value:N2}" : "Not available")</dd>
                        </div>
                        <div>
                            <dt>Payment method</dt>
                            <dd>@(Model.PaymentMethod ?? "Not available")</dd>
                        </div>
                        <div>
                            <dt>Paid at</dt>
                            <dd>@(Model.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Not available")</dd>
                        </div>
                    </dl>
                </section>
            }

            <section class="complaint-section">
                <div class="complaint-section__header">
                    <div>
                        <span>People</span>
                        <h3>Buyer and seller</h3>
                    </div>
                </div>

                <div class="complaint-party-grid">
                    <div class="complaint-party">
                        <span>Buyer</span>
                        <strong>@Model.BuyerName</strong>
                        <small>@Model.BuyerEmail</small>
                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Details"
                           asp-route-id="@Model.BuyerId"
                           class="complaint-inline-link">
                            <partial name="_AdminIcon" model='"external"' />
                            <span>Open profile</span>
                        </a>
                    </div>

                    @if (Model.SellerId.HasValue)
                    {
                        <div class="complaint-party">
                            <span>Seller</span>
                            <strong>@Model.SellerName</strong>
                            <small>@Model.SellerEmail</small>
                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Details"
                               asp-route-id="@Model.SellerId"
                               class="complaint-inline-link">
                                <partial name="_AdminIcon" model='"external"' />
                                <span>Open profile</span>
                            </a>
                        </div>
                    }
                </div>

                @if (Model.AuctionId.HasValue)
                {
                    <a asp-area="Admin"
                       asp-controller="Auction"
                       asp-action="Details"
                       asp-route-id="@Model.AuctionId"
                       class="complaint-inline-link complaint-inline-link--standalone">
                        <partial name="_AdminIcon" model='"external"' />
                        <span>Open auction #@Model.AuctionId</span>
                    </a>
                }
            </section>

            @if (Model.ReviewedAt.HasValue)
            {
                <section class="complaint-section">
                    <div class="complaint-section__header">
                        <div>
                            <span>Review history</span>
                            <h3>Last decision</h3>
                        </div>
                    </div>
                    <p class="complaint-review-note">
                        Reviewed by @(Model.ReviewerName ?? "Admin") on @Model.ReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </p>
                </section>
            }
        </div>

        <aside class="complaint-detail-aside">
            <div class="complaint-sticky-stack">
                <section class="complaint-section complaint-section--aside">
                    <div class="complaint-section__header">
                        <div>
                            <span>Internal</span>
                            <h3>Admin notes</h3>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.AdminNotes))
                    {
                        <div class="complaint-notes-box">
                            @Model.AdminNotes
                        </div>
                    }
                    else
                    {
                        <p class="complaint-empty-note">No internal notes yet.</p>
                    }

                    <form asp-action="UpdateStatus" method="post" class="complaint-action-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ComplaintId" value="@Model.Id" />
                        <input type="hidden" name="Action" value="@ComplaintStatusActions.AddNote" />
                        <label for="adminNotes">Add note</label>
                        <textarea id="adminNotes"
                                  name="AdminNotes"
                                  rows="4"
                                  placeholder="Write an internal note..."></textarea>
                        <button type="submit" class="complaint-action-button complaint-action-button--primary">
                            <partial name="_AdminIcon" model='"save"' />
                            <span>Save note</span>
                        </button>
                    </form>
                </section>

                <section class="complaint-section complaint-section--aside">
                    <div class="complaint-section__header">
                        <div>
                            <span>Decision</span>
                            <h3>Actions</h3>
                        </div>
                    </div>

                    @if (Model.CanMarkUnderReview)
                    {
                        <form asp-action="UpdateStatus" method="post" class="complaint-action-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <input type="hidden" name="Action" value="@ComplaintStatusActions.UnderReview" />
                            <button type="submit" class="complaint-action-button complaint-action-button--review">
                                <partial name="_AdminIcon" model='"review"' />
                                <span>Mark under review</span>
                            </button>
                        </form>
                    }

                    @if (Model.CanApprove || Model.CanReject)
                    {
                        <form asp-action="UpdateStatus"
                              method="post"
                              class="complaint-action-form"
                              id="complaintDecisionForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <label for="resolutionNote">Resolution note</label>
                            <textarea id="resolutionNote"
                                      name="ResolutionNote"
                                      rows="5"
                                      placeholder="Explain the decision to the buyer..."></textarea>

                            @if (Model.CanApprove)
                            {
                                <button type="submit"
                                        name="Action"
                                        value="@ComplaintStatusActions.Approve"
                                        class="complaint-action-button complaint-action-button--approve">
                                    <partial name="_AdminIcon" model='"check"' />
                                    <span>Approve refund</span>
                                </button>
                            }

                            @if (Model.CanReject)
                            {
                                <button type="submit"
                                        name="Action"
                                        value="@ComplaintStatusActions.Reject"
                                        class="complaint-action-button complaint-action-button--reject">
                                    <partial name="_AdminIcon" model='"x-mark"' />
                                    <span>Reject complaint</span>
                                </button>
                            }
                        </form>
                    }

                    @if (Model.CanClose)
                    {
                        <form asp-action="UpdateStatus" method="post" class="complaint-action-form"
                              data-confirm
                              data-confirm-variant="danger"
                              data-confirm-title="Close complaint?"
                              data-confirm-message="Close this complaint?"
                              data-confirm-confirm="Close">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <input type="hidden" name="Action" value="@ComplaintStatusActions.Close" />
                            <button type="submit" class="complaint-action-button complaint-action-button--ghost">
                                <partial name="_AdminIcon" model='"x-mark"' />
                                <span>Close complaint</span>
                            </button>
                        </form>
                    }

                    @if (!Model.CanMarkUnderReview && !Model.CanApprove && !Model.CanReject && !Model.CanClose)
                    {
                        <p class="complaint-empty-note">No further actions available for this complaint.</p>
                    }
                </section>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('complaintDecisionForm');
            if (!form) {
                return;
            }

            form.addEventListener('submit', function (event) {
                if (form.dataset.confirmAccepted === '1') {
                    delete form.dataset.confirmAccepted;
                    return;
                }

                const submitter = event.submitter;
                const action = submitter?.value;
                if (action !== '@ComplaintStatusActions.Approve' && action !== '@ComplaintStatusActions.Reject') {
                    return;
                }

                const note = form.querySelector('[name="ResolutionNote"]')?.value?.trim() ?? '';
                if (note.length < 10) {
                    event.preventDefault();
                    alert('Resolution note must be at least 10 characters.');
                    return;
                }

                if (action !== '@ComplaintStatusActions.Approve') {
                    return;
                }

                event.preventDefault();
                const confirmFn = typeof window.showConfirmModal === 'function'
                    ? window.showConfirmModal
                    : function (options) {
                        return Promise.resolve(window.confirm(options.message || ''));
                    };

                confirmFn({
                    title: 'Approve refund?',
                    message: 'Approve this refund request?',
                    confirmText: 'Approve',
                    variant: 'default'
                }).then(function (confirmed) {
                    if (!confirmed) {
                        return;
                    }

                    form.dataset.confirmAccepted = '1';
                    if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit(submitter || undefined);
                    } else {
                        HTMLFormElement.prototype.submit.call(form);
                    }
                });
            });
        })();
    </script>
}
