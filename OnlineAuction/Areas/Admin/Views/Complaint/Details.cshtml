@model ComplaintDetailViewModel

@{
    ViewData["Title"] = "Complaint Details";
    ViewData["AdminPage"] = "complaints";
}

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Model.RequestReference</h2>
            <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                @Model.ComplaintTypeLabel · submitted @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
        <a asp-action="Index"
           class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
           title="Back to list"
           aria-label="Back to list">
            <partial name="_AdminIcon" model='"arrow-left"' />
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    <div class="grid grid-cols-1 gap-6 xl:grid-cols-3">
        <div class="space-y-6 xl:col-span-2">
            <section class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Complaint</h3>
                    <span class="inline-flex rounded-full border px-2.5 py-0.5 text-theme-xs font-medium @ComplaintDisplayHelper.GetStatusBadgeClass(Model.Status)">
                        @Model.StatusLabel
                    </span>
                </div>

                <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <div>
                        <dt class="text-theme-xs uppercase text-gray-400">Type</dt>
                        <dd class="mt-1 text-theme-sm">@Model.ComplaintTypeLabel</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs uppercase text-gray-400">Reason</dt>
                        <dd class="mt-1 text-theme-sm">@Model.ReasonLabel</dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs uppercase text-gray-400">Requested amount</dt>
                        <dd class="mt-1 text-theme-sm">
                            @(Model.RequestedAmount.HasValue ? $"${Model.RequestedAmount.Value:N2}" : "Full refund")
                        </dd>
                    </div>
                    <div>
                        <dt class="text-theme-xs uppercase text-gray-400">Contact</dt>
                        <dd class="mt-1 text-theme-sm">@Model.ContactName · @Model.ContactEmail</dd>
                    </div>
                </dl>

                <div class="mt-4">
                    <dt class="text-theme-xs uppercase text-gray-400">Description</dt>
                    <dd class="mt-2 whitespace-pre-wrap rounded-xl border border-gray-100 bg-gray-50 p-4 text-theme-sm text-gray-700 dark:border-gray-800 dark:bg-white/[0.02] dark:text-gray-300">
                        @Model.Description
                    </dd>
                </div>

                @if (Model.EvidenceUrls.Count > 0)
                {
                    <div class="mt-4">
                        <dt class="text-theme-xs uppercase text-gray-400">Evidence</dt>
                        <ul class="mt-2 space-y-2">
                            @foreach (var url in Model.EvidenceUrls)
                            {
                                <li>
                                    <a href="@url" target="_blank" rel="noopener"
                                       class="text-theme-sm font-medium text-brand-600 hover:text-brand-700">
                                        @url
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ResolutionNote))
                {
                    <div class="mt-4">
                        <dt class="text-theme-xs uppercase text-gray-400">Resolution note (buyer-facing)</dt>
                        <dd class="mt-2 whitespace-pre-wrap rounded-xl border border-brand-100 bg-brand-50 p-4 text-theme-sm text-brand-800">
                            @Model.ResolutionNote
                        </dd>
                    </div>
                }
            </section>

            @if (Model.OrderId.HasValue)
            {
                <section class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                    <h3 class="mb-4 text-lg font-semibold text-gray-800 dark:text-white/90">Order</h3>
                    <dl class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        <div>
                            <dt class="text-theme-xs uppercase text-gray-400">Order reference</dt>
                            <dd class="mt-1 text-theme-sm">@(Model.OrderReference ?? "—")</dd>
                        </div>
                        <div>
                            <dt class="text-theme-xs uppercase text-gray-400">Status</dt>
                            <dd class="mt-1 text-theme-sm capitalize">@(Model.OrderStatus ?? "—")</dd>
                        </div>
                        <div>
                            <dt class="text-theme-xs uppercase text-gray-400">Product</dt>
                            <dd class="mt-1 text-theme-sm">@Model.ProductName</dd>
                        </div>
                        <div>
                            <dt class="text-theme-xs uppercase text-gray-400">Subtotal</dt>
                            <dd class="mt-1 text-theme-sm">@(Model.OrderSubtotal.HasValue ? $"${Model.OrderSubtotal.Value:N2}" : "—")</dd>
                        </div>
                        <div>
                            <dt class="text-theme-xs uppercase text-gray-400">Total</dt>
                            <dd class="mt-1 text-theme-sm">@(Model.OrderTotal.HasValue ? $"${Model.OrderTotal.Value:N2}" : "—")</dd>
                        </div>
                        <div>
                            <dt class="text-theme-xs uppercase text-gray-400">Payment method</dt>
                            <dd class="mt-1 text-theme-sm">@(Model.PaymentMethod ?? "—")</dd>
                        </div>
                        <div>
                            <dt class="text-theme-xs uppercase text-gray-400">Paid at</dt>
                            <dd class="mt-1 text-theme-sm">
                                @(Model.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </dd>
                        </div>
                    </dl>
                </section>
            }

            <section class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                <h3 class="mb-4 text-lg font-semibold text-gray-800 dark:text-white/90">Parties</h3>
                <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                    <div>
                        <p class="text-theme-xs uppercase text-gray-400">Buyer</p>
                        <p class="mt-1 text-theme-sm font-medium text-gray-800 dark:text-white/90">@Model.BuyerName</p>
                        <p class="text-theme-xs text-gray-500">@Model.BuyerEmail</p>
                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Details"
                           asp-route-id="@Model.BuyerId"
                           class="admin-icon-action admin-icon-action--view admin-icon-action--sm mt-2"
                           title="View buyer"
                           aria-label="View buyer">
                            <partial name="_AdminIcon" model='"external"' />
                        </a>
                    </div>
                    @if (Model.SellerId.HasValue)
                    {
                        <div>
                            <p class="text-theme-xs uppercase text-gray-400">Seller</p>
                            <p class="mt-1 text-theme-sm font-medium text-gray-800 dark:text-white/90">@Model.SellerName</p>
                            <p class="text-theme-xs text-gray-500">@Model.SellerEmail</p>
                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Details"
                               asp-route-id="@Model.SellerId"
                               class="admin-icon-action admin-icon-action--view admin-icon-action--sm mt-2"
                               title="View seller"
                               aria-label="View seller">
                                <partial name="_AdminIcon" model='"external"' />
                            </a>
                        </div>
                    }
                </div>
                @if (Model.AuctionId.HasValue)
                {
                    <a asp-area="Admin"
                       asp-controller="Auction"
                       asp-action="Details"
                       asp-route-id="@Model.AuctionId"
                       class="admin-icon-action admin-icon-action--view admin-icon-action--sm mt-4"
                       title="View auction #@Model.AuctionId"
                       aria-label="View auction #@Model.AuctionId">
                        <partial name="_AdminIcon" model='"external"' />
                    </a>
                }
            </section>

            @if (Model.ReviewedAt.HasValue)
            {
                <section class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                    <h3 class="mb-2 text-lg font-semibold text-gray-800 dark:text-white/90">Review</h3>
                    <p class="text-theme-sm text-gray-600 dark:text-gray-400">
                        Reviewed by @(Model.ReviewerName ?? "Admin") on @Model.ReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </p>
                </section>
            }
        </div>

        <aside class="xl:col-span-1">
            <div class="sticky top-24 space-y-6">
                <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Admin notes</h3>
                    <p class="mt-1 text-theme-xs text-gray-500">Internal notes — not visible to the buyer.</p>

                    @if (!string.IsNullOrWhiteSpace(Model.AdminNotes))
                    {
                        <div class="mt-3 whitespace-pre-wrap rounded-lg bg-gray-50 p-3 text-theme-sm text-gray-700 dark:bg-white/[0.02] dark:text-gray-300">
                            @Model.AdminNotes
                        </div>
                    }

                    <form asp-action="UpdateStatus" method="post" class="mt-4 space-y-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ComplaintId" value="@Model.Id" />
                        <input type="hidden" name="Action" value="@ComplaintStatusActions.AddNote" />
                        <textarea name="AdminNotes"
                                  rows="3"
                                  placeholder="Add internal note..."
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
                        <button type="submit"
                                class="admin-icon-action admin-icon-action--primary admin-icon-action--lg mx-auto w-full max-w-none"
                                title="Save note"
                                aria-label="Save note">
                            <partial name="_AdminIcon" model='"save"' />
                        </button>
                    </form>
                </div>

                <div class="rounded-2xl border border-gray-200 bg-white p-6 dark:border-gray-800 dark:bg-white/[0.03]">
                    <h3 class="text-lg font-semibold text-gray-800 dark:text-white/90">Actions</h3>
                    <p class="mt-2 text-theme-sm text-gray-500 dark:text-gray-400">
                        Update status and provide a resolution note when approving or rejecting.
                    </p>

                    @if (Model.CanMarkUnderReview)
                    {
                        <form asp-action="UpdateStatus" method="post" class="mt-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <input type="hidden" name="Action" value="@ComplaintStatusActions.UnderReview" />
                            <button type="submit"
                                    class="admin-icon-action admin-icon-action--review admin-icon-action--lg mx-auto w-full max-w-none"
                                    title="Mark under review"
                                    aria-label="Mark under review">
                                <partial name="_AdminIcon" model='"review"' />
                            </button>
                        </form>
                    }

                    @if (Model.CanApprove || Model.CanReject)
                    {
                        <form asp-action="UpdateStatus"
                              method="post"
                              class="mt-4 space-y-3"
                              id="complaintDecisionForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <label class="block text-theme-xs font-medium text-gray-500">Resolution note (required for approve/reject)</label>
                            <textarea id="resolutionNote"
                                      name="ResolutionNote"
                                      rows="4"
                                      class="w-full rounded-lg border border-gray-300 px-3 py-2 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"
                                      placeholder="Explain the decision to the buyer..."></textarea>

                            @if (Model.CanApprove)
                            {
                                <button type="submit"
                                        name="Action"
                                        value="@ComplaintStatusActions.Approve"
                                        class="admin-icon-action admin-icon-action--approve admin-icon-action--lg mx-auto w-full max-w-none"
                                        title="Approve"
                                        aria-label="Approve">
                                    <partial name="_AdminIcon" model='"check"' />
                                </button>
                            }

                            @if (Model.CanReject)
                            {
                                <button type="submit"
                                        name="Action"
                                        value="@ComplaintStatusActions.Reject"
                                        class="admin-icon-action admin-icon-action--reject admin-icon-action--lg mx-auto w-full max-w-none"
                                        title="Reject"
                                        aria-label="Reject">
                                    <partial name="_AdminIcon" model='"x-mark"' />
                                </button>
                            }
                        </form>
                    }

                    @if (Model.CanClose)
                    {
                        <form asp-action="UpdateStatus" method="post" class="mt-4"
                              data-confirm
                              data-confirm-variant="danger"
                              data-confirm-title="Close complaint?"
                              data-confirm-message="Close this complaint?"
                              data-confirm-confirm="Close">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <input type="hidden" name="Action" value="@ComplaintStatusActions.Close" />
                            <button type="submit"
                                    class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg mx-auto w-full max-w-none"
                                    title="Close complaint"
                                    aria-label="Close complaint">
                                <partial name="_AdminIcon" model='"x-mark"' />
                            </button>
                        </form>
                    }

                    @if (!Model.CanMarkUnderReview && !Model.CanApprove && !Model.CanReject && !Model.CanClose)
                    {
                        <p class="mt-4 text-theme-sm text-gray-500">No further actions available for this complaint.</p>
                    }
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('complaintDecisionForm');
            if (!form) {
                return;
            }

            form.addEventListener('submit', function (event) {
                if (form.dataset.confirmAccepted === '1') {
                    delete form.dataset.confirmAccepted;
                    return;
                }

                const submitter = event.submitter;
                const action = submitter?.value;
                if (action !== '@ComplaintStatusActions.Approve' && action !== '@ComplaintStatusActions.Reject') {
                    return;
                }

                const note = form.querySelector('[name="ResolutionNote"]')?.value?.trim() ?? '';
                if (note.length < 10) {
                    event.preventDefault();
                    alert('Resolution note must be at least 10 characters.');
                    return;
                }

                if (action !== '@ComplaintStatusActions.Approve') {
                    return;
                }

                event.preventDefault();
                const confirmFn = typeof window.showConfirmModal === 'function'
                    ? window.showConfirmModal
                    : function (options) {
                        return Promise.resolve(window.confirm(options.message || ''));
                    };

                confirmFn({
                    title: 'Approve refund?',
                    message: 'Approve this refund request?',
                    confirmText: 'Approve',
                    variant: 'default'
                }).then(function (confirmed) {
                    if (!confirmed) {
                        return;
                    }

                    form.dataset.confirmAccepted = '1';
                    if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit(submitter || undefined);
                    } else {
                        HTMLFormElement.prototype.submit.call(form);
                    }
                });
            });
        })();
    </script>
}
