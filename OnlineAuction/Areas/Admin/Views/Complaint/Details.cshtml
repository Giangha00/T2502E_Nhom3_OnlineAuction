@model ComplaintDetailViewModel

@{
    ViewData["Title"] = "Complaint Details";
    ViewData["AdminPage"] = "complaints";
}

<link rel="stylesheet" href="~/admin/css/admin-complaint-details.css" asp-append-version="true" />

<div class="mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="mb-6 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
        <div class="complaint-detail-main">
            <div class="complaint-title-row">
                <h2 class="text-title-md font-bold text-gray-800 dark:text-white/90">@Model.RequestReference</h2>
                <span class="inline-flex rounded-full border px-2.5 py-0.5 text-theme-xs font-medium @ComplaintDisplayHelper.GetStatusBadgeClass(Model.Status)">
                    @Model.StatusLabel
                </span>
            </div>
            <p class="mt-1 text-theme-sm text-gray-500 dark:text-gray-400">
                @Model.ComplaintTypeLabel · submitted @Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
            </p>
        </div>
        <a asp-action="Index"
           class="admin-icon-action admin-icon-action--neutral admin-icon-action--lg"
           title="Back to list"
           aria-label="Back to list">
            <partial name="_AdminIcon" model='"arrow-left"' />
        </a>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-success-200 bg-success-50 px-4 py-3 text-theme-sm text-success-700">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.OrderRefundEligibilityWarning))
    {
        <div class="mb-4 rounded-lg border border-warning-200 bg-warning-50 px-4 py-3 text-theme-sm text-warning-800">
            @Model.OrderRefundEligibilityWarning
        </div>
    }

    @if (Model.HasApprovedComplaintForOrder)
    {
        <div class="mb-4 rounded-lg border border-error-200 bg-error-50 px-4 py-3 text-theme-sm text-error-700">
            Another approved complaint already exists for this order. Approval is blocked.
        </div>
    }

    <div class="complaint-detail-grid">
        <div class="complaint-detail-main complaint-stack">
            <section class="complaint-card">
                <h3 class="complaint-card__title">Complaint</h3>

                <dl class="complaint-meta-grid">
                    <div class="complaint-field">
                        <dt class="complaint-label">Type</dt>
                        <dd class="complaint-value">@Model.ComplaintTypeLabel</dd>
                    </div>
                    <div class="complaint-field">
                        <dt class="complaint-label">Reason</dt>
                        <dd class="complaint-value">@Model.ReasonLabel</dd>
                    </div>
                    <div class="complaint-field">
                        <dt class="complaint-label">Requested amount</dt>
                        <dd class="complaint-value complaint-value--strong">
                            @(Model.RequestedAmount.HasValue ? $"${Model.RequestedAmount.Value:N2}" : "Full refund")
                        </dd>
                    </div>
                    <div class="complaint-field">
                        <dt class="complaint-label">Contact</dt>
                        <dd class="complaint-value">@Model.ContactName</dd>
                        <dd class="complaint-value complaint-value--muted">@Model.ContactEmail</dd>
                    </div>
                </dl>

                <div class="complaint-section">
                    <p class="complaint-label">Description</p>
                    <div class="complaint-text-box">
                        <p>@Model.Description</p>
                    </div>
                </div>

                @if (Model.EvidenceUrls.Count > 0)
                {
                    <div class="complaint-section">
                        <p class="complaint-label">Evidence</p>
                        <ul class="complaint-evidence-list">
                            @foreach (var url in Model.EvidenceUrls)
                            {
                                <li>
                                    <a href="@url" target="_blank" rel="noopener">@url</a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.ResolutionNote))
                {
                    <div class="complaint-section">
                        <p class="complaint-label">Resolution note (buyer-facing)</p>
                        <div class="complaint-text-box complaint-text-box--resolution">
                            <p>@Model.ResolutionNote</p>
                        </div>
                    </div>
                }
            </section>

            @if (Model.OrderId.HasValue)
            {
                <section class="complaint-card">
                    <h3 class="complaint-card__title">Order</h3>
                    <dl class="complaint-order-grid">
                        <div>
                            <dt class="complaint-label">Order reference</dt>
                            <dd class="complaint-value">@(Model.OrderReference ?? "—")</dd>
                        </div>
                        <div>
                            <dt class="complaint-label">Status</dt>
                            <dd class="complaint-value capitalize">@(Model.OrderStatus ?? "—")</dd>
                        </div>
                        <div>
                            <dt class="complaint-label">Product</dt>
                            <dd class="complaint-value">@Model.ProductName</dd>
                        </div>
                        <div>
                            <dt class="complaint-label">Subtotal</dt>
                            <dd class="complaint-value">@(Model.OrderSubtotal.HasValue ? $"${Model.OrderSubtotal.Value:N2}" : "—")</dd>
                        </div>
                        <div>
                            <dt class="complaint-label">Total</dt>
                            <dd class="complaint-value complaint-value--strong">@(Model.OrderTotal.HasValue ? $"${Model.OrderTotal.Value:N2}" : "—")</dd>
                        </div>
                        <div>
                            <dt class="complaint-label">Payment method</dt>
                            <dd class="complaint-value">@(Model.PaymentMethod ?? "—")</dd>
                        </div>
                        <div>
                            <dt class="complaint-label">Paid at</dt>
                            <dd class="complaint-value">
                                @(Model.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")
                            </dd>
                        </div>
                    </dl>
                </section>
            }

            <section class="complaint-card">
                <h3 class="complaint-card__title">Parties</h3>
                <div class="complaint-parties">
                    <div class="complaint-party">
                        <p class="complaint-label">Buyer</p>
                        <p class="complaint-value">@Model.BuyerName</p>
                        <p class="complaint-value complaint-value--muted">@Model.BuyerEmail</p>
                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Details"
                           asp-route-id="@Model.BuyerId"
                           class="complaint-link">
                            View buyer
                            <partial name="_AdminIcon" model='"external"' />
                        </a>
                    </div>
                    @if (Model.SellerId.HasValue)
                    {
                        <div class="complaint-party">
                            <p class="complaint-label">Seller</p>
                            <p class="complaint-value">@Model.SellerName</p>
                            <p class="complaint-value complaint-value--muted">@Model.SellerEmail</p>
                            <a asp-area="Admin"
                               asp-controller="User"
                               asp-action="Details"
                               asp-route-id="@Model.SellerId"
                               class="complaint-link">
                                View seller
                                <partial name="_AdminIcon" model='"external"' />
                            </a>
                        </div>
                    }
                </div>
                @if (Model.AuctionId.HasValue)
                {
                    <a asp-area="Admin"
                       asp-controller="Auction"
                       asp-action="Details"
                       asp-route-id="@Model.AuctionId"
                       class="complaint-link complaint-link--md">
                        View auction #@Model.AuctionId
                        <partial name="_AdminIcon" model='"external"' />
                    </a>
                }
            </section>

            @if (Model.ReviewedAt.HasValue)
            {
                <section class="complaint-card">
                    <h3 class="complaint-card__title complaint-card__title--tight">Review</h3>
                    <p class="complaint-review-text">
                        Reviewed by @(Model.ReviewerName ?? "Admin") on @Model.ReviewedAt.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                    </p>
                </section>
            }
        </div>

        <aside class="complaint-detail-aside">
            <div class="complaint-aside-stack">
                <div class="complaint-card">
                    <h3 class="complaint-card__title complaint-card__title--xs">Admin notes</h3>
                    <p class="text-theme-xs text-gray-500">Internal notes — not visible to the buyer.</p>

                    @if (!string.IsNullOrWhiteSpace(Model.AdminNotes))
                    {
                        <div class="complaint-text-box complaint-text-box--sm">
                            <p>@Model.AdminNotes</p>
                        </div>
                    }

                    <form asp-action="UpdateStatus" method="post" class="complaint-form-stack">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="ComplaintId" value="@Model.Id" />
                        <input type="hidden" name="Action" value="@ComplaintStatusActions.AddNote" />
                        <textarea name="AdminNotes"
                                  rows="3"
                                  placeholder="Add internal note..."
                                  class="w-full rounded-lg border border-gray-300 px-3 py-2 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"></textarea>
                        <button type="submit" class="complaint-btn complaint-btn--primary">
                            <partial name="_AdminIcon" model='"save"' />
                            Save note
                        </button>
                    </form>
                </div>

                <div class="complaint-card">
                    <h3 class="complaint-card__title complaint-card__title--tight">Actions</h3>
                    <p class="text-theme-sm text-gray-500 dark:text-gray-400">
                        Update status and provide a resolution note when approving or rejecting.
                    </p>

                    @if (Model.CanMarkUnderReview)
                    {
                        <form asp-action="UpdateStatus" method="post" class="complaint-form-stack--flush">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <input type="hidden" name="Action" value="@ComplaintStatusActions.UnderReview" />
                            <button type="submit" class="complaint-btn complaint-btn--primary">
                                <partial name="_AdminIcon" model='"review"' />
                                Mark under review
                            </button>
                        </form>
                    }

                    @if (Model.CanApprove || Model.CanReject)
                    {
                        <form asp-action="UpdateStatus"
                              method="post"
                              class="complaint-form-stack"
                              id="complaintDecisionForm">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <label class="block text-theme-xs font-medium text-gray-500">Resolution note (required for approve/reject)</label>
                            <textarea id="resolutionNote"
                                      name="ResolutionNote"
                                      rows="4"
                                      class="w-full rounded-lg border border-gray-300 px-3 py-2 text-theme-sm dark:border-gray-700 dark:bg-gray-900 dark:text-white/90"
                                      placeholder="Explain the decision to the buyer..."></textarea>

                            @if (Model.CanApprove)
                            {
                                <button type="submit"
                                        name="Action"
                                        value="@ComplaintStatusActions.Approve"
                                        class="complaint-btn complaint-btn--approve">
                                    <partial name="_AdminIcon" model='"check"' />
                                    Approve
                                </button>
                            }

                            @if (Model.CanReject)
                            {
                                <button type="submit"
                                        name="Action"
                                        value="@ComplaintStatusActions.Reject"
                                        class="complaint-btn complaint-btn--reject">
                                    <partial name="_AdminIcon" model='"x-mark"' />
                                    Reject
                                </button>
                            }
                        </form>
                    }

                    @if (Model.CanClose)
                    {
                        <form asp-action="UpdateStatus" method="post" class="complaint-form-stack--flush"
                              data-confirm
                              data-confirm-variant="danger"
                              data-confirm-title="Close complaint?"
                              data-confirm-message="Close this complaint?"
                              data-confirm-confirm="Close">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="ComplaintId" value="@Model.Id" />
                            <input type="hidden" name="Action" value="@ComplaintStatusActions.Close" />
                            <button type="submit" class="complaint-btn complaint-btn--neutral">
                                <partial name="_AdminIcon" model='"x-mark"' />
                                Close complaint
                            </button>
                        </form>
                    }

                    @if (!Model.CanMarkUnderReview && !Model.CanApprove && !Model.CanReject && !Model.CanClose)
                    {
                        <p class="complaint-empty-actions">No further actions available for this complaint.</p>
                    }
                </div>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const form = document.getElementById('complaintDecisionForm');
            if (!form) {
                return;
            }

            form.addEventListener('submit', function (event) {
                if (form.dataset.confirmAccepted === '1') {
                    delete form.dataset.confirmAccepted;
                    return;
                }

                const submitter = event.submitter;
                const action = submitter?.value;
                if (action !== '@ComplaintStatusActions.Approve' && action !== '@ComplaintStatusActions.Reject') {
                    return;
                }

                const note = form.querySelector('[name="ResolutionNote"]')?.value?.trim() ?? '';
                if (note.length < 10) {
                    event.preventDefault();
                    alert('Resolution note must be at least 10 characters.');
                    return;
                }

                if (action !== '@ComplaintStatusActions.Approve') {
                    return;
                }

                event.preventDefault();
                const confirmFn = typeof window.showConfirmModal === 'function'
                    ? window.showConfirmModal
                    : function (options) {
                        return Promise.resolve(window.confirm(options.message || ''));
                    };

                confirmFn({
                    title: 'Approve refund?',
                    message: 'Approve this refund request?',
                    confirmText: 'Approve',
                    variant: 'default'
                }).then(function (confirmed) {
                    if (!confirmed) {
                        return;
                    }

                    form.dataset.confirmAccepted = '1';
                    if (typeof form.requestSubmit === 'function') {
                        form.requestSubmit(submitter || undefined);
                    } else {
                        HTMLFormElement.prototype.submit.call(form);
                    }
                });
            });
        })();
    </script>
}
