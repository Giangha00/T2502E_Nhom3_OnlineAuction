@model ComplaintListViewModel

@{
    var currentPage = Model.Filter.Page <= 0 ? 1 : Model.Filter.Page;
    var totalPages = Model.TotalPages <= 0 ? 1 : Model.TotalPages;
    var startPage = Math.Max(1, currentPage - 2);
    var endPage = Math.Min(totalPages, currentPage + 2);
}

<div class="complaint-list-panel">
    <div class="complaint-list-panel__header">
        <div>
            <h3>Case queue</h3>
            <p>Showing @Model.Items.Count of @Model.TotalItems complaints</p>
        </div>
        <span class="complaint-page-chip">Page @currentPage of @totalPages</span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="complaint-empty-state">
            <div class="complaint-empty-state__icon">
                <partial name="_AdminIcon" model='"review"' />
            </div>
            <p>No complaints found</p>
            <span>Try clearing filters or checking again after buyers submit new requests.</span>
        </div>
    }
    else
    {
        <div class="complaint-table-wrap">
            <table class="complaint-table">
                <thead>
                    <tr>
                        <th>Request</th>
                        <th>Buyer</th>
                        <th>Order</th>
                        <th>Reason</th>
                        <th>Amount</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th class="complaint-table__actions">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td data-label="Request">
                                <div class="complaint-request-cell">
                                    <span>@item.RequestReference</span>
                                    <small>@(string.IsNullOrWhiteSpace(item.ProductName) ? "No product name" : item.ProductName)</small>
                                </div>
                            </td>
                            <td data-label="Buyer">
                                <div class="complaint-person-cell">
                                    <span>@item.BuyerName</span>
                                    <small>@item.BuyerEmail</small>
                                </div>
                            </td>
                            <td data-label="Order">
                                <span class="complaint-muted-text">@(item.OrderReference ?? "Not linked")</span>
                            </td>
                            <td data-label="Reason">
                                <span class="complaint-reason-pill">@item.ReasonLabel</span>
                            </td>
                            <td data-label="Amount">
                                <span class="complaint-amount">
                                    @(item.RequestedAmount.HasValue ? $"${item.RequestedAmount.Value:N2}" : "Full refund")
                                </span>
                            </td>
                            <td data-label="Status">
                                <span class="inline-flex rounded-full border px-2.5 py-0.5 text-theme-xs font-medium @ComplaintDisplayHelper.GetStatusBadgeClass(item.Status)">
                                    @item.StatusLabel
                                </span>
                            </td>
                            <td data-label="Submitted">
                                <span class="complaint-muted-text">@item.SubmittedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </td>
                            <td data-label="Action" class="complaint-table__actions">
                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="complaint-action-button complaint-action-button--review complaint-action-button--compact"
                                   title="Review complaint"
                                   aria-label="Review complaint @item.RequestReference">
                                    <partial name="_AdminIcon" model='"review"' />
                                    <span>Review</span>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="complaint-pagination">
                <p>Showing @Model.Items.Count of @Model.TotalItems complaints</p>
                <div class="complaint-pagination__links">
                    @if (currentPage > 1)
                    {
                        <a asp-action="Index"
                           asp-all-route-data="@(new Dictionary<string, string?> {
                               ["Search"] = Model.Filter.Search,
                               ["Status"] = Model.Filter.Status,
                               ["ReasonCode"] = Model.Filter.ReasonCode,
                               ["ComplaintType"] = Model.Filter.ComplaintType,
                               ["DateRange"] = Model.Filter.DateRange,
                               ["SortOrder"] = Model.Filter.SortOrder,
                               ["Page"] = (currentPage - 1).ToString()
                           })"
                           class="js-admin-page complaint-page-button"
                           title="Previous page"
                           aria-label="Previous page">
                            <partial name="_AdminIcon" model='"chevron-left"' />
                        </a>
                    }

                    @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                    {
                        <a asp-action="Index"
                           asp-all-route-data="@(new Dictionary<string, string?> {
                               ["Search"] = Model.Filter.Search,
                               ["Status"] = Model.Filter.Status,
                               ["ReasonCode"] = Model.Filter.ReasonCode,
                               ["ComplaintType"] = Model.Filter.ComplaintType,
                               ["DateRange"] = Model.Filter.DateRange,
                               ["SortOrder"] = Model.Filter.SortOrder,
                               ["Page"] = pageNumber.ToString()
                           })"
                           class="js-admin-page complaint-page-number @(pageNumber == currentPage ? "is-active" : string.Empty)">
                            @pageNumber
                        </a>
                    }

                    @if (currentPage < totalPages)
                    {
                        <a asp-action="Index"
                           asp-all-route-data="@(new Dictionary<string, string?> {
                               ["Search"] = Model.Filter.Search,
                               ["Status"] = Model.Filter.Status,
                               ["ReasonCode"] = Model.Filter.ReasonCode,
                               ["ComplaintType"] = Model.Filter.ComplaintType,
                               ["DateRange"] = Model.Filter.DateRange,
                               ["SortOrder"] = Model.Filter.SortOrder,
                               ["Page"] = (currentPage + 1).ToString()
                           })"
                           class="js-admin-page complaint-page-button"
                           title="Next page"
                           aria-label="Next page">
                            <partial name="_AdminIcon" model='"chevron-right"' />
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>
