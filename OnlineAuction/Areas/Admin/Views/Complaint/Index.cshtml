@model ComplaintListViewModel

@{
    ViewData["Title"] = "Complaints";
    ViewData["AdminPage"] = "complaints";

    var activeFilterCount = new[]
    {
        Model.Filter.Search,
        Model.Filter.Status,
        Model.Filter.ReasonCode,
        Model.Filter.ComplaintType,
        Model.Filter.DateRange,
        Model.Filter.SortOrder
    }.Count(value => !string.IsNullOrWhiteSpace(value));

    var openOnPage = Model.Items.Count(item =>
        item.Status is ComplaintStatuses.Pending or ComplaintStatuses.UnderReview);
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.css" />
<link rel="stylesheet" href="~/admin/css/daterangepicker-admin.css" asp-append-version="true" />
<link rel="stylesheet" href="~/admin/css/admin-complaints.css" asp-append-version="true" />

<div class="complaint-page mx-auto max-w-(--breakpoint-2xl) p-4 md:p-6">
    <div class="complaint-hero">
        <div class="complaint-hero__copy">
            <span class="complaint-kicker">Admin casework</span>
            <h2>Complaints &amp; Refunds</h2>
            <p>Buyer dispute queue with refund, evidence, and order context in one place.</p>
        </div>
        <div class="complaint-hero__stats" aria-label="Complaint summary">
            <div>
                <span>Total results</span>
                <strong>@Model.TotalItems</strong>
            </div>
            <div>
                <span>Open on page</span>
                <strong>@openOnPage</strong>
            </div>
            <div>
                <span>Filters</span>
                <strong>@activeFilterCount</strong>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="complaint-alert complaint-alert--success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="complaint-alert complaint-alert--error">
            @TempData["ErrorMessage"]
        </div>
    }

    <section class="complaint-filter-panel" aria-label="Complaint filters">
        <div class="complaint-filter-panel__header">
            <div>
                <h3>Find cases</h3>
                <p>Search and narrow the queue by status, type, reason, and date.</p>
            </div>
            @if (activeFilterCount > 0)
            {
                <span class="complaint-filter-count">@activeFilterCount active</span>
            }
        </div>

        <form id="complaintFilterForm" method="get" class="complaint-filter-grid">
            <input type="hidden" name="Page" value="@(Model.Filter.Page <= 0 ? 1 : Model.Filter.Page)" />

            <div class="complaint-filter-field complaint-filter-field--search">
                <label for="complaintSearchInput">Search</label>
                <input id="complaintSearchInput"
                       name="Search"
                       value="@Model.Filter.Search"
                       placeholder="Request ID, order ref, buyer"
                       autocomplete="off" />
            </div>

            <div class="complaint-filter-field">
                <label for="complaintStatusFilter">Status</label>
                <select id="complaintStatusFilter" name="Status" class="admin-filter-control">
                    <option value="">All statuses</option>
                    @foreach (var status in ComplaintStatuses.All)
                    {
                        <option value="@status" selected="@(Model.Filter.Status == status)">@ComplaintDisplayHelper.GetStatusLabel(status)</option>
                    }
                </select>
            </div>

            <div class="complaint-filter-field">
                <label for="complaintTypeFilter">Type</label>
                <select id="complaintTypeFilter" name="ComplaintType" class="admin-filter-control">
                    <option value="">All types</option>
                    @foreach (var type in ComplaintTypes.All)
                    {
                        <option value="@type" selected="@(Model.Filter.ComplaintType == type)">@ComplaintDisplayHelper.GetTypeLabel(type)</option>
                    }
                </select>
            </div>

            <div class="complaint-filter-field complaint-filter-field--reason">
                <label for="complaintReasonFilter">Reason</label>
                <select id="complaintReasonFilter" name="ReasonCode" class="admin-filter-control">
                    <option value="">All reasons</option>
                    @foreach (var reason in ComplaintReasonCodes.Labels)
                    {
                        <option value="@reason.Key" selected="@(Model.Filter.ReasonCode == reason.Key)">@reason.Value</option>
                    }
                </select>
            </div>

            <div class="complaint-filter-field complaint-filter-field--date">
                <label>Date range</label>
                @{
                    ViewData["DateRangeId"] = "complaintDateRangePicker";
                    ViewData["DateRangeHiddenId"] = "complaintDateRangeValue";
                    ViewData["DateRangeName"] = "DateRange";
                    ViewData["DateRangeValue"] = Model.Filter.DateRange;
                    ViewData["DateRangePlaceholder"] = "Any date";
                }
                @await Html.PartialAsync("_DateRangeTrigger")
            </div>

            <div class="complaint-filter-field">
                <label for="complaintSortFilter">Sort</label>
                <select id="complaintSortFilter" name="SortOrder" class="admin-filter-control">
                    <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Filter.SortOrder))">Newest first</option>
                    <option value="date_asc" selected="@(Model.Filter.SortOrder == "date_asc")">Oldest first</option>
                </select>
            </div>

            <div class="complaint-filter-actions">
                <button type="submit" class="complaint-action-button complaint-action-button--primary">
                    <partial name="_AdminIcon" model='"apply"' />
                    <span>Apply</span>
                </button>
                <a asp-action="Index" class="complaint-action-button complaint-action-button--ghost">
                    <partial name="_AdminIcon" model='"x-mark"' />
                    <span>Clear</span>
                </a>
            </div>
        </form>
    </section>

    <div id="complaintListResults" class="transition-opacity duration-200">
        <partial name="_ComplaintList" model="Model" />
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/jquery/latest/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/momentjs/latest/moment.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/daterangepicker/daterangepicker.min.js"></script>
    <script src="~/admin/js/admin-list-filter.js" asp-append-version="true"></script>
    <script>
        AdminListFilter.init({
            formId: 'complaintFilterForm',
            resultsId: 'complaintListResults',
            searchInputId: 'complaintSearchInput',
            listUrl: '@Url.Action("Index", "Complaint", new { area = "Admin" })',
            setupDateRange: function (submitCallback) {
                AdminListFilter.setupDateRangePicker('#complaintDateRangePicker', submitCallback);
            }
        });
    </script>
}
