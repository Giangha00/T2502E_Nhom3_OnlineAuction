{
  "name": "onlineauction",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build:css": "tailwindcss -i ./wwwroot/css/app.css -o ./wwwroot/css/output.css --minify",
    "watch:css": "tailwindcss -i ./wwwroot/css/app.css -o ./wwwroot/css/output.css --watch",
    "postinstall": "npm run build:css"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "tailwindcss": "^4.3.0"
  }
  
}
