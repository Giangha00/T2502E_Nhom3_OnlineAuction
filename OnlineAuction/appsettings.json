{
  "DatabaseProvider": "MySql",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "server=localhost;port=3306;database=online_auction;user=root;password=;"
  },
  "SeedData": {
    "RefreshTestAuctionsOnStartup": false,
    "RefreshTestAuctionsInDevelopment": true
  },
  "CloudinarySettings": {
    "CloudName": "drzztxdrc",
    "ApiKey": "YOUR_CLOUDINARY_API_KEY",
    "ApiSecret": "YOUR_CLOUDINARY_API_SECRET"
  },
  "PayPal": {
    "ClientId": "YOUR_SANDBOX_CLIENT_ID",
    "ClientSecret": "YOUR_SANDBOX_CLIENT_SECRET",
    "Mode": "sandbox",
    "ReturnUrl": "http://localhost:5006/Payment/PayPalReturn",
    "CancelUrl": "http://localhost:5006/Payment/PayPalCancel",
    "CurrencyCode": "USD"
  },
  "FirebaseSettings": {
    "ProjectId": "YOUR_FIREBASE_PROJECT_ID",
    "ClientEmail": "firebase-adminsdk-xxxxx@YOUR_FIREBASE_PROJECT_ID.iam.gserviceaccount.com",
    "PrivateKey": "YOUR_FIREBASE_PRIVATE_KEY",
    "WebApiKey": "YOUR_WEB_API_KEY",
    "MessagingSenderId": "YOUR_MESSAGING_SENDER_ID",
    "AppId": "1:YOUR_MESSAGING_SENDER_ID:web:YOUR_APP_HASH",
    "VapidKey": "YOUR_WEB_PUSH_VAPID_KEY"
  },
  "PasswordResetOtp": {
    "CodeLength": 6,
    "ExpiryMinutes": 10,
    "MaxAttempts": 5,
    "ResendCooldownSeconds": 60,
    "MaxResendsPerHour": 3,
    "VerifiedSessionMinutes": 15,
    "UseMockOtpSender": false
  },
  "BidFraudDetection": {
    "Enabled": true,
    "RateLimitingEnabled": true,
    "MaxBidsPerMinutePerUser": 10,
    "MaxBidsPerMinutePerAuction": 30,
    "SameIpAccountThreshold": 2,
    "RapidBidWindowSeconds": 60,
    "RapidBidCountThreshold": 5,
    "CollusionRoundTripThreshold": 3,
    "AbnormalJumpPercent": 50,
    "NewAccountHoursThreshold": 24,
    "AntiSnipeThresholdMinutes": 5,
    "AntiSnipeExtensionMinutes": 5,
    "MaxAntiSnipeExtensions": 3,
    "MaxEndDateExtensionTotalMinutes": 15
  },
  "Email": {
    "Gmail": {
      "ClientId": "",
      "ClientSecret": "",
      "RefreshToken": "",
      "SenderEmail": "",
      "SenderName": "RareCard Auction House"
    }
  },
  "RabbitMq": {
    "Enabled": true,
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "guest",
    "Password": "guest",
    "VirtualHost": "/",
    "ExchangeName": "online-auction.direct",
    "PrefetchCount": 10
  },
  "PlatformFee": {
    "RegistrationDepositPercent": 10.0,
    "BuyerCheckoutFeePercent": 2.5,
    "SellerSuccessFeePercent": 10.0,
    "MinimumRegistrationDeposit": 1.0
  }
