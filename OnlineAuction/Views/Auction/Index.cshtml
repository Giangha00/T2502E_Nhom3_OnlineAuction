@model OnlineAuction.Models.AuctionViewModel
@{
    ViewData["Title"] = "Auctions";
    var totalCount = Model.Auctions.Count;
}

<section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8 lg:py-12">
    <div class="mb-8">
        <p class="text-sm font-semibold uppercase tracking-widest text-amber-700">Browse &amp; Bid</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl">Live Auctions</h1>
        <p class="mt-3 max-w-2xl text-stone-600">
            Browse cars, watches, cards, billiard sticks, and jewelry. Filter by category or search by product name.
        </p>
    </div>

    <div class="mb-6 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <form id="auctionSearchForm" class="relative w-full lg:max-w-md" role="search">
            <input id="auctionSearch" type="search" placeholder="Search auctions..." aria-label="Search auctions"
                   class="w-full rounded-full border border-stone-200 bg-white/80 py-2.5 pl-4 pr-12 text-sm text-stone-700 outline-none transition focus:border-amber-500 focus:ring-4 focus:ring-amber-100"/>
            <button type="submit" aria-label="Search"
                    class="absolute right-1 top-1/2 -translate-y-1/2 rounded-full p-2 text-stone-500 hover:text-amber-700">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"/>
                    <path d="m21 21-4.3-4.3"/>
                </svg>
            </button>
        </form>

        <div class="flex items-center gap-3">
            <label for="auctionSort" class="text-sm font-medium text-stone-600">Sort by</label>
            <select id="auctionSort"
                    class="rounded-xl border border-stone-200 bg-white/80 px-3 py-2 text-sm text-stone-700 outline-none focus:border-amber-500 focus:ring-4 focus:ring-amber-100">
                <option value="ending">Ending Soon</option>
                <option value="price-asc">Price: Low to High</option>
                <option value="price-desc">Price: High to Low</option>
                <option value="name">Name A–Z</option>
            </select>
        </div>
    </div>

    <div class="mb-8 flex flex-wrap gap-2" id="categoryFilters">
        <button type="button" data-category="All"
                class="category-btn rounded-full bg-amber-700 px-4 py-1.5 text-sm font-medium text-white">
            All (@totalCount)
        </button>
        @foreach (var category in Model.Categories)
        {
            <button type="button" data-category="@category.Name"
                    class="category-btn rounded-full border border-stone-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-stone-700 transition hover:border-amber-500 hover:text-amber-700">
                @category.Name (@category.ItemCount)
            </button>
        }
    </div>

    <p id="resultCount" class="mb-4 text-sm text-stone-500">Showing @totalCount auctions</p>

    <div id="auctionGrid" class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5">
        @foreach (var item in Model.Auctions)
        {
            <article class="auction-card group overflow-hidden rounded-xl border border-stone-200 bg-white/80 shadow-sm transition hover:shadow-lg"
                     data-name="@item.Name.ToLowerInvariant()"
                     data-category="@item.Category"
                     data-price="@item.CurrentPrice"
                     data-time="@item.TimeRemaining">
                <div class="relative h-32 overflow-hidden sm:h-36">
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy"
                         class="h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
                    <span class="absolute left-2 top-2 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white @(item.Status == "Ending Soon" ? "bg-orange-600" : "bg-amber-700")">
                        @item.Status
                    </span>
                </div>
                <div class="p-3">
                    <p class="text-[10px] font-semibold uppercase tracking-widest text-stone-400">@item.Category</p>
                    <h2 class="mt-1 line-clamp-2 text-sm font-semibold leading-snug text-stone-900">@item.Name</h2>
                    <div class="mt-2 flex gap-4">
                        <div>
                            <p class="text-[10px] uppercase tracking-wide text-stone-400">Starting</p>
                            <p class="mt-0.5 text-xs font-semibold text-stone-700">$@item.StartingPrice.ToString("N0")</p>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase tracking-wide text-stone-400">Current</p>
                            <p class="mt-0.5 text-xs font-semibold text-amber-700">$@item.CurrentPrice.ToString("N0")</p>
                        </div>
                    </div>
                    <div class="mt-2 flex items-center gap-1 text-xs text-stone-500">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"/>
                            <path d="M12 6v6l4 2"/>
                        </svg>
                        @item.TimeRemaining
                    </div>
                    <a href="#"
                       class="mt-3 block w-full rounded-lg border border-amber-700 py-1.5 text-center text-xs font-semibold text-amber-700 transition hover:bg-amber-700 hover:text-white">
                        View Detail
                    </a>
                </div>
            </article>
        }
    </div>

    <div id="emptyState" class="hidden rounded-2xl border border-dashed border-stone-300 bg-white/60 py-16 text-center">
        <p class="text-lg font-semibold text-stone-800">No auctions found</p>
        <p class="mt-2 text-sm text-stone-500">Try a different search term or category.</p>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var searchInput = document.getElementById('auctionSearch');
            var searchForm = document.getElementById('auctionSearchForm');
            var sortSelect = document.getElementById('auctionSort');
            var grid = document.getElementById('auctionGrid');
            var emptyState = document.getElementById('emptyState');
            var resultCount = document.getElementById('resultCount');
            var categoryButtons = document.querySelectorAll('.category-btn');
            var cards = Array.from(document.querySelectorAll('.auction-card'));

            var activeCategory = 'All';

            function parseTimeRemaining(value) {
                var match = value.match(/(\d+)\s*h/i);
                if (match) return parseInt(match[1], 10);
                var minuteMatch = value.match(/(\d+)\s*m/i);
                if (minuteMatch) return parseInt(minuteMatch[1], 10) / 60;
                var dayMatch = value.match(/(\d+)\s*d/i);
                if (dayMatch) return parseInt(dayMatch[1], 10) * 24;
                return 999;
            }

            function sortCards(list) {
                var sort = sortSelect.value;
                return list.sort(function (a, b) {
                    if (sort === 'price-asc') {
                        return Number(a.dataset.price) - Number(b.dataset.price);
                    }
                    if (sort === 'price-desc') {
                        return Number(b.dataset.price) - Number(a.dataset.price);
                    }
                    if (sort === 'name') {
                        return a.dataset.name.localeCompare(b.dataset.name);
                    }
                    return parseTimeRemaining(a.dataset.time) - parseTimeRemaining(b.dataset.time);
                });
            }

            function updateCategoryStyles() {
                categoryButtons.forEach(function (btn) {
                    var isActive = btn.dataset.category === activeCategory;
                    btn.className = isActive
                        ? 'category-btn rounded-full bg-amber-700 px-4 py-1.5 text-sm font-medium text-white'
                        : 'category-btn rounded-full border border-stone-200 bg-white/80 px-4 py-1.5 text-sm font-medium text-stone-700 transition hover:border-amber-500 hover:text-amber-700';
                });
            }

            function applyFilters() {
                var query = searchInput.value.trim().toLowerCase();
                var visible = cards.filter(function (card) {
                    var matchesCategory = activeCategory === 'All' || card.dataset.category === activeCategory;
                    var matchesSearch = !query || card.dataset.name.includes(query);
                    return matchesCategory && matchesSearch;
                });

                sortCards(visible).forEach(function (card) {
                    grid.appendChild(card);
                });

                cards.forEach(function (card) {
                    var isVisible = visible.includes(card);
                    card.classList.toggle('hidden', !isVisible);
                });

                resultCount.textContent = 'Showing ' + visible.length + ' auction' + (visible.length === 1 ? '' : 's');
                emptyState.classList.toggle('hidden', visible.length > 0);
                grid.classList.toggle('hidden', visible.length === 0);
            }

            categoryButtons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activeCategory = btn.dataset.category;
                    updateCategoryStyles();
                    applyFilters();
                });
            });

            searchInput.addEventListener('input', applyFilters);
            searchForm.addEventListener('submit', function (e) {
                e.preventDefault();
                applyFilters();
            });
            sortSelect.addEventListener('change', applyFilters);

            applyFilters();
        })();
    </script>
}
