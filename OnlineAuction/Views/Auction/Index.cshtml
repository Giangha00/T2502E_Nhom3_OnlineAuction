@model OnlineAuction.Models.AuctionViewModel
@using OnlineAuction.Helpers
@{
    ViewData["Title"] = Localizer["Auction_PageTitle"];
    var totalCount = Model.Auctions.Count;
    var endingCount = Model.Auctions.Count(a => a.ListingPhase == AuctionListingPhases.LiveEndingSoon);
    var liveAuctionCount = Model.Auctions.Count(a => a.ListingPhase == AuctionListingPhases.LiveAuction);
    var registrationOpenCount = Model.Auctions.Count(a => a.ListingPhase == AuctionListingPhases.RegistrationOpen);
}

<div class="rarecard-page bg-white" data-e2e-page="auction-index">
  <section class="border-b border-stone-200 px-4 py-10 sm:px-8 lg:px-12 lg:py-12">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <h1 class="text-3xl font-bold text-slate-900 sm:text-4xl lg:text-5xl">@Localizer["Auction_PageTitle"]</h1>
        <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base">
          @Localizer["Auction_Subtitle"]
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-3">
        <span class="inline-flex items-center gap-2 rounded-full bg-sky-50 px-4 py-2 text-xs font-semibold text-sky-800">
          <span class="h-2 w-2 rounded-full bg-sky-600"></span>
          @Localizer["Auction_Phase_registration_open"]: @registrationOpenCount
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-emerald-50 px-4 py-2 text-xs font-semibold text-emerald-800">
          <span class="h-2 w-2 rounded-full bg-emerald-600"></span>
          @Localizer["Auction_Phase_live_auction"]: @liveAuctionCount
        </span>
        <span class="inline-flex items-center gap-2 rounded-full bg-red-50 px-4 py-2 text-xs font-semibold text-red-800">
          <span class="h-2 w-2 rounded-full bg-red-600"></span>
          @Localizer["Auction_Phase_live_ending_soon"]: @endingCount
        </span>
        <a asp-controller="Account" asp-action="Watchlist" data-watchlist-count
           class="rounded-full border border-stone-300 px-4 py-2 text-xs font-semibold text-slate-700 transition hover:border-blue-300 hover:text-blue-800">
          @Localizer["Auction_WatchlistCount", 0]
        </a>
      </div>
    </div>
  </section>

  <div class="flex w-full flex-col lg:flex-row">
    <aside class="rarecard-sidebar shrink-0 border-b border-stone-200 bg-slate-50 px-4 py-6 sm:px-8 lg:w-72 lg:border-b-0 lg:border-r lg:px-6 xl:w-80">
      <form id="auctionFilterForm" class="space-y-6">
        <div class="border-b border-stone-200 pb-6">
          <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">@Localizer["Auction_Filter_Category"]</h3>
          <div class="mt-3 space-y-2">
            @foreach (var category in Model.Categories)
            {
              <label class="flex cursor-pointer items-center gap-2 text-sm text-slate-700">
                <input type="checkbox" name="category" value="@category.Name" class="filter-category rounded border-stone-300 text-blue-700 focus:ring-blue-600"/>
                @category.Name
              </label>
            }
          </div>
        </div>

        @{
          ViewData["RangeTitle"] = "Year";
          ViewData["RangeKey"] = "Year";
        }
        @await Html.PartialAsync("Partials/_MinMaxRangeFilter")

        @await Html.PartialAsync("Partials/_AuthenticatorFilter")

        @{
          ViewData["RangeTitle"] = "Grade";
          ViewData["RangeKey"] = "Grade";
        }
        @await Html.PartialAsync("Partials/_MinMaxRangeFilter")

        @{
          ViewData["RangeTitle"] = Localizer["Auction_Filter_PriceRange"].Value;
          ViewData["RangeKey"] = "Price";
        }
        @await Html.PartialAsync("Partials/_MinMaxRangeFilter")

        <div class="flex items-center justify-between rounded-xl border border-stone-200 bg-white px-4 py-3">
          <span class="text-sm font-medium text-slate-800">@Localizer["Auction_Filter_EndingSoonOnly"]</span>
          <label class="relative inline-flex cursor-pointer items-center">
            <input type="checkbox" id="filterEndingSoon" class="peer sr-only"/>
            <span class="h-6 w-11 rounded-full bg-stone-300 transition peer-checked:bg-blue-700 after:absolute after:left-[2px] after:top-[2px] after:h-5 after:w-5 after:rounded-full after:bg-white after:transition peer-checked:after:translate-x-full"></span>
          </label>
        </div>

        <button type="button" id="clearFilters" class="w-full rounded-full border border-stone-300 py-2 text-xs font-semibold uppercase tracking-wider text-slate-600 hover:bg-white">
          @Localizer["Auction_ClearFilters"]
        </button>
      </form>
    </aside>

    <section class="min-w-0 flex-1 px-4 py-6 sm:px-8 lg:px-10 lg:py-8">
      <div class="mb-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p id="resultCount" class="text-sm text-slate-500">@Localizer["Auction_ShowingItems", totalCount]</p>
        <div class="flex items-center gap-3">
          <label for="auctionSearch" class="sr-only">@Localizer["Common_Search"]</label>
          <input id="auctionSearch" type="search" placeholder="@Localizer["Common_Search"]..."
                 class="w-full rounded-full border border-stone-200 bg-stone-50 px-4 py-2.5 text-sm outline-none focus:border-blue-600 sm:max-w-xs"/>
          <select id="auctionSort" class="rounded-full border border-stone-200 bg-white px-3 py-2 text-sm outline-none focus:border-blue-600">
            <option value="default">@Localizer["Auction_Sort_Featured"]</option>
            <option value="ending">@Localizer["Auction_Sort_EndingSoon"]</option>
            <option value="price-asc">@Localizer["Auction_Sort_PriceAsc"]</option>
            <option value="price-desc">@Localizer["Auction_Sort_PriceDesc"]</option>
            <option value="name">@Localizer["Auction_Sort_Name"]</option>
          </select>
        </div>
      </div>

      <div id="auctionGrid" class="rarecard-auction-grid">
        @foreach (var item in Model.Auctions)
        {
          <partial name="Partials/_TradingCardAuctionCard"
                   model="@(new AuctionCardViewModel { Item = item, EnableFiltering = true, Variant = "grid", ShowWatchlistButton = true })"/>
        }
      </div>

      <div id="emptyState" class="hidden rounded-2xl border border-dashed border-stone-300 py-20 text-center">
        <p class="text-xl font-bold text-slate-800">@Localizer["Catalog_NoCardsFound"]</p>
        <p class="mt-2 text-sm text-slate-500">@Localizer["Catalog_TryAdjustFilters"]</p>
      </div>

      <div id="pagination" class="mt-12 flex flex-col items-center gap-4 border-t border-stone-200 pt-10 sm:flex-row sm:justify-center sm:gap-8">
        <button type="button" id="prevPage" class="text-sm font-semibold text-slate-600 hover:text-slate-900 disabled:opacity-30" disabled>@Localizer["Catalog_Previous"]</button>
        <div id="pageNumbers" class="flex flex-wrap items-center justify-center gap-1"></div>
        <button type="button" id="nextPage" class="text-sm font-semibold text-slate-600 hover:text-slate-900 disabled:opacity-30">@Localizer["Catalog_Next"]</button>
      </div>
    </section>
  </div>
</div>

@section Scripts {
  <script>
    (function () {
      var PAGE_SIZE = 12;
      var grid = document.getElementById('auctionGrid');
      var emptyState = document.getElementById('emptyState');
      var pagination = document.getElementById('pagination');
      var resultCount = document.getElementById('resultCount');
      var pageNumbers = document.getElementById('pageNumbers');
      var prevPageBtn = document.getElementById('prevPage');
      var nextPageBtn = document.getElementById('nextPage');
      var searchInput = document.getElementById('auctionSearch');
      var sortSelect = document.getElementById('auctionSort');
      var endingSoonToggle = document.getElementById('filterEndingSoon');
      var clearBtn = document.getElementById('clearFilters');
      var yearMinInput = document.getElementById('filterYearMin');
      var yearMaxInput = document.getElementById('filterYearMax');
      var gradeMinInput = document.getElementById('filterGradeMin');
      var gradeMaxInput = document.getElementById('filterGradeMax');
      var priceMinInput = document.getElementById('filterPriceMin');
      var priceMaxInput = document.getElementById('filterPriceMax');
      var cards = Array.from(document.querySelectorAll('.auction-card'));

      var currentPage = 1;
      var filteredCards = [];

      function parseTimeRemaining(value) {
        var dayMatch = value.match(/(\d+)\s*d/i);
        if (dayMatch) return parseInt(dayMatch[1], 10) * 24;
        var hourMatch = value.match(/(\d+)\s*h/i);
        if (hourMatch) return parseInt(hourMatch[1], 10);
        var minuteMatch = value.match(/(\d+)\s*m/i);
        if (minuteMatch) return parseInt(minuteMatch[1], 10) / 60;
        return 999;
      }

      function getCheckedValues(selector) {
        return Array.from(document.querySelectorAll(selector + ':checked')).map(function (el) { return el; });
      }

      function matchesInputRange(value, minInput, maxInput) {
        var hasMin = minInput && minInput.value.trim() !== '';
        var hasMax = maxInput && maxInput.value.trim() !== '';
        if (!hasMin && !hasMax) return true;
        var num = Number(value);
        if (!value || isNaN(num)) return false;
        if (hasMin && num < Number(minInput.value)) return false;
        if (hasMax && num > Number(maxInput.value)) return false;
        return true;
      }

      function sortCards(list) {
        var sort = sortSelect.value;
        return list.sort(function (a, b) {
          if (sort === 'default') return Number(b.dataset.id) - Number(a.dataset.id);
          if (sort === 'price-asc') return Number(a.dataset.price) - Number(b.dataset.price);
          if (sort === 'price-desc') return Number(b.dataset.price) - Number(a.dataset.price);
          if (sort === 'name') return a.dataset.name.localeCompare(b.dataset.name);
          return parseTimeRemaining(a.dataset.time) - parseTimeRemaining(b.dataset.time);
        });
      }

      function renderPageNumbers(totalPages) {
        pageNumbers.innerHTML = '';
        var maxVisible = 5;
        var start = Math.max(1, currentPage - 2);
        var end = Math.min(totalPages, start + maxVisible - 1);
        if (end - start < maxVisible - 1) start = Math.max(1, end - maxVisible + 1);

        for (var i = start; i <= end; i++) {
          var btn = document.createElement('button');
          btn.type = 'button';
          btn.textContent = String(i);
          btn.className = 'mx-0.5 flex h-9 w-9 items-center justify-center rounded-full text-sm font-semibold ' +
            (i === currentPage ? 'bg-blue-700 text-white' : 'text-slate-600 hover:bg-stone-100');
          btn.addEventListener('click', (function (page) {
            return function () { currentPage = page; renderPage(); grid.scrollIntoView({ behavior: 'smooth', block: 'start' }); };
          })(i));
          pageNumbers.appendChild(btn);
        }
      }

      function renderPage() {
        var totalPages = Math.max(1, Math.ceil(filteredCards.length / PAGE_SIZE));
        if (currentPage > totalPages) currentPage = totalPages;
        if (currentPage < 1) currentPage = 1;

        var start = (currentPage - 1) * PAGE_SIZE;
        var end = start + PAGE_SIZE;
        var pageCards = filteredCards.slice(start, end);

        filteredCards.forEach(function (card) { grid.appendChild(card); });

        cards.forEach(function (card) {
          var inFilter = filteredCards.includes(card);
          var onPage = pageCards.includes(card);
          card.classList.toggle('hidden', !inFilter || !onPage);
        });

        var total = filteredCards.length;
        resultCount.textContent = total === 0 ? 'Showing 0 items' : 'Showing ' + (start + 1) + '–' + Math.min(end, total) + ' of ' + total + ' items';

        prevPageBtn.disabled = currentPage <= 1;
        nextPageBtn.disabled = currentPage >= totalPages;
        renderPageNumbers(totalPages);

        var hasResults = total > 0;
        emptyState.classList.toggle('hidden', hasResults);
        grid.classList.toggle('hidden', !hasResults);
        pagination.classList.toggle('hidden', !hasResults || totalPages <= 1);
      }

      function normalizeCategory(value) {
        return decodeURIComponent(String(value || ''))
          .toLowerCase()
          .normalize('NFD')
          .replace(/[\u0300-\u036f]/g, '')
          .replace(/[^a-z0-9]+/g, '');
      }

      function applyFilters() {
        var query = searchInput.value.trim().toLowerCase();
        var categories = getCheckedValues('.filter-category').map(function (el) { return el.value; });
        var authenticators = getCheckedValues('.filter-authenticator').map(function (el) { return el.value; });
        var endingOnly = endingSoonToggle.checked;

        filteredCards = cards.filter(function (card) {
          if (query && !card.dataset.name.includes(query)) return false;
          if (categories.length && categories.indexOf(card.dataset.category) === -1) return false;
          if (authenticators.length && authenticators.indexOf(card.dataset.authenticator) === -1) return false;
          if (!matchesInputRange(card.dataset.year, yearMinInput, yearMaxInput)) return false;
          if (!matchesInputRange(card.dataset.grade, gradeMinInput, gradeMaxInput)) return false;
          if (!matchesInputRange(card.dataset.price, priceMinInput, priceMaxInput)) return false;
          if (endingOnly && card.dataset.endingSoon !== 'true') return false;
          return true;
        });

        sortCards(filteredCards);
        currentPage = 1;
        renderPage();
      }

      document.querySelectorAll('.filter-category, .filter-authenticator').forEach(function (el) {
        el.addEventListener('change', applyFilters);
      });
      document.getElementById('filterYearApply').addEventListener('click', applyFilters);
      document.getElementById('filterGradeApply').addEventListener('click', applyFilters);
      document.getElementById('filterPriceApply').addEventListener('click', applyFilters);
      [yearMinInput, yearMaxInput, gradeMinInput, gradeMaxInput, priceMinInput, priceMaxInput].forEach(function (input) {
        input.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            applyFilters();
          }
        });
      });
      endingSoonToggle.addEventListener('change', applyFilters);
      searchInput.addEventListener('input', applyFilters);
      sortSelect.addEventListener('change', applyFilters);

      clearBtn.addEventListener('click', function () {
        document.querySelectorAll('.filter-category, .filter-authenticator').forEach(function (el) { el.checked = false; });
        yearMinInput.value = '';
        yearMaxInput.value = '';
        gradeMinInput.value = '';
        gradeMaxInput.value = '';
        priceMinInput.value = '';
        priceMaxInput.value = '';
        endingSoonToggle.checked = false;
        searchInput.value = '';
        applyFilters();
      });

      prevPageBtn.addEventListener('click', function () {
        if (currentPage > 1) { currentPage--; renderPage(); grid.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      });
      nextPageBtn.addEventListener('click', function () {
        var totalPages = Math.ceil(filteredCards.length / PAGE_SIZE);
        if (currentPage < totalPages) { currentPage++; renderPage(); grid.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
      });

      if (window.location.hash.startsWith('#category-')) {
        var hashSlug = normalizeCategory(window.location.hash.slice('#category-'.length));
        document.querySelectorAll('.filter-category').forEach(function (el) {
          if (normalizeCategory(el.value) === hashSlug) {
            el.checked = true;
          }
        });
      }

      applyFilters();
    })();
  </script>
  <script src="~/js/watchlist.js" asp-append-version="true"></script>
}
