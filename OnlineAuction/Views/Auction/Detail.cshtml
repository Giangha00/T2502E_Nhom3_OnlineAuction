@using System.Text.Json
@using OnlineAuction.Helpers
@model OnlineAuction.Models.ProductDetailViewModel
@{
    var productDetailI18n = new Dictionary<string, string>
    {
        ["placingBid"] = Localizer["Js_ProductDetail_PlacingBid"].Value,
        ["bid"] = Localizer["Product_Bid"].Value,
        ["bidFailed"] = Localizer["Js_ProductDetail_BidFailed"].Value,
        ["bidSuccess"] = Localizer["Js_ProductDetail_BidSuccess"].Value,
        ["auctionEnded"] = Localizer["Js_ProductDetail_AuctionEnded"].Value,
        ["winning"] = Localizer["Product_Winning"].Value,
        ["raised"] = Localizer["Product_Raised"].Value,
        ["outbid"] = Localizer["Product_Outbid"].Value,
        ["noBidsYet"] = Localizer["Product_NoBidsYet"].Value,
        ["bidsCount"] = Localizer["Product_BidsCount", 0].Value.Replace("0", "{0}"),
        ["registeredCount"] = Localizer["Product_RegisteredCount", 0].Value.Replace("0", "{0}"),
        ["registerForAuction"] = Localizer["Product_RegisterForAuction"].Value,
        ["registering"] = Localizer["Js_ProductDetail_Registering"].Value,
        ["registrationSuccess"] = Localizer["Js_ProductDetail_RegistrationSuccess"].Value,
        ["registrationFailed"] = Localizer["Js_ProductDetail_RegistrationFailed"].Value,
        ["registrationCancelled"] = Localizer["Js_ProductDetail_RegistrationCancelled"].Value,
        ["cancelRegistrationFailed"] = Localizer["Js_ProductDetail_CancelRegistrationFailed"].Value,
        ["mustRegisterToBid"] = Localizer["Product_MustRegisterToBid"].Value
    };
}

<div class="rarecard-page bg-white">
  <div class="w-full px-4 py-8 sm:px-8 lg:px-12 lg:py-10">
    @await Html.PartialAsync("Partials/_Breadcrumb", Model)

    <div class="product-detail-hero">
      <div class="product-detail-hero__media">
        @await Html.PartialAsync("Partials/_ProductGallery", Model)
        @await Html.PartialAsync("Partials/_ProductDetailTabs", Model)
      </div>
      <div class="product-detail-hero__info sticky-below-header">
        @await Html.PartialAsync("Partials/_ProductBidPanel", Model)
      </div>
    </div>

    @await Html.PartialAsync("Partials/_RelatedProducts", Model)
  </div>
</div>

@section Scripts {
  <script>
    window.productDetailConfig = {
      auctionId: @Model.Id,
      bidStep: @Model.BidStep.ToString(System.Globalization.CultureInfo.InvariantCulture),
      endDate: @Html.Raw(JsonSerializer.Serialize(DateTimeUtilities.ToUtcIsoString(Model.EndDate))),
      canBid: @(Model.CanBid ? "true" : "false"),
      requiresRegistration: @(Model.RequiresRegistration ? "true" : "false"),
      i18n: @Html.Raw(JsonSerializer.Serialize(productDetailI18n))
    };
  </script>
  <script src="~/js/product-detail.js" asp-append-version="true"></script>
}
