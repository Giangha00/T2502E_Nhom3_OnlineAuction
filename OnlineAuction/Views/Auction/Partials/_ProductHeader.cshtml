@model OnlineAuction.Models.ProductDetailViewModel

<div class="mb-8">
  <div class="flex flex-wrap items-center gap-3">
    <span class="rounded-full @Model.StatusBadgeClass px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
      @Model.AuctionStatus
    </span>
    <span class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold uppercase tracking-widest text-amber-800">
      @Model.Category
    </span>
  </div>
  <h1 class="mt-4 text-3xl font-bold tracking-tight text-stone-900 sm:text-4xl lg:text-5xl">@Model.Name</h1>
  <p class="mt-3 max-w-3xl text-lg text-stone-600">@Model.ShortDescription</p>
</div>
