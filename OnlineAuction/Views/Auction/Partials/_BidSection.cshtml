@model OnlineAuction.Models.ProductDetailViewModel
@{
    var minBid = Model.CurrentPrice + Model.BidStep;
}

<div id="bidSection" class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
  <div class="border-b border-stone-100 px-5 py-4">
    <h2 class="text-lg font-semibold text-stone-900">@Localizer["Product_PlaceBidTitle"]</h2>
  </div>
  <div class="space-y-4 p-5">
    <div>
      <label for="bidAmount" class="mb-2 block text-sm font-medium text-stone-700">@Localizer["Product_BidAmountLabel"]</label>
      <div class="flex items-stretch overflow-hidden rounded-xl border border-stone-200 bg-stone-50 focus-within:border-amber-500 focus-within:bg-white focus-within:ring-4 focus-within:ring-amber-100">
        <button type="button"
                id="bidAmountDecrease"
                class="flex w-11 shrink-0 items-center justify-center border-r border-stone-200 text-lg font-semibold text-stone-600 transition hover:bg-stone-100 disabled:cursor-not-allowed disabled:text-stone-300"
                aria-label="@Localizer["Product_DecreaseBid"]"
                @(Model.CanPlaceBid ? null : "disabled")>
          −
        </button>
        <div class="relative min-w-0 flex-1">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm font-medium text-stone-500">$</span>
          <input type="text"
                 inputmode="numeric"
                 id="bidAmount"
                 name="bidAmount"
                 value="@minBid.ToString("0.##")"
                 autocomplete="off"
                 class="w-full border-0 bg-transparent py-3.5 pl-7 pr-3 text-center text-sm font-semibold tabular-nums text-stone-800 outline-none"
                 @(Model.CanPlaceBid ? null : "disabled") />
        </div>
        <button type="button"
                id="bidAmountIncrease"
                class="flex w-11 shrink-0 items-center justify-center border-l border-stone-200 text-lg font-semibold text-stone-600 transition hover:bg-stone-100 disabled:cursor-not-allowed disabled:text-stone-300"
                aria-label="@Localizer["Product_IncreaseBid"]"
                @(Model.CanPlaceBid ? null : "disabled")>
          +
        </button>
      </div>
      <p class="mt-2 text-xs text-stone-400">
        @Localizer["Product_MinBid"] <span class="font-semibold text-stone-600">$@minBid.ToString("N0")</span>
        · @Localizer["Product_Step"] <span class="font-semibold text-stone-600">$@Model.BidStep.ToString("N0")</span>
      </p>
    </div>
    <button type="button"
            class="flex w-full items-center justify-center gap-2 rounded-xl bg-amber-700 py-3.5 text-sm font-bold text-white shadow-lg shadow-amber-700/25 transition hover:bg-amber-800 disabled:cursor-not-allowed disabled:bg-stone-400"
            @(Model.CanPlaceBid ? null : "disabled")>
      <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.362 5.214A8.252 8.252 0 0 1 12 21.75a8.25 8.25 0 0 1-6.037-13.84M12 21.75V3"/>
      </svg>
      @(Model.CanPlaceBid ? Localizer["Product_Bid"].Value : Localizer["Product_AuctionEnded"].Value)
    </button>
  </div>
</div>
