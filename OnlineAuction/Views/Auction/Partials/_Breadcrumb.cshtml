@model OnlineAuction.Models.ProductDetailViewModel

<nav aria-label="Breadcrumb" class="mb-8">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-500">
    <li><a asp-controller="Home" asp-action="Index" class="transition hover:text-blue-700">@Localizer["Common_Breadcrumb_Home"]</a></li>
    <li aria-hidden="true" class="text-slate-300">›</li>
    <li><a asp-controller="Auction" asp-action="Index" class="transition hover:text-blue-700">@Localizer["Auction"]</a></li>
    <li aria-hidden="true" class="text-slate-300">›</li>
    <li><a asp-controller="Auction" asp-action="Index" asp-fragment="category-@CategorySlug.ToSlug(Model.Category)" class="transition hover:text-blue-700">@Model.Category</a></li>
    <li aria-hidden="true" class="text-slate-300">›</li>
    <li class="font-medium text-slate-900" aria-current="page">@Model.Name</li>
  </ol>
</nav>
