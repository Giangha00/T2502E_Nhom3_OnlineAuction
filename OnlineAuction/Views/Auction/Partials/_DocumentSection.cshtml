@model OnlineAuction.Models.ProductDetailViewModel

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-blue-50/50 px-6 py-4">
    <h2 class="text-lg font-semibold text-slate-900">@Localizer["Product_Documents_Title"]</h2>
    <p class="mt-1 text-sm text-slate-500">@Localizer["Product_Documents_Desc"]</p>
  </div>
  <ul class="divide-y divide-slate-100">
    @foreach (var doc in Model.Documents)
    {
      <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-lg">📄</span>
          <div class="min-w-0">
            <p class="font-semibold text-slate-900">@doc.Name</p>
            <p class="truncate text-sm text-slate-500">@doc.FileType</p>
          </div>
        </div>
        <div class="flex gap-2 sm:shrink-0">
          <a href="@doc.FileUrl" target="_blank" rel="noopener noreferrer"
             class="rounded-lg border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">@Localizer["Common_View"]</a>
          <a href="@doc.FileUrl" download
             class="rounded-lg bg-blue-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-blue-800">@Localizer["Common_Download"]</a>
        </div>
      </li>
    }
  </ul>
</div>
