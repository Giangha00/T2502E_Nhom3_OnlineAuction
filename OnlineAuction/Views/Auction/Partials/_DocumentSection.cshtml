@model OnlineAuction.Models.ProductDetailViewModel

<div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
  <div class="border-b border-stone-100 bg-gradient-to-r from-stone-50 to-amber-50/50 px-6 py-4">
    <h2 class="text-lg font-semibold text-stone-900">Product Documents</h2>
    <p class="mt-1 text-sm text-stone-500">Certificates, warranty, and verification files</p>
  </div>
  <ul class="divide-y divide-stone-100">
    @foreach (var doc in Model.Documents)
    {
      <li class="flex flex-col gap-3 px-6 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex min-w-0 items-center gap-3">
          <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-red-50 text-lg">📄</span>
          <div class="min-w-0">
            <p class="font-semibold text-stone-900">@doc.Name</p>
            <p class="truncate text-sm text-stone-500">@doc.FileName</p>
          </div>
        </div>
        <div class="flex gap-2 sm:shrink-0">
          <button type="button"
                  class="rounded-lg border border-stone-200 px-4 py-2 text-sm font-semibold text-stone-700 transition hover:bg-stone-50">
            View
          </button>
          <button type="button"
                  class="rounded-lg bg-amber-700 px-4 py-2 text-sm font-semibold text-white transition hover:bg-amber-800">
            Download
          </button>
        </div>
      </li>
    }
  </ul>
</div>
