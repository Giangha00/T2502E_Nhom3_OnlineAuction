@model OnlineAuction.Models.ProductDetailViewModel

<div class="product-gallery">
  <div class="product-gallery__main overflow-hidden bg-slate-50">
    <img id="mainProductImage" src="@Model.Images.FirstOrDefault()" alt="@Model.Name"
         class="h-full w-full object-contain object-center transition duration-500"/>
  </div>

  @if (Model.Images.Count > 1)
  {
    <div class="mt-3 flex flex-wrap gap-2">
      @for (var i = 0; i < Math.Min(Model.Images.Count, 5); i++)
      {
        var image = Model.Images[i];
        <button type="button"
                class="gallery-thumb group h-14 w-14 shrink-0 overflow-hidden rounded border-2 @(i == 0 ? "border-slate-900" : "border-transparent") bg-white transition hover:border-slate-400"
                data-image="@image"
                aria-label="View image @(i + 1)">
          <img src="@image" alt="@Model.Name thumbnail @(i + 1)"
               class="h-full w-full object-cover"/>
        </button>
      }
    </div>
  }

  <div class="product-gallery__actions mt-6 flex flex-wrap items-center justify-center gap-6 text-sm text-slate-600">
    <button type="button" class="inline-flex items-center gap-2 transition hover:text-slate-900">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z"/></svg>
      Watch lot
    </button>
    <button type="button" class="inline-flex items-center gap-2 transition hover:text-slate-900">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/></svg>
      View in room
    </button>
    <button type="button" class="inline-flex items-center gap-2 transition hover:text-slate-900">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"/></svg>
      Share
    </button>
  </div>
</div>
