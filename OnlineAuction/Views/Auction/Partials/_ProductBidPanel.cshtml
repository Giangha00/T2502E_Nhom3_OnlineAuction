@model OnlineAuction.Models.ProductDetailViewModel
@using Microsoft.AspNetCore.Authentication
@using OnlineAuction.Configurations
@using OnlineAuction.Entities
@using OnlineAuction.Helpers
@{
    var minBid = Model.CurrentPrice + Model.BidStep;
    var specs = new List<string>();
    if (!string.IsNullOrEmpty(Model.Grade)) specs.Add(Model.Grade);
    if (!string.IsNullOrEmpty(Model.SetName)) specs.Add(Model.SetName);
    if (!string.IsNullOrEmpty(Model.Condition)) specs.Add(Model.Condition);
    if (!string.IsNullOrEmpty(Model.CertificateNumber)) specs.Add(Localizer["Product_CertPrefix", Model.CertificateNumber].Value);
    var userAuth = await Context.AuthenticateAsync(AuthSchemes.User);
    var isLoggedIn = userAuth.Succeeded;
    var endDateIso = DateTimeUtilities.ToUtcIsoString(Model.CountdownTargetDate);
    var showRegistrationFlow = Model.RequiresRegistration && Model.CanRegister && !Model.IsSeller;
    var showCancelRegistration = Model.RequiresRegistration && Model.CanRegister && !Model.IsSeller && Model.IsRegistered &&
        Model.RegistrationStatus is AuctionRegistrationStatuses.Pending or AuctionRegistrationStatuses.Approved;
    var showRegistrationUi = Model.RequiresRegistration && !Model.IsSeller &&
        (showRegistrationFlow || showCancelRegistration ||
         Model.RegistrationStatus == AuctionRegistrationStatuses.Pending ||
         Model.RegistrationStatus == AuctionRegistrationStatuses.Rejected);
    var showBidForm = !Model.IsSeller && Model.CanPlaceBid &&
        (!Model.RequiresRegistration || Model.RegistrationStatus == AuctionRegistrationStatuses.Approved);
    var registrationStatus = Model.RegistrationStatus ?? string.Empty;
}

<div class="product-bid-panel"
     data-is-logged-in="@(isLoggedIn ? "true" : "false")"
     data-auction-id="@Model.Id"
     data-end-date="@endDateIso"
     data-bid-step="@Model.BidStep.ToString("0.##")"
     data-current-price="@Model.CurrentPrice.ToString("0.##")"
     data-can-bid="@(Model.CanBid ? "true" : "false")"
     data-can-place-bid="@(Model.CanPlaceBid ? "true" : "false")"
     data-can-register="@(Model.CanRegister ? "true" : "false")"
     data-countdown-kind="@Model.PhaseCountdownKind"
     data-requires-registration="@(Model.RequiresRegistration ? "true" : "false")"
     data-is-seller="@(Model.IsSeller ? "true" : "false")"
     data-registration-status="@registrationStatus">
  <p class="text-sm text-slate-500">@Localizer["Product_Lot", Model.LotNumber]</p>

  <h1 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@Model.Category</h1>
  <p class="mt-1 text-lg text-slate-800">
    <em>@Model.Name</em>@if (Model.Year > 0) { <span>, @Model.Year</span> }
  </p>

  @if (specs.Count > 0)
  {
    <p class="mt-4 text-sm leading-relaxed text-slate-600">@string.Join(" · ", specs)</p>
  }

  <div class="mt-4 inline-flex items-center gap-2 text-sm text-slate-600">
    <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
    </svg>
    @Localizer["Product_AuthenticatedListing"]
  </div>

  <div class="product-bid-panel__divider"></div>

  <div class="mt-5 flex items-start justify-between gap-6">
    <div>
      <p class="text-sm text-slate-700">@Localizer["Product_CurrentBid"]</p>
      <p id="bidCountLabel" class="mt-1 text-xs text-slate-500">
        @Localizer["Product_BidsCount", Model.BidCount]@(Model.ReserveMet ? $", {Localizer["Product_ReserveMet"]}" : "")
      </p>
      <p id="registrationCountLabel" class="mt-0.5 text-xs text-slate-500">
        @Localizer["Product_RegisteredCount", Model.RegistrationCount]
      </p>
    </div>
    <p id="currentPriceDisplay" class="text-3xl font-bold tabular-nums text-slate-900 sm:text-4xl">$@Model.CurrentPrice.ToString("N0")</p>
  </div>

  <p class="mt-4 text-xs leading-relaxed text-slate-500">
    @Localizer["Product_BuyersPremium"]
  </p>

  <div class="product-bid-panel__divider"></div>

  @if (Model.IsSeller)
  {
    <div class="rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-700">
      @Localizer["Product_YouAreTheSeller"]
    </div>
  }
  else if (!Model.CanPlaceBid && !Model.CanRegister)
  {
    <div class="rounded-md border border-slate-200 bg-slate-50 px-4 py-3 text-sm text-slate-600">
      @if (Model.RequiresRegistration && DateTime.UtcNow < Model.RegistrationStartDate.ToUniversalTime())
      {
        @Localizer["Product_RegistrationNotOpen"]
      }
      else if (DateTime.UtcNow >= Model.EndDate.ToUniversalTime())
      {
        @Localizer["Product_AuctionEnded"]
      }
      else if (Model.RequiresRegistration && !Model.CanPlaceBid)
      {
        @Localizer["Product_LiveNotStarted"]
      }
      else
      {
        @Localizer["Product_AuctionEnded"]
      }
    </div>
  }
  else
  {
    @if (showRegistrationUi)
    {
      <div id="registrationSection">
        @if (Model.RegistrationStatus == AuctionRegistrationStatuses.Pending)
        {
          <div id="registrationBanner" class="rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
            @Localizer["Product_RegistrationPending"]
          </div>
        }
        else if (Model.RegistrationStatus == AuctionRegistrationStatuses.Rejected)
        {
          <div id="registrationBanner" class="rounded-md border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @Localizer["Product_RegistrationRejected"]
            @if (!string.IsNullOrWhiteSpace(Model.RegistrationRejectReason))
            {
              <span class="mt-1 block text-xs">@Model.RegistrationRejectReason</span>
            }
          </div>
        }
        else if (!Model.IsRegistered && showRegistrationFlow)
        {
          <p class="mb-3 text-sm text-slate-600">@Localizer["Product_MustRegisterToBid"]</p>
          <button type="button" id="registerAuctionBtn"
                  class="flex w-full items-center justify-center rounded-md bg-slate-900 py-3.5 text-sm font-semibold text-white transition hover:bg-slate-800">
            @Localizer["Product_RegisterForAuction"]
          </button>
        }

        @if (showCancelRegistration)
        {
          <div class="mt-4 rounded-lg border border-red-200 bg-red-50/80 p-4">
            <p class="text-xs text-red-700">@Localizer["Product_CancelRegistrationHint"]</p>
            <button type="button" id="cancelRegistrationBtn"
                    class="mt-3 flex w-full items-center justify-center gap-2 rounded-md border border-red-300 bg-white px-4 py-3 text-sm font-semibold text-red-700 shadow-sm transition hover:border-red-400 hover:bg-red-50">
              <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12"/>
              </svg>
              @Localizer["Product_CancelRegistration"]
            </button>
          </div>
        }
      </div>
    }

    <div id="registrationFeedback" class="mt-3 hidden rounded-md px-3 py-2 text-sm font-medium" role="status" aria-live="polite"></div>

    @if (showBidForm)
    {
      <div id="bidFormSection" class="@(showRegistrationUi ? "mt-4" : string.Empty)">
        <div>
          <label for="bidAmount" class="inline-flex items-center gap-1.5 text-sm font-medium text-slate-800">
            @Localizer["Product_PlaceMaxBid"]
            <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z"/>
            </svg>
          </label>
          <div class="mt-2 flex items-stretch overflow-hidden rounded-md border border-slate-300 bg-white focus-within:border-slate-900 focus-within:ring-1 focus-within:ring-slate-900">
            <button type="button"
                    id="bidAmountDecrease"
                    class="flex w-11 shrink-0 items-center justify-center border-r border-slate-200 text-lg font-semibold text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:text-slate-300"
                    aria-label="@Localizer["Product_DecreaseBid"]">
              −
            </button>
            <div class="relative min-w-0 flex-1">
              <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm font-medium text-slate-500">$</span>
              <input type="text"
                     inputmode="numeric"
                     id="bidAmount"
                     name="bidAmount"
                     value="@minBid.ToString("0.##")"
                     autocomplete="off"
                     class="w-full border-0 bg-transparent py-3 pl-7 pr-3 text-center text-sm font-semibold tabular-nums text-slate-800 outline-none"
                     aria-describedby="minBidHint" />
            </div>
            <button type="button"
                    id="bidAmountIncrease"
                    class="flex w-11 shrink-0 items-center justify-center border-l border-slate-200 text-lg font-semibold text-slate-600 transition hover:bg-slate-50 disabled:cursor-not-allowed disabled:text-slate-300"
                    aria-label="@Localizer["Product_IncreaseBid"]">
              +
            </button>
          </div>
          <p id="minBidHint" class="mt-2 text-xs text-slate-400">
            @Localizer["Product_MinBid"] <span id="minBidDisplay" class="font-semibold text-slate-600">$@minBid.ToString("N0")</span>
            · @Localizer["Product_Step"] <span class="font-semibold text-slate-600">$@Model.BidStep.ToString("N0")</span>
          </p>
        </div>

        <div id="bidFeedback" class="mt-3 hidden rounded-md px-3 py-2 text-sm font-medium" role="status" aria-live="polite"></div>

        <button type="button" id="placeBidBtn"
                class="mt-4 flex w-full items-center justify-center rounded-md bg-slate-900 py-3.5 text-sm font-semibold text-white transition hover:bg-slate-800 disabled:cursor-not-allowed disabled:bg-slate-400"
                @(!Model.RequiresRegistration || Model.CanBid ? null : "disabled")>
          @Localizer["Product_Bid"]
        </button>
      </div>
    }
  }

  <div class="mt-5 space-y-2 text-sm">
    <div class="grid grid-cols-4 gap-2 text-center">
      <div class="rounded-md bg-slate-50 px-2 py-2">
        <p id="cdDays" class="text-lg font-bold tabular-nums text-slate-900">@Model.CountdownDays.ToString("D2")</p>
        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500">@Localizer["Product_Days"]</p>
      </div>
      <div class="rounded-md bg-slate-50 px-2 py-2">
        <p id="cdHours" class="text-lg font-bold tabular-nums text-slate-900">@Model.CountdownHours.ToString("D2")</p>
        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500">@Localizer["Product_Hours"]</p>
      </div>
      <div class="rounded-md bg-slate-50 px-2 py-2">
        <p id="cdMinutes" class="text-lg font-bold tabular-nums text-slate-900">@Model.CountdownMinutes.ToString("D2")</p>
        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500">@Localizer["Product_Minutes"]</p>
      </div>
      <div class="rounded-md bg-slate-50 px-2 py-2">
        <p id="cdSeconds" class="text-lg font-bold tabular-nums text-slate-900">@Model.CountdownSeconds.ToString("D2")</p>
        <p class="text-[10px] font-medium uppercase tracking-wide text-slate-500">@Localizer["Product_Seconds"]</p>
      </div>
    </div>
    <p id="countdownSummary" class="font-medium text-blue-700" data-countdown-label="@Model.PhaseCountdownKind">
      @Localizer["Product_CountdownIn", Model.CountdownDays, Model.CountdownHours]
    </p>
    <p id="endsAtLabel" class="text-slate-600">
      @switch (Model.PhaseCountdownKind)
      {
        case "registration_end":
          @Localizer["Product_RegistrationClosesAt", DateTimeUtilities.AsUtc(Model.CountdownTargetDate).ToLocalTime().ToString("dd/MM/yyyy HH:mm")]
          break;
        case "live_start":
          @Localizer["Product_LiveStartsAt", DateTimeUtilities.AsUtc(Model.CountdownTargetDate).ToLocalTime().ToString("dd/MM/yyyy HH:mm")]
          break;
        default:
          @Localizer["Product_EndsAt", DateTimeUtilities.AsUtc(Model.CountdownTargetDate).ToLocalTime().ToString("MMM dd 'at' h:mmtt")]
          break;
      }
    </p>
    <p class="text-xs text-slate-400">@Localizer["Product_ClosureNote"]</p>
  </div>

  <div class="product-bid-panel__divider"></div>

  <p class="text-sm leading-relaxed text-slate-600">@Model.AuctionEventName</p>

  <div class="mt-6">
    @await Html.PartialAsync("Partials/_SellerInfo", Model.Seller)
  </div>
</div>
