@model OnlineAuction.Models.ProductDetailViewModel

<div class="rounded-xl border border-slate-200 bg-white p-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <p class="text-sm font-bold text-slate-900">@Localizer["Product_GradingReport", Model.Grade]</p>
      <p class="mt-1 text-xs text-slate-500">@Localizer["Product_Certificate", Model.CertificateNumber]</p>
    </div>
    <a href="#" class="text-xs font-semibold text-blue-700 hover:text-blue-900">@Localizer["Product_ViewCertificate"]</a>
  </div>
  <div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
    <div class="text-center">
      <p class="text-2xl font-bold tabular-nums text-slate-900">@Model.Grading.Centering</p>
      <p class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">@Localizer["Product_Centering"]</p>
    </div>
    <div class="text-center">
      <p class="text-2xl font-bold tabular-nums text-slate-900">@Model.Grading.Corners</p>
      <p class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">@Localizer["Product_Corners"]</p>
    </div>
    <div class="text-center">
      <p class="text-2xl font-bold tabular-nums text-slate-900">@Model.Grading.Edges</p>
      <p class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">@Localizer["Product_Edges"]</p>
    </div>
    <div class="text-center">
      <p class="text-2xl font-bold tabular-nums text-slate-900">@Model.Grading.Surface</p>
      <p class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">@Localizer["Product_Surface"]</p>
    </div>
  </div>
  <div class="mt-6 flex items-start gap-3 rounded-xl bg-slate-50 px-4 py-3">
    <svg class="mt-0.5 h-5 w-5 shrink-0 text-slate-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
    @if (Model.IsVerifiedAuthentic)
    {
      <p class="text-sm text-slate-700">@Localizer["Product_VerifiedAuthentic"]</p>
    }
    else
    {
      <p class="text-sm text-slate-500">@Localizer["Product_PendingVerification"]</p>
    }
  </div>
</div>
