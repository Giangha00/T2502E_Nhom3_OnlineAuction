@model OnlineAuction.Models.ProductDetailViewModel

<section class="product-detail-section mt-12">
  <h2 class="text-xl font-bold text-slate-900 sm:text-2xl">@Localizer["Product_Description"]</h2>
  <div class="mt-6 rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
    <h3 class="text-sm font-bold uppercase tracking-wider text-slate-900">@Localizer["Product_ItemOverview"]</h3>
    <div class="product-description mt-4 text-sm leading-relaxed text-slate-600">
      @Html.Raw(Model.DescriptionHtml)
    </div>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="rounded-xl border border-slate-100 bg-slate-50 p-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">@Localizer["Product_Year"]</p>
        <p class="mt-1 text-sm font-bold text-slate-900">@(Model.Year > 0 ? Model.Year.ToString() : "—")</p>
      </div>
      <div class="rounded-xl border border-slate-100 bg-slate-50 p-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">@Localizer["Product_Set"]</p>
        <p class="mt-1 text-sm font-bold text-slate-900">@Model.SetName</p>
      </div>
      <div class="rounded-xl border border-slate-100 bg-slate-50 p-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">@Localizer["Product_Language"]</p>
        <p class="mt-1 text-sm font-bold text-slate-900">@Model.Language</p>
      </div>
      <div class="rounded-xl border border-slate-100 bg-slate-50 p-4">
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">@Localizer["Product_CardNumber"]</p>
        <p class="mt-1 text-sm font-bold text-slate-900">@Model.CardNumber</p>
      </div>
    </div>
  </div>
</section>
