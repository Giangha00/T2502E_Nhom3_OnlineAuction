@model OnlineAuction.Models.SellerViewModel

<div class="flex items-center gap-4 rounded-2xl border border-slate-200 bg-slate-50 p-4">
  <img src="@Model.AvatarUrl" alt="@Model.Username"
       class="h-12 w-12 shrink-0 rounded-full object-cover ring-2 ring-blue-100"/>
  <div class="min-w-0 flex-1">
    <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Seller</p>
    <p class="truncate text-sm font-bold text-slate-900">@Model.Username</p>
    <p class="mt-0.5 text-xs text-slate-500">@Model.Rating.ToString("0.0") ★ · @Model.SuccessfulSales sales</p>
  </div>
  <a asp-controller="User" asp-action="Detail" asp-route-id="@Model.Id"
     class="shrink-0 rounded-full border border-slate-300 px-4 py-2 text-xs font-semibold text-slate-700 transition hover:border-blue-600 hover:text-blue-700">
    View Seller
  </a>
</div>
