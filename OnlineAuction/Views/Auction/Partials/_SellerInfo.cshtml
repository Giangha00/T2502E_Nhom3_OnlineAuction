@model OnlineAuction.Models.SellerViewModel

<div class="flex items-center gap-4 rounded-2xl border border-stone-200 bg-stone-50/80 p-4">
  <img src="@Model.AvatarUrl" alt="@Model.Username"
       class="h-14 w-14 shrink-0 rounded-full object-cover ring-2 ring-amber-100"/>
  <div class="min-w-0 flex-1">
    <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Seller</p>
    <p class="truncate text-base font-bold text-stone-900">@Model.Username</p>
    <div class="mt-1 flex items-center gap-2 text-xs text-stone-500">
      <span class="font-semibold text-amber-700">@Model.Rating.ToString("0.0")</span>
      <span>·</span>
      <span>@Model.SuccessfulSales sales</span>
    </div>
  </div>
  <a asp-controller="User" asp-action="Detail" asp-route-id="@Model.Id"
     class="shrink-0 rounded-xl border border-amber-300 bg-white px-4 py-2 text-sm font-semibold text-amber-800 transition hover:bg-amber-50">
    View Seller
  </a>
</div>
