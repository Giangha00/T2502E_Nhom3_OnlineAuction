@model OnlineAuction.Models.SavedPaymentMethodViewModel

@{
    var typeLabel = Model.CardType switch
    {
        "mastercard" => Localizer["Payment_Mastercard"].Value,
        "other" => Localizer["Payment_Other"].Value,
        _ => Localizer["Payment_Visa"].Value
    };
    var typeIcon = Model.CardType switch
    {
        "mastercard" => "MC",
        "other" => "••",
        _ => "VISA"
    };
}

<article class="payment-card-item rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-blue-300"
         data-card-id="@Model.Id"
         data-card-type="@Model.CardType"
         data-holder="@Model.HolderName"
         data-expiry-month="@Model.ExpiryMonth"
         data-expiry-year="@Model.ExpiryYear"
         data-billing="@Model.BillingAddress"
         data-last-four="@Model.LastFour">
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div class="flex items-center gap-3">
            <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-gradient-to-br from-amber-600 to-stone-800 text-xs font-bold text-white">
                @typeIcon
            </span>
            <div>
                <p class="text-sm font-semibold text-slate-900">@typeLabel</p>
                <p class="mt-1 font-mono text-sm tracking-wider text-slate-600">@Model.MaskedNumber</p>
                <p class="mt-1 text-xs text-slate-500">@Localizer["Payment_Expires"] @Model.ExpiryMonth/@Model.ExpiryYear</p>
            </div>
        </div>
        @if (Model.IsDefault)
        {
            <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-800">@Localizer["Payment_Default"]</span>
        }
    </div>
    <div class="mt-4 flex flex-wrap gap-2 border-t border-slate-100 pt-4">
        <button type="button" data-action="edit" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-slate-700 transition hover:border-amber-500 hover:text-blue-700">@Localizer["Payment_Edit"]</button>
        <button type="button" data-action="remove" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-red-600 transition hover:border-red-300 hover:bg-red-50">@Localizer["Payment_Remove"]</button>
        @if (!Model.IsDefault)
        {
            <button type="button" data-action="set-default" class="rounded-lg border border-slate-200 px-3 py-1.5 text-xs font-medium text-blue-700 transition hover:border-amber-500 hover:bg-blue-50">@Localizer["Payment_SetDefaultBtn"]</button>
        }
    </div>
</article>
