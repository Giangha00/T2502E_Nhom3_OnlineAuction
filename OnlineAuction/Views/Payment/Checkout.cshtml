@model OnlineAuction.Models.PaymentCheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<section class="page-hero relative overflow-hidden py-12 sm:py-16">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -right-40 -top-40 h-80 w-80 rounded-full bg-amber-400/10 blur-3xl"></div>
        <div class="absolute -left-40 bottom-0 h-80 w-80 rounded-full bg-orange-400/10 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="page-hero__label text-sm font-semibold uppercase tracking-widest">Secure Checkout</p>
        <h1 class="page-hero__title mt-2 text-3xl font-bold tracking-tight sm:text-4xl">Complete Your Payment</h1>
        <p class="page-hero__desc mt-3 max-w-2xl text-base leading-7 sm:text-lg">
            Congratulations on winning the auction. Please complete payment before
            <span class="font-semibold text-white">@Model.PaymentDeadline.ToString("MMMM dd, yyyy")</span>
            to secure your item.
        </p>
        <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1.5 text-sm text-amber-100">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Order reference: <span class="font-semibold text-white">@Model.OrderReference</span>
        </p>
    </div>
</section>

<!-- Progress Steps -->
<section class="border-b border-amber-200/40 bg-amber-50/30">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <ol class="flex flex-wrap items-center justify-center gap-4 sm:gap-8">
            <li class="flex items-center gap-2 text-sm font-medium text-amber-700">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-amber-700 text-xs font-bold text-white">1</span>
                Review Order
            </li>
            <li class="hidden h-px w-8 bg-stone-300 sm:block"></li>
            <li class="flex items-center gap-2 text-sm font-medium text-amber-700">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-amber-700 text-xs font-bold text-white">2</span>
                Payment Details
            </li>
            <li class="hidden h-px w-8 bg-stone-300 sm:block"></li>
            <li class="flex items-center gap-2 text-sm font-medium text-stone-400">
                <span class="flex h-7 w-7 items-center justify-center rounded-full border border-stone-300 text-xs font-bold">3</span>
                Confirmation
            </li>
        </ol>
    </div>
</section>

<!-- Main Content -->
<section class="py-10 lg:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <form id="paymentForm" class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_380px] lg:gap-12">
            <input type="hidden" id="orderRef" value="@Model.OrderReference"/>
            <input type="hidden" id="auctionName" value="@Model.Auction.Name"/>
            <input type="hidden" id="totalAmount" value="@Model.TotalAmount"/>

            <!-- Left: Forms -->
            <div class="space-y-8">
                <!-- Shipping -->
                <div class="rounded-2xl border border-stone-200 bg-white/80 p-6 shadow-sm sm:p-8">
                    <h2 class="text-lg font-semibold text-stone-900">Shipping Information</h2>
                    <p class="mt-1 text-sm text-stone-500">Where should we deliver your winning item?</p>

                    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
                        <div>
                            <label for="fullName" class="block text-sm font-medium text-stone-900">Full Name <span class="text-red-500">*</span></label>
                            <input type="text" id="fullName" placeholder="John Doe"
                                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                            <span id="fullNameError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-stone-900">Phone Number <span class="text-red-500">*</span></label>
                            <input type="tel" id="phone" placeholder="+84 123 456 789"
                                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                            <span id="phoneError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div class="sm:col-span-2">
                            <label for="email" class="block text-sm font-medium text-stone-900">Email Address <span class="text-red-500">*</span></label>
                            <input type="email" id="email" placeholder="john@example.com"
                                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                            <span id="emailError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div class="sm:col-span-2">
                            <label for="address" class="block text-sm font-medium text-stone-900">Street Address <span class="text-red-500">*</span></label>
                            <input type="text" id="address" placeholder="123 Auction Street, District 1"
                                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                            <span id="addressError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label for="city" class="block text-sm font-medium text-stone-900">City <span class="text-red-500">*</span></label>
                            <input type="text" id="city" placeholder="Hanoi"
                                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                            <span id="cityError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label for="postalCode" class="block text-sm font-medium text-stone-900">Postal Code</label>
                            <input type="text" id="postalCode" placeholder="10000"
                                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="rounded-2xl border border-stone-200 bg-white/80 p-6 shadow-sm sm:p-8">
                    <h2 class="text-lg font-semibold text-stone-900">Payment Method</h2>
                    <p class="mt-1 text-sm text-stone-500">Choose how you would like to pay for your winning bid.</p>

                    <div class="mt-6 space-y-3" id="paymentMethods">
                        @foreach (var method in Model.PaymentMethods)
                        {
                            <label class="payment-method-option flex cursor-pointer items-start gap-4 rounded-xl border border-stone-200 p-4 transition hover:border-amber-400 has-[:checked]:border-amber-600 has-[:checked]:bg-amber-50/50">
                                <input type="radio" name="paymentMethod" value="@method.Id" data-label="@method.Name"
                                       class="mt-1 h-4 w-4 border-stone-300 text-amber-700 focus:ring-amber-500"
                                       @(method == Model.PaymentMethods.First() ? "checked" : null)/>
                                <div class="flex-1">
                                    <p class="font-medium text-stone-900">@method.Name</p>
                                    <p class="mt-0.5 text-sm text-stone-500">@method.Description</p>
                                </div>
                            </label>
                        }
                    </div>
                    <span id="paymentMethodError" class="mt-2 block text-sm text-red-600"></span>

                    <!-- Card details (shown when card selected) -->
                    <div id="cardDetails" class="mt-6 hidden space-y-4 rounded-xl border border-dashed border-stone-200 bg-stone-50/50 p-5">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <p class="text-sm font-medium text-stone-700">Card Details</p>
                            <a asp-controller="Payment" asp-action="Index"
                               class="text-xs font-semibold text-amber-700 hover:text-amber-800">
                                Manage saved payment methods →
                            </a>
                        </div>
                        <div>
                            <label for="cardNumber" class="block text-sm font-medium text-stone-900">Card Number</label>
                            <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19"
                                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="cardExpiry" class="block text-sm font-medium text-stone-900">Expiry Date</label>
                                <input type="text" id="cardExpiry" placeholder="MM/YY" maxlength="5"
                                       class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                            </div>
                            <div>
                                <label for="cardCvc" class="block text-sm font-medium text-stone-900">CVC</label>
                                <input type="text" id="cardCvc" placeholder="123" maxlength="4"
                                       class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
                            </div>
                        </div>
                    </div>

                    <!-- Bank transfer info -->
                    <div id="bankDetails" class="mt-6 hidden rounded-xl border border-dashed border-stone-200 bg-stone-50/50 p-5">
                        <p class="text-sm font-medium text-stone-700">Bank Transfer Details</p>
                        <dl class="mt-3 space-y-2 text-sm">
                            <div class="flex justify-between gap-4">
                                <dt class="text-stone-500">Bank</dt>
                                <dd class="font-medium text-stone-900">Vietcombank</dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt class="text-stone-500">Account Name</dt>
                                <dd class="font-medium text-stone-900">Auction House Escrow</dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt class="text-stone-500">Account Number</dt>
                                <dd class="font-mono font-medium text-stone-900">0123456789</dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt class="text-stone-500">Transfer Content</dt>
                                <dd class="font-mono text-xs font-medium text-amber-700">@Model.OrderReference</dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- Terms -->
                <div class="rounded-2xl border border-stone-200 bg-white/80 p-6 shadow-sm">
                    <label class="flex cursor-pointer items-start gap-3">
                        <input type="checkbox" id="agreeTerms"
                               class="mt-1 h-4 w-4 rounded border-stone-300 text-amber-700 focus:ring-amber-500"/>
                        <span class="text-sm text-stone-600">
                            I agree to the
                            <a asp-controller="Policy" asp-action="Index" class="font-medium text-amber-700 hover:text-amber-800">Payment Policy</a>
                            and confirm that I am the winning bidder for this auction item.
                        </span>
                    </label>
                    <span id="termsError" class="mt-2 block text-sm text-red-600"></span>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <aside class="sticky-below-header">
                <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
                    <h2 class="text-lg font-semibold text-stone-900">Order Summary</h2>

                    <div class="mt-5 flex gap-4">
                        <div class="h-20 w-20 shrink-0 overflow-hidden rounded-xl border border-stone-200">
                            <img src="@Model.Auction.ImageUrl" alt="@Model.Auction.Name"
                                 class="h-full w-full object-cover"/>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-[10px] font-semibold uppercase tracking-widest text-stone-400">@Model.Auction.Category</p>
                            <h3 class="mt-1 line-clamp-2 text-sm font-semibold text-stone-900">@Model.Auction.Name</h3>
                            <span class="mt-2 inline-block rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-green-700">
                                Won
                            </span>
                        </div>
                    </div>

                    <dl class="mt-6 space-y-3 border-t border-stone-100 pt-5 text-sm">
                        <div class="flex justify-between gap-4">
                            <dt class="text-stone-500">Winning Bid</dt>
                            <dd class="font-medium text-stone-900">$@Model.WinningBid.ToString("N2")</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-stone-500">Platform Fee (2.5%)</dt>
                            <dd class="font-medium text-stone-900">$@Model.PlatformFee.ToString("N2")</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-stone-500">Shipping</dt>
                            <dd class="font-medium text-stone-900">$@Model.ShippingFee.ToString("N2")</dd>
                        </div>
                        <div class="flex justify-between gap-4 border-t border-stone-100 pt-3">
                            <dt class="text-base font-semibold text-stone-900">Total</dt>
                            <dd class="text-lg font-bold text-amber-700">$@Model.TotalAmount.ToString("N2")</dd>
                        </div>
                    </dl>

                    <button type="submit"
                            class="mt-6 w-full rounded-xl bg-amber-700 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800 focus:ring-2 focus:ring-amber-700 focus:ring-offset-2 active:scale-[0.98]">
                        Pay $@Model.TotalAmount.ToString("N2") Now
                    </button>

                    <div class="mt-4 flex items-center justify-center gap-2 text-xs text-stone-500">
                        <svg class="h-4 w-4 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        Secure SSL encrypted payment
                    </div>

                    <p class="mt-4 text-center text-xs text-stone-400">
                        Need help?
                        <a asp-controller="Contact" asp-action="Index" class="text-amber-700 hover:text-amber-800">Contact support</a>
                    </p>
                </div>
            </aside>
        </form>
    </div>
</section>

@section Scripts {
    <script src="~/js/payment.js" asp-append-version="true"></script>
}
