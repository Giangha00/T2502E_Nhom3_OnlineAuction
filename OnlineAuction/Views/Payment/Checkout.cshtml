@using System.Text.Json
@model OnlineAuction.Models.PaymentCheckoutViewModel
@{
    ViewData["Title"] = Localizer["Checkout_PageTitle"];
    var checkoutDescription = Localizer["Checkout_Description", Model.PaymentDeadline.ToString("MMMM dd, yyyy"), Model.OrderReference].Value;
    var paymentI18n = new Dictionary<string, string>
    {
        ["fullNameRequired"] = Localizer["Js_Payment_FullNameRequired"].Value,
        ["phoneRequired"] = Localizer["Js_Payment_PhoneRequired"].Value,
        ["emailInvalid"] = Localizer["Js_Payment_EmailInvalid"].Value,
        ["addressRequired"] = Localizer["Js_Payment_AddressRequired"].Value,
        ["cityRequired"] = Localizer["Js_Payment_CityRequired"].Value,
        ["methodRequired"] = Localizer["Js_Payment_MethodRequired"].Value,
        ["termsRequired"] = Localizer["Js_Payment_TermsRequired"].Value
    };
}

<div class="rarecard-page bg-white">
<partial name="_PageHero" model='new PageHeroViewModel {
    Label = Localizer["Checkout_Label"].Value,
    Title = Localizer["Checkout_Title"].Value,
    Description = checkoutDescription
}' />

<!-- Progress Steps -->
<section class="border-b border-blue-200/40 bg-blue-50/30">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <ol class="flex flex-wrap items-center justify-center gap-4 sm:gap-8">
            <li class="flex items-center gap-2 text-sm font-medium text-blue-700">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">1</span>
                @Localizer["Checkout_Step_Review"]
            </li>
            <li class="hidden h-px w-8 bg-stone-300 sm:block"></li>
            <li class="flex items-center gap-2 text-sm font-medium text-blue-700">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">2</span>
                @Localizer["Checkout_Step_Payment"]
            </li>
            <li class="hidden h-px w-8 bg-stone-300 sm:block"></li>
            <li class="flex items-center gap-2 text-sm font-medium text-slate-400">
                <span class="flex h-7 w-7 items-center justify-center rounded-full border border-slate-300 text-xs font-bold">3</span>
                @Localizer["Checkout_Step_Confirmation"]
            </li>
        </ol>
    </div>
</section>

<!-- Main Content -->
<section class="py-10 lg:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <form id="paymentForm" class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_380px] lg:gap-12">
            <input type="hidden" id="orderRef" value="@Model.OrderReference"/>
            <input type="hidden" id="auctionName" value="@Model.Auction.Name"/>
            <input type="hidden" id="totalAmount" value="@Model.TotalAmount"/>

            <!-- Left: Forms -->
            <div class="space-y-8">
                <!-- Shipping -->
                <div class="rounded-2xl border border-slate-200 bg-white/80 p-6 shadow-sm sm:p-8">
                    <h2 class="text-lg font-semibold text-slate-900">@Localizer["Checkout_ShippingInfo"]</h2>
                    <p class="mt-1 text-sm text-slate-500">@Localizer["Checkout_ShippingDesc"]</p>

                    <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
                        <div>
                            <label for="fullName" class="block text-sm font-medium text-slate-900">@Localizer["Checkout_FullName"] <span class="text-red-500">*</span></label>
                            <input type="text" id="fullName" placeholder="John Doe"
                                   class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                            <span id="fullNameError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-slate-900">@Localizer["Checkout_Phone"] <span class="text-red-500">*</span></label>
                            <input type="tel" id="phone" placeholder="+84 123 456 789"
                                   class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                            <span id="phoneError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div class="sm:col-span-2">
                            <label for="email" class="block text-sm font-medium text-slate-900">@Localizer["Checkout_Email"] <span class="text-red-500">*</span></label>
                            <input type="email" id="email" placeholder="john@example.com"
                                   class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                            <span id="emailError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div class="sm:col-span-2">
                            <label for="address" class="block text-sm font-medium text-slate-900">@Localizer["Checkout_StreetAddress"] <span class="text-red-500">*</span></label>
                            <input type="text" id="address" placeholder="123 Auction Street, District 1"
                                   class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                            <span id="addressError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label for="city" class="block text-sm font-medium text-slate-900">@Localizer["Checkout_City"] <span class="text-red-500">*</span></label>
                            <input type="text" id="city" placeholder="Hanoi"
                                   class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                            <span id="cityError" class="mt-1 block text-sm text-red-600"></span>
                        </div>
                        <div>
                            <label for="postalCode" class="block text-sm font-medium text-slate-900">@Localizer["Checkout_PostalCode"]</label>
                            <input type="text" id="postalCode" placeholder="10000"
                                   class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                        </div>
                    </div>
                </div>

                <!-- Payment Method -->
                <div class="rounded-2xl border border-slate-200 bg-white/80 p-6 shadow-sm sm:p-8">
                    <h2 class="text-lg font-semibold text-slate-900">@Localizer["Checkout_PaymentMethod"]</h2>
                    <p class="mt-1 text-sm text-slate-500">@Localizer["Checkout_PaymentMethodDesc"]</p>

                    <div class="mt-6 space-y-3" id="paymentMethods">
                        @foreach (var method in Model.PaymentMethods)
                        {
                            <label class="payment-method-option flex cursor-pointer items-start gap-4 rounded-xl border border-slate-200 p-4 transition hover:border-blue-400 has-[:checked]:border-amber-600 has-[:checked]:bg-blue-50/50">
                                <input type="radio" name="paymentMethod" value="@method.Id" data-label="@method.Name"
                                       class="mt-1 h-4 w-4 border-slate-300 text-blue-700 focus:ring-blue-500"
                                       @(method == Model.PaymentMethods.First() ? "checked" : null)/>
                                <div class="flex-1">
                                    <p class="font-medium text-slate-900">@method.Name</p>
                                    <p class="mt-0.5 text-sm text-slate-500">@method.Description</p>
                                </div>
                            </label>
                        }
                    </div>
                    <span id="paymentMethodError" class="mt-2 block text-sm text-red-600"></span>

                    <!-- Card details (shown when card selected) -->
                    <div id="cardDetails" class="mt-6 hidden space-y-4 rounded-xl border border-dashed border-slate-200 bg-stone-50/50 p-5">
                        <div class="flex flex-wrap items-center justify-between gap-2">
                            <p class="text-sm font-medium text-slate-700">@Localizer["Checkout_CardDetails"]</p>
                            <a asp-controller="Payment" asp-action="Index"
                               class="text-xs font-semibold text-blue-700 hover:text-blue-800">
                                @Localizer["Checkout_ManageSaved"]
                            </a>
                        </div>
                        <div>
                            <label for="cardNumber" class="block text-sm font-medium text-slate-900">@Localizer["Payment_CardNumber"]</label>
                            <input type="text" id="cardNumber" placeholder="1234 5678 9012 3456" maxlength="19"
                                   class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="cardExpiry" class="block text-sm font-medium text-slate-900">@Localizer["Checkout_ExpiryDate"]</label>
                                <input type="text" id="cardExpiry" placeholder="MM/YY" maxlength="5"
                                       class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                            </div>
                            <div>
                                <label for="cardCvc" class="block text-sm font-medium text-slate-900">@Localizer["Payment_CVV"]</label>
                                <input type="text" id="cardCvc" placeholder="123" maxlength="4"
                                       class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                            </div>
                        </div>
                    </div>

                    <!-- Bank transfer info -->
                    <div id="bankDetails" class="mt-6 hidden rounded-xl border border-dashed border-slate-200 bg-stone-50/50 p-5">
                        <p class="text-sm font-medium text-slate-700">@Localizer["Checkout_BankTransfer"]</p>
                        <dl class="mt-3 space-y-2 text-sm">
                            <div class="flex justify-between gap-4">
                                <dt class="text-slate-500">@Localizer["Checkout_Bank"]</dt>
                                <dd class="font-medium text-slate-900">Vietcombank</dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt class="text-slate-500">@Localizer["Checkout_AccountName"]</dt>
                                <dd class="font-medium text-slate-900">Auction House Escrow</dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt class="text-slate-500">@Localizer["Checkout_AccountNumber"]</dt>
                                <dd class="font-mono font-medium text-slate-900">0123456789</dd>
                            </div>
                            <div class="flex justify-between gap-4">
                                <dt class="text-slate-500">@Localizer["Checkout_TransferContent"]</dt>
                                <dd class="font-mono text-xs font-medium text-blue-700">@Model.OrderReference</dd>
                            </div>
                        </dl>
                    </div>
                </div>

                <!-- Terms -->
                <div class="rounded-2xl border border-slate-200 bg-white/80 p-6 shadow-sm">
                    <label class="flex cursor-pointer items-start gap-3">
                        <input type="checkbox" id="agreeTerms"
                               class="mt-1 h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-500"/>
                        <span class="text-sm text-slate-600">
                            @Localizer["Checkout_AgreeTerms"]
                            <a asp-controller="Policy" asp-action="Index" class="font-medium text-blue-700 hover:text-blue-800">@Localizer["Checkout_PaymentPolicy"]</a>
                            @Localizer["Checkout_WinningBidderConfirm"]
                        </span>
                    </label>
                    <span id="termsError" class="mt-2 block text-sm text-red-600"></span>
                </div>
            </div>

            <!-- Right: Order Summary -->
            <aside class="sticky-below-header">
                <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
                    <h2 class="text-lg font-semibold text-slate-900">@Localizer["Checkout_OrderSummary"]</h2>

                    <div class="mt-5 flex gap-4">
                        <div class="h-20 w-20 shrink-0 overflow-hidden rounded-xl border border-slate-200">
                            <img src="@Model.Auction.ImageUrl" alt="@Model.Auction.Name"
                                 class="h-full w-full object-cover"/>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-[10px] font-semibold uppercase tracking-widest text-slate-400">@Model.Auction.Category</p>
                            <h3 class="mt-1 line-clamp-2 text-sm font-semibold text-slate-900">@Model.Auction.Name</h3>
                            <span class="mt-2 inline-block rounded-full bg-green-100 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-green-700">
                                @Localizer["Checkout_Won"]
                            </span>
                        </div>
                    </div>

                    <dl class="mt-6 space-y-3 border-t border-slate-100 pt-5 text-sm">
                        <div class="flex justify-between gap-4">
                            <dt class="text-slate-500">@Localizer["Checkout_WinningBid"]</dt>
                            <dd class="font-medium text-slate-900">$@Model.WinningBid.ToString("N2")</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-slate-500">@Localizer["Checkout_PlatformFee"]</dt>
                            <dd class="font-medium text-slate-900">$@Model.PlatformFee.ToString("N2")</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-slate-500">@Localizer["Checkout_Shipping"]</dt>
                            <dd class="font-medium text-slate-900">$@Model.ShippingFee.ToString("N2")</dd>
                        </div>
                        <div class="flex justify-between gap-4 border-t border-slate-100 pt-3">
                            <dt class="text-base font-semibold text-slate-900">@Localizer["Checkout_Total"]</dt>
                            <dd class="text-lg font-bold text-blue-700">$@Model.TotalAmount.ToString("N2")</dd>
                        </div>
                    </dl>

                    <button type="submit"
                            class="mt-6 w-full rounded-xl bg-blue-700 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-700/20 transition hover:bg-blue-800 focus:ring-2 focus:ring-blue-700 focus:ring-offset-2 active:scale-[0.98]">
                        @Localizer["Checkout_PayNow", $"${Model.TotalAmount:N2}"]
                    </button>

                    <div class="mt-4 flex items-center justify-center gap-2 text-xs text-slate-500">
                        <svg class="h-4 w-4 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/>
                        </svg>
                        @Localizer["Checkout_SecurePayment"]
                    </div>

                    <p class="mt-4 text-center text-xs text-slate-400">
                        @Localizer["Checkout_NeedHelp"]
                        <a asp-controller="Contact" asp-action="Index" class="text-blue-700 hover:text-blue-800">@Localizer["Checkout_ContactSupport"]</a>
                    </p>
                </div>
            </aside>
        </form>
    </div>
</section>
</div>

@section Scripts {
    <script>
        window.paymentConfig = {
            i18n: @Html.Raw(JsonSerializer.Serialize(paymentI18n))
        };
    </script>
    <script src="~/js/payment.js" asp-append-version="true"></script>
}
