@model OnlineAuction.Models.PaymentInformationViewModel
@using System.Text.Json
@using System.Text.Json.Serialization
@{
    ViewData["Title"] = "Payment Information";
    var jsonOptions = new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase };
    var initialMethodsJson = JsonSerializer.Serialize(Model.SavedMethods, jsonOptions);
}

<div class="min-h-screen bg-white px-4 py-8 sm:py-12">
    <div class="mx-auto w-full max-w-6xl">
        <div class="mb-8 text-center">
            <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2.5">
                <span class="text-lg font-extrabold tracking-tight text-slate-900">RareCard</span>
            </a>
        </div>

        <div class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-xl">
            <partial name="_PaymentHeader" />

            @if (TempData["FromSignUp"] is true)
            {
                <div class="border-b border-emerald-200/60 bg-emerald-50/80 px-6 py-4 sm:px-8">
                    <p class="text-sm text-emerald-800">
                        Account created successfully. Please add your payment information to complete setup.
                    </p>
                </div>
            }

            <section class="px-4 py-8 sm:px-8 lg:py-10">
                <div id="paymentNotification" class="mb-6 hidden rounded-xl border px-4 py-3 text-sm font-medium" role="alert"></div>

                <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_360px] lg:gap-10">
                    <partial name="_PaymentForm" />
                    <partial name="_CardPreview" />
                </div>

                <partial name="_SavedPaymentList" model="Model" />
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        window.paymentInfoConfig = {
            initialMethods: @Html.Raw(initialMethodsJson)
        };
    </script>
    <script src="~/js/payment-information.js" asp-append-version="true"></script>
}
