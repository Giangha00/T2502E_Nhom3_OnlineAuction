@model OnlineAuction.Models.PaymentConfirmationViewModel
@{
    ViewData["Title"] = Localizer["PaymentConfirm_PageTitle"];
    var showSuccessModal = TempData["PaymentSuccess"] is true;
}

<div class="rarecard-page bg-slate-50 min-h-screen">
@if (showSuccessModal)
{
  <div id="paymentSuccessModal" class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/50 px-4 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-3xl border border-emerald-200 bg-white p-8 text-center shadow-2xl">
      <div class="mx-auto flex h-20 w-20 items-center justify-center rounded-full bg-emerald-100">
        <svg class="h-10 w-10 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      <h2 class="mt-5 text-2xl font-bold text-slate-900">@Localizer["PaymentConfirm_Success"]</h2>
      <p class="mt-2 text-sm text-slate-600">@Localizer["PaymentConfirm_ThankYou"]</p>
      <button type="button" id="paymentSuccessModalClose"
              class="mt-6 w-full rounded-xl bg-emerald-600 py-3 text-sm font-semibold text-white transition hover:bg-emerald-700">
        @Localizer["PaymentConfirm_ViewDetails"]
      </button>
    </div>
  </div>
}

<section class="py-12 lg:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-slate-200 bg-white p-8 shadow-lg sm:p-12">
            <div class="text-center">
                <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-emerald-100">
                    <svg class="h-8 w-8 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                    </svg>
                </div>
                <h1 class="mt-6 text-3xl font-bold text-slate-900">@Localizer["PaymentConfirm_Success"]</h1>
                <p class="mt-3 text-slate-600">@Localizer["PaymentConfirm_ThankYou"]</p>
            </div>

            @if (Model.Items.Count > 0)
            {
                <div class="mt-8 space-y-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="flex items-center gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-4">
                            @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt="@item.Name" class="h-16 w-16 rounded-xl object-cover"/>
                            }
                            <div class="min-w-0 flex-1 text-left">
                                <p class="font-semibold text-slate-900">@item.Name</p>
                                @if (!string.IsNullOrWhiteSpace(item.Grade))
                                {
                                    <p class="text-sm text-slate-500">@item.Grade</p>
                                }
                            </div>
                            <p class="font-bold text-blue-700">$@item.Amount.ToString("N2")</p>
                        </div>
                    }
                </div>
            }

            <div class="mt-8 rounded-2xl border border-slate-100 bg-stone-50/80 p-6">
                <dl class="space-y-4 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">@Localizer["PaymentConfirm_OrderReference"]</dt>
                        <dd class="font-mono font-semibold text-slate-900">@Model.OrderReference</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">@Localizer["PaymentConfirm_Item"]</dt>
                        <dd class="max-w-[60%] text-right font-medium text-slate-900">@Model.AuctionName</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">@Localizer["PaymentConfirm_PaymentMethod"]</dt>
                        <dd class="font-medium text-slate-900">@Model.PaymentMethod</dd>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.TransactionId))
                    {
                        <div class="flex justify-between gap-4">
                            <dt class="text-slate-500">@Localizer["PaymentConfirm_TransactionId"]</dt>
                            <dd class="max-w-[60%] break-all text-right font-mono text-xs text-slate-700">@Model.TransactionId</dd>
                        </div>
                    }
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">@Localizer["PaymentConfirm_PaidAt"]</dt>
                        <dd class="font-medium text-slate-900">@Model.PaidAt.ToLocalTime().ToString("g")</dd>
                    </div>
                    <div class="flex justify-between gap-4 border-t border-slate-200 pt-4">
                        <dt class="font-semibold text-slate-900">@Localizer["PaymentConfirm_AmountPaid"]</dt>
                        <dd class="text-lg font-bold text-blue-700">$@Model.TotalAmount.ToString("N2")</dd>
                    </div>
                </dl>
            </div>

            <div class="mt-8 rounded-xl bg-blue-50 p-4 text-left text-sm text-blue-900">
                <p class="font-medium">@Localizer["PaymentConfirm_WhatNext"]</p>
                <ul class="mt-2 list-inside list-disc space-y-1 text-blue-800">
                    <li>@Localizer["PaymentConfirm_Step1"]</li>
                    <li>@Localizer["PaymentConfirm_Step2"]</li>
                    <li>@Localizer["PaymentConfirm_Step3"]</li>
                </ul>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
                <a asp-controller="Auction" asp-action="Index"
                   class="rounded-xl border border-blue-700 px-6 py-3 text-center text-sm font-semibold text-blue-700 transition hover:bg-blue-50">
                    @Localizer["PaymentConfirm_BrowseMore"]
                </a>
                <a asp-controller="Home" asp-action="Index"
                   class="rounded-xl bg-blue-700 px-6 py-3 text-center text-sm font-semibold text-white shadow-lg shadow-blue-700/20 transition hover:bg-blue-800">
                    @Localizer["PaymentConfirm_BackHome"]
                </a>
            </div>
        </div>
    </div>
</section>
</div>

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('paymentSuccessModal');
            var closeBtn = document.getElementById('paymentSuccessModalClose');
            if (!modal || !closeBtn) return;
            closeBtn.addEventListener('click', function () {
                modal.classList.add('hidden');
            });
        })();
    </script>
}
