@model OnlineAuction.Models.PaymentConfirmationViewModel
@{
    ViewData["Title"] = "Payment Confirmed";
}

<section class="py-16 lg:py-24">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-stone-200 bg-white/90 p-8 text-center shadow-lg sm:p-12">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-green-100">
                <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
            </div>

            <h1 class="mt-6 text-3xl font-bold text-stone-900">Payment Successful</h1>
            <p class="mt-3 text-stone-600">
                Thank you! Your payment has been received and your order is being processed.
            </p>

            <div class="mt-8 rounded-2xl border border-stone-100 bg-stone-50/80 p-6 text-left">
                <dl class="space-y-4 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-stone-500">Order Reference</dt>
                        <dd class="font-mono font-semibold text-stone-900">@Model.OrderReference</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-stone-500">Item</dt>
                        <dd class="max-w-[60%] text-right font-medium text-stone-900">@Model.AuctionName</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-stone-500">Payment Method</dt>
                        <dd class="font-medium text-stone-900">@Model.PaymentMethod</dd>
                    </div>
                    <div class="flex justify-between gap-4 border-t border-stone-200 pt-4">
                        <dt class="font-semibold text-stone-900">Amount Paid</dt>
                        <dd class="text-lg font-bold text-amber-700">$@Model.TotalAmount.ToString("N2")</dd>
                    </div>
                </dl>
            </div>

            <div class="mt-8 rounded-xl bg-amber-50 p-4 text-left text-sm text-amber-900">
                <p class="font-medium">What happens next?</p>
                <ul class="mt-2 list-inside list-disc space-y-1 text-amber-800">
                    <li>You will receive a confirmation email shortly.</li>
                    <li>The seller will prepare your item for shipment.</li>
                    <li>Tracking details will be sent once the package is dispatched.</li>
                </ul>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
                <a asp-controller="Auction" asp-action="Index"
                   class="rounded-xl border border-amber-700 px-6 py-3 text-sm font-semibold text-amber-700 transition hover:bg-amber-50">
                    Browse More Auctions
                </a>
                <a asp-controller="Home" asp-action="Index"
                   class="rounded-xl bg-amber-700 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800">
                    Back to Home
                </a>
            </div>
        </div>
    </div>
</section>
