@model OnlineAuction.Models.PaymentInformationViewModel

<section class="mt-10 lg:mt-12">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 class="text-xl font-semibold text-stone-900">Saved Payment Methods</h2>
            <p class="mt-1 text-sm text-stone-500">Manage your stored cards for faster checkout.</p>
        </div>
        <span id="savedCountBadge" class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
            @Model.SavedMethods.Count method@(Model.SavedMethods.Count == 1 ? "" : "s")
        </span>
    </div>

    <div id="savedPaymentList" class="grid gap-4 sm:grid-cols-2">
        @foreach (var method in Model.SavedMethods)
        {
            <partial name="_PaymentCardItem" model="method" />
        }
    </div>

    <partial name="_PaymentEmptyState" />
</section>
