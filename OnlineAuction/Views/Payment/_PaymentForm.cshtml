<div class="rounded-2xl border border-stone-200 bg-white/80 p-6 shadow-sm sm:p-8">
    <h2 class="text-lg font-semibold text-stone-900">Add New Payment Method</h2>
    <p class="mt-1 text-sm text-stone-500">Enter your card details below. Information is stored locally for UI demo only.</p>

    <form id="paymentInfoForm" class="mt-6 space-y-5" novalidate>
        <input type="hidden" id="editingCardId" value=""/>

        <!-- Card Type -->
        <fieldset>
            <legend class="block text-sm font-medium text-stone-900">Card Type <span class="text-red-500">*</span></legend>
            <div class="mt-3 flex flex-wrap gap-4" id="cardTypeSelector">
                <label class="inline-flex cursor-pointer items-center gap-2">
                    <input type="radio" name="cardType" value="visa" checked
                           class="h-4 w-4 border-stone-300 text-amber-700 focus:ring-amber-500"/>
                    <span class="text-sm text-stone-700">Visa</span>
                </label>
                <label class="inline-flex cursor-pointer items-center gap-2">
                    <input type="radio" name="cardType" value="mastercard"
                           class="h-4 w-4 border-stone-300 text-amber-700 focus:ring-amber-500"/>
                    <span class="text-sm text-stone-700">Mastercard</span>
                </label>
                <label class="inline-flex cursor-pointer items-center gap-2">
                    <input type="radio" name="cardType" value="other"
                           class="h-4 w-4 border-stone-300 text-amber-700 focus:ring-amber-500"/>
                    <span class="text-sm text-stone-700">Other</span>
                </label>
            </div>
        </fieldset>

        <!-- Card Number -->
        <div>
            <label for="cardNumber" class="block text-sm font-medium text-stone-900">Card Number <span class="text-red-500">*</span></label>
            <input type="text" id="cardNumber" inputmode="numeric" autocomplete="off"
                   placeholder="xxxx xxxx xxxx xxxx" maxlength="19"
                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
            <span id="cardNumberError" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <!-- Card Holder -->
        <div>
            <label for="cardHolder" class="block text-sm font-medium text-stone-900">Card Holder Name <span class="text-red-500">*</span></label>
            <input type="text" id="cardHolder" autocomplete="off" placeholder="NGUYEN VAN A"
                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm uppercase outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
            <span id="cardHolderError" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <!-- Expiry -->
        <div class="grid grid-cols-2 gap-4">
            <div>
                <label for="expiryMonth" class="block text-sm font-medium text-stone-900">Expiry Month <span class="text-red-500">*</span></label>
                <select id="expiryMonth"
                        class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500">
                    <option value="">MM</option>
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value='@m.ToString("D2")'>@m.ToString("D2")</option>
                    }
                </select>
            </div>
            <div>
                <label for="expiryYear" class="block text-sm font-medium text-stone-900">Expiry Year <span class="text-red-500">*</span></label>
                <select id="expiryYear"
                        class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500">
                    <option value="">YY</option>
                    @for (var y = DateTime.Now.Year; y <= DateTime.Now.Year + 15; y++)
                    {
                        <option value='@((y % 100).ToString("D2"))'>@y</option>
                    }
                </select>
            </div>
        </div>
        <span id="expiryError" class="block text-sm text-red-600"></span>

        <!-- CVV -->
        <div class="max-w-xs">
            <label for="cardCvv" class="block text-sm font-medium text-stone-900">CVV <span class="text-red-500">*</span></label>
            <input type="password" id="cardCvv" inputmode="numeric" autocomplete="off"
                   placeholder="XXX" maxlength="4"
                   class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"/>
            <span id="cvvError" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <!-- Billing Address -->
        <div>
            <label for="billingAddress" class="block text-sm font-medium text-stone-900">Billing Address <span class="text-red-500">*</span></label>
            <textarea id="billingAddress" rows="4" placeholder="Street&#10;City&#10;Country"
                      class="mt-2 w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-amber-500 focus:ring-1 focus:ring-amber-500"></textarea>
            <span id="billingError" class="mt-1 block text-sm text-red-600"></span>
        </div>

        <!-- Default -->
        <label class="flex cursor-pointer items-start gap-3">
            <input type="checkbox" id="setAsDefault"
                   class="mt-1 h-4 w-4 rounded border-stone-300 text-amber-700 focus:ring-amber-500"/>
            <span class="text-sm text-stone-600">Set as default payment method</span>
        </label>

        <partial name="_PaymentActions" />
    </form>
</div>
