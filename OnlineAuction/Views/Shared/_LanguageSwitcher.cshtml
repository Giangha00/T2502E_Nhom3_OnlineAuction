@using Microsoft.AspNetCore.Localization
@using Microsoft.Extensions.Localization
@using OnlineAuction.Resources
@inject IStringLocalizer<SharedResource> Localizer

@{
    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";

    var languages = new[]
    {
        new { Code = "en-US", Label = Localizer["English"].Value, Short = "EN" },
        new { Code = "vi-VN", Label = Localizer["Vietnamese"].Value, Short = "VI" },
        new { Code = "ja-JP", Label = Localizer["Japanese"].Value, Short = "JA" },
        new { Code = "ko-KR", Label = Localizer["Korean"].Value, Short = "KO" }
    };

    var current = languages.FirstOrDefault(l => l.Code == currentCulture) ?? languages[0];
}

<div class="relative" id="languageSwitcher" data-e2e="language-switcher">
    <button type="button"
            id="languageButton"
            class="flex items-center gap-2 rounded-full border border-stone-200 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm transition hover:border-blue-300 hover:text-blue-700"
            aria-haspopup="true"
            aria-expanded="false"
            aria-label="@Localizer["Language"]">
        <svg class="h-4 w-4 text-slate-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5a17.92 17.92 0 0 1-8.716-2.247m0 0A8.966 8.966 0 0 1 3 12c0-1.264.26-2.468.732-3.564"/>
        </svg>
        <span>@current.Short</span>
        <svg class="h-3.5 w-3.5 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
        </svg>
    </button>

    <div id="languageDropdown"
         class="absolute right-0 z-50 mt-2 hidden w-52 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl">
        <div class="border-b border-slate-100 px-4 py-2.5">
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@Localizer["Language"]</p>
        </div>
        <form asp-controller="Language" asp-action="SetLanguage" method="post" data-e2e="language-form">
            <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

            @foreach (var lang in languages)
            {
                var isActive = lang.Code == currentCulture;
                <button name="culture" value="@lang.Code" type="submit"
                        class="flex w-full items-center justify-between px-4 py-2.5 text-sm transition @(isActive ? "bg-blue-50 font-semibold text-blue-700" : "text-slate-700 hover:bg-slate-50")">
                    <span class="flex items-center gap-2">
                        @if (isActive)
                        {
                            <svg class="h-4 w-4 text-blue-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5"/>
                            </svg>
                        }
                        else
                        {
                            <span class="inline-block h-4 w-4"></span>
                        }
                        @lang.Label
                    </span>
                    <span class="text-xs @(isActive ? "text-blue-500" : "text-slate-400")">@lang.Short</span>
                </button>
            }
        </form>
    </div>
</div>
