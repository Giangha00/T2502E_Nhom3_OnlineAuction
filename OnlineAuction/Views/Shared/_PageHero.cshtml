@model OnlineAuction.Models.PageHeroViewModel

<section class="page-header border-b border-slate-200 bg-white px-4 py-10 sm:px-8 lg:px-12 lg:py-12">
    <div class="w-full @(Model.Centered ? "mx-auto max-w-3xl text-center" : "")">
        @if (!string.IsNullOrWhiteSpace(Model.Label))
        {
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">@Model.Label</p>
        }
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p class="mt-3 max-w-2xl text-sm leading-relaxed text-slate-600 sm:text-base @(Model.Centered ? "mx-auto" : "")">
                @Model.Description
            </p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ActionText) && !string.IsNullOrWhiteSpace(Model.ActionController))
        {
            <a asp-controller="@Model.ActionController" asp-action="@Model.ActionName"
               class="mt-8 inline-flex items-center rounded-lg bg-blue-700 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-700/20 transition hover:bg-blue-800">
                @Model.ActionText
            </a>
        }
    </div>
</section>
