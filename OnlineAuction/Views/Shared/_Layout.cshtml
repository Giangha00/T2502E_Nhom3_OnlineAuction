@using Microsoft.Extensions.Localization
@using OnlineAuction
@using OnlineAuction.Resources
@using Microsoft.AspNetCore.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthPage = string.Equals(currentController, "Auth", StringComparison.OrdinalIgnoreCase);
    var isPaymentInfoPage = string.Equals(currentController, "Payment", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isStandalonePage = isAuthPage || isPaymentInfoPage;
    var isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
    var isAuctionPage = string.Equals(currentController, "Auction", StringComparison.OrdinalIgnoreCase);
    var isPolicyPage = string.Equals(currentController, "Policy", StringComparison.OrdinalIgnoreCase);
    var isSellPage = string.Equals(currentController, "Sell", StringComparison.OrdinalIgnoreCase);
    var isContactPage = string.Equals(currentController, "Contact", StringComparison.OrdinalIgnoreCase);
    var isAboutPage = string.Equals(currentController, "AboutUs", StringComparison.OrdinalIgnoreCase);
    var isFaqPage = string.Equals(currentController, "Faq", StringComparison.OrdinalIgnoreCase);
    var isRefundPage = string.Equals(currentController, "Refund", StringComparison.OrdinalIgnoreCase);
    var isBrowsePage = isHomePage || isAuctionPage;

    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";

    string NavLinkClass(bool isActive) =>
    isBrowsePage
        ? (isActive ? "text-blue-700 visited:text-blue-700 border-b-2 border-blue-700" : "text-slate-600 visited:text-slate-600 transition hover:text-blue-700")
        : (isActive ? "text-amber-700 visited:text-amber-700" : "text-stone-600 visited:text-stone-600 transition hover:text-amber-700");

    var loginBtnClass = isBrowsePage
        ? "rounded-full border border-blue-700 px-5 py-2 text-sm font-medium text-blue-700 transition hover:bg-blue-50"
        : "rounded-full border border-amber-700 px-5 py-2 text-sm font-medium text-amber-700 transition hover:bg-amber-50";

    var signUpBtnClass = isBrowsePage
        ? "rounded-full bg-blue-700 px-5 py-2 text-sm font-medium text-white shadow-lg shadow-blue-700/20 transition hover:bg-blue-800"
        : "rounded-full bg-amber-700 px-5 py-2 text-sm font-medium text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800";

    string FooterLinkClass(bool isActive) =>
    isActive ? "footer-link footer-link--active" : "footer-link";
}
<!DOCTYPE html>
<html lang="@currentCulture.Replace("_", "-").ToLower()">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(isBrowsePage ? "RareCard" : "Auction House")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineAuction.styles.css" asp-append-version="true" />
</head>

<body
    class="@(isStandalonePage ? "bg-stone-50" : isBrowsePage ? "min-h-screen bg-white text-stone-900" : "min-h-screen bg-gradient-to-br from-stone-100 via-amber-50 to-orange-100 text-stone-800")">
    @if (!isStandalonePage)
    {
        <header id="siteHeader" class="sticky top-0 z-50 w-full border-b border-stone-200/80 bg-white/95 backdrop-blur">
            <div class="site-shell flex items-center gap-4 py-4">
                <a asp-controller="Home" asp-action="Index" class="flex shrink-0 items-center gap-2.5">
                    @if (isBrowsePage)
                    {
                        <span class="text-lg font-extrabold tracking-tight text-slate-900">RareCard</span>
                    }
                    else
                    {
                        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-amber-700 to-stone-900 text-sm font-bold text-white">A</span>
                        <span class="text-sm font-semibold tracking-tight text-stone-900">Auction House</span>
                    }
                </a>

                <form class="relative mx-auto hidden max-w-xl flex-1 md:block" role="search">
                    <input type="search" placeholder="@(isBrowsePage ? "Search rare items..." : "Search by product, category, seller...")" aria-label="Search products"
                        class="w-full rounded-full border border-stone-200 bg-stone-50 py-2.5 pl-4 pr-12 text-sm text-stone-700 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100" />
                    <button type="submit" aria-label="Search"
                        class="absolute right-1 top-1/2 -translate-y-1/2 rounded-full p-2 text-stone-500 hover:text-amber-700">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                    </button>
                </form>

                <div class="hidden shrink-0 items-center gap-2 lg:flex">

                    @await Html.PartialAsync("_LanguageSwitcher")

                    <button type="button" data-auth-tab="login" class="@loginBtnClass">
                        @Localizer["Login"]
                    </button>
                    <button type="button" data-auth-tab="signup" class="@signUpBtnClass">
                        @Localizer["SignUp"]
                    </button>
                </div>

                <button id="mobileMenuBtn" type="button" aria-label="Toggle navigation" aria-expanded="false"
                    class="ml-auto flex flex-col gap-1.5 p-2 lg:hidden">
                    <span class="block h-0.5 w-5 bg-stone-800"></span>
                    <span class="block h-0.5 w-5 bg-stone-800"></span>
                    <span class="block h-0.5 w-5 bg-stone-800"></span>
                </button>
            </div>

            <div class="site-shell border-t border-stone-100 pb-3 md:hidden">
                <form class="relative" role="search">
                    <input type="search" placeholder="Search products..." aria-label="Search products"
                        class="w-full rounded-full border border-stone-200 bg-stone-50 py-2.5 pl-4 pr-12 text-sm outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100" />
                    <button type="submit" aria-label="Search"
                        class="absolute right-1 top-1/2 -translate-y-1/2 rounded-full p-2 text-stone-500">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                    </button>
                </form>
            </div>

            <nav class="hidden w-full border-t border-stone-100 lg:block">
                <div class="site-shell">
                    <ul class="flex overflow-x-auto">
                        <li><a asp-controller="Home" asp-action="Index"
                                class="block whitespace-nowrap py-3.5 pr-4 text-sm font-medium @NavLinkClass(isHomePage)">@Localizer["Home"]</a>
                        </li>
                        <li><a asp-controller="Auction" asp-action="Index"
                                class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium @NavLinkClass(isAuctionPage)">@Localizer["Auction"]</a>
                        </li>
                        <li><a asp-controller="Sell" asp-action="Create"
                                class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium @NavLinkClass(isSellPage)">Sell</a></li>
                        <li><a asp-controller="AboutUs" asp-action="About"
                                class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium @NavLinkClass(isAboutPage)">About
                                Us</a></li>
                        <li><a asp-controller="Contact" asp-action="Index"
                                class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium @NavLinkClass(isContactPage)">@Localizer["Contact"]</a>
                        </li>
                        <li><a asp-controller="Faq" asp-action="Index"
                                class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium @NavLinkClass(isFaqPage)">@Localizer["FAQ"]</a>
                        </li>
                        <li><a asp-controller="Policy" asp-action="Index"
                                class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium @NavLinkClass(isPolicyPage)">Policy
                                &amp; Term of Use</a></li>
                        <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                                class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium text-stone-600 transition hover:text-amber-700">Admin</a>
                        </li>
                    </ul>
                </div>
            </nav>

            <nav id="mobileNav" class="hidden w-full border-t border-stone-200 bg-white lg:hidden">
                <ul class="site-shell py-3">
                    <li><a asp-controller="Home" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @NavLinkClass(isHomePage)">@Localizer["Home"]</a>
                    </li>
                    <li><a asp-controller="Auction" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @NavLinkClass(isAuctionPage)">@Localizer["Auction"]</a>
                    </li>
                    <li><a asp-controller="Sell" asp-action="Create"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @NavLinkClass(isSellPage)">Sell</a></li>
                    <li><a asp-controller="AboutUs" asp-action="About"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @NavLinkClass(isAboutPage)">About
                            Us</a></li>
                    <li><a asp-controller="Contact" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @NavLinkClass(isContactPage)">@Localizer["Contact"]</a>
                    </li>
                    <li><a asp-controller="Faq" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @NavLinkClass(isFaqPage)">@Localizer["FAQ"]</a>
                    </li>
                    <li><a asp-controller="Policy" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @NavLinkClass(isPolicyPage)">Policy
                            &amp; Term of Use</a></li>
                    <li><a asp-area="Admin" asp-controller="Dashboard" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm text-stone-700">Admin</a></li>
                    <li class="flex gap-2 pt-4">
                        <button type="button" data-auth-tab="login"
                            class="flex-1 rounded-full border @(isBrowsePage ? "border-blue-700 text-blue-700" : "border-amber-700 text-amber-700") py-2 text-center text-sm font-medium">
                            @Localizer["Login"]
                        </button>
                        <button type="button" data-auth-tab="signup"
                            class="flex-1 rounded-full @(isBrowsePage ? "bg-blue-700" : "bg-amber-700") py-2 text-center text-sm font-medium text-white">
                            @Localizer["SignUp"]
                        </button>
                    </li>
                </ul>
            </nav>
        </header>
    }

    <main>
        @RenderBody()
    </main>

    @if (!isStandalonePage)
    {
        @await Html.PartialAsync("Partials/_AuthModal")
    }

    @if (!isStandalonePage)
    {
        <footer class="mt-8 w-full border-t border-stone-200 bg-white">
            <div class="site-shell py-12 lg:py-14">
                <div class="grid gap-10 md:grid-cols-[1.2fr_2fr] md:gap-16">
                    <div>
                        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                            <span
                                class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-amber-700 to-stone-900 text-sm font-bold text-white">A</span>
                            <span class="text-sm font-semibold text-stone-900">Auction House</span>
                        </a>
                        <p class="mt-3 max-w-xs text-sm leading-6 text-stone-600">
                            Discover unique products through online auction.
                        </p>
                    </div>

                    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">About</h4>
                            <ul class="mt-4 space-y-2">
                                <li><a asp-controller="AboutUs" asp-action="About"
                                        class="@FooterLinkClass(isAboutPage)">About Us</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">Our Story</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">Careers</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Contact</h4>
                            <ul class="mt-4 space-y-2">
                                <li><a asp-controller="Contact" asp-action="Index"
                                        class="@FooterLinkClass(isContactPage)">Contact Us</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">Support</a></li>
                                <li><a href="mailto:help@auctionhouse.com"
                                        class="@FooterLinkClass(false)">help@auctionhouse.com</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Help</h4>
                            <ul class="mt-4 space-y-2">
                                <li><a asp-controller="Faq" asp-action="Index" class="@FooterLinkClass(isFaqPage)">FAQ</a>
                                </li>
                                <li><a asp-controller="Refund" asp-action="Index"
                                        class="@FooterLinkClass(isRefundPage)">Refund Request</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">How to Bid</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">Seller Guide</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Legal</h4>
                            <ul class="mt-4 space-y-2">
                                <li><a asp-controller="Policy" asp-action="Index"
                                        class="@FooterLinkClass(isPolicyPage)">Policy &amp; Term of Use</a></li>
                                <li><a asp-controller="Policy" asp-action="Index" asp-fragment="privacy-policy"
                                        class="@FooterLinkClass(isPolicyPage)">Privacy Policy</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">Cookie Policy</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="mt-10 border-t border-stone-200 pt-6">
                    <p class="text-xs text-stone-500">&copy; @DateTime.Now.Year Auction House. All rights reserved.</p>
                </div>
            </div>
        </footer>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (!isStandalonePage)
    {
        <script src="~/js/auth-modal.js" asp-append-version="true"></script>
        <script>
            (function () {
                var btn = document.getElementById('mobileMenuBtn');
                var nav = document.getElementById('mobileNav');
                if (!btn || !nav) return;

                btn.addEventListener('click', function () {
                    var isOpen = !nav.classList.contains('hidden');
                    nav.classList.toggle('hidden', isOpen);
                    btn.setAttribute('aria-expanded', String(!isOpen));
                });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>