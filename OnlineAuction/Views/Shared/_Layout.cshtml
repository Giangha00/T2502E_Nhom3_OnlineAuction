@using Microsoft.Extensions.Localization
@using OnlineAuction
@using OnlineAuction.Resources
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Identity
@using OnlineAuction.Entities
@using OnlineAuction.Models
@inject IStringLocalizer<SharedResource> Localizer
@inject UserManager<ApplicationUser> UserManager
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject OnlineAuction.Services.Interfaces.IOrderService OrderService
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var isAuthPage = string.Equals(currentController, "Auth", StringComparison.OrdinalIgnoreCase);
    var isPaymentInfoPage = string.Equals(currentController, "Payment", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isStandalonePage = isAuthPage || isPaymentInfoPage;
    var isHomePage = string.Equals(currentController, "Home", StringComparison.OrdinalIgnoreCase);
    var isAuctionPage = string.Equals(currentController, "Auction", StringComparison.OrdinalIgnoreCase);
    var isBuyNowPage = string.Equals(currentController, "BuyNow", StringComparison.OrdinalIgnoreCase);
    var isPolicyPage = string.Equals(currentController, "Policy", StringComparison.OrdinalIgnoreCase);
    var isSellPage = string.Equals(currentController, "Sell", StringComparison.OrdinalIgnoreCase);
    var isContactPage = string.Equals(currentController, "Contact", StringComparison.OrdinalIgnoreCase);
    var isAboutPage = string.Equals(currentController, "AboutUs", StringComparison.OrdinalIgnoreCase);
    var isFaqPage = string.Equals(currentController, "Faq", StringComparison.OrdinalIgnoreCase);
    var isRefundPage = string.Equals(currentController, "Refund", StringComparison.OrdinalIgnoreCase);
    var isAccountPage = string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase);
    var isAdminArea = string.Equals(ViewContext.RouteData.Values["area"]?.ToString(), "Admin", StringComparison.OrdinalIgnoreCase);
    var isRareCardTheme = !isStandalonePage && !isAdminArea;

    var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name ?? "en-US";
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
    ApplicationUser? currentUser = isLoggedIn ? await UserManager.GetUserAsync(User) : null;
    var displayName = currentUser?.FullName ?? User.Identity?.Name ?? "User";
    var currentUserId = currentUser?.Id ?? 0;
    var orderCount = currentUser is not null ? await OrderService.CountPendingPaymentOrdersAsync(currentUser.Id) : 0;
    var isOrderPage = string.Equals(currentController, "Order", StringComparison.OrdinalIgnoreCase);

    var userInitials = "U";
    AccountShellViewModel? accountMenu = null;
    if (isLoggedIn)
    {
        var nameParts = displayName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        userInitials = nameParts.Length >= 2
            ? $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpperInvariant()
            : (string.IsNullOrWhiteSpace(displayName) ? "U" : char.ToUpperInvariant(displayName[0]).ToString());
        var vaultId = currentUserId > 0 ? (11600000 + currentUserId).ToString() : "11608867";
        accountMenu = new AccountShellViewModel
        {
            UserId = currentUserId,
            DisplayName = displayName,
            Initials = userInitials,
            VaultAddressName = displayName,
            VaultAddressLine1 = $"7560 SW Durham Rd, ID {vaultId}",
            VaultAddressLine2 = "Tigard, OR 97224",
            VaultId = vaultId
        };
    }

    string NavLinkClass(bool isActive) =>
        isActive
            ? "site-nav-link is-active text-blue-700 visited:text-blue-700"
            : "site-nav-link text-slate-600 visited:text-slate-600 transition hover:text-blue-700";

    string MobileNavLinkClass(bool isActive) =>
        isActive ? "text-blue-700 visited:text-blue-700" : "text-slate-600 visited:text-slate-600";

    var loginBtnClass = "rounded-full border border-blue-700 px-5 py-2 text-sm font-medium text-blue-700 transition hover:bg-blue-50";

    var signUpBtnClass = "rounded-full bg-blue-700 px-5 py-2 text-sm font-medium text-white shadow-lg shadow-blue-700/20 transition hover:bg-blue-800";

    string FooterLinkClass(bool isActive) =>
        isActive ? "footer-link footer-link--active" : "footer-link";

    var antiforgeryTokens = Antiforgery.GetAndStoreTokens(Context);
}
<!DOCTYPE html>
<html lang="@currentCulture.Replace("_", "-").ToLower()">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="request-verification-token" content="@antiforgeryTokens.RequestToken" />
    <title>@ViewData["Title"] - @(isRareCardTheme ? "RareCard" : "Auction House")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/OnlineAuction.styles.css" asp-append-version="true" />
</head>

<body
    class="@(isStandalonePage ? "bg-white text-slate-900" : "min-h-screen bg-white text-slate-900")">
    @if (!isStandalonePage)
    {
        <header id="siteHeader" class="sticky top-0 z-50 w-full border-b border-stone-200/80 bg-white/95 backdrop-blur">
            <div class="site-shell flex items-center gap-6 py-4">
                <a asp-controller="Home" asp-action="Index" class="flex shrink-0 items-center gap-2.5">
                    <span class="text-lg font-extrabold tracking-tight text-slate-900">RareCard</span>
                </a>

                <nav class="hidden flex-1 justify-center lg:block" aria-label="Main navigation">
                    <ul class="flex items-center justify-center">
                        <li><a asp-controller="Home" asp-action="Index"
                                class="@NavLinkClass(isHomePage)">@Localizer["Home"]</a></li>
                        <li><a asp-controller="Auction" asp-action="Index"
                                class="@NavLinkClass(isAuctionPage)">@Localizer["Auction"]</a></li>
                        <li><a asp-controller="BuyNow" asp-action="Index"
                                class="@NavLinkClass(isBuyNowPage)">@Localizer["BuyNow"]</a></li>
                        <li><a asp-controller="AboutUs" asp-action="About"
                                class="@NavLinkClass(isAboutPage)">@Localizer["AboutUs"]</a></li>
                        <li><a asp-controller="Contact" asp-action="Index"
                                class="@NavLinkClass(isContactPage)">@Localizer["Contact"]</a></li>
                        <li><a asp-controller="Faq" asp-action="Index"
                                class="@NavLinkClass(isFaqPage)">@Localizer["FAQ"]</a></li>
                    </ul>
                </nav>

                <div class="ml-auto flex items-center gap-2">
                    @if (isLoggedIn)
                    {
                        @await Html.PartialAsync("Partials/_HeaderNotifications", OnlineAuction.Data.MockNotificationData.GetNotifications())
                        <a asp-controller="Order" asp-action="Index"
                           class="relative flex h-10 w-10 items-center justify-center rounded-full text-slate-600 transition hover:bg-slate-100 hover:text-blue-700 @(isOrderPage ? "bg-blue-50 text-blue-700" : "")"
                           aria-label="@Localizer["Layout_WonAuctions"]">
                            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5V6a3.75 3.75 0 1 0-7.5 0v4.5m11.356-1.993 1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 0 1-1.12-1.243l1.264-12A1.125 1.125 0 0 1 5.513 7.5h12.974c.576 0 1.059.435 1.119 1.007ZM8.625 10.5a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Zm7.5 0a.375.375 0 1 1-.75 0 .375.375 0 0 1 .75 0Z"/>
                            </svg>
                            @if (orderCount > 0)
                            {
                                <span class="absolute -right-0.5 -top-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-blue-700 px-1 text-[10px] font-bold text-white">
                                    @(orderCount > 9 ? "9+" : orderCount.ToString())
                                </span>
                            }
                        </a>
                    }
                    @await Html.PartialAsync("_LanguageSwitcher")

                    @if (isLoggedIn)
                    {
                        <div class="relative hidden lg:block" id="userMenuRoot">
                            <button type="button" id="userMenuBtn"
                                    class="flex cursor-pointer items-center gap-2 rounded-full border border-slate-200 bg-white py-1.5 pl-2 pr-3 text-sm font-medium text-slate-700 shadow-sm transition hover:border-blue-200 hover:bg-blue-50 hover:text-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-200"
                                    aria-haspopup="true" aria-expanded="false" aria-controls="userMenuPanel">
                                <span class="account-sidebar__avatar account-sidebar__avatar--sm">@userInitials</span>
                                <span class="max-w-[140px] truncate" title="@displayName">@displayName</span>
                                <svg class="h-4 w-4 text-slate-400 transition" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6"/>
                                </svg>
                            </button>
                            @if (accountMenu is not null)
                            {
                                @await Html.PartialAsync("Partials/_UserMenuDropdown", accountMenu)
                            }
                        </div>
                    }
                    else
                    {
                        <div class="hidden items-center gap-2 lg:flex">
                            <button type="button" data-auth-tab="login" class="@loginBtnClass">
                                @Localizer["Login"]
                            </button>
                            <button type="button" data-auth-tab="signup" class="@signUpBtnClass">
                                @Localizer["SignUp"]
                            </button>
                        </div>
                    }

                    <button id="mobileMenuBtn" type="button" aria-label="@Localizer["Layout_ToggleNavigation"]" aria-expanded="false"
                        class="flex flex-col gap-1.5 p-2 lg:hidden">
                        <span class="block h-0.5 w-5 bg-stone-800"></span>
                        <span class="block h-0.5 w-5 bg-stone-800"></span>
                        <span class="block h-0.5 w-5 bg-stone-800"></span>
                    </button>
                </div>
            </div>

            <nav id="mobileNav" class="hidden w-full border-t border-stone-200 bg-white lg:hidden">
                <ul class="site-shell py-3">
                    <li><a asp-controller="Home" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @MobileNavLinkClass(isHomePage)">@Localizer["Home"]</a></li>
                    <li><a asp-controller="Auction" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @MobileNavLinkClass(isAuctionPage)">@Localizer["Auction"]</a></li>
                    <li><a asp-controller="BuyNow" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @MobileNavLinkClass(isBuyNowPage)">@Localizer["BuyNow"]</a></li>
                    <li><a asp-controller="AboutUs" asp-action="About"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @MobileNavLinkClass(isAboutPage)">@Localizer["AboutUs"]</a></li>
                    <li><a asp-controller="Contact" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @MobileNavLinkClass(isContactPage)">@Localizer["Contact"]</a></li>
                    <li><a asp-controller="Faq" asp-action="Index"
                            class="block border-b border-stone-100 py-3 text-sm font-medium @MobileNavLinkClass(isFaqPage)">@Localizer["FAQ"]</a></li>
                    <li class="flex flex-col gap-2 pt-4">
                        @if (isLoggedIn)
                        {
                            <p class="text-sm font-medium text-slate-700">@displayName</p>
                            <a asp-controller="Account" asp-action="Selling"
                               class="w-full rounded-full border border-blue-200 py-2 text-center text-sm font-medium text-blue-700 transition hover:bg-blue-50">
                                @Localizer["Account_Selling"]
                            </a>
                            <a asp-controller="User" asp-action="Detail" asp-route-id="@currentUserId"
                               class="w-full rounded-full border border-slate-200 py-2 text-center text-sm font-medium text-slate-700 transition hover:bg-slate-50">
                                @Localizer["UserMenu_UserInformation"]
                            </a>
                            <a asp-controller="Account" asp-action="Orders"
                               class="w-full rounded-full border border-slate-200 py-2 text-center text-sm font-medium text-slate-700 transition hover:bg-slate-50">
                                @Localizer["Account_Orders"]
                            </a>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="w-full cursor-pointer rounded-full border border-slate-300 py-2 text-center text-sm font-medium text-slate-700 transition hover:bg-slate-50">
                                    @Localizer["Layout_Logout"]
                                </button>
                            </form>
                        }
                        else
                        {
                            <div class="flex gap-2">
                                <button type="button" data-auth-tab="login"
                                    class="flex-1 rounded-full border border-blue-700 py-2 text-center text-sm font-medium text-blue-700">
                                    @Localizer["Login"]
                                </button>
                                <button type="button" data-auth-tab="signup"
                                    class="flex-1 rounded-full bg-blue-700 py-2 text-center text-sm font-medium text-white">
                                    @Localizer["SignUp"]
                                </button>
                            </div>
                        }
                    </li>
                </ul>
            </nav>
        </header>
    }

    <main>
        @RenderBody()
    </main>

    @if (!isStandalonePage)
    {
        @await Html.PartialAsync("Partials/_AuthModal")
    }

    @if (!isStandalonePage)
    {
        <footer class="mt-8 w-full border-t border-stone-200 bg-white">
            <div class="site-shell py-12 lg:py-14">
                <div class="grid gap-10 md:grid-cols-[1.2fr_2fr] md:gap-16">
                    <div>
                        <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                            <span class="text-lg font-extrabold tracking-tight text-slate-900">RareCard</span>
                        </a>
                        <p class="mt-3 max-w-xs text-sm leading-6 text-slate-600">
                            @Localizer["Layout_Brand_Tagline"]
                        </p>
                    </div>

                    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">@Localizer["Layout_Footer_About"]</h4>
                            <ul class="mt-4 space-y-2">
                                <li><a asp-controller="AboutUs" asp-action="About"
                                        class="@FooterLinkClass(isAboutPage)">@Localizer["Layout_Footer_AboutUs"]</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">@Localizer["Layout_Footer_OurStory"]</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">@Localizer["Layout_Footer_Careers"]</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">@Localizer["Layout_Footer_Contact"]</h4>
                            <ul class="mt-4 space-y-2">
                                <li><a asp-controller="Contact" asp-action="Index"
                                        class="@FooterLinkClass(isContactPage)">@Localizer["Layout_Footer_ContactUs"]</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">@Localizer["Layout_Footer_Support"]</a></li>
                                <li><a href="mailto:help@auctionhouse.com"
                                        class="@FooterLinkClass(false)">help@auctionhouse.com</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">@Localizer["Layout_Footer_Help"]</h4>
                            <ul class="mt-4 space-y-2">
                                <li><a asp-controller="Faq" asp-action="Index" class="@FooterLinkClass(isFaqPage)">@Localizer["FAQ"]</a>
                                </li>
                                <li><a asp-controller="Refund" asp-action="Index"
                                        class="@FooterLinkClass(isRefundPage)">@Localizer["Layout_Footer_RefundRequest"]</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">@Localizer["Layout_Footer_HowToBid"]</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">@Localizer["Layout_Footer_SellerGuide"]</a></li>
                            </ul>
                        </div>
                        <div>
                            <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">@Localizer["Layout_Footer_Legal"]</h4>
                            <ul class="mt-4 space-y-2">
                                <li><a asp-controller="Policy" asp-action="Index"
                                        class="@FooterLinkClass(isPolicyPage)">@Localizer["Layout_Footer_PolicyTerms"]</a></li>
                                <li><a asp-controller="Policy" asp-action="Index" asp-fragment="privacy-policy"
                                        class="@FooterLinkClass(isPolicyPage)">@Localizer["Layout_Footer_PrivacyPolicy"]</a></li>
                                <li><a href="#" class="@FooterLinkClass(false)">@Localizer["Layout_Footer_CookiePolicy"]</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="mt-10 border-t border-stone-200 pt-6">
                    <p class="text-xs text-slate-500">@Localizer["Layout_Copyright", DateTime.Now.Year]</p>
                </div>
            </div>
        </footer>
    }

    <script src="~/js/site.js" asp-append-version="true"></script>
    @if (!isStandalonePage)
    {
        <script>
            window.authModalConfig = {
                i18n: {
                    slide1Eyebrow: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide1_Eyebrow"].Value)),
                    slide1Title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide1_Title"].Value)),
                    slide1Desc: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide1_Desc"].Value)),
                    slide2Eyebrow: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide2_Eyebrow"].Value)),
                    slide2Title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide2_Title"].Value)),
                    slide2Desc: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide2_Desc"].Value)),
                    slide3Eyebrow: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide3_Eyebrow"].Value)),
                    slide3Title: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide3_Title"].Value)),
                    slide3Desc: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["Auth_Slide3_Desc"].Value))
                }
            };
        </script>
        <script src="~/js/auth-modal.js" asp-append-version="true"></script>
        <script src="~/js/language-switcher.js" asp-append-version="true"></script>
        @if (isLoggedIn)
        {
            <script src="~/js/header-notifications.js" asp-append-version="true"></script>
            <script src="~/js/user-menu.js" asp-append-version="true"></script>
        }
        @if (TempData["OpenAuthModal"] is string openAuthTab)
        {
            <script>
                document.addEventListener('DOMContentLoaded', function () {
                    if (typeof window.openAuthModal === 'function') {
                        window.openAuthModal(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(openAuthTab)));
                    }
                });
            </script>
        }
        <script>
            (function () {
                var btn = document.getElementById('mobileMenuBtn');
                var nav = document.getElementById('mobileNav');
                if (!btn || !nav) return;

                btn.addEventListener('click', function () {
                    var isOpen = !nav.classList.contains('hidden');
                    nav.classList.toggle('hidden', isOpen);
                    btn.setAttribute('aria-expanded', String(!isOpen));
                });

                document.querySelectorAll('[data-auto-dismiss]').forEach(function (el) {
                    var delay = Number(el.getAttribute('data-auto-dismiss')) || 5000;
                    window.setTimeout(function () {
                        el.classList.add('hidden');
                    }, delay);
                });
            })();
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
