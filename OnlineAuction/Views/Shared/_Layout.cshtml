@{
    var isAuthPage = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "Auth",
        StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Auction House</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/OnlineAuction.styles.css" asp-append-version="true"/>
</head>
<body class="@ViewData["BodyClass"]">
@if (!isAuthPage)
{
    <header class="site-header">
        <div class="header-top">
            <div class="container-fluid header-container">
                <a class="site-logo" asp-controller="Home" asp-action="Index">
                    <span class="logo-mark">A</span>
                    <span class="logo-text">Auction House</span>
                </a>

                <form class="header-search d-none d-md-block" role="search">
                    <input type="search" class="search-input" placeholder="Search by product, category, seller..." aria-label="Search products"/>
                    <button type="submit" class="search-btn" aria-label="Search">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.3-4.3"/>
                        </svg>
                    </button>
                </form>

                <div class="header-auth">
                    <a asp-controller="Auth" asp-action="Login" class="btn-auth btn-auth-outline">Log In</a>
                    <a asp-controller="Auth" asp-action="SignUp" class="btn-auth btn-auth-solid">Register</a>
                </div>

                <button class="mobile-menu-toggle d-lg-none" type="button" data-bs-toggle="collapse" data-bs-target="#mobileNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
            </div>
        </div>

        <div class="header-search-mobile d-md-none">
            <div class="container-fluid header-container">
                <form role="search">
                    <input type="search" class="search-input" placeholder="Search products..." aria-label="Search products"/>
                    <button type="submit" class="search-btn" aria-label="Search">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"/>
                            <path d="m21 21-4.3-4.3"/>
                        </svg>
                    </button>
                </form>
            </div>
        </div>

        <nav class="header-nav d-none d-lg-block">
            <div class="container-fluid header-container">
                <ul class="nav-menu">
                    <li><a asp-controller="Home" asp-action="Index" class="nav-link active">Home</a></li>
                    <li><a href="#featured-auctions" class="nav-link">Auction</a></li>
                    <li><a href="#" class="nav-link">About Us</a></li>
                    <li><a href="#" class="nav-link">Contact Us</a></li>
                    <li><a href="#" class="nav-link">FAQ</a></li>
                    <li><a href="#" class="nav-link">Policy &amp; Term of Use</a></li>
                </ul>
            </div>
        </nav>

        <nav class="mobile-nav collapse d-lg-none" id="mobileNav">
            <ul class="mobile-nav-menu">
                <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li><a href="#featured-auctions">Auction</a></li>
                <li><a href="#">About Us</a></li>
                <li><a href="#">Contact Us</a></li>
                <li><a href="#">FAQ</a></li>
                <li><a href="#">Policy &amp; Term of Use</a></li>
                <li class="mobile-auth">
                    <a asp-controller="Auth" asp-action="Login" class="btn-auth btn-auth-outline">Log In</a>
                    <a asp-controller="Auth" asp-action="SignUp" class="btn-auth btn-auth-solid">Register</a>
                </li>
            </ul>
        </nav>
    </header>
}

@if (isAuthPage)
{
    <main role="main">
        @RenderBody()
    </main>
}
else
{
    <main>
        @RenderBody()
    </main>
}

@if (!isAuthPage)
{
    <footer class="site-footer">
        <div class="container-fluid footer-container">
            <div class="footer-top">
                <div class="footer-brand">
                    <a class="site-logo" asp-controller="Home" asp-action="Index">
                        <span class="logo-mark">A</span>
                        <span class="logo-text">Auction House</span>
                    </a>
                    <p class="footer-tagline">Discover unique products through online auction.</p>
                </div>

                <div class="footer-links-grid">
                    <div class="footer-col">
                        <h4>About</h4>
                        <ul>
                            <li><a href="#">About Us</a></li>
                            <li><a href="#">Our Story</a></li>
                            <li><a href="#">Careers</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Contact</h4>
                        <ul>
                            <li><a href="#">Contact Us</a></li>
                            <li><a href="#">Support</a></li>
                            <li><a href="#">help@auctionhouse.com</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Help</h4>
                        <ul>
                            <li><a href="#">FAQ</a></li>
                            <li><a href="#">How to Bid</a></li>
                            <li><a href="#">Seller Guide</a></li>
                        </ul>
                    </div>
                    <div class="footer-col">
                        <h4>Legal</h4>
                        <ul>
                            <li><a href="#">Policy &amp; Term of Use</a></li>
                            <li><a href="#">Privacy Policy</a></li>
                            <li><a href="#">Cookie Policy</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <p>&copy; @DateTime.Now.Year Auction House. All rights reserved.</p>
            </div>
        </div>
    </footer>
}

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
