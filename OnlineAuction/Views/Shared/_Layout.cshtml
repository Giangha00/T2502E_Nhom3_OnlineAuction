@{
    var isAuthPage = string.Equals(
        ViewContext.RouteData.Values["controller"]?.ToString(),
        "Auth",
        StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Auction House</title>
    <link rel="preconnect" href="https://fonts.googleapis.com"/>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/output.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/OnlineAuction.styles.css" asp-append-version="true"/>
</head>
<body class="@(isAuthPage ? "bg-stone-50" : "min-h-screen bg-gradient-to-br from-stone-100 via-amber-50 to-orange-100 text-stone-800")">
@if (!isAuthPage)
{
    <header class="sticky top-0 z-50 border-b border-stone-200/80 bg-white/90 backdrop-blur">
        <div class="mx-auto flex max-w-7xl items-center gap-4 px-4 py-4 sm:px-6 lg:px-8">
            <a asp-controller="Home" asp-action="Index" class="flex shrink-0 items-center gap-2.5">
                <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-amber-700 to-stone-900 text-sm font-bold text-white">A</span>
                <span class="text-sm font-semibold tracking-tight text-stone-900">Auction House</span>
            </a>

            <form class="relative mx-auto hidden max-w-xl flex-1 md:block" role="search">
                <input type="search" placeholder="Search by product, category, seller..." aria-label="Search products"
                       class="w-full rounded-full border border-stone-200 bg-stone-50 py-2.5 pl-4 pr-12 text-sm text-stone-700 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"/>
                <button type="submit" aria-label="Search"
                        class="absolute right-1 top-1/2 -translate-y-1/2 rounded-full p-2 text-stone-500 hover:text-amber-700">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                </button>
            </form>

            <div class="hidden shrink-0 items-center gap-2 lg:flex">
                <a asp-controller="Auth" asp-action="Login"
                   class="rounded-full border border-amber-700 px-5 py-2 text-sm font-medium text-amber-700 transition hover:bg-amber-50">
                    Log In
                </a>
                <a asp-controller="Auth" asp-action="SignUp"
                   class="rounded-full bg-amber-700 px-5 py-2 text-sm font-medium text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800">
                    Register
                </a>
            </div>

            <button id="mobileMenuBtn" type="button" aria-label="Toggle navigation" aria-expanded="false"
                    class="ml-auto flex flex-col gap-1.5 p-2 lg:hidden">
                <span class="block h-0.5 w-5 bg-stone-800"></span>
                <span class="block h-0.5 w-5 bg-stone-800"></span>
                <span class="block h-0.5 w-5 bg-stone-800"></span>
            </button>
        </div>

        <div class="border-t border-stone-100 px-4 pb-3 md:hidden sm:px-6">
            <form class="relative" role="search">
                <input type="search" placeholder="Search products..." aria-label="Search products"
                       class="w-full rounded-full border border-stone-200 bg-stone-50 py-2.5 pl-4 pr-12 text-sm outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"/>
                <button type="submit" aria-label="Search"
                        class="absolute right-1 top-1/2 -translate-y-1/2 rounded-full p-2 text-stone-500">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"/>
                        <path d="m21 21-4.3-4.3"/>
                    </svg>
                </button>
            </form>
        </div>

        <nav class="hidden border-t border-stone-100 lg:block">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
                <ul class="flex overflow-x-auto">
                    <li><a asp-controller="Home" asp-action="Index" class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium text-amber-700">Home</a></li>
                    <li><a href="#featured-auctions" class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium text-stone-600 transition hover:text-amber-700">Auction</a></li>
                    <li><a href="#" class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium text-stone-600 transition hover:text-amber-700">About Us</a></li>
                    <li><a href="#" class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium text-stone-600 transition hover:text-amber-700">Contact Us</a></li>
                    <li><a href="#" class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium text-stone-600 transition hover:text-amber-700">FAQ</a></li>
                    <li><a href="#" class="block whitespace-nowrap px-4 py-3.5 text-sm font-medium text-stone-600 transition hover:text-amber-700">Policy &amp; Term of Use</a></li>
                </ul>
            </div>
        </nav>

        <nav id="mobileNav" class="hidden border-t border-stone-200 bg-white lg:hidden">
            <ul class="px-4 py-3 sm:px-6">
                <li><a asp-controller="Home" asp-action="Index" class="block border-b border-stone-100 py-3 text-sm font-medium text-stone-900">Home</a></li>
                <li><a href="#featured-auctions" class="block border-b border-stone-100 py-3 text-sm text-stone-700">Auction</a></li>
                <li><a href="#" class="block border-b border-stone-100 py-3 text-sm text-stone-700">About Us</a></li>
                <li><a href="#" class="block border-b border-stone-100 py-3 text-sm text-stone-700">Contact Us</a></li>
                <li><a href="#" class="block border-b border-stone-100 py-3 text-sm text-stone-700">FAQ</a></li>
                <li><a href="#" class="block border-b border-stone-100 py-3 text-sm text-stone-700">Policy &amp; Term of Use</a></li>
                <li class="flex gap-2 pt-4">
                    <a asp-controller="Auth" asp-action="Login"
                       class="flex-1 rounded-full border border-amber-700 py-2 text-center text-sm font-medium text-amber-700">Log In</a>
                    <a asp-controller="Auth" asp-action="SignUp"
                       class="flex-1 rounded-full bg-amber-700 py-2 text-center text-sm font-medium text-white">Register</a>
                </li>
            </ul>
        </nav>
    </header>
}

<main>
    @RenderBody()
</main>

@if (!isAuthPage)
{
    <footer class="mt-8 border-t border-stone-200/80 bg-white/70">
        <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
            <div class="grid gap-10 md:grid-cols-[1.2fr_2fr] md:gap-16">
                <div>
                    <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-amber-700 to-stone-900 text-sm font-bold text-white">A</span>
                        <span class="text-sm font-semibold text-stone-900">Auction House</span>
                    </a>
                    <p class="mt-3 max-w-xs text-sm leading-6 text-stone-600">
                        Discover unique products through online auction.
                    </p>
                </div>

                <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
                    <div>
                        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">About</h4>
                        <ul class="mt-4 space-y-2">
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">About Us</a></li>
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Our Story</a></li>
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Careers</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Contact</h4>
                        <ul class="mt-4 space-y-2">
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Contact Us</a></li>
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Support</a></li>
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">help@auctionhouse.com</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Help</h4>
                        <ul class="mt-4 space-y-2">
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">FAQ</a></li>
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">How to Bid</a></li>
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Seller Guide</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Legal</h4>
                        <ul class="mt-4 space-y-2">
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Policy &amp; Term of Use</a></li>
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Privacy Policy</a></li>
                            <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Cookie Policy</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <div class="mt-10 border-t border-stone-200 pt-6">
                <p class="text-xs text-stone-500">&copy; @DateTime.Now.Year Auction House. All rights reserved.</p>
            </div>
        </div>
    </footer>
}

<script src="~/js/site.js" asp-append-version="true"></script>
@if (!isAuthPage)
{
    <script>
        (function () {
            var btn = document.getElementById('mobileMenuBtn');
            var nav = document.getElementById('mobileNav');
            if (!btn || !nav) return;

            btn.addEventListener('click', function () {
                var isOpen = !nav.classList.contains('hidden');
                nav.classList.toggle('hidden', isOpen);
                btn.setAttribute('aria-expanded', String(!isOpen));
            });
        })();
    </script>
}
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
