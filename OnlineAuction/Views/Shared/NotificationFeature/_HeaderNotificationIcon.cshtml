@model IEnumerable<OnlineAuction.Models.NotificationItemViewModel>
@{
    var notifications = Model.ToList();
    var unreadCount = notifications.Count(notification => !notification.IsRead);
    var previewItems = notifications.Take(3).ToList();
}

<div class="relative" data-notification-header>
    <button type="button"
            class="relative inline-flex h-10 w-10 items-center justify-center rounded-full border border-stone-200 bg-white text-stone-700 shadow-sm transition hover:border-amber-300 hover:bg-amber-50 hover:text-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-600 focus:ring-offset-2"
            aria-label="Open notifications"
            aria-expanded="false"
            data-notification-toggle>
        <span class="text-lg leading-none" aria-hidden="true">🔔</span>
        <span class="absolute -right-1 -top-1 min-w-5 rounded-full bg-red-600 px-1.5 py-0.5 text-center text-[11px] font-bold leading-none text-white"
              data-notification-badge>@unreadCount</span>
    </button>

    <div class="absolute right-0 top-12 z-50 hidden w-[min(92vw,24rem)] overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-2xl"
         data-notification-dropdown>
        <div class="flex items-center justify-between border-b border-stone-100 px-4 py-3">
            <div>
                <p class="text-sm font-semibold text-stone-950">Notifications</p>
                <p class="text-xs text-stone-500">@unreadCount unread updates</p>
            </div>
            <button type="button"
                    class="rounded-full px-3 py-1.5 text-xs font-semibold text-amber-800 transition hover:bg-amber-50"
                    data-mark-all-read>Mark all</button>
        </div>

        <div class="max-h-80 overflow-y-auto py-2">
            @foreach (var item in previewItems)
            {
                <a href="/notifications/@item.Id"
                   class="group flex gap-3 px-4 py-3 transition hover:bg-stone-50 @(item.IsRead ? "bg-white" : "bg-amber-50/70")"
                   data-notification-preview
                   data-read="@item.IsRead.ToString().ToLowerInvariant()">
                    <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white text-lg shadow-sm ring-1 ring-stone-200">@item.Icon</span>
                    <span class="min-w-0 flex-1">
                        <span class="flex items-center gap-2">
                            @if (!item.IsRead)
                            {
                                <span class="h-2 w-2 shrink-0 rounded-full bg-amber-700" aria-label="Unread"></span>
                            }
                            <span class="truncate text-sm font-semibold text-stone-950">@item.Title</span>
                        </span>
                        <span class="mt-1 line-clamp-2 text-xs leading-5 text-stone-600">@item.Description</span>
                        <span class="mt-1 block text-xs font-medium text-stone-400">@item.TimeAgo</span>
                    </span>
                </a>
            }
        </div>

        <div class="border-t border-stone-100 p-3">
            <a href="/notifications"
               class="block rounded-xl bg-stone-950 px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-stone-800">
                View All
            </a>
        </div>
    </div>
</div>
