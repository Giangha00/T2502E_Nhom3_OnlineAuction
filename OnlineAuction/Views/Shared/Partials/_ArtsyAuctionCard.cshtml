@model OnlineAuction.Models.AuctionCardViewModel
@{
    var item = Model.Item;
    var bidCount = (item.Id * 3 + 7) % 24 + 3;
    var isEndingSoon = item.Status == "Ending Soon";
    var isWon = item.Status == "Won";
}

<article class="artsy-card group @(Model.EnableFiltering ? "auction-card" : "")"
@if (Model.EnableFiltering)
{
  @:data-id="@item.Id" data-name="@item.Name.ToLowerInvariant()" data-category="@item.Category" data-price="@item.CurrentPrice" data-time="@item.TimeRemaining"
}
>
  <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id" class="artsy-card__media block">
    <div class="relative aspect-[3/4] overflow-hidden bg-stone-100">
      <img src="@item.ImageUrl" alt="@item.Name" loading="lazy"
           class="h-full w-full object-cover object-center transition duration-700 ease-out group-hover:scale-[1.03]"/>
      @if (isEndingSoon)
      {
        <span class="absolute left-0 top-0 bg-stone-900 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-widest text-white">
          Ending soon
        </span>
      }
      else if (!isWon)
      {
        <span class="absolute left-0 top-0 bg-white/95 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-widest text-stone-800">
          Live
        </span>
      }
      <div class="artsy-card__overlay absolute inset-0 flex items-end bg-gradient-to-t from-stone-900/50 via-transparent to-transparent p-3 opacity-0 transition duration-300 group-hover:opacity-100">
        <span class="text-xs font-medium text-white">View lot →</span>
      </div>
    </div>
  </a>
  <div class="artsy-card__body mt-3 space-y-1">
    <p class="text-[11px] font-medium uppercase tracking-[0.14em] text-stone-400">@item.Category</p>
    <h3 class="artsy-card__title line-clamp-2 text-[15px] font-medium leading-snug text-stone-900">
      <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id"
         class="transition hover:text-amber-800">@item.Name</a>
    </h3>
    <div class="flex items-baseline gap-2 pt-0.5">
      <span class="text-xs text-stone-500">@(isWon ? "Winning bid" : "Current bid")</span>
      <span class="text-sm font-semibold tabular-nums text-stone-900">$@item.CurrentPrice.ToString("N0")</span>
    </div>
    <p class="text-xs text-stone-400">
      <span class="tabular-nums">@bidCount bids</span>
      <span class="mx-1.5">·</span>
      <span>@item.TimeRemaining</span>
    </p>
    @if (Model.ShowBidLink)
    {
      <div class="pt-2">
        @if (isWon)
        {
          <a asp-controller="Payment" asp-action="Checkout" asp-route-auctionId="@item.Id"
             class="inline-flex text-xs font-semibold uppercase tracking-wider text-emerald-700 transition hover:text-emerald-900">
            Complete payment →
          </a>
        }
        else
        {
          <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id"
             class="inline-flex text-xs font-semibold uppercase tracking-wider text-stone-800 underline decoration-stone-300 underline-offset-4 transition hover:text-amber-800 hover:decoration-amber-400">
            Place bid
          </a>
        }
      </div>
    }
  </div>
</article>
