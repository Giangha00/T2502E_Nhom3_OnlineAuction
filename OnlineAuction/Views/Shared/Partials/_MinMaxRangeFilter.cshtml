@{
    var title = (string)ViewData["RangeTitle"]!;
    var key = (string)ViewData["RangeKey"]!;
    var keyLower = key.ToLowerInvariant();
}
<div class="border-b border-stone-200 pb-6">
  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">@title</h3>
  <div class="mt-3 flex items-end gap-2">
    <div class="min-w-0 flex-1">
      <label for="filter@(key)Min" class="mb-1 block text-xs text-slate-500">From:</label>
      <input type="number"
             id="filter@(key)Min"
             inputmode="decimal"
             step="any"
             placeholder="Enter min"
             class="filter-@keyLower-min w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm outline-none focus:border-blue-600"/>
    </div>
    <div class="min-w-0 flex-1">
      <label for="filter@(key)Max" class="mb-1 block text-xs text-slate-500">To:</label>
      <input type="number"
             id="filter@(key)Max"
             inputmode="decimal"
             step="any"
             placeholder="Enter max"
             class="filter-@keyLower-max w-full rounded-lg border border-stone-300 bg-white px-3 py-2 text-sm outline-none focus:border-blue-600"/>
    </div>
    <button type="button"
            id="filter@(key)Apply"
            aria-label="Apply @title filter"
            class="filter-@keyLower-apply mb-0.5 flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-stone-300 bg-white text-lg text-slate-600 hover:bg-stone-50 hover:text-slate-900">
      →
    </button>
  </div>
</div>
