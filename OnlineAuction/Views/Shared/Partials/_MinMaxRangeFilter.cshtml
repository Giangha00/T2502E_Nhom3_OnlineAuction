@{
    var rangeTitle = ViewData["RangeTitle"]?.ToString() ?? "Range";
    var rangeKey = ViewData["RangeKey"]?.ToString() ?? "Range";
}

<div class="border-b border-stone-200 pb-6">
  <h3 class="text-xs font-bold uppercase tracking-wider text-slate-900">@rangeTitle</h3>
  <div class="mt-3 flex items-center gap-2">
    <input type="number"
           id="filter@(rangeKey)Min"
           placeholder="Min"
           class="w-full rounded-lg border border-stone-200 bg-white px-3 py-2 text-sm text-slate-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
    <span class="text-slate-400">—</span>
    <input type="number"
           id="filter@(rangeKey)Max"
           placeholder="Max"
           class="w-full rounded-lg border border-stone-200 bg-white px-3 py-2 text-sm text-slate-800 outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
    <button type="button"
            id="filter@(rangeKey)Apply"
            class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border border-stone-200 bg-white text-slate-600 transition hover:border-blue-500 hover:text-blue-700"
            aria-label="Apply @rangeTitle filter">
      →
    </button>
  </div>
</div>
