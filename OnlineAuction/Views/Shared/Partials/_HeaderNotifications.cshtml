@using Microsoft.Extensions.Localization
@using OnlineAuction.Resources
@model IEnumerable<OnlineAuction.Models.NotificationItemViewModel>
@inject IStringLocalizer<SharedResource> Localizer

@{
    var notifications = Model.ToList();
    var unreadCount = notifications.Count(n => !n.IsRead);
}

<div class="relative" id="headerNotifications" data-read-all-label="@Localizer["ReadAll"]">
    <button type="button"
            id="notificationButton"
            class="relative flex h-10 w-10 items-center justify-center rounded-full border border-stone-200 bg-white text-slate-600 transition hover:border-blue-300 hover:text-blue-700"
            aria-label="@Localizer["Notifications"]"
            aria-haspopup="true"
            aria-expanded="false">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"/>
        </svg>
        <span id="notificationBadge"
              class="@(unreadCount > 0 ? "" : "hidden") absolute -right-0.5 -top-0.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-red-600 px-1 text-[10px] font-bold text-white">
            @unreadCount
        </span>
    </button>

    <div id="notificationDropdown"
         class="absolute right-0 z-50 mt-2 hidden w-80 overflow-hidden rounded-xl border border-slate-200 bg-white shadow-xl sm:w-96">
        <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
            <h3 class="text-sm font-semibold text-slate-900">@Localizer["Notifications"]</h3>
            <button type="button" id="readAllNotifications"
                    class="text-xs font-semibold text-blue-700 transition hover:text-blue-800">
                @Localizer["ReadAll"]
            </button>
        </div>

        <ul id="notificationList" class="max-h-80 overflow-y-auto">
            @foreach (var item in notifications)
            {
                <li>
                    <button type="button"
                            class="notification-item flex w-full gap-3 border-b border-slate-50 px-4 py-3 text-left transition hover:bg-slate-50 @(item.IsRead ? "is-read" : "is-unread bg-blue-50/40")"
                            data-notification-id="@item.Id"
                            data-notification-url="@item.RelatedUrl">
                        <span class="notification-dot mt-1.5 h-2 w-2 shrink-0 rounded-full @(item.IsRead ? "bg-transparent" : "bg-blue-600")"></span>
                        <span class="min-w-0 flex-1">
                            <span class="block text-sm font-medium text-slate-900">@item.Title</span>
                            <span class="mt-0.5 block text-xs leading-relaxed text-slate-500">@item.Message</span>
                            <span class="mt-1 block text-[11px] text-slate-400">@item.TimeAgo</span>
                        </span>
                    </button>
                </li>
            }
        </ul>

        <div id="notificationEmpty" class="@(notifications.Count > 0 ? "hidden" : "") px-4 py-8 text-center">
            <p class="text-sm text-slate-500">@Localizer["NoNotifications"]</p>
        </div>
    </div>
</div>
