@model OnlineAuction.Models.RelatedListingsCarouselViewModel

@if (Model.Items.Count > 0)
{
  <section class="product-detail-related__carousel" data-home-carousel data-product-related-carousel>
    <div class="mb-4 flex items-center justify-between gap-4">
      <h2 class="text-lg font-bold text-slate-900 sm:text-xl">@Model.Title</h2>
    </div>
    <div class="home-carousel-shell">
      <button type="button"
              class="home-carousel-btn home-carousel-btn--prev"
              data-home-carousel-prev
              aria-label="Scroll @Model.Title left">
        ‹
      </button>
      <div class="home-carousel-fade home-carousel-fade--left" aria-hidden="true"></div>
      <div class="home-carousel-fade home-carousel-fade--right" aria-hidden="true"></div>
      <div class="product-detail-related-row" data-home-carousel-track id="product-related-@Model.SectionKey">
        @foreach (var item in Model.Items)
        {
          <div class="product-detail-related-row__item">
            <partial name="~/Views/Home/Partials/_RecommendedDealCard.cshtml" model="item"/>
          </div>
        }
      </div>
      <button type="button"
              class="home-carousel-btn home-carousel-btn--next"
              data-home-carousel-next
              aria-label="Scroll @Model.Title right">
        ›
      </button>
    </div>
  </section>
}
