@model OnlineAuction.Models.AuctionCardViewModel
@using System.Text.RegularExpressions
@using Microsoft.AspNetCore.Authentication
@using OnlineAuction.Configurations
@using OnlineAuction.Helpers
@{
    var item = Model.Item;
    var variant = Model.Variant ?? "grid";
    var isBuyNow = string.Equals(Model.CardMode, "buynow", StringComparison.OrdinalIgnoreCase);
    var isEndingSoon = item.ListingPhase == AuctionListingPhases.LiveEndingSoon || item.Status == "Ending Soon";
    var isWon = item.Status == "Won";
    var phaseLabelKey = $"Auction_Phase_{item.ListingPhase}";
    var phaseBadgeClass = item.ListingPhase switch
    {
        AuctionListingPhases.RegistrationOpen => "bg-sky-600 text-white",
        AuctionListingPhases.RegistrationClosed => "bg-amber-500 text-white",
        AuctionListingPhases.LiveAuction => "bg-emerald-600 text-white",
        AuctionListingPhases.LiveEndingSoon => "bg-red-600 text-white",
        _ => "bg-slate-600 text-white"
    };
    var countdownLabelKey = item.PhaseCountdownKind switch
    {
        "registration_end" => "Auction_Countdown_RegistrationEnd",
        "live_start" => "Auction_Countdown_LiveStart",
        "live_end" => "Auction_Countdown_LiveEnd",
        "registration_start" => "Auction_Countdown_RegistrationStart",
        _ => "Card_TimeLeft"
    };
    var actionLabel = isBuyNow ? Localizer["Card_AddToCart"].Value : (isWon ? Localizer["Card_CompletePayment"].Value : Localizer["Card_BidNow"].Value);
    var userAuth = await Context.AuthenticateAsync(AuthSchemes.User);
    var isLoggedIn = userAuth.Succeeded;
    var gradeNumber = string.Empty;
    if (!string.IsNullOrWhiteSpace(item.Grade))
    {
        var gradeMatch = Regex.Match(item.Grade, @"(\d+(?:\.\d+)?)");
        if (gradeMatch.Success)
        {
            gradeNumber = gradeMatch.Groups[1].Value;
        }
    }
    var filterAttrs = Model.EnableFiltering
        ? $"data-id=\"{item.Id}\" data-name=\"{item.Name.ToLowerInvariant()}\" data-category=\"{item.Category}\" data-price=\"{item.CurrentPrice}\" data-time=\"{item.TimeRemaining}\" data-year=\"{item.Year}\" data-grade=\"{gradeNumber}\" data-authenticator=\"{item.Authenticator}\" data-phase=\"{item.ListingPhase}\" data-ending-soon=\"{isEndingSoon.ToString().ToLowerInvariant()}\""
        : "";
    var priceLabelKey = isWon
        ? "Card_WinningBid"
        : isBuyNow
            ? "BuyNow_Price"
            : Model.PriceLabelResourceKey;
}

@if (variant == "hot")
{
    <article class="rarecard-card rarecard-card--hot group @((Model.EnableFiltering ? "auction-card" : ""))" @Html.Raw(filterAttrs)>
        <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id" class="block">
            <div class="relative overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm">
                <div class="relative aspect-[3/4] bg-stone-100">
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"/>
                    @if (isEndingSoon)
                    {
                        <span class="absolute left-3 top-3 rounded-md bg-red-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">@Localizer["Card_EndingSoon"]</span>
                    }
                    else if (item.IsHot)
                    {
                        <span class="absolute left-3 top-3 rounded-md bg-red-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">@Localizer["Card_Hot"]</span>
                    }
                    @if (!string.IsNullOrEmpty(item.Grade))
                    {
                        <span class="absolute right-3 top-3 rounded-md bg-white/95 px-2 py-0.5 text-[10px] font-bold text-slate-800 shadow">@item.Grade</span>
                    }
                </div>
                <div class="p-4">
                    <h3 class="line-clamp-2 text-sm font-semibold text-stone-900">@item.Name</h3>
                    <div class="mt-3 flex items-end justify-between gap-2">
                        <div>
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">@Localizer["Card_CurrentBid"]</p>
                            <p class="text-lg font-bold tabular-nums text-blue-700">$@item.CurrentPrice.ToString("N0")</p>
                        </div>
                        <p class="text-right text-xs font-semibold tabular-nums @(isEndingSoon ? "text-red-600" : "text-stone-600")">@item.TimeRemaining</p>
                    </div>
                    @if (Model.ShowBidLink)
                    {
                        <span class="mt-4 block w-full rounded-full bg-slate-900 py-2.5 text-center text-xs font-semibold uppercase tracking-wider text-white transition group-hover:bg-blue-800">
                            @Localizer["Card_PlaceBid"]
                        </span>
                    }
                </div>
            </div>
        </a>
    </article>
}
else if (variant == "compact")
{
    <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id"
       class="rarecard-ending-item group flex gap-3 rounded-xl border border-stone-200 bg-white p-3 transition hover:border-blue-200 hover:shadow-md">
        <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" class="h-20 w-16 shrink-0 rounded-lg object-cover"/>
        <div class="min-w-0 flex-1">
            <p class="line-clamp-2 text-sm font-semibold text-stone-900 group-hover:text-blue-800">@item.Name</p>
            <p class="mt-1 text-sm font-bold tabular-nums text-blue-700">$@item.CurrentPrice.ToString("N0")</p>
            <p class="mt-0.5 text-xs font-medium text-red-600">@item.TimeRemaining</p>
        </div>
    </a>
}
else if (variant == "home")
{
    <article class="rarecard-card rarecard-card--home group">
        <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition duration-300 group-hover:shadow-lg">
            <a asp-controller="@(isBuyNow ? "BuyNow" : "Auction")"
               asp-action="Detail"
               asp-route-id="@item.Id"
               class="block">
                <div class="relative aspect-[3/4] bg-stone-50">
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"/>
                    @if (!string.IsNullOrEmpty(item.Grade))
                    {
                        <span class="absolute left-3 top-3 rounded-md bg-slate-900 px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-white">@item.Grade</span>
                    }
                </div>
                <div class="p-4">
                    <h3 class="line-clamp-2 text-base font-semibold leading-snug text-stone-900">@item.Name</h3>
                    @if (!string.IsNullOrEmpty(item.Subtitle))
                    {
                        <p class="mt-1 line-clamp-1 text-xs text-stone-500">@item.Subtitle</p>
                    }
                    <div class="mt-3.5 flex items-end justify-between gap-2 border-t border-stone-100 pt-3.5">
                        <div>
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">@(isBuyNow ? Localizer["BuyNow_Price"] : Localizer["Card_CurrentBid"])</p>
                            <p class="text-xl font-bold tabular-nums text-blue-700">$@item.CurrentPrice.ToString("N0")</p>
                        </div>
                        @if (!isBuyNow)
                        {
                            <p class="max-w-[6rem] truncate text-right text-xs font-medium tabular-nums @(isEndingSoon ? "text-red-600" : "text-stone-600")">@item.TimeRemaining</p>
                        }
                    </div>
                </div>
            </a>
            @if (Model.ShowBidLink)
            {
                @if (isBuyNow)
                {
                    <div class="px-4 pb-4">
                        <button type="button"
                                class="buy-now-add-to-cart mt-3.5 block w-full rounded-full bg-blue-700 py-2.5 text-center text-xs font-semibold uppercase tracking-wide text-white transition hover:bg-blue-800"
                                data-auction-id="@item.Id"
                                data-is-logged-in="@(isLoggedIn ? "true" : "false")"
                                data-label="@actionLabel"
                                data-adding-label="@Localizer["Js_BuyNow_Adding"]">
                            @actionLabel
                        </button>
                    </div>
                }
                else
                {
                    <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id" class="block px-4 pb-4">
                        <span class="mt-3.5 block w-full rounded-full bg-blue-700 py-2.5 text-center text-xs font-semibold uppercase tracking-wide text-white transition group-hover:bg-blue-800">
                            @actionLabel
                        </span>
                    </a>
                }
            }
        </div>
    </article>
}
else if (variant == "related")
{
    <article class="rarecard-card rarecard-card--related group">
        <div class="overflow-hidden rounded-xl border border-stone-200 bg-white shadow-sm transition hover:shadow-md">
            <a asp-controller="@(isWon ? "Order" : isBuyNow ? "BuyNow" : "Auction")"
               asp-action="@(isWon ? "Index" : "Detail")"
               asp-route-id="@(isWon ? null : item.Id)"
               class="block min-h-[44px]">
                <div class="relative aspect-[3/4] bg-stone-50">
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" class="h-full w-full object-cover"/>
                    @if (!isBuyNow && !string.IsNullOrWhiteSpace(item.ListingPhase))
                    {
                        <span class="absolute left-2 top-2 max-w-[calc(100%-1rem)] rounded px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide shadow @phaseBadgeClass">
                            @Localizer[phaseLabelKey]
                        </span>
                    }
                    else if (isBuyNow)
                    {
                        <span class="absolute left-2 top-2 rounded px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white bg-emerald-600">@Localizer["BuyNow_InStock"]</span>
                    }
                    else if (!string.IsNullOrEmpty(item.Grade))
                    {
                        <span class="absolute right-2 top-2 rounded bg-slate-900 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white">@item.Grade</span>
                    }
                </div>
                <div class="p-3">
                    <h3 class="line-clamp-2 text-xs font-semibold leading-snug text-stone-900">@item.Name</h3>
                    <div class="mt-2.5 flex items-end justify-between gap-2 border-t border-stone-100 pt-2.5">
                        <div>
                            <p class="text-[9px] font-semibold uppercase tracking-wider text-stone-400">@Localizer[priceLabelKey]</p>
                            <p class="text-base font-bold tabular-nums text-blue-700">$@item.CurrentPrice.ToString("N0")</p>
                        </div>
                        @if (Model.ShowTimeRemaining && !isBuyNow)
                        {
                            <div class="text-right">
                                <p class="text-[9px] font-semibold uppercase tracking-wider text-stone-400">@Localizer[countdownLabelKey]</p>
                                <p class="text-[11px] font-semibold tabular-nums @(isEndingSoon ? "text-red-600" : "text-stone-700")">@item.TimeRemaining</p>
                            </div>
                        }
                    </div>
                </div>
            </a>
        </div>
    </article>
}
else
{
    <article class="rarecard-card rarecard-card--grid group @(Model.EnableFiltering ? "auction-card" : "")" @Html.Raw(filterAttrs)>
        <div class="overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:shadow-lg">
            <a asp-controller="@(isWon ? "Order" : isBuyNow ? "BuyNow" : "Auction")"
               asp-action="@(isWon ? "Index" : "Detail")"
               asp-route-id="@(isWon ? null : item.Id)"
               class="block">
                <div class="relative aspect-[4/5] bg-stone-50">
                    <img src="@item.ImageUrl" alt="@item.Name" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.02]"/>
                    @if (!isBuyNow && !string.IsNullOrWhiteSpace(item.ListingPhase))
                    {
                        <span class="absolute left-3 top-3 max-w-[calc(100%-1.5rem)] rounded-md px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide shadow @phaseBadgeClass">
                            @Localizer[phaseLabelKey]
                        </span>
                    }
                    else if (isBuyNow && !Model.ShowTimeRemaining)
                    {
                        <span class="absolute left-3 top-3 rounded-md bg-emerald-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">@Localizer["BuyNow_InStock"]</span>
                    }
                    else if (!string.IsNullOrEmpty(item.Grade))
                    {
                        <span class="absolute @(isBuyNow ? "left-3 top-3" : "right-3 top-3") rounded-md bg-slate-900 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">@item.Grade</span>
                    }
                    @if (Model.ShowWatchlistButton)
                    {
                        <button type="button"
                                data-watchlist-toggle
                                data-auction-id="@item.Id"
                                data-watched="@(Model.IsWatched ? "true" : "false")"
                                aria-pressed="@(Model.IsWatched ? "true" : "false")"
                                aria-label="@(Model.IsWatched ? "Remove from watchlist" : "Add to watchlist")"
                                class="watchlist-btn absolute bottom-3 right-3 flex h-8 w-8 items-center justify-center rounded-full bg-white/95 shadow transition @(Model.IsWatched ? "text-red-500" : "text-stone-400 hover:text-red-500")">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="@(Model.IsWatched ? "currentColor" : "none")" stroke="currentColor" stroke-width="2">
                                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
                            </svg>
                        </button>
                    }
                </div>
                <div class="p-4">
                    <p class="text-[10px] font-bold uppercase tracking-wide text-blue-700">@item.Category</p>
                    <h3 class="mt-1 line-clamp-2 text-sm font-semibold leading-snug text-stone-900">@item.Name</h3>
                    @if (!string.IsNullOrEmpty(item.Subtitle))
                    {
                        <p class="mt-1 line-clamp-1 text-xs text-stone-500">@item.Subtitle</p>
                    }
                    @if (Model.ShowProductMeta && (!string.IsNullOrEmpty(item.Grade) || !string.IsNullOrEmpty(item.Condition) || item.Year > 0))
                    {
                        <div class="mt-2 flex flex-wrap gap-x-2 gap-y-1 text-[10px] font-semibold uppercase tracking-wide text-stone-500">
                            @if (!string.IsNullOrEmpty(item.Grade))
                            {
                                <span>@item.Grade</span>
                            }
                            @if (!string.IsNullOrEmpty(item.Condition))
                            {
                                <span>@item.Condition</span>
                            }
                            @if (item.Year > 0)
                            {
                                <span>@item.Year</span>
                            }
                        </div>
                    }
                    <div class="mt-4 flex items-end justify-between gap-2 border-t border-stone-100 pt-3">
                        <div>
                            <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">@Localizer[priceLabelKey]</p>
                            <p class="text-xl font-bold tabular-nums text-blue-700">$@item.CurrentPrice.ToString("N0")</p>
                        </div>
                        @if (Model.ShowTimeRemaining && !isBuyNow)
                        {
                            <div class="text-right">
                                <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">@Localizer[countdownLabelKey]</p>
                                <p class="text-xs font-semibold tabular-nums @(isEndingSoon ? "text-red-600" : "text-stone-700")">@item.TimeRemaining</p>
                            </div>
                        }
                        else if (isBuyNow)
                        {
                            <p class="text-right text-xs font-semibold text-emerald-700">@Localizer["BuyNow_InStock"]</p>
                        }
                    </div>
                </div>
            </a>
            @if (Model.ShowBidLink)
            {
                @if (isWon)
                {
                    <a asp-controller="Order" asp-action="Index" class="block px-4 pb-4">
                        <span class="mt-4 block w-full rounded-full bg-emerald-600 py-2.5 text-center text-xs font-semibold uppercase tracking-wider text-white">@Localizer["Card_CompletePayment"]</span>
                    </a>
                }
                else if (isBuyNow)
                {
                    <div class="px-4 pb-4">
                        <button type="button"
                                class="buy-now-add-to-cart mt-4 block w-full rounded-full bg-blue-700 py-2.5 text-center text-xs font-semibold uppercase tracking-wider text-white transition hover:bg-blue-800"
                                data-auction-id="@item.Id"
                                data-is-logged-in="@(isLoggedIn ? "true" : "false")"
                                data-label="@actionLabel"
                                data-adding-label="@Localizer["Js_BuyNow_Adding"]">
                            @actionLabel
                        </button>
                    </div>
                }
                else
                {
                    <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id" class="block px-4 pb-4">
                        <span class="mt-4 block w-full rounded-full bg-blue-700 py-2.5 text-center text-xs font-semibold uppercase tracking-wider text-white transition group-hover:bg-blue-800">
                            @actionLabel
                        </span>
                    </a>
                }
            }
        </div>
    </article>
}
