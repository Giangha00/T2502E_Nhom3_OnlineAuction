@model OnlineAuction.Models.HomeViewModel
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Home_PageTitle"];
    var heroImage = PageBannerImages.Home;
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<div id="homePageContent" class="rarecard-page">
  <section class="rarecard-hero relative w-full overflow-hidden bg-slate-50">
    <div class="absolute inset-0 opacity-[0.07]">
      <img src="@heroImage" alt="" class="h-full w-full object-cover" aria-hidden="true"/>
    </div>
    <div class="relative w-full px-4 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
      <div class="mx-auto max-w-4xl text-center lg:mx-0 lg:text-left">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-blue-700">@Localizer["Home_Hero_Eyebrow"]</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          @Localizer["Home_Hero_TitleLine1"]<br/>
          <span class="text-blue-600">@Localizer["Home_Hero_TitleAccent"]</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-slate-600 lg:mx-0 lg:text-lg">
          @Localizer["Home_Hero_Subtitle"]
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a asp-controller="Auction" asp-action="Index"
             class="inline-flex items-center rounded-full bg-slate-900 px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-white transition hover:bg-blue-800">
            @Localizer["Home_Hero_ExploreAuctions"]
          </a>
          @if (isLoggedIn)
          {
            <a asp-controller="Account" asp-action="Selling"
               class="inline-flex items-center rounded-full border-2 border-slate-900 bg-white px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-slate-900 transition hover:bg-slate-50">
              @Localizer["Home_Hero_SellYourCard"]
            </a>
          }
          else
          {
            var sellReturnUrl = Url.Action("Selling", "Account", new { tab = "active", channel = "buynow" }) ?? "/Account/Selling";
            <button type="button" data-auth-tab="login" data-auth-return-url="@sellReturnUrl"
                    class="inline-flex cursor-pointer items-center rounded-full border-2 border-slate-900 bg-white px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-slate-900 transition hover:bg-slate-50">
              @Localizer["Home_Hero_SellYourCard"]
            </button>
          }
        </div>
      </div>
    </div>
  </section>

  <partial name="Partials/_HomeRecommendedSection" model="Model"/>

  <partial name="Partials/_HomeProductSection"
           model="@(new HomeProductSectionViewModel { Title = "Trending on auction", SectionKey = "trending-auction", Items = Model.TrendingOnAuction })"/>

  <partial name="Partials/_HomeProductSection"
           model="@(new HomeProductSectionViewModel { Title = "Trending on buy now", SectionKey = "trending-buynow", Items = Model.TrendingOnBuyNow, CardMode = "buynow", ViewAllController = "BuyNow" })"/>

  <partial name="Partials/_HomeProductSection"
           model="@(new HomeProductSectionViewModel { Title = "Recently added", SectionKey = "recently-added", Items = Model.RecentlyAdded })"/>

  <section class="border-b border-stone-200 bg-slate-50 py-10 sm:py-12">
    <div class="mb-8 px-4 sm:px-8 lg:px-12">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">@Localizer["Home_BrowseByCategory_Title"]</h2>
    </div>
    <div class="grid w-full grid-cols-1 gap-4 px-4 sm:grid-cols-2 sm:px-8 lg:grid-cols-4 lg:px-12">
      @foreach (var category in Model.Categories.Take(4))
      {
        <a asp-controller="Auction" asp-action="Index" asp-fragment="category-@CategorySlug.ToSlug(category.Name)"
           class="rarecard-category-tile group relative overflow-hidden rounded-2xl">
          <img src="@category.ImageUrl" alt="@category.Name" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/40 to-transparent"></div>
          <div class="relative flex min-h-[10rem] flex-col justify-end p-5 sm:min-h-[12rem]">
            <h3 class="text-lg font-bold text-white">@category.Name</h3>
            <p class="text-sm text-white/80">@(string.IsNullOrEmpty(category.DisplayCount) ? Localizer["Common_ItemsSuffix", category.ItemCount] : category.DisplayCount)</p>
          </div>
        </a>
      }
    </div>
  </section>

  <section class="border-b border-stone-200 py-10 sm:py-12">
    <div class="mb-8 px-4 sm:px-8 lg:px-12">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Best seller</h2>
    </div>
    <div class="flex flex-wrap justify-center gap-8 px-4 sm:px-8 lg:px-12">
      @foreach (var seller in Model.BestSellers)
      {
        <div class="flex w-28 flex-col items-center text-center sm:w-32">
          <a asp-controller="User" asp-action="Detail" asp-route-id="@seller.Id" class="group">
            <img src="@seller.AvatarUrl" alt="@seller.Username" loading="lazy"
                 class="mx-auto h-20 w-20 rounded-full object-cover ring-2 ring-stone-200 transition group-hover:ring-blue-400 sm:h-24 sm:w-24"/>
            <p class="mt-3 text-sm font-semibold text-slate-900 group-hover:text-blue-800">@seller.Username</p>
          </a>
        </div>
      }
    </div>
  </section>

  @if (Model.VaultPosts.Count > 0)
  {
    <section class="py-10 sm:py-14">
      <div class="mb-8 flex w-full items-end justify-between gap-4 px-4 sm:px-8 lg:px-12">
        <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Latest from vault</h2>
        <a href="#" class="text-sm font-semibold text-blue-700 hover:text-blue-900">@Localizer["Common_ViewAllPosts"] <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid w-full grid-cols-1 gap-6 px-4 sm:grid-cols-2 sm:px-8 lg:grid-cols-3 lg:px-12">
        @foreach (var post in Model.VaultPosts)
        {
          <article class="group overflow-hidden rounded-2xl border border-stone-200 bg-white transition hover:shadow-lg">
            <div class="aspect-[16/10] overflow-hidden bg-stone-100">
              <img src="@post.ImageUrl" alt="@post.Title" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
            </div>
            <div class="p-5">
              <span class="text-[10px] font-bold uppercase tracking-widest text-blue-700">@post.Tag</span>
              <h3 class="mt-2 line-clamp-2 text-lg font-bold text-slate-900">@post.Title</h3>
              <p class="mt-2 line-clamp-2 text-sm text-slate-600">@post.Excerpt</p>
            </div>
          </article>
        }
      </div>
    </section>
  }
</div>

@section Scripts {
  <script src="~/js/home-carousel.js" asp-append-version="true"></script>
}
