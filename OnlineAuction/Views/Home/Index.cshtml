@model OnlineAuction.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
    var heroImage = PageBannerImages.Home;
    var featured = Model.FeaturedEndingSoon;
}

<div id="homePageContent" class="rarecard-page">
  <section class="rarecard-hero relative w-full overflow-hidden bg-slate-50">
    <div class="absolute inset-0 opacity-[0.07]">
      <img src="@heroImage" alt="" class="h-full w-full object-cover" aria-hidden="true"/>
    </div>
    <div class="relative w-full px-4 py-16 sm:px-8 sm:py-20 lg:px-12 lg:py-24">
      <div class="mx-auto max-w-4xl text-center lg:mx-0 lg:text-left">
        <p class="text-xs font-bold uppercase tracking-[0.25em] text-blue-700">RareCard Vault</p>
        <h1 class="mt-4 text-4xl font-bold leading-tight tracking-tight text-slate-900 sm:text-5xl lg:text-6xl">
          Invest in the World's<br/>
          <span class="text-blue-600">Rarest Collectibles</span>
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-slate-600 lg:mx-0 lg:text-lg">
          The premier destination for authenticated Pokémon, sports, and TCG cards — curated for the world's most discerning collectors.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3 lg:justify-start">
          <a asp-controller="Auction" asp-action="Index"
             class="inline-flex items-center rounded-full bg-slate-900 px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-white transition hover:bg-blue-800">
            Explore Auctions
          </a>
          <a asp-controller="Sell" asp-action="Create"
             class="inline-flex items-center rounded-full border-2 border-slate-900 bg-white px-7 py-3.5 text-xs font-bold uppercase tracking-widest text-slate-900 transition hover:bg-slate-50">
            Sell Your Card
          </a>
        </div>
      </div>
    </div>
  </section>

  @if (Model.HotAuctions.Count > 0)
  {
    <section class="border-b border-stone-200 py-10 sm:py-12">
      <div class="mb-6 flex w-full items-end justify-between gap-4 px-4 sm:px-8 lg:px-12">
        <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Hot Auctions</h2>
        <a asp-controller="Auction" asp-action="Index" class="text-sm font-semibold text-blue-700 hover:text-blue-900">View All →</a>
      </div>
      <div class="rarecard-hot-row px-4 sm:px-8 lg:px-12">
        @foreach (var item in Model.HotAuctions)
        {
          <div class="rarecard-hot-row__item">
            <partial name="Partials/_TradingCardAuctionCard" model="@(new AuctionCardViewModel { Item = item, Variant = "hot" })"/>
          </div>
        }
      </div>
    </section>
  }

  <section class="border-b border-stone-200 bg-slate-50 py-10 sm:py-12">
    <div class="mb-8 px-4 sm:px-8 lg:px-12">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Browse by Category</h2>
    </div>
    <div class="grid w-full grid-cols-1 gap-4 px-4 sm:grid-cols-2 sm:px-8 lg:grid-cols-4 lg:px-12">
      @foreach (var category in Model.Categories.Take(4))
      {
        <a asp-controller="Auction" asp-action="Index" asp-fragment="category-@category.Name.Replace(" ", "-").ToLowerInvariant()"
           class="rarecard-category-tile group relative overflow-hidden rounded-2xl">
          <img src="@category.ImageUrl" alt="@category.Name" loading="lazy" class="absolute inset-0 h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-900/40 to-transparent"></div>
          <div class="relative flex min-h-[10rem] flex-col justify-end p-5 sm:min-h-[12rem]">
            <h3 class="text-lg font-bold text-white">@category.Name</h3>
            <p class="text-sm text-white/80">@(string.IsNullOrEmpty(category.DisplayCount) ? $"{category.ItemCount}+ Items" : category.DisplayCount)</p>
          </div>
        </a>
      }
    </div>
  </section>

  <section class="border-b border-stone-200 py-10 sm:py-12">
    <div class="mb-8 px-4 sm:px-8 lg:px-12">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Best Sellers</h2>
    </div>
    <div class="flex flex-wrap justify-center gap-8 px-4 sm:px-8 lg:px-12">
      @foreach (var seller in Model.BestSellers)
      {
        <div class="flex w-28 flex-col items-center text-center sm:w-32">
          <a asp-controller="User" asp-action="Detail" asp-route-id="@seller.Id" class="group">
            <img src="@seller.AvatarUrl" alt="@seller.Username" loading="lazy"
                 class="mx-auto h-20 w-20 rounded-full object-cover ring-2 ring-stone-200 transition group-hover:ring-blue-400 sm:h-24 sm:w-24"/>
            <p class="mt-3 text-sm font-semibold text-slate-900 group-hover:text-blue-800">@seller.Username</p>
          </a>
          <button type="button" class="mt-2 rounded-full border border-slate-300 px-4 py-1 text-xs font-semibold text-slate-700 transition hover:border-blue-600 hover:text-blue-700">
            Follow
          </button>
        </div>
      }
    </div>
  </section>

  @if (featured != null)
  {
    <section class="border-b border-stone-200 py-10 sm:py-14">
      <div class="mb-8 px-4 sm:px-8 lg:px-12">
        <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Auction Ending Soon</h2>
      </div>
      <div class="grid w-full gap-8 px-4 sm:px-8 lg:grid-cols-[1.1fr_1fr_0.9fr] lg:px-12">
        <a asp-controller="Auction" asp-action="Detail" asp-route-id="@featured.Id" class="group relative overflow-hidden rounded-2xl bg-slate-900">
          <img src="@featured.ImageUrl" alt="@featured.Name" loading="lazy" class="aspect-[4/5] h-full w-full object-cover opacity-90 transition duration-500 group-hover:scale-[1.02]"/>
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
        </a>
        <div class="flex flex-col justify-center">
          <span class="inline-flex w-fit items-center gap-2 rounded-full bg-red-100 px-3 py-1 text-xs font-bold uppercase tracking-wider text-red-700">
            <span class="h-2 w-2 animate-pulse rounded-full bg-red-600"></span>
            Ending Soon · @featured.TimeRemaining
          </span>
          <h3 class="mt-4 text-2xl font-bold text-slate-900 sm:text-3xl">@featured.Name</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">@featured.Subtitle · @featured.Grade</p>
          <p class="mt-6 text-xs font-semibold uppercase tracking-wider text-stone-400">Final Bid Prediction</p>
          <p class="text-3xl font-bold tabular-nums text-blue-700">$@featured.CurrentPrice.ToString("N0")</p>
          <a asp-controller="Auction" asp-action="Detail" asp-route-id="@featured.Id"
             class="mt-6 inline-flex w-fit items-center rounded-full bg-red-600 px-8 py-3.5 text-xs font-bold uppercase tracking-widest text-white transition hover:bg-red-700">
            Place Final Bid
          </a>
        </div>
        <div class="flex flex-col gap-3">
          @foreach (var item in Model.EndingSoonAuctions)
          {
            <partial name="Partials/_TradingCardAuctionCard" model="@(new AuctionCardViewModel { Item = item, Variant = "compact" })"/>
          }
        </div>
      </div>
    </section>
  }

  @if (Model.VaultPosts.Count > 0)
  {
    <section class="py-10 sm:py-14">
      <div class="mb-8 flex w-full items-end justify-between gap-4 px-4 sm:px-8 lg:px-12">
        <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">Latest from the Vault</h2>
        <a href="#" class="text-sm font-semibold text-blue-700 hover:text-blue-900">View All Posts →</a>
      </div>
      <div class="grid w-full grid-cols-1 gap-6 px-4 sm:grid-cols-2 sm:px-8 lg:grid-cols-3 lg:px-12">
        @foreach (var post in Model.VaultPosts)
        {
          <article class="group overflow-hidden rounded-2xl border border-stone-200 bg-white transition hover:shadow-lg">
            <div class="aspect-[16/10] overflow-hidden bg-stone-100">
              <img src="@post.ImageUrl" alt="@post.Title" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
            </div>
            <div class="p-5">
              <span class="text-[10px] font-bold uppercase tracking-widest text-blue-700">@post.Tag</span>
              <h3 class="mt-2 line-clamp-2 text-lg font-bold text-slate-900">@post.Title</h3>
              <p class="mt-2 line-clamp-2 text-sm text-slate-600">@post.Excerpt</p>
            </div>
          </article>
        }
      </div>
    </section>
  }

  @if (Model.WonAuctions.Count > 0)
  {
    <section class="border-t border-emerald-100 bg-emerald-50/60 py-10">
      <div class="mb-6 px-4 sm:px-8 lg:px-12">
        <h2 class="text-xl font-bold text-emerald-800">Complete payment on your wins</h2>
      </div>
      <div class="grid grid-cols-1 gap-4 px-4 sm:grid-cols-2 sm:px-8 lg:grid-cols-4 lg:px-12">
        @foreach (var item in Model.WonAuctions)
        {
          <partial name="Partials/_TradingCardAuctionCard" model="new AuctionCardViewModel { Item = item }"/>
        }
      </div>
    </section>
  }
</div>
