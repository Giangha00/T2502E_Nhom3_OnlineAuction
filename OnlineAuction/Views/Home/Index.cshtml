@model OnlineAuction.Models.HomeViewModel
@using Microsoft.AspNetCore.Authentication
@using OnlineAuction.Configurations
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Home_PageTitle"];
    var heroBanners = new[]
    {
        new { Alt = "Pokémon Trading Card Game", ImageUrl = "/images/pages/home/banners/pokemon-tcg.png" },
        new { Alt = "Trading card games collection", ImageUrl = "/images/pages/home/banners/tcg-collage.png" },
        new { Alt = "One Piece Card Game", ImageUrl = "/images/pages/home/banners/one-piece.png" },
        new { Alt = "Vintage sports trading cards", ImageUrl = "/images/pages/home/banners/sports-cards.png" },
    };
    var userAuth = await Context.AuthenticateAsync(AuthSchemes.User);
    var isLoggedIn = userAuth.Succeeded;
}

<div id="homePageContent" class="rarecard-page">
  <section class="home-hero-banner" data-home-hero-banner aria-label="@Localizer["Home_Hero_TitleLine1"]">
    <div class="home-hero-banner__backdrop" aria-hidden="true">
      @for (var i = 0; i < heroBanners.Length; i++)
      {
        <img src="@heroBanners[i].ImageUrl"
             alt=""
             class="home-hero-banner__backdrop-img @(i == 0 ? "is-active" : "")"
             data-home-hero-backdrop
             loading="@(i == 0 ? "eager" : "lazy")"/>
      }
    </div>

    <div class="home-hero-banner__slides" aria-live="polite">
      @for (var i = 0; i < heroBanners.Length; i++)
      {
        var banner = heroBanners[i];
        <div class="home-hero-banner__slide @(i == 0 ? "is-active" : "")"
             data-home-hero-slide
             aria-hidden="@(i == 0 ? "false" : "true")">
          <img src="@banner.ImageUrl" alt="@banner.Alt" class="home-hero-banner__slide-img" loading="@(i == 0 ? "eager" : "lazy")"/>
        </div>
      }
    </div>

    <div class="home-hero-banner__scrim" aria-hidden="true"></div>

    <div class="home-hero-banner__inner">
      <div class="home-hero-banner__copy">
        <p class="home-hero-banner__eyebrow">@Localizer["Home_Hero_Eyebrow"]</p>
        <h1 class="home-hero-banner__title">
          @Localizer["Home_Hero_TitleLine1"]<br/>
          <span class="home-hero-banner__title-accent">@Localizer["Home_Hero_TitleAccent"]</span>
        </h1>
        <p class="home-hero-banner__subtitle">@Localizer["Home_Hero_Subtitle"]</p>
        <div class="home-hero-banner__actions">
          <a asp-controller="Auction" asp-action="Index" class="home-hero-banner__btn home-hero-banner__btn--primary">
            @Localizer["Home_Hero_ExploreAuctions"]
          </a>
          @if (isLoggedIn)
          {
            <a asp-controller="Account" asp-action="Selling" class="home-hero-banner__btn home-hero-banner__btn--ghost">
              @Localizer["Home_Hero_SellYourCard"]
            </a>
          }
          else
          {
            var sellReturnUrl = Url.Action("Selling", "Account", new { tab = "active", channel = "buynow" }) ?? "/Account/Selling";
            <button type="button" data-auth-tab="login" data-auth-return-url="@sellReturnUrl"
                    class="home-hero-banner__btn home-hero-banner__btn--ghost">
              @Localizer["Home_Hero_SellYourCard"]
            </button>
          }
        </div>
      </div>
    </div>
  </section>

  <partial name="Partials/_HomeRecommendedSection" model="Model"/>

  <partial name="Partials/_HomeProductSection"
           model="@(new HomeProductSectionViewModel { Title = Localizer["Home_TrendingAuction_Title"].Value, SectionKey = "trending-auction", Items = Model.TrendingOnAuction })"/>

  <partial name="Partials/_HomeProductSection"
           model="@(new HomeProductSectionViewModel { Title = Localizer["Home_TrendingBuyNow_Title"].Value, SectionKey = "trending-buynow", Items = Model.TrendingOnBuyNow, CardMode = "buynow", ViewAllController = "BuyNow" })"/>

  <partial name="Partials/_HomeProductSection"
           model="@(new HomeProductSectionViewModel { Title = Localizer["Home_RecentlyAdded_Title"].Value, SectionKey = "recently-added", Items = Model.RecentlyAdded })"/>

  <section class="border-b border-stone-200 bg-slate-50 py-10 sm:py-12">
    <div class="mb-8 px-4 sm:px-8 lg:px-12">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">@Localizer["Home_BrowseByCategory_Title"]</h2>
    </div>
    <div class="grid w-full grid-cols-1 gap-4 px-4 sm:grid-cols-2 sm:px-8 lg:grid-cols-4 lg:px-12">
      @foreach (var category in Model.Categories.Take(4))
      {
        <a asp-controller="Auction" asp-action="Index" asp-fragment="category-@CategorySlug.ToSlug(category.Name)"
           class="rarecard-category-tile group">
          <div class="rarecard-category-tile__visual">
            <img src="@category.ImageUrl"
                 alt="@category.Name"
                 loading="lazy"
                 asp-append-version="true"
                 class="rarecard-category-tile__logo"/>
          </div>
          <div class="rarecard-category-tile__footer">
            <h3 class="rarecard-category-tile__title">@category.Name</h3>
            <p class="rarecard-category-tile__count">@(string.IsNullOrEmpty(category.DisplayCount) ? Localizer["Common_ItemsSuffix", category.ItemCount] : category.DisplayCount)</p>
          </div>
        </a>
      }
    </div>
  </section>

  <section class="border-b border-stone-200 py-10 sm:py-12">
    <div class="mb-8 px-4 sm:px-8 lg:px-12">
      <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">@Localizer["Home_BestSeller_Title"]</h2>
    </div>
    <div class="flex flex-wrap justify-center gap-8 px-4 sm:px-8 lg:px-12">
      @foreach (var seller in Model.BestSellers)
      {
        <div class="flex w-28 flex-col items-center text-center sm:w-32">
          @if (seller.Id > 0)
          {
            <a asp-controller="User" asp-action="Detail" asp-route-id="@seller.Id" class="group">
              <img src="@seller.AvatarUrl" alt="@seller.DisplayName" loading="lazy"
                   class="mx-auto h-20 w-20 rounded-full object-cover ring-2 ring-stone-200 transition group-hover:ring-blue-400 sm:h-24 sm:w-24"/>
              <p class="mt-3 text-sm font-semibold leading-snug text-slate-900 group-hover:text-blue-800">@seller.DisplayName</p>
            </a>
          }
          else
          {
            <div>
              <img src="@seller.AvatarUrl" alt="@seller.DisplayName" loading="lazy"
                   class="mx-auto h-20 w-20 rounded-full object-cover ring-2 ring-stone-200 sm:h-24 sm:w-24"/>
              <p class="mt-3 text-sm font-semibold leading-snug text-slate-900">@seller.DisplayName</p>
            </div>
          }
        </div>
      }
    </div>
  </section>

  @if (Model.VaultPosts.Count > 0)
  {
    <section class="py-10 sm:py-14">
      <div class="mb-8 flex w-full items-end justify-between gap-4 px-4 sm:px-8 lg:px-12">
        <h2 class="text-2xl font-bold text-slate-900 sm:text-3xl">@Localizer["Home_LatestFromVault_Title"]</h2>
        <a href="#" class="text-sm font-semibold text-blue-700 hover:text-blue-900">@Localizer["Common_ViewAllPosts"] <span aria-hidden="true">→</span></a>
      </div>
      <div class="grid w-full grid-cols-1 gap-6 px-4 sm:grid-cols-2 sm:px-8 lg:grid-cols-3 lg:px-12">
        @foreach (var post in Model.VaultPosts)
        {
          <article class="group overflow-hidden rounded-2xl border border-stone-200 bg-white transition hover:shadow-lg">
            <div class="aspect-[16/10] overflow-hidden bg-stone-100">
              <img src="@post.ImageUrl" alt="@post.Title" loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
            </div>
            <div class="p-5">
              <span class="text-[10px] font-bold uppercase tracking-widest text-blue-700">@post.Tag</span>
              <h3 class="mt-2 line-clamp-2 text-lg font-bold text-slate-900">@post.Title</h3>
              <p class="mt-2 line-clamp-2 text-sm text-slate-600">@post.Excerpt</p>
            </div>
          </article>
        }
      </div>
    </section>
  }
</div>

@section Scripts {
  <script src="~/js/home-hero-banner.js" asp-append-version="true"></script>
  <script src="~/js/home-carousel.js" asp-append-version="true"></script>
  <script src="~/js/buy-now-cart.js" asp-append-version="true"></script>
}
