@model OnlineAuction.Models.HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<partial name="_PageHero" model='new PageHeroViewModel {
    Label = "Online Auction",
    Title = "Welcome to Auction House",
    Description = "Discover unique products through online auction. Browse curated collections, place your bids, and connect with trusted sellers from around the world.",
    Centered = true,
    ImageUrl = PageBannerImages.Home,
    ImageAlt = "Featured artwork at auction",
    ActionText = "Explore Auctions",
    ActionController = "Auction",
    ActionName = "Index"
}' />

<section id="featured-auctions" class="border-t border-stone-200/80 bg-white/50 py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h2 class="text-2xl font-bold text-stone-900 sm:text-3xl">Featured Auctions</h2>
        </div>

        <div id="featuredGrid" class="grid grid-cols-2 items-stretch gap-5 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4">
            @foreach (var item in Model.FeaturedAuctions)
            {
                <article class="group flex h-full flex-col overflow-hidden rounded-xl border border-stone-200 bg-white/80 shadow-sm transition hover:shadow-lg">
                    <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id" class="block shrink-0">
                    <div class="relative aspect-[4/5] overflow-hidden bg-stone-100">
                        <img src="@item.ImageUrl" alt="@item.Name" loading="lazy"
                             class="h-full w-full object-cover object-center transition duration-500 group-hover:scale-105"/>
                        <span class="absolute left-2 top-2 rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-white @(item.Status == "Ending Soon" ? "bg-orange-600" : "bg-amber-700")">
                            @item.Status
                        </span>
                    </div>
                    </a>
                    <div class="flex flex-1 flex-col p-4">
                        <p class="text-[10px] font-semibold uppercase tracking-widest text-stone-400">@item.Category</p>
                        <h3 class="mt-1 min-h-[2.5rem] line-clamp-2 text-sm font-semibold leading-snug text-stone-900">
                            <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id" class="hover:text-amber-700">@item.Name</a>
                        </h3>
                        <div class="mt-2 flex gap-4">
                            <div>
                                <p class="text-[10px] uppercase tracking-wide text-stone-400">Starting</p>
                                <p class="mt-0.5 text-xs font-semibold text-stone-700">$@item.StartingPrice.ToString("N0")</p>
                            </div>
                            <div>
                                <p class="text-[10px] uppercase tracking-wide text-stone-400">Current</p>
                                <p class="mt-0.5 text-xs font-semibold text-amber-700">$@item.CurrentPrice.ToString("N0")</p>
                            </div>
                        </div>
                        <div class="mt-2 flex min-h-[1.25rem] items-center gap-1 text-xs text-stone-500">
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0">
                                <circle cx="12" cy="12" r="10"/>
                                <path d="M12 6v6l4 2"/>
                            </svg>
                            <span class="line-clamp-1">@item.TimeRemaining</span>
                        </div>
                        <div class="mt-auto pt-3">
                            <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id"
                               class="block w-full rounded-lg bg-amber-700 py-2 text-center text-xs font-semibold text-white transition hover:bg-amber-800">
                                View Details
                            </a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>

<section class="py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-8 text-2xl font-bold text-stone-900 sm:text-3xl">Best Sellers</h2>

        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
            @foreach (var seller in Model.BestSellers)
            {
                <article class="rounded-2xl border border-stone-200 bg-white/80 p-6 text-center shadow-sm transition hover:shadow-lg">
                    <a asp-controller="User" asp-action="Detail" asp-route-id="@seller.Id" class="block">
                    <img src="@seller.AvatarUrl" alt="@seller.Username" loading="lazy"
                         class="mx-auto h-20 w-20 rounded-full object-cover ring-4 ring-amber-100"/>
                    <h3 class="mt-4 text-lg font-semibold text-stone-900 transition hover:text-amber-700">@seller.Username</h3>
                    </a>
                    <div class="mt-5 flex justify-center gap-6 border-b border-stone-100 pb-5">
                        <div>
                            <p class="text-lg font-bold text-stone-900">@seller.AuctionCount</p>
                            <p class="text-xs uppercase tracking-wide text-stone-400">Auctions</p>
                        </div>
                        <div>
                            <p class="text-lg font-bold text-stone-900">@seller.SuccessfulSales</p>
                            <p class="text-xs uppercase tracking-wide text-stone-400">Sales</p>
                        </div>
                        <div>
                            <p class="text-lg font-bold text-amber-700">@seller.Rating.ToString("0.0")</p>
                            <p class="text-xs uppercase tracking-wide text-stone-400">Rating</p>
                        </div>
                    </div>
                    <div class="mt-4 flex justify-center gap-1">
                        @for (var i = 1; i <= 5; i++)
                        {
                            var filled = i <= Math.Floor(seller.Rating);
                            var half = !filled && seller.Rating >= i - 0.5;
                            <span class="text-base @(filled ? "text-amber-500" : half ? "text-amber-300" : "text-stone-200")">&#9733;</span>
                        }
                    </div>
                    <a asp-controller="User" asp-action="Detail" asp-route-id="@seller.Id"
                       class="mt-5 inline-flex rounded-xl border border-amber-300 bg-white px-5 py-2 text-sm font-semibold text-amber-800 transition hover:bg-amber-50">
                        View Profile
                    </a>
                </article>
            }
        </div>
    </div>
</section>

