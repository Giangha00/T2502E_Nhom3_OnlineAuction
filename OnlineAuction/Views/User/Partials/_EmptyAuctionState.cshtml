@model OnlineAuction.Models.EmptyListingStateViewModel
@using OnlineAuction.Entities
@{
    var isBuyNow = string.Equals(Model.Channel, ListingTypes.BuyNow, StringComparison.OrdinalIgnoreCase);
    var title = isBuyNow
        ? (Model.IsOwner ? Localizer["User_NoBuyNow_OwnerTitle"] : Localizer["User_NoBuyNow_VisitorTitle"])
        : (Model.IsOwner ? Localizer["User_NoAuctions_OwnerTitle"] : Localizer["User_NoAuctions_VisitorTitle"]);
    var description = isBuyNow
        ? (Model.IsOwner ? Localizer["User_NoBuyNow_OwnerDesc"] : Localizer["User_NoBuyNow_VisitorDesc"])
        : (Model.IsOwner ? Localizer["User_NoAuctions_OwnerDesc"] : Localizer["User_NoAuctions_VisitorDesc"]);
    var createAction = isBuyNow ? "BuyNow" : "Create";
    var createLabel = isBuyNow ? Localizer["User_CreateBuyNowListing"] : Localizer["User_CreateListing"];
}

<div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-6 py-12 text-center">
  <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-white text-slate-400 shadow-sm">
    @if (isBuyNow)
    {
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25h9.75M7.5 14.25 6.106 5.272M7.5 14.25l-1.086 4.77M16.5 14.25l1.086 4.77M16.5 14.25V9.75a2.25 2.25 0 0 0-2.25-2.25h-4.5A2.25 2.25 0 0 0 7.5 9.75v4.5"/>
      </svg>
    }
    else
    {
      <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 15.536c-1.171 1.952-3.07 1.952-4.242 0-1.172-1.953-1.172-5.119 0-7.072 1.171-1.952 3.07-1.952 4.242 0M8 10.5h4m-4 3h4m9-1.5a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
    }
  </div>
  <p class="mt-4 text-sm font-semibold text-slate-800">@title</p>
  <p class="mt-1 text-xs text-slate-500">@description</p>

  @if (Model.IsOwner)
  {
    <a asp-controller="Sell" asp-action="@createAction"
       class="mt-5 inline-flex cursor-pointer items-center justify-center rounded-lg bg-blue-700 px-5 py-2.5 text-xs font-semibold text-white shadow-sm transition duration-200 hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-300">
      @createLabel
    </a>
  }
</div>
