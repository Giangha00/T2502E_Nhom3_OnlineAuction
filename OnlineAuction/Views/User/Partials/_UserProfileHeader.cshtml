@model OnlineAuction.Models.UserProfileViewModel

<div class="user-profile-header overflow-hidden rounded-3xl border border-stone-200 bg-white shadow-xl">
  <div class="bg-gradient-to-br from-amber-700 via-amber-800 to-stone-900 px-6 py-10 text-white sm:px-10 sm:py-12">
    <div class="flex flex-col items-center text-center">
      <img src="@Model.AvatarUrl" alt="@Model.Username"
           class="h-28 w-28 rounded-full object-cover ring-4 ring-white/30 sm:h-32 sm:w-32"/>
      <h1 class="mt-5 text-2xl font-bold sm:text-3xl">@Model.Username</h1>
      @if (!string.IsNullOrWhiteSpace(Model.FullName) && Model.FullName != Model.Username)
      {
        <p class="mt-1 text-sm text-amber-100">@Model.FullName</p>
      }
      <p class="mt-3 text-sm font-semibold uppercase tracking-widest text-amber-200">@Model.Role</p>
      <p class="mt-2 text-sm text-amber-100/90">Member since @Model.MemberSince</p>
    </div>
  </div>
</div>
