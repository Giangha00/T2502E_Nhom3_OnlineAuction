@model OnlineAuction.Models.UserDetailViewModel

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  @* Profile top *@
  <div class="p-6 sm:p-8">
    <div class="flex flex-col items-center gap-6 sm:flex-row sm:items-start">
      <img src="@Model.Profile.AvatarUrl" alt="@Model.Profile.Username"
           class="h-24 w-24 shrink-0 rounded-full object-cover ring-4 ring-blue-50 sm:h-28 sm:w-28"/>

      <div class="min-w-0 flex-1 text-center sm:text-left">
        <div class="flex flex-wrap items-center justify-center gap-2 sm:justify-start">
          <span class="inline-flex rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold text-blue-700">@Model.Profile.Role</span>
          <span class="inline-flex items-center gap-1 rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">
            <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
            Verified
          </span>
        </div>

        <h1 class="mt-3 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@Model.Profile.Username</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Profile.FullName) && Model.Profile.FullName != Model.Profile.Username)
        {
          <p class="mt-1 text-sm text-slate-500">@Model.Profile.FullName</p>
        }

        <div class="mt-3 flex flex-wrap items-center justify-center gap-4 sm:justify-start">
          <div class="flex items-center gap-2">
            @await Html.PartialAsync("Partials/_StarRating", Model.Statistics.Rating)
            <span class="text-sm font-semibold text-slate-900">@Model.Statistics.Rating.ToString("0.0")</span>
            <span class="text-sm text-slate-400">(@Model.Rating.ReviewCount reviews)</span>
          </div>
          <span class="hidden text-slate-300 sm:inline">·</span>
          <span class="text-sm text-slate-500">Member since @Model.Profile.MemberSince</span>
        </div>
      </div>
    </div>
  </div>

  @* Stats row *@
  <div class="grid grid-cols-2 border-t border-slate-100 bg-slate-50/60 sm:grid-cols-4">
    <div class="border-b border-r border-slate-100 px-5 py-4 sm:border-b-0">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Total Auctions</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">@Model.Statistics.TotalAuctions</p>
    </div>
    <div class="border-b border-slate-100 px-5 py-4 sm:border-b-0 sm:border-r">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Completed</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">@Model.Statistics.CompletedAuctions</p>
    </div>
    <div class="border-r border-slate-100 px-5 py-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Total Sales</p>
      <p class="mt-1 text-2xl font-bold text-slate-900">@Model.Statistics.TotalSales</p>
    </div>
    <div class="px-5 py-4">
      <p class="text-xs font-medium uppercase tracking-wide text-slate-400">Success Rate</p>
      <p class="mt-1 text-2xl font-bold text-blue-700">
        @(Model.Statistics.TotalAuctions > 0
            ? $"{Math.Round((double)Model.Statistics.CompletedAuctions / Model.Statistics.TotalAuctions * 100)}%"
            : "—")
      </p>
    </div>
  </div>
</div>
