@model OnlineAuction.Models.UserDetailViewModel
@{
    var roleKey = $"User_Role_{Model.Profile.Role}";
    var roleLabel = Localizer[roleKey];
    if (roleLabel.ResourceNotFound)
    {
        roleLabel = Localizer["User_Role_User"];
    }
}

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <div class="flex flex-col items-start gap-6 sm:flex-row">
    <img src="@Model.Profile.AvatarUrl" alt="@Model.Profile.Username"
         class="h-24 w-24 shrink-0 rounded-xl object-cover ring-1 ring-slate-200 sm:h-28 sm:w-28"/>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@Model.Profile.Username</h1>
        <span class="inline-flex rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-blue-700">
          @roleLabel
        </span>
        @if (Model.Profile.EmailConfirmed)
        {
          <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-700">
            <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
            @Localizer["User_Verified"]
          </span>
        }
      </div>

      @if (!string.IsNullOrWhiteSpace(Model.Profile.FullName))
      {
        <p class="mt-1 text-sm text-slate-500">@Model.Profile.FullName</p>
      }

      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <span>@Localizer["User_MemberSince", Model.Profile.MemberSince]</span>
        <span class="hidden text-slate-300 sm:inline">·</span>
        <span>@Localizer["Product_SalesCount", Model.Statistics.TotalSales]</span>
      </div>
    </div>
  </div>
</div>
