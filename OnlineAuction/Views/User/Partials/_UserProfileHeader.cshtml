@model OnlineAuction.Models.UserDetailViewModel
@{
    var roleKey = $"User_Role_{Model.Profile.Role}";
    var roleLabel = Localizer[roleKey];
    if (roleLabel.ResourceNotFound)
    {
        roleLabel = Localizer["User_Role_User"];
    }
}

<div class="overflow-hidden rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <div class="flex flex-col items-start gap-6 sm:flex-row">
    <div class="relative shrink-0">
      <img id="profile-avatar-preview"
           src="@Model.Profile.AvatarUrl"
           data-original-src="@Model.Profile.AvatarUrl"
           alt="@Model.Profile.Username"
           class="h-24 w-24 rounded-xl object-cover ring-1 ring-slate-200 sm:h-28 sm:w-28"/>
      @if (Model.IsOwner)
      {
        <label id="profile-avatar-change"
               for="profile-avatar-input"
               hidden
               class="absolute -bottom-2 -right-2 inline-flex h-9 w-9 cursor-pointer items-center justify-center rounded-full border border-slate-200 bg-white text-slate-700 shadow-sm transition hover:bg-blue-50 hover:text-blue-700"
               title="@Localizer["User_ChangeAvatar"]"
               aria-label="@Localizer["User_ChangeAvatar"]">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.827 6.175A2.31 2.31 0 0 1 5.186 7.23c-.38.055-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 0 0 2.25 2.25h15A2.25 2.25 0 0 0 21.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 0 0-1.134-.175 2.31 2.31 0 0 1-1.64-1.055l-.822-1.316a2.192 2.192 0 0 0-1.736-1.039 48.774 48.774 0 0 0-5.232 0 2.192 2.192 0 0 0-1.736 1.039l-.821 1.316Z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 12.75a4.5 4.5 0 1 1-9 0 4.5 4.5 0 0 1 9 0Z"/>
          </svg>
        </label>
      }
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@Model.Profile.Username</h1>
        <span class="inline-flex rounded-full border border-blue-200 bg-blue-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-blue-700">
          @roleLabel
        </span>
        @if (Model.Profile.EmailConfirmed)
        {
          <span class="inline-flex items-center gap-1 rounded-full border border-emerald-200 bg-emerald-50 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-emerald-700">
            <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
            </svg>
            @Localizer["User_Verified"]
          </span>
        }
      </div>

      @if (!string.IsNullOrWhiteSpace(Model.Profile.FullName))
      {
        <p class="mt-1 text-sm text-slate-500">@Model.Profile.FullName</p>
      }

      <div class="mt-3 flex flex-wrap items-center gap-3 text-sm text-slate-500">
        <span>@Localizer["User_MemberSince", Model.Profile.MemberSince]</span>
        <span class="hidden text-slate-300 sm:inline">·</span>
        <span>@Localizer["Product_SalesCount", Model.Statistics.TotalSales]</span>
      </div>
    </div>
  </div>
</div>
