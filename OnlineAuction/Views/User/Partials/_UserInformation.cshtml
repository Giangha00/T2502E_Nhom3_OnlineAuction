@model OnlineAuction.Models.UserBasicInfoViewModel

<section class="user-information rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
  <h2 class="text-xl font-bold text-stone-900">Basic Information</h2>
  <p class="mt-1 text-sm text-stone-500">Contact and profile details</p>

  <dl class="mt-6 grid gap-5 sm:grid-cols-2">
    <div>
      <dt class="text-xs font-semibold uppercase tracking-widest text-stone-400">Full Name</dt>
      <dd class="mt-1 text-base font-medium text-stone-900">@Model.FullName</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-widest text-stone-400">Email</dt>
      <dd class="mt-1 text-base font-medium text-stone-900 break-all">@Model.Email</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-widest text-stone-400">Phone Number</dt>
      <dd class="mt-1 text-base font-medium text-stone-900">@Model.PhoneNumber</dd>
    </div>
    <div>
      <dt class="text-xs font-semibold uppercase tracking-widest text-stone-400">Address</dt>
      <dd class="mt-1 text-base font-medium text-stone-900">@Model.Address</dd>
    </div>
  </dl>
</section>
