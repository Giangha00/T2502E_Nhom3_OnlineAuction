@model List<OnlineAuction.Models.AuctionItemViewModel>

@if (Model.Count > 0)
{
  <section class="related-auctions mt-12 border-t border-stone-200 pt-12">
    <div class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-widest text-amber-700">Discover More</p>
      <h2 class="mt-1 text-2xl font-bold text-stone-900 sm:text-3xl">Related Auctions</h2>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
      @foreach (var item in Model)
      {
        <a asp-controller="Auction" asp-action="Detail" asp-route-id="@item.Id"
           class="group overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg">
          <div class="relative aspect-[4/3] overflow-hidden">
            <img src="@item.ImageUrl" alt="@item.Name" loading="lazy"
                 class="h-full w-full object-cover transition duration-500 group-hover:scale-105"/>
            <div class="absolute left-2 top-2">
              @await Html.PartialAsync("Partials/_AuctionStatusBadge", item.Status)
            </div>
          </div>
          <div class="p-4">
            <h3 class="line-clamp-2 text-sm font-semibold text-stone-900">@item.Name</h3>
            <p class="mt-2 text-sm font-bold text-amber-700">$@item.CurrentPrice.ToString("N0")</p>
          </div>
        </a>
      }
    </div>
  </section>
}
