@model List<OnlineAuction.Models.AuctionItemViewModel>
@using OnlineAuction.Entities

@if (Model.Count > 0)
{
  <section class="mt-12 border-t border-slate-200 pt-10">
    <div class="mb-6">
      <p class="text-xs font-semibold uppercase tracking-wide text-blue-700">@Localizer["User_DiscoverMore"]</p>
      <h2 class="mt-1 text-xl font-bold text-slate-900 sm:text-2xl">@Localizer["User_RelatedAuctions"]</h2>
    </div>

    <div class="rarecard-auction-grid">
      @foreach (var item in Model)
      {
        var isBuyNow = string.Equals(item.ListingType, ListingTypes.BuyNow, StringComparison.OrdinalIgnoreCase);
        <partial name="~/Views/Shared/Partials/_TradingCardAuctionCard.cshtml"
                 model="@(new AuctionCardViewModel
                 {
                     Item = item,
                     Variant = "grid",
                     CardMode = isBuyNow ? "buynow" : "auction",
                     ShowBidLink = false,
                     ShowWatchlistButton = false,
                     ShowWatchlistPlaceholder = true,
                     ShowTimeRemaining = !isBuyNow
                 })"/>
      }
    </div>
  </section>
}
