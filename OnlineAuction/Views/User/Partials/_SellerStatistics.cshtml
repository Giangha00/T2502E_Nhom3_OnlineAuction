@model OnlineAuction.Models.SellerStatisticsViewModel

<section class="seller-statistics">
  <h2 class="text-xl font-bold text-slate-900">@Localizer["User_SellerStats_Title"]</h2>
  <p class="mt-1 text-sm text-slate-500">@Localizer["User_SellerStats_Description"]</p>

  <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">@Localizer["User_Stat_TotalAuctions"]</p>
      <p class="mt-2 text-3xl font-bold text-slate-900">@Model.TotalAuctions</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">@Localizer["User_Stat_Completed"]</p>
      <p class="mt-2 text-3xl font-bold text-slate-900">@Model.CompletedAuctions</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">@Localizer["User_Stat_PaidOrders"]</p>
      <p class="mt-2 text-3xl font-bold text-slate-900">@Model.TotalSales</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm col-span-2 lg:col-span-1">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">@Localizer["User_Stat_Rating"]</p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        @await Html.PartialAsync("Partials/_StarRating", Model.Rating)
        <span class="text-lg font-bold text-slate-900">@Model.Rating.ToString("0.0") / 5</span>
      </div>
    </div>
  </div>

  <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">@Localizer["User_Stat_GrossSales"]</p>
      <p class="mt-2 text-2xl font-bold text-slate-900">@Model.GrossSales.ToString("C2")</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">@Localizer["User_Stat_SellerFee"]</p>
      <p class="mt-2 text-2xl font-bold text-slate-900">@Model.SellerFees.ToString("C2")</p>
    </div>
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400">@Localizer["User_Stat_NetProceeds"]</p>
      <p class="mt-2 text-2xl font-bold text-slate-900">@Model.NetProceeds.ToString("C2")</p>
      <p class="mt-1 text-xs text-slate-400">@Localizer["User_Stat_NetProceedsNote"]</p>
    </div>
  </div>
</section>
