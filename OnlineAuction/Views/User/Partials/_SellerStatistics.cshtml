@model OnlineAuction.Models.SellerStatisticsViewModel

<section class="seller-statistics">
  <h2 class="text-xl font-bold text-stone-900">Seller Statistics</h2>
  <p class="mt-1 text-sm text-stone-500">Activity and performance overview</p>

  <div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Total Auctions</p>
      <p class="mt-2 text-3xl font-bold text-stone-900">@Model.TotalAuctions</p>
    </div>
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Completed</p>
      <p class="mt-2 text-3xl font-bold text-stone-900">@Model.CompletedAuctions</p>
    </div>
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
      <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Sales</p>
      <p class="mt-2 text-3xl font-bold text-stone-900">@Model.TotalSales</p>
    </div>
    <div class="rounded-2xl border border-stone-200 bg-white p-5 shadow-sm col-span-2 lg:col-span-1">
      <p class="text-xs font-semibold uppercase tracking-widest text-stone-400">Rating</p>
      <div class="mt-2 flex flex-wrap items-center gap-2">
        @await Html.PartialAsync("Partials/_StarRating", Model.Rating)
        <span class="text-lg font-bold text-stone-900">@Model.Rating.ToString("0.0") / 5</span>
      </div>
    </div>
  </div>
</section>
