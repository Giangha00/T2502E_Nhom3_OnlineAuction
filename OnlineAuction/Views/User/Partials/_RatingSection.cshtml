@model OnlineAuction.Models.SellerRatingViewModel

<section class="p-6 sm:p-8">
  <div class="mb-5 flex items-center gap-3">
    <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 0 1 1.04 0l2.125 5.111a.563.563 0 0 0 .475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 0 0-.182.557l1.285 5.385a.562.562 0 0 1-.84.61l-4.725-2.885a.562.562 0 0 0-.586 0L6.982 20.54a.562.562 0 0 1-.84-.61l1.285-5.386a.562.562 0 0 0-.182-.557l-4.204-3.602a.562.562 0 0 1 .321-.988l5.518-.442a.563.563 0 0 0 .475-.345L11.48 3.5Z"/>
      </svg>
    </div>
    <div>
      <h2 class="text-base font-bold text-slate-900">@Localizer["User_ReviewsTitle"]</h2>
      <p class="text-xs text-slate-500">@Localizer["User_ReviewsDesc"]</p>
    </div>
  </div>

  <div class="flex flex-wrap items-center gap-4 rounded-lg bg-slate-50 px-5 py-4">
    <div class="flex items-center gap-3">
      @await Html.PartialAsync("Partials/_StarRating", Model.AverageRating)
      <span class="text-2xl font-bold text-slate-900">@Model.AverageRating.ToString("0.0")</span>
    </div>
    <span class="text-sm text-slate-500">@Localizer["User_ReviewCount", Model.ReviewCount]</span>
  </div>

  @if (Model.Reviews.Count > 0)
  {
    <div class="mt-6 space-y-4">
      @foreach (var review in Model.Reviews)
      {
        @await Html.PartialAsync("Partials/_ReviewCard", review)
      }
    </div>
  }
</section>
