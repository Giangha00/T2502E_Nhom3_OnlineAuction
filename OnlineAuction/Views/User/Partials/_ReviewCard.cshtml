@model OnlineAuction.Models.SellerReviewViewModel

<article class="rounded-lg border border-slate-100 bg-slate-50/60 p-4">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="flex items-center gap-2">
      <div class="flex h-8 w-8 items-center justify-center rounded-full bg-blue-100 text-xs font-bold text-blue-700">
        @Model.ReviewerName[0]
      </div>
      <div>
        <p class="text-sm font-semibold text-slate-900">@Model.ReviewerName</p>
        @await Html.PartialAsync("Partials/_StarRating", Model.Rating)
      </div>
    </div>
    <time datetime="@Model.ReviewDate.ToString("yyyy-MM-dd")" class="text-xs text-slate-400">
      @Model.ReviewDate.ToString("MMM dd, yyyy")
    </time>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-slate-600">@Model.Comment</p>
</article>
