@model OnlineAuction.Models.SellerReviewViewModel

<article class="review-card rounded-2xl border border-stone-200 bg-white p-5 shadow-sm">
  <div class="flex flex-wrap items-start justify-between gap-3">
    @await Html.PartialAsync("Partials/_StarRating", Model.Rating)
    <time datetime="@Model.ReviewDate.ToString("yyyy-MM-dd")" class="text-xs text-stone-400">
      @Model.ReviewDate.ToString("dd/MM/yyyy")
    </time>
  </div>
  <p class="mt-3 text-sm leading-relaxed text-stone-700">@Model.Comment</p>
  <p class="mt-4 text-xs font-semibold uppercase tracking-widest text-stone-400">
    By <span class="text-stone-700">@Model.ReviewerName</span>
  </p>
</article>
