@model OnlineAuction.Models.SellerListingCardViewModel
@using OnlineAuction.Entities
@{
    var auction = Model.Auction;
    var isBuyNow = string.Equals(auction.ListingType, ListingTypes.BuyNow, StringComparison.OrdinalIgnoreCase);
    var detailController = isBuyNow ? "BuyNow" : "Auction";

    var cardItem = new AuctionItemViewModel
    {
        Id = auction.Id,
        Name = auction.Name,
        Category = auction.Category,
        ImageUrl = auction.ImageUrl,
        StartingPrice = auction.StartingPrice,
        CurrentPrice = auction.CurrentPrice,
        Status = auction.Status,
        RejectReason = auction.RejectReason,
        Grade = auction.Grade,
        Condition = auction.Condition,
        Year = auction.Year,
        ListingType = auction.ListingType,
        TimeRemaining = auction.TimeRemaining
    };

    var cardModel = new AuctionCardViewModel
    {
        Item = cardItem,
        Variant = "grid",
        CardMode = isBuyNow ? "buynow" : "auction",
        ShowBidLink = false,
        ShowWatchlistButton = false,
        ShowTimeRemaining = !isBuyNow,
        ShowProductMeta = true,
        PriceLabelResourceKey = isBuyNow ? "BuyNow_Price" : "Card_CurrentBid"
    };
}

<div class="seller-listing-card flex h-full flex-col">
  <div class="relative flex-1">
    @if (!isBuyNow)
    {
      <div class="absolute right-3 top-3 z-10">
        @await Html.PartialAsync("Partials/_AuctionStatusBadge", auction.Status)
      </div>
    }

    <partial name="~/Views/Shared/Partials/_TradingCardAuctionCard.cshtml" model="cardModel" />
  </div>

  @if (Model.IsOwner && string.Equals(auction.Status, AuctionStatuses.Rejected, StringComparison.OrdinalIgnoreCase)
      && !string.IsNullOrWhiteSpace(auction.RejectReason))
  {
    <p class="mt-3 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">
      @Localizer["User_RejectReason", auction.RejectReason]
    </p>
  }

  <div class="mt-3 flex flex-wrap gap-2">
    <a asp-controller="@detailController" asp-action="Detail" asp-route-id="@auction.Id"
       class="inline-flex flex-1 cursor-pointer items-center justify-center gap-1.5 rounded-lg bg-blue-700 px-3 py-2 text-xs font-semibold text-white shadow-sm transition duration-200 hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-300 sm:flex-none sm:px-4">
      @Localizer["User_ViewDetail"]
    </a>

    @if (Model.IsOwner && !isBuyNow)
    {
      <a asp-controller="UserAuction" asp-action="Edit" asp-route-auctionId="@auction.Id"
         class="inline-flex cursor-pointer items-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition duration-200 hover:border-slate-300 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-200 sm:px-4">
        @Localizer["Payment_Edit"]
      </a>
    }

    @if (Model.IsOwner)
    {
      <form asp-controller="UserAuction"
            asp-action="Delete"
            asp-route-auctionId="@auction.Id"
            method="post"
            class="inline"
            onsubmit="return confirm('@Localizer["User_CancelConfirm"]');">
        @Html.AntiForgeryToken()
        <button type="submit"
                class="inline-flex cursor-pointer items-center rounded-lg border border-red-200 bg-white px-3 py-2 text-xs font-semibold text-red-600 transition duration-200 hover:border-red-300 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-200 sm:px-4">
          @Localizer["User_CancelListing"]
        </button>
      </form>
    }
  </div>
</div>
