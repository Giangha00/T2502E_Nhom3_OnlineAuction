@model OnlineAuction.Models.SellerListingCardViewModel
@using OnlineAuction.Entities
@using OnlineAuction.Helpers
@{
    var auction = Model.Auction;
    var isBuyNow = string.Equals(auction.ListingType, ListingTypes.BuyNow, StringComparison.OrdinalIgnoreCase);
    var detailController = isBuyNow ? "BuyNow" : "Auction";
    var showOwnerActions = Model.IsOwner && (Model.CanEdit || Model.CanDelete);
}

<div class="seller-listing-card flex h-full flex-col gap-3">
  @* Match Sell form Auction/Product Preview exactly (no Bid Now CTA; decorative heart). *@
  <partial name="~/Views/Shared/Partials/_TradingCardAuctionCard.cshtml"
           model="@(new AuctionCardViewModel
           {
               Item = auction,
               Variant = "grid",
               CardMode = isBuyNow ? "buynow" : "auction",
               ShowBidLink = false,
               ShowWatchlistButton = false,
               ShowWatchlistPlaceholder = true,
               ShowTimeRemaining = !isBuyNow,
               ShowProductMeta = false,
               PriceLabelResourceKey = isBuyNow ? "BuyNow_Price" : "Card_CurrentBid"
           })"/>

  @if (!string.IsNullOrWhiteSpace(auction.RejectReason) && Model.IsOwner)
  {
    <p class="rounded-lg border border-red-100 bg-red-50 px-3 py-2 text-xs text-red-700">
      <span class="font-semibold">@Localizer["User_Status_Rejected"]:</span>
      @auction.RejectReason
    </p>
  }

  @if (showOwnerActions)
  {
    <div class="flex flex-wrap gap-2">
      <a asp-controller="@detailController"
         asp-action="Detail"
         asp-route-id="@auction.Id"
         class="inline-flex flex-1 items-center justify-center rounded-lg border border-slate-200 bg-white px-3 py-2 text-xs font-semibold text-slate-700 transition hover:bg-slate-50">
        @Localizer["Common_View"]
      </a>

      @if (Model.CanEdit)
      {
        <a asp-controller="UserAuction"
           asp-action="Edit"
           asp-route-auctionId="@auction.Id"
           class="inline-flex flex-1 items-center justify-center rounded-lg border border-blue-200 bg-blue-50 px-3 py-2 text-xs font-semibold text-blue-800 transition hover:bg-blue-100">
          @Localizer["User_EditListing"]
        </a>
      }

      @if (Model.CanDelete)
      {
        <form asp-controller="UserAuction"
              asp-action="Delete"
              asp-route-auctionId="@auction.Id"
              method="post"
              class="flex-1"
              data-confirm
              data-confirm-variant="danger"
              data-confirm-title="@Localizer["User_CancelListing"]"
              data-confirm-message="@Localizer["User_CancelListingConfirm"]"
              data-confirm-confirm="@Localizer["User_CancelListing"]">
          @Html.AntiForgeryToken()
          <button type="submit"
                  class="inline-flex w-full cursor-pointer items-center justify-center rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-100">
            @Localizer["User_CancelListing"]
          </button>
        </form>
      }
    </div>
  }
</div>
