@model List<OnlineAuction.Models.AuctionItemViewModel>

<section id="seller-auctions" class="scroll-mt-header">
  <div class="mb-5 flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 0 1-2.247 2.118H6.622a2.25 2.25 0 0 1-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125Z"/>
        </svg>
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-900">Seller Auctions</h2>
        <p class="text-xs text-slate-500">@Model.Count listing@(Model.Count == 1 ? "" : "s") currently active</p>
      </div>
    </div>
  </div>

  @if (Model.Count > 0)
  {
    <div class="space-y-4">
      @foreach (var auction in Model)
      {
        @await Html.PartialAsync("Partials/_AuctionCard", auction)
      }
    </div>
  }
  else
  {
    @await Html.PartialAsync("Partials/_EmptyAuctionState")
  }
</section>
