@model OnlineAuction.Models.SellerListingListViewModel
@using OnlineAuction.Entities
@using OnlineAuction.Helpers
@{
    var isBuyNow = string.Equals(Model.Channel, ListingTypes.BuyNow, StringComparison.OrdinalIgnoreCase);
    var title = Model.IsOwner
        ? (isBuyNow ? Localizer["User_YourBuyNowList"] : Localizer["User_YourAuctionList"])
        : (isBuyNow ? Localizer["User_SellerBuyNowList"] : Localizer["User_SellerAuctions"]);
    var createAction = isBuyNow ? "BuyNow" : "Create";
    var createLabel = isBuyNow ? Localizer["User_CreateBuyNowListing"] : Localizer["User_CreateListing"];
    var listingCountLabel = isBuyNow
        ? Localizer["User_BuyNowListingCount", Model.Listings.Count]
        : Localizer["User_AuctionListingCount", Model.Listings.Count];
}

<section id="@Model.SectionId" class="scroll-mt-header p-6 sm:p-8">
  <div class="mb-6 flex flex-wrap items-start justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
        @if (isBuyNow)
        {
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25h9.75M7.5 14.25 6.106 5.272M7.5 14.25l-1.086 4.77M16.5 14.25l1.086 4.77M16.5 14.25V9.75a2.25 2.25 0 0 0-2.25-2.25h-4.5A2.25 2.25 0 0 0 7.5 9.75v4.5"/>
          </svg>
        }
        else
        {
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 15.536c-1.171 1.952-3.07 1.952-4.242 0-1.172-1.953-1.172-5.119 0-7.072 1.171-1.952 3.07-1.952 4.242 0M8 10.5h4m-4 3h4m9-1.5a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
          </svg>
        }
      </div>
      <div>
        <h2 class="text-base font-bold text-slate-900">@title</h2>
        <p class="text-xs text-slate-500">@listingCountLabel</p>
      </div>
    </div>

    @if (Model.IsOwner)
    {
      <a asp-controller="Sell" asp-action="@createAction"
         class="inline-flex cursor-pointer items-center justify-center rounded-lg bg-blue-700 px-4 py-2 text-xs font-semibold text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-blue-800 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-blue-300">
        @createLabel
      </a>
    }
  </div>

  @if (Model.Listings.Count > 0)
  {
    <div class="rarecard-auction-grid">
      @foreach (var listing in Model.Listings)
      {
        var canManage = Model.IsOwner && SellerListingActions.CanManage(listing);
        @await Html.PartialAsync("Partials/_SellerListingCard", new SellerListingCardViewModel
        {
          Auction = listing,
          IsOwner = Model.IsOwner,
          CanEdit = canManage,
          CanDelete = canManage
        })
      }
    </div>
  }
  else
  {
    @await Html.PartialAsync("Partials/_EmptyAuctionState", new EmptyListingStateViewModel
    {
      IsOwner = Model.IsOwner,
      Channel = Model.Channel
    })
  }
</section>
