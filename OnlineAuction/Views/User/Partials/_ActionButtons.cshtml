@model OnlineAuction.Models.UserProfileViewModel

<section class="action-buttons rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
  <h2 class="text-lg font-bold text-stone-900">Seller Actions</h2>
  <p class="mt-1 text-sm text-stone-500">Connect with this seller</p>

  <div class="mt-5 flex flex-col gap-3">
    <button type="button"
            class="w-full rounded-xl bg-amber-700 px-5 py-3 text-sm font-semibold text-white transition hover:bg-amber-800">
      Contact Seller
    </button>
    <a asp-controller="User" asp-action="Detail" asp-route-id="@Model.Id" asp-fragment="seller-auctions"
       class="w-full rounded-xl border border-stone-300 bg-white px-5 py-3 text-center text-sm font-semibold text-stone-800 transition hover:bg-stone-50">
      View Auctions
    </a>
    <button type="button"
            class="w-full rounded-xl border border-amber-300 bg-amber-50 px-5 py-3 text-sm font-semibold text-amber-800 transition hover:bg-amber-100">
      Follow
    </button>
  </div>
</section>
