@model OnlineAuction.Models.SellerAuctionCardViewModel
@using OnlineAuction.Entities
@{
  var auction = Model.Auction;
  var isBuyNow = string.Equals(auction.ListingType, ListingTypes.BuyNow, StringComparison.OrdinalIgnoreCase);
  var detailController = isBuyNow ? "BuyNow" : "Auction";
}

<article class="user-detail-auction-card">
  <a asp-controller="@detailController" asp-action="Detail" asp-route-id="@auction.Id"
     class="user-detail-auction-card__media">
    <img src="@auction.ImageUrl" alt="@auction.Name" loading="lazy"
         class="h-full w-full object-cover"/>
  </a>

  <div class="user-detail-auction-card__body">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-[10px] font-bold uppercase tracking-wide text-blue-700">@auction.Category</span>
      @if (isBuyNow)
      {
        <span class="inline-flex rounded-full bg-emerald-600 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">
          @Localizer["BuyNow_InStock"]
        </span>
      }
      else
      {
        @await Html.PartialAsync("Partials/_AuctionStatusBadge", auction.Status)
      }
    </div>

    <h3 class="mt-2 line-clamp-2 text-sm font-bold text-slate-900 sm:text-base">@auction.Name</h3>

    @if (Model.IsOwner && string.Equals(auction.Status, "rejected", StringComparison.OrdinalIgnoreCase)
        && !string.IsNullOrWhiteSpace(auction.RejectReason))
    {
      <p class="mt-2 rounded-lg border border-red-200 bg-red-50 px-3 py-2 text-xs text-red-700">
        @Localizer["User_RejectReason", auction.RejectReason]
      </p>
    }

    <div class="mt-3 flex flex-wrap gap-x-8 gap-y-2 text-sm">
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">
          @(isBuyNow ? Localizer["BuyNow_Price"] : Localizer["User_CurrentBid"])
        </p>
        <p class="mt-0.5 text-base font-bold text-slate-900">$@auction.CurrentPrice.ToString("N0")</p>
      </div>
      @if (!isBuyNow)
      {
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">@Localizer["User_Ends"]</p>
          <p class="mt-0.5 text-sm font-medium text-slate-700">@auction.TimeRemaining</p>
        </div>
      }
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <a asp-controller="@detailController" asp-action="Detail" asp-route-id="@auction.Id"
         class="inline-flex cursor-pointer items-center gap-1.5 rounded-lg bg-blue-700 px-4 py-2 text-xs font-semibold text-white shadow-sm transition duration-200 hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-blue-300">
        @Localizer["User_ViewDetail"]
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
      </a>

      @if (Model.IsOwner && !isBuyNow)
      {
        <a asp-controller="UserAuction" asp-action="Edit" asp-route-auctionId="@auction.Id"
           class="inline-flex cursor-pointer items-center rounded-lg border border-slate-200 bg-white px-4 py-2 text-xs font-semibold text-slate-700 transition duration-200 hover:border-slate-300 hover:bg-slate-50 focus:outline-none focus:ring-2 focus:ring-slate-200">
          @Localizer["Payment_Edit"]
        </a>

        <form asp-controller="UserAuction"
              asp-action="Delete"
              asp-route-auctionId="@auction.Id"
              method="post"
              class="inline"
              onsubmit="return confirm('@Localizer["User_CancelConfirm"]');">
          @Html.AntiForgeryToken()
          <button type="submit"
                  class="inline-flex cursor-pointer items-center rounded-lg border border-red-200 bg-white px-4 py-2 text-xs font-semibold text-red-600 transition duration-200 hover:border-red-300 hover:bg-red-50 focus:outline-none focus:ring-2 focus:ring-red-200">
            @Localizer["User_CancelListing"]
          </button>
        </form>
      }
    </div>
  </div>
</article>
