@model OnlineAuction.Models.AuctionItemViewModel

<article class="flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:border-blue-200 hover:shadow-md sm:flex-row">
  <a asp-controller="Auction" asp-action="Detail" asp-route-id="@Model.Id"
     class="relative aspect-[4/3] shrink-0 overflow-hidden sm:aspect-auto sm:h-32 sm:w-36">
    <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy"
         class="h-full w-full object-cover transition duration-300 hover:scale-105"/>
  </a>

  <div class="flex min-w-0 flex-1 flex-col p-4 sm:p-5">
    <div class="flex flex-wrap items-center gap-2">
      <span class="text-[10px] font-semibold uppercase tracking-wide text-blue-700">@Model.Category</span>
      @await Html.PartialAsync("Partials/_AuctionStatusBadge", Model.Status)
    </div>

    <h3 class="mt-2 line-clamp-2 text-sm font-semibold text-slate-900 sm:text-base">@Model.Name</h3>

    <div class="mt-3 flex flex-wrap gap-x-6 gap-y-1 text-sm">
      <div>
        <span class="text-slate-400">Current Bid</span>
        <p class="font-bold text-blue-700">$@Model.CurrentPrice.ToString("N0")</p>
      </div>
      <div>
        <span class="text-slate-400">Ends</span>
        <p class="font-medium text-slate-700">@Model.TimeRemaining</p>
      </div>
    </div>

    <div class="mt-auto pt-4">
      <a asp-controller="Auction" asp-action="Detail" asp-route-id="@Model.Id"
         class="inline-flex items-center gap-1 rounded-lg bg-blue-700 px-4 py-2 text-xs font-semibold text-white transition hover:bg-blue-800">
        View Detail
        <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
      </a>
    </div>
  </div>
</article>
