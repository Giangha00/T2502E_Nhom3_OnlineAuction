@model OnlineAuction.Models.AuctionItemViewModel

<article class="auction-card flex flex-col overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:border-amber-300 hover:shadow-md sm:flex-row">
  <a asp-controller="Auction" asp-action="Detail" asp-route-id="@Model.Id"
     class="relative aspect-[4/3] shrink-0 overflow-hidden sm:aspect-auto sm:h-36 sm:w-36">
    <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy"
         class="h-full w-full object-cover transition duration-300 hover:scale-105"/>
  </a>

  <div class="flex min-w-0 flex-1 flex-col p-4 sm:p-5">
    <div class="flex flex-wrap items-center gap-2">
      <p class="text-[10px] font-semibold uppercase tracking-widest text-stone-400">@Model.Category</p>
      @await Html.PartialAsync("Partials/_AuctionStatusBadge", Model.Status)
    </div>

    <h3 class="mt-2 line-clamp-2 text-base font-semibold text-stone-900">@Model.Name</h3>

    <dl class="mt-3 space-y-1 text-sm">
      <div class="flex flex-wrap items-baseline gap-2">
        <dt class="text-stone-500">Current Bid:</dt>
        <dd class="font-bold text-amber-700">$@Model.CurrentPrice.ToString("N0")</dd>
      </div>
      <div class="flex flex-wrap items-baseline gap-2">
        <dt class="text-stone-500">End Time:</dt>
        <dd class="font-medium text-stone-700">@Model.TimeRemaining</dd>
      </div>
    </dl>

    <div class="mt-auto pt-4">
      <a asp-controller="Auction" asp-action="Detail" asp-route-id="@Model.Id"
         class="inline-flex rounded-xl border border-amber-300 bg-amber-50 px-4 py-2 text-sm font-semibold text-amber-800 transition hover:bg-amber-100">
        View Detail
      </a>
    </div>
  </div>
</article>
