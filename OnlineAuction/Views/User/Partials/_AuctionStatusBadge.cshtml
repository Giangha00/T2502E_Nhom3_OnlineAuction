@model string

@{
    var normalized = Model switch
    {
        "Live" or "Active" => ("Active", "Active Auction", "bg-emerald-600"),
        "Ending Soon" => ("Ending Soon", "Ending Soon", "bg-orange-600"),
        "Completed" or "Won" => ("Completed", "Completed", "bg-stone-500"),
        _ => (Model, Model, "bg-blue-700")
    };
}

<span class="inline-flex rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white @normalized.Item3">
  @normalized.Item2
</span>
