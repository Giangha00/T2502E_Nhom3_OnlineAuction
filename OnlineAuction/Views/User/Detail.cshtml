@model OnlineAuction.Models.UserDetailViewModel
@{
    ViewData["Title"] = Model.Profile.Username;
    var successRate = Model.Statistics.TotalAuctions > 0
        ? Math.Round((double)Model.Statistics.CompletedAuctions / Model.Statistics.TotalAuctions * 100)
        : 0;
}

<div class="user-detail-page min-h-screen bg-slate-50">
  <section class="site-shell px-4 py-8 sm:px-6 lg:py-10">
    @await Html.PartialAsync("Partials/_UserProfileHeader", Model)

    <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4">
      <div class="user-detail-stat-card">
        <p class="user-detail-stat-card__label">@Localizer["User_Stat_TotalListings"]</p>
        <p class="user-detail-stat-card__value">@Model.Statistics.TotalListings</p>
      </div>
      <div class="user-detail-stat-card">
        <p class="user-detail-stat-card__label">@Localizer["User_Stat_Completed"]</p>
        <p class="user-detail-stat-card__value">@Model.Statistics.CompletedAuctions</p>
      </div>
      <div class="user-detail-stat-card">
        <p class="user-detail-stat-card__label">@Localizer["User_Stat_PaidOrders"]</p>
        <p class="user-detail-stat-card__value">@Model.Statistics.TotalSales</p>
      </div>
      <div class="user-detail-stat-card">
        <p class="user-detail-stat-card__label">@Localizer["User_Stat_SuccessRate"]</p>
        <p class="user-detail-stat-card__value user-detail-stat-card__value--accent">@successRate%</p>
      </div>
    </div>

    @if (Model.IsOwner)
    {
      <div class="user-detail-actions-mobile mt-6 lg:hidden">
        @await Html.PartialAsync("Partials/_ActionButtons", Model.Profile)
      </div>
    }

    <div class="mt-8 grid gap-8 @(Model.IsOwner ? "lg:grid-cols-[minmax(0,1fr)_300px] xl:grid-cols-[minmax(0,1fr)_320px]" : string.Empty)">
      <div class="overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
        @await Html.PartialAsync("Partials/_UserInformation", Model.BasicInfo)
        <div class="border-t border-slate-100"></div>
        @await Html.PartialAsync("Partials/_SellerAuctionList", new SellerListingListViewModel
        {
          IsOwner = Model.IsOwner,
          Channel = OnlineAuction.Entities.ListingTypes.Auction,
          SectionId = "seller-auctions",
          Listings = Model.Auctions
        })
        <div class="border-t border-slate-100"></div>
        @await Html.PartialAsync("Partials/_SellerAuctionList", new SellerListingListViewModel
        {
          IsOwner = Model.IsOwner,
          Channel = OnlineAuction.Entities.ListingTypes.BuyNow,
          SectionId = "seller-buynow",
          Listings = Model.BuyNowListings
        })
      </div>

      @if (Model.IsOwner)
      {
        <aside class="hidden lg:block">
          <div class="sticky-below-header">
            @await Html.PartialAsync("Partials/_ActionButtons", Model.Profile)
          </div>
        </aside>
      }
    </div>

    @await Html.PartialAsync("Partials/_RelatedAuctions", Model.RelatedAuctions)
  </section>
</div>
