@model OnlineAuction.Models.UserDetailViewModel
@{
    ViewData["Title"] = Model.Profile.Username;
}

<div class="user-detail-page min-h-screen bg-slate-50">
  <section class="site-shell px-4 py-8 sm:px-6 lg:py-10">
    <nav aria-label="Breadcrumb" class="mb-6">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-slate-400 sm:text-sm">
        <li><a asp-controller="Home" asp-action="Index" class="transition hover:text-blue-700">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a asp-controller="Auction" asp-action="Index" class="transition hover:text-blue-700">Auction</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-slate-700" aria-current="page">Seller Profile</li>
      </ol>
    </nav>

    @await Html.PartialAsync("Partials/_UserProfileHeader", Model)

    @if (TempData["SuccessMessage"] is string successMessage)
    {
      <div class="mt-6 rounded-xl border border-emerald-200 bg-emerald-50 px-5 py-3 text-sm text-emerald-800">
        @successMessage
      </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
      <div class="mt-6 rounded-xl border border-red-200 bg-red-50 px-5 py-3 text-sm text-red-700">
        @errorMessage
      </div>
    }

    <div class="user-detail-actions-mobile mt-6 lg:hidden">
      @await Html.PartialAsync("Partials/_ActionButtons", Model.Profile)
    </div>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1fr_300px] xl:grid-cols-[1fr_320px]">
      <div class="space-y-8">
        @await Html.PartialAsync("Partials/_UserInformation", Model.BasicInfo)
        @await Html.PartialAsync("Partials/_SellerAuctionList", Model)
        @await Html.PartialAsync("Partials/_RatingSection", Model.Rating)
      </div>

      <aside class="hidden lg:block">
        <div class="sticky-below-header">
          @await Html.PartialAsync("Partials/_ActionButtons", Model.Profile)
        </div>
      </aside>
    </div>

    @await Html.PartialAsync("Partials/_RelatedAuctions", Model.RelatedAuctions)
  </section>
</div>
