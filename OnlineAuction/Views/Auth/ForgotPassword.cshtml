@model OnlineAuction.Models.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="home-auth-overlay" aria-hidden="false">
  <div class="home-auth-backdrop"></div>
  <div class="home-auth-modal home-auth-modal--auth-page" role="dialog" aria-modal="true" aria-labelledby="forgotPasswordTitle">
    <div class="home-auth-modal__grid">
      <aside class="home-auth-visual" aria-hidden="true">
        <div class="home-auth-visual__slides">
          <div class="home-auth-visual__slide is-active"
               style="background-image: url('https://images.unsplash.com/photo-1612036782180-6f0b6cd846fe?w=900&h=1100&fit=crop&q=80');"></div>
        </div>
        <div class="home-auth-visual__overlay"></div>
        <div class="home-auth-visual__content">
          <p class="home-auth-visual__eyebrow">RareCard Vault</p>
          <h3 class="home-auth-visual__title">Welcome to RareCard</h3>
          <p class="home-auth-visual__desc">Bid on authenticated graded cards from PSA, BGS and CGC vaults.</p>
        </div>
      </aside>

      <div class="home-auth-form-col">
        <a asp-controller="Home" asp-action="Index" class="home-auth-close" aria-label="Đóng">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 6 6 18M6 6l12 12"/>
          </svg>
        </a>

        <div class="home-auth-brand">
          <span class="home-auth-logo">RareCard</span>
        </div>

        <h1 id="forgotPasswordTitle" class="home-auth-heading">Quên mật khẩu?</h1>
        <p class="home-auth-subheading">Nhập email để nhận liên kết đặt lại mật khẩu.</p>

        @if (TempData["AuthError"] is string resetError)
        {
          <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@resetError</p>
        }

        <div class="home-auth-tabs" role="tablist" aria-label="Password reset">
          <a asp-controller="Auth" asp-action="Login" class="home-auth-tab" role="tab" aria-selected="false">Log in</a>
          <button type="button" class="home-auth-tab home-auth-tab--active" role="tab" aria-selected="true">Reset password</button>
        </div>

        <div asp-validation-summary="ModelOnly" class="mb-2 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

        <form method="post" asp-action="ForgotPassword" class="home-auth-form">
          @Html.AntiForgeryToken()

          <div class="home-auth-field">
            <label asp-for="Email" class="home-auth-field__label">Email</label>
            <input asp-for="Email" placeholder="Enter your email address" autocomplete="email" class="home-auth-input" />
            <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
          </div>

          <button type="submit" class="home-auth-submit">Gửi liên kết reset</button>
        </form>

        <p class="home-auth-legal">
          Nếu email tồn tại, RareCard sẽ tạo liên kết đặt lại mật khẩu cho tài khoản đó.
        </p>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
