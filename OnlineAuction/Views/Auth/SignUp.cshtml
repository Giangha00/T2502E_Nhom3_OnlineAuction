@model OnlineAuction.Models.SignUpViewModel
@{
    ViewData["Title"] = Localizer["Auth_SignUp"];
}
<div class="min-h-screen bg-gradient-to-br from-stone-100 via-amber-50 to-orange-100 flex items-center justify-center px-4 py-8">
    <div class="w-full max-w-5xl overflow-hidden rounded-3xl bg-white/80 shadow-2xl backdrop-blur">
        <div class="grid md:grid-cols-2">
            <div class="hidden md:flex flex-col justify-between bg-gradient-to-br from-stone-900 to-amber-700 p-10 text-white">
                <div>
                    <h1 class="text-4xl font-bold">Auction House</h1>
                    <p class="mt-4 text-sm leading-6 text-amber-100">
                        @Localizer["Auth_Modal_Subtitle"]
                    </p>
                </div>

                <div class="rounded-2xl bg-white/10 p-5">
                    <p class="text-sm text-amber-100">@Localizer["Auth_Slide2_Title"]</p>
                </div>
            </div>

            <div class="p-8 sm:p-12">
                <h2 class="text-3xl font-bold text-stone-800">@Localizer["Auth_CreateAccount"]</h2>
                <p class="mt-2 text-sm text-stone-500">@Localizer["Auth_Modal_Subtitle"]</p>

                @if (TempData["AuthError"] is string signUpError)
                {
                    <p class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">@signUpError</p>
                }

                <div asp-validation-summary="ModelOnly" class="mt-4 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"></div>

                <form id="signUpForm" method="post" asp-action="SignUp" class="mt-8 space-y-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div>
                        <input asp-for="FullName" placeholder="@Localizer["Auth_Placeholder_FullName"]"
                               class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100" />
                        <span asp-validation-for="FullName" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <div>
                        <input asp-for="Email" placeholder="@Localizer["Auth_Placeholder_Email"]"
                               class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100" />
                        <span asp-validation-for="Email" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <div>
                        <input asp-for="PhoneNumber" placeholder="@Localizer["Auth_Placeholder_Phone"]"
                               class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100" />
                        <span asp-validation-for="PhoneNumber" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <div>
                        <input asp-for="Password" placeholder="@Localizer["Auth_Placeholder_SignupPassword"]"
                               class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100" />
                        <span asp-validation-for="Password" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <div>
                        <input asp-for="ConfirmPassword" placeholder="@Localizer["Auth_Placeholder_ConfirmPassword"]"
                               class="w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100" />
                        <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-red-600"></span>
                    </div>

                    <button type="submit"
                            class="w-full rounded-xl bg-amber-700 py-3 font-semibold text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800">
                        @Localizer["Auth_CreateAccount"]
                    </button>
                </form>

                <p class="mt-6 text-center text-sm text-stone-500">
                    <a asp-controller="Auth" asp-action="Login" class="font-semibold text-amber-700 hover:text-amber-800">
                        @Localizer["Auth_LogIn"]
                    </a>
                </p>

                <a asp-controller="Home" asp-action="Index"
                   class="mt-4 flex w-full items-center justify-center rounded-xl border border-stone-200 py-3 text-sm font-medium text-stone-600 transition hover:border-stone-300 hover:bg-stone-50">
                    @Localizer["Common_Breadcrumb_Home"]
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
