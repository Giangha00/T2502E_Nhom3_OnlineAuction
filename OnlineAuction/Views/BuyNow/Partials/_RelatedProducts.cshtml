@model OnlineAuction.Models.ProductDetailViewModel
@{
    var hasSimilar = Model.RelatedProducts.Count > 0;
    var hasMoreRelated = Model.MoreRelatedProducts.Count > 0;
}

@if (hasSimilar || hasMoreRelated)
{
  <div class="product-detail-section product-detail-related mt-14 border-t border-slate-200 pt-12">
    @if (hasSimilar)
    {
      <partial name="~/Views/Shared/Partials/_RelatedListingsCarousel.cshtml"
               model="@(new RelatedListingsCarouselViewModel
               {
                 Title = Localizer["Product_SimilarListingsTitle"].Value,
                 SectionKey = "similar",
                 Items = Model.RelatedProducts
               })"/>
    }
    @if (hasMoreRelated)
    {
      <div class="@(hasSimilar ? "mt-10 sm:mt-12" : null)">
        <partial name="~/Views/Shared/Partials/_RelatedListingsCarousel.cshtml"
                 model="@(new RelatedListingsCarouselViewModel
                 {
                   Title = Localizer["Product_MoreRelatedTitle"].Value,
                   SectionKey = "more-related",
                   Items = Model.MoreRelatedProducts
                 })"/>
      </div>
    }
  </div>
}
