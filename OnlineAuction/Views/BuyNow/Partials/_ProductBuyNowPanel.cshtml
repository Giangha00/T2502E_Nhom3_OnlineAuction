@model OnlineAuction.Models.ProductDetailViewModel
@{
    var specs = new List<string>();
    if (!string.IsNullOrEmpty(Model.Grade)) specs.Add(Model.Grade);
    if (!string.IsNullOrEmpty(Model.SetName)) specs.Add(Model.SetName);
    if (!string.IsNullOrEmpty(Model.Condition)) specs.Add(Model.Condition);
    if (!string.IsNullOrEmpty(Model.CertificateNumber)) specs.Add($"Cert. {Model.CertificateNumber}");
    var isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<div class="product-bid-panel product-buy-panel" data-is-logged-in="@(isLoggedIn ? "true" : "false")" data-product-id="@Model.Id">
  <h1 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">@Model.Category</h1>
  <p class="mt-1 text-lg text-slate-800">
    <em>@Model.Name</em>@if (Model.Year > 0) { <span>, @Model.Year</span> }
  </p>

  @if (specs.Count > 0)
  {
    <p class="mt-4 text-sm leading-relaxed text-slate-600">@string.Join(" · ", specs)</p>
  }

  <div class="mt-4 inline-flex items-center gap-2 text-sm text-slate-600">
    <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
    </svg>
    Authenticated listing
  </div>

  <div class="product-bid-panel__divider"></div>

  <div class="flex items-start justify-between gap-6">
    <div>
      <p class="text-sm text-slate-700">Price</p>
      <p class="mt-1 text-xs text-slate-500">Fixed buy now price</p>
      <p class="mt-0.5 text-xs font-medium text-emerald-700">In stock</p>
    </div>
    <p class="text-3xl font-bold tabular-nums text-slate-900 sm:text-4xl">$@Model.CurrentPrice.ToString("N0")</p>
  </div>

  <p class="mt-4 text-xs leading-relaxed text-slate-500">
    Price includes buyer's premium. Shipping and taxes may apply.
  </p>

  <div class="product-bid-panel__divider"></div>

  <button type="button" id="addToCartBtn"
          class="flex w-full items-center justify-center rounded-md bg-slate-900 py-3.5 text-sm font-semibold text-white transition hover:bg-slate-800">
    Add to Cart
  </button>

  <p id="addToCartMessage" class="mt-3 hidden text-center text-sm font-medium text-emerald-700" role="status"></p>

  <div class="mt-6">
    @await Html.PartialAsync("~/Views/Auction/Partials/_SellerInfo.cshtml", Model.Seller)
  </div>
</div>
