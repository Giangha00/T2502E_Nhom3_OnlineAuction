@model OnlineAuction.Models.ProductDetailViewModel

<section class="product-detail-tabs mt-10">
  <div class="product-detail-tabs__nav" role="tablist">
    <button type="button" class="product-detail-tabs__tab is-active" role="tab" aria-selected="true" data-tab="about">@Localizer["Product_AboutTheWork"]</button>
    <button type="button" class="product-detail-tabs__tab" role="tab" aria-selected="false" data-tab="grading">@Localizer["Product_Grading"]</button>
    <button type="button" class="product-detail-tabs__tab" role="tab" aria-selected="false" data-tab="certificates">@Localizer["Product_Certificates_Tab"]</button>
    <button type="button" class="product-detail-tabs__tab" role="tab" aria-selected="false" data-tab="shipping">@Localizer["Product_Shipping"]</button>
  </div>

  <div class="product-detail-tabs__panel is-active" role="tabpanel" data-panel="about">
    <div class="product-description text-sm leading-relaxed text-slate-600">
      @Html.Raw(Model.DescriptionHtml)
    </div>
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div>
        <p class="text-xs text-slate-400">@Localizer["Product_Year"]</p>
        <p class="mt-1 text-sm font-medium text-slate-900">@(Model.Year > 0 ? Model.Year.ToString() : "—")</p>
      </div>
      <div>
        <p class="text-xs text-slate-400">@Localizer["Product_Set"]</p>
        <p class="mt-1 text-sm font-medium text-slate-900">@Model.SetName</p>
      </div>
      <div>
        <p class="text-xs text-slate-400">@Localizer["Product_Language"]</p>
        <p class="mt-1 text-sm font-medium text-slate-900">@Model.Language</p>
      </div>
      <div>
        <p class="text-xs text-slate-400">@Localizer["Product_CardNumber"]</p>
        <p class="mt-1 text-sm font-medium text-slate-900">@Model.CardNumber</p>
      </div>
    </div>
  </div>

  <div class="product-detail-tabs__panel" role="tabpanel" data-panel="grading" hidden>
    @await Html.PartialAsync("~/Views/Auction/Partials/_GradingSection.cshtml", Model)
  </div>

  <div class="product-detail-tabs__panel" role="tabpanel" data-panel="certificates" hidden>
    @await Html.PartialAsync("~/Views/Auction/Partials/_DocumentSection.cshtml", Model)
  </div>

  <div class="product-detail-tabs__panel" role="tabpanel" data-panel="shipping" hidden>
    @await Html.PartialAsync("~/Views/Auction/Partials/_ShippingSection.cshtml", Model)
  </div>
</section>
