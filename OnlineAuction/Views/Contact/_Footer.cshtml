<!-- Footer Component -->
<footer class="mt-8 border-t border-stone-200/80 bg-white/70">
    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="grid gap-10 md:grid-cols-[1.2fr_2fr] md:gap-16">
            <div>
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-2.5">
                    <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-amber-700 to-stone-900 text-sm font-bold text-white">A</span>
                    <span class="text-sm font-semibold text-stone-900">Auction House</span>
                </a>
                <p class="mt-3 max-w-xs text-sm leading-6 text-stone-600">
                    Discover unique products through online auction. Connect with trusted sellers and bidders worldwide.
                </p>
            </div>

            <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
                <div>
                    <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">About</h4>
                    <ul class="mt-4 space-y-2">
                        <li><a asp-controller="AboutUs" asp-action="Index" class="text-sm text-stone-600 transition hover:text-amber-700">About Us</a></li>
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Our Story</a></li>
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Careers</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Contact</h4>
                    <ul class="mt-4 space-y-2">
                        <li><a asp-controller="Contact" asp-action="Index" class="text-sm text-stone-600 transition hover:text-amber-700">Contact Us</a></li>
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Support</a></li>
                        <li><a href="mailto:help@auctionhouse.com" class="text-sm text-stone-600 transition hover:text-amber-700">help@auctionhouse.com</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Help</h4>
                    <ul class="mt-4 space-y-2">
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">FAQ</a></li>
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">How to Bid</a></li>
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Seller Guide</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs font-semibold uppercase tracking-widest text-stone-900">Legal</h4>
                    <ul class="mt-4 space-y-2">
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Policy &amp; Term of Use</a></li>
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Privacy Policy</a></li>
                        <li><a href="#" class="text-sm text-stone-600 transition hover:text-amber-700">Cookie Policy</a></li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="mt-10 border-t border-stone-200 pt-6">
            <p class="text-xs text-stone-500">&copy; @DateTime.Now.Year Auction House. All rights reserved.</p>
        </div>
    </div>
</footer>

