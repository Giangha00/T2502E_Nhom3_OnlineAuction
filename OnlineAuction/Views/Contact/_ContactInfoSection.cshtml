@model OnlineAuction.Models.ContactPageViewModel
@{
    var info = Model.ContactInfo;
    var location = Model.Location;
}

<div class="flex h-full flex-col gap-5">
  <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm shadow-slate-200/50">
    <h2 class="text-lg font-bold text-slate-900">@Localizer["Contact_GetInTouch"]</h2>
    <p class="mt-1 text-sm text-slate-500">@Localizer["Contact_Form_ResponseTime"]</p>

    <ul class="mt-6 space-y-3">
      <li>
        <a href="mailto:@info?.Email"
           class="group flex items-start gap-4 rounded-xl border border-transparent p-3 transition hover:border-blue-100 hover:bg-blue-50/50">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-600/20">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"/>
            </svg>
          </div>
          <div class="min-w-0 pt-0.5">
            <p class="text-sm font-semibold text-slate-900">@Localizer["Contact_EmailUs"]</p>
            <p class="mt-0.5 truncate text-sm text-blue-700 group-hover:text-blue-800">@info?.Email</p>
          </div>
        </a>
      </li>
      <li>
        <a href="tel:+18887273273"
           class="group flex items-start gap-4 rounded-xl border border-transparent p-3 transition hover:border-blue-100 hover:bg-blue-50/50">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-700 transition group-hover:bg-white group-hover:shadow-sm">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"/>
            </svg>
          </div>
          <div class="min-w-0 pt-0.5">
            <p class="text-sm font-semibold text-slate-900">@Localizer["Contact_CallDirectly"]</p>
            <p class="mt-0.5 text-sm text-slate-600 group-hover:text-blue-700">@info?.Phone</p>
          </div>
        </a>
      </li>
      <li>
        <a href="#"
           class="group flex items-start gap-4 rounded-xl border border-transparent p-3 transition hover:border-blue-100 hover:bg-blue-50/50">
          <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-slate-100 text-slate-700 transition group-hover:bg-white group-hover:shadow-sm">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 0 0 3.741-.479 3 3 0 0 0-4.682-2.72m.94 3.198.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0 1 12 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 0 1 6 18.719m12 0a5.971 5.971 0 0 0-.941-3.197m0 0A5.995 5.995 0 0 0 12 12.75a5.995 5.995 0 0 0-5.058 2.772m0 0a3 3 0 0 0-4.681 2.72 8.986 8.986 0 0 0 3.74.477m.94-3.197a5.971 5.971 0 0 0-.94 3.197M15 6.75a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm6 3a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Zm-13.5 0a2.25 2.25 0 1 1-4.5 0 2.25 2.25 0 0 1 4.5 0Z"/>
            </svg>
          </div>
          <div class="min-w-0 pt-0.5">
            <p class="text-sm font-semibold text-slate-900">@Localizer["Contact_JoinCommunity"]</p>
            <p class="mt-0.5 text-sm text-blue-700 group-hover:text-blue-800">@info?.Discord</p>
          </div>
        </a>
      </li>
    </ul>
  </div>

  <div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-sm shadow-slate-200/50">
    <div class="flex items-start gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-blue-50 text-blue-700">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z"/>
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z"/>
        </svg>
      </div>
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-blue-700">@Localizer["Contact_HQLocation"]</p>
        <p class="mt-2 text-sm leading-relaxed text-slate-600">@location?.Address</p>
      </div>
    </div>

    <div class="mt-5 border-t border-slate-100 pt-5">
      <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">@Localizer["Contact_BusinessHours"]</p>
      <dl class="mt-3 space-y-2 text-sm">
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">@Localizer["Contact_MonFri"]</dt>
          <dd class="font-medium text-slate-900">08:00 – 18:00</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">@Localizer["Contact_Saturday"]</dt>
          <dd class="font-medium text-slate-900">09:00 – 17:00</dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-slate-500">@Localizer["Contact_Sunday"]</dt>
          <dd class="font-medium text-slate-400">@Localizer["Contact_Closed"]</dd>
        </div>
      </dl>
    </div>
  </div>
</div>
