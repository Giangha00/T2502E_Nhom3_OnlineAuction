<!-- Map/Location Section -->
<section class="py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
                Our Location
            </h2>
            <p class="mt-2 text-base text-slate-600">
                Visit us at our Hanoi headquarters or connect with us online
            </p>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
            <!-- Map Placeholder -->
            <div class="lg:col-span-2">
                <!-- Embedded Google Map (iframe) - replaced clickable preview with inline map -->
                <div class="relative h-96 overflow-hidden rounded-2xl border border-slate-200 bg-stone-50 shadow-sm">
                    <iframe
                        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d12104.732669536184!2d105.74325493307715!3d21.03749454480402!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x313455305afd834b%3A0x17268e09af37081e!2sT%C3%B2a%20nh%C3%A0%20FPT%20Polytechnic.!5e0!3m2!1svi!2s!4v1781168481501!5m2!1svi!2s"
                        width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>

                    <!-- Centered label over iframe (non-clickable) -->
                    <div class="absolute inset-0 flex items-start justify-center pointer-events-none">
                        <div class="mt-4 rounded-md bg-white/60 px-3 py-1 text-sm font-medium text-slate-800">
                            Tòa nhà FPT Polytechnic — Trịnh Văn Bô, Xuân Phương, Hà Nội 100000
                        </div>
                    </div>
                </div>
            </div>

            <!-- Location Details -->
            <div class="space-y-6">
                <!-- Main Office -->
                <div class="rounded-xl border border-slate-200 bg-white/80 p-5 shadow-sm">
                    <h3 class="font-semibold text-slate-900 mb-3">Main Office</h3>
                    <div class="space-y-3 text-sm text-slate-600">
                        <div class="flex gap-2">
                            <svg class="h-5 w-5 text-blue-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            </svg>
                            <p>Tòa nhà FPT Polytechnic, Trịnh Văn Bô, Xuân Phương, Hà Nội 100000, Việt Nam</p>      
                        </div>
                        <div class="flex gap-2">
                            <svg class="h-5 w-5 text-blue-700 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                            <a href="tel:+84123456789" class="text-blue-700 hover:text-blue-800 font-medium">+84 123 456 789</a>
                        </div>
                    </div>
                </div>

                <!-- Hours -->
                <div class="rounded-xl border border-slate-200 bg-white/80 p-5 shadow-sm">
                    <h3 class="font-semibold text-slate-900 mb-3">Business Hours</h3>
                    <div class="space-y-2 text-sm text-slate-600">
                        <div class="flex justify-between">
                            <span>Monday - Friday</span>
                            <span class="font-medium text-slate-900">08:00 - 18:00</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Saturday</span>
                            <span class="font-medium text-slate-900">09:00 - 17:00</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Sunday</span>
                            <span class="font-medium text-slate-900">Closed</span>
                        </div>
                    </div>
                </div>

                <!-- Get Directions Button -->
                <!-- Get Directions button removed external navigation; map is embedded inline now -->
                <button type="button" class="flex items-center justify-center gap-2 w-full rounded-lg bg-blue-100 px-4 py-2.5 text-sm font-semibold text-blue-700 transition" disabled>
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    Map embedded on this page
                </button>
            </div>
        </div>
    </div>
</section>

