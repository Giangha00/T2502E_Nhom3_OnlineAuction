<!-- Map/Location Section -->
<section class="py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <h2 class="text-3xl font-bold text-stone-900 sm:text-4xl">
                Our Location
            </h2>
            <p class="mt-2 text-base text-stone-600">
                Visit us at our Hanoi headquarters or connect with us online
            </p>
        </div>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
            <!-- Map Placeholder -->
            <div class="lg:col-span-2">
                <div class="relative h-96 overflow-hidden rounded-2xl border border-stone-200 bg-gradient-to-br from-stone-100 to-stone-50 shadow-sm">
                    <!-- Map container -->
                    <div class="flex h-full w-full items-center justify-center">
                        <div class="text-center">
                            <svg class="mx-auto h-12 w-12 text-stone-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6.553 3.276A1 1 0 0117 20.382V9.618a1 1 0 00-1.447-.894L9 13m0-13v13m6-13l5.447-2.724A1 1 0 0121 5.618v10.764a1 1 0 01-1.447.894L15 18"></path>
                            </svg>
                            <p class="text-stone-500 font-medium">Google Map will be integrated here</p>
                            <p class="text-xs text-stone-400 mt-2">123 Auction Street, Hanoi, Vietnam</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Location Details -->
            <div class="space-y-6">
                <!-- Main Office -->
                <div class="rounded-xl border border-stone-200 bg-white/80 p-5 shadow-sm">
                    <h3 class="font-semibold text-stone-900 mb-3">Main Office</h3>
                    <div class="space-y-3 text-sm text-stone-600">
                        <div class="flex gap-2">
                            <svg class="h-5 w-5 text-amber-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            </svg>
                            <p>123 Auction Street, Hanoi 10000, Vietnam</p>
                        </div>
                        <div class="flex gap-2">
                            <svg class="h-5 w-5 text-amber-700 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                            </svg>
                            <a href="tel:+84123456789" class="text-amber-700 hover:text-amber-800 font-medium">+84 123 456 789</a>
                        </div>
                    </div>
                </div>

                <!-- Hours -->
                <div class="rounded-xl border border-stone-200 bg-white/80 p-5 shadow-sm">
                    <h3 class="font-semibold text-stone-900 mb-3">Business Hours</h3>
                    <div class="space-y-2 text-sm text-stone-600">
                        <div class="flex justify-between">
                            <span>Monday - Friday</span>
                            <span class="font-medium text-stone-900">08:00 - 18:00</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Saturday</span>
                            <span class="font-medium text-stone-900">09:00 - 17:00</span>
                        </div>
                        <div class="flex justify-between">
                            <span>Sunday</span>
                            <span class="font-medium text-stone-900">Closed</span>
                        </div>
                    </div>
                </div>

                <!-- Get Directions Button -->
                <a href="#" class="flex items-center justify-center gap-2 w-full rounded-lg bg-amber-100 px-4 py-2.5 text-sm font-semibold text-amber-700 transition hover:bg-amber-200">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                    Get Directions
                </a>
            </div>
        </div>
    </div>
</section>

