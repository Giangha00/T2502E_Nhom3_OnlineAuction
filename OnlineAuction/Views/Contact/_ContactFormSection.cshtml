<div class="rounded-2xl border border-slate-200/80 bg-white p-6 shadow-lg shadow-slate-200/40 sm:p-8 lg:p-10">
  <div class="border-b border-slate-100 pb-6">
    <h2 class="text-xl font-bold text-slate-900 sm:text-2xl">@Localizer["Contact_Form_Title"]</h2>
    <p class="mt-2 text-sm leading-relaxed text-slate-500">@Localizer["Contact_Form_ResponseTime"]</p>
  </div>

  <form id="contactForm" class="mt-8 space-y-6">
    <div class="grid gap-6 sm:grid-cols-2">
      <div>
        <label for="fullName" class="mb-2 block text-sm font-medium text-slate-700">@Localizer["User_FullName"]</label>
        <input type="text" id="fullName" placeholder="e.g. John Doe"
               class="w-full rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"/>
        <span id="nameError" class="mt-1.5 hidden text-xs text-red-600"></span>
      </div>
      <div>
        <label for="email" class="mb-2 block text-sm font-medium text-slate-700">@Localizer["User_Email"]</label>
        <input type="email" id="email" placeholder="john@example.com"
               class="w-full rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"/>
        <span id="emailError" class="mt-1.5 hidden text-xs text-red-600"></span>
      </div>
    </div>

    <div>
      <label for="reason" class="mb-2 block text-sm font-medium text-slate-700">@Localizer["Contact_Reason"]</label>
      <select id="reason"
              class="w-full rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10">
        <option value="Auction Inquiry">@Localizer["Contact_Reason_Auction"]</option>
        <option value="Private Sale">@Localizer["Contact_Reason_PrivateSale"]</option>
        <option value="Account Support">@Localizer["Contact_Reason_Account"]</option>
        <option value="Shipping & Insurance">@Localizer["Contact_Reason_Shipping"]</option>
        <option value="Other">@Localizer["Contact_Reason_Other"]</option>
      </select>
    </div>

    <div>
      <label for="message" class="mb-2 block text-sm font-medium text-slate-700">@Localizer["Contact_Message"]</label>
      <textarea id="message" rows="6" placeholder="@Localizer["Contact_Message_Placeholder"]"
                class="w-full resize-none rounded-xl border border-slate-200 bg-slate-50/80 px-4 py-3 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-500/10"></textarea>
      <span id="messageError" class="mt-1.5 hidden text-xs text-red-600"></span>
    </div>

    <div class="flex flex-col gap-5 border-t border-slate-100 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-center gap-2 text-xs leading-relaxed text-slate-400">
        <svg class="h-4 w-4 shrink-0 text-emerald-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
        </svg>
        @Localizer["Contact_SecurityNote"]
      </p>
      <button type="submit"
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-blue-700 to-indigo-600 px-8 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-700/25 transition hover:from-blue-800 hover:to-indigo-700 hover:shadow-blue-700/30">
        @Localizer["Contact_Submit"]
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
      </button>
    </div>
  </form>
</div>
