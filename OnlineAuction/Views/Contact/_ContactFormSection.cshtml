<!-- Contact Form Section -->
<section class="border-t border-stone-200/80 bg-white/50 py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-16">
            <!-- Left Column - Additional Info -->
            <div class="flex flex-col justify-center space-y-8">
                <div>
                    <h2 class="text-3xl font-bold text-stone-900 sm:text-4xl">
                        Have a Question?
                    </h2>
                    <p class="mt-4 text-base text-stone-600 leading-7">
                        Our dedicated support team is ready to assist you with any inquiries about our auction platform, bidding process, or services. We typically respond within 2-4 business hours.
                    </p>
                </div>

                <!-- Support Channels -->
                <div class="space-y-4">
                    <h3 class="font-semibold text-stone-900">Other Ways to Connect</h3>
                    <ul class="space-y-3">
                        <li class="flex items-start gap-3">
                            <svg class="h-5 w-5 text-amber-700 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 10 10.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                            </svg>
                            <div>
                                <p class="font-medium text-stone-900">Live Chat Support</p>
                                <p class="text-sm text-stone-600">Available Mon-Fri 8AM-6PM Vietnam Time</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <svg class="h-5 w-5 text-amber-700 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 10 10.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                            </svg>
                            <div>
                                <p class="font-medium text-stone-900">FAQ Section</p>
                                <p class="text-sm text-stone-600">Browse our comprehensive knowledge base</p>
                            </div>
                        </li>
                        <li class="flex items-start gap-3">
                            <svg class="h-5 w-5 text-amber-700 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 10 10.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"></path>
                            </svg>
                            <div>
                                <p class="font-medium text-stone-900">Community Forum</p>
                                <p class="text-sm text-stone-600">Connect with other auction house members</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>

            <!-- Right Column - Contact Form -->
            <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm sm:p-8">
                <h3 class="text-xl font-semibold text-stone-900 mb-6">Send us a Message</h3>
                
                <form id="contactForm" class="space-y-5">
                    <!-- Full Name -->
                    <div>
                        <label for="fullName" class="block text-sm font-medium text-stone-900 mb-2">
                            Full Name <span class="text-red-500">*</span>
                        </label>
                        <input
                            type="text"
                            id="fullName"
                            placeholder="John Doe"
                            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-amber-500 focus:ring-1 focus:ring-amber-500">
                        <span id="nameError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-stone-900 mb-2">
                            Email Address <span class="text-red-500">*</span>
                        </label>
                        <input
                            type="email"
                            id="email"
                            placeholder="john@example.com"
                            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-amber-500 focus:ring-1 focus:ring-amber-500">
                        <span id="emailError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <!-- Subject -->
                    <div>
                        <label for="subject" class="block text-sm font-medium text-stone-900 mb-2">
                            Subject
                        </label>
                        <input
                            type="text"
                            id="subject"
                            placeholder="How can we help you?"
                            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-amber-500 focus:ring-1 focus:ring-amber-500">
                    </div>

                    <!-- Message -->
                    <div>
                        <label for="message" class="block text-sm font-medium text-stone-900 mb-2">
                            Message <span class="text-red-500">*</span>
                        </label>
                        <textarea
                            id="message"
                            placeholder="Please describe your inquiry in detail..."
                            rows="5"
                            class="w-full rounded-lg border border-stone-300 bg-white px-4 py-2.5 text-sm text-stone-900 outline-none transition placeholder:text-stone-400 focus:border-amber-500 focus:ring-1 focus:ring-amber-500 resize-none"></textarea>
                        <span id="messageError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <!-- Submit Button -->
                    <button
                        type="submit"
                        class="w-full rounded-lg bg-amber-700 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800 focus:ring-2 focus:ring-amber-700 focus:ring-offset-2 active:scale-95">
                        Send Message
                    </button>

                    <p class="text-xs text-stone-500 text-center">
                        We'll get back to you as soon as possible. Required fields are marked with <span class="text-red-500">*</span>
                    </p>
                </form>
            </div>
        </div>
    </div>
</section>

