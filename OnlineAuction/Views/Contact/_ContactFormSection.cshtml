<div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
  <h2 class="text-xl font-bold text-slate-900">@Localizer["Contact_Form_Title"]</h2>
  <p class="mt-1 text-sm text-slate-500">@Localizer["Contact_Form_ResponseTime"]</p>

  <form id="contactForm" class="mt-6 space-y-5">
    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="fullName" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["User_FullName"]</label>
        <input type="text" id="fullName" placeholder="e.g. John Doe"
               class="w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
        <span id="nameError" class="mt-1 hidden text-xs text-red-600"></span>
      </div>
      <div>
        <label for="email" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["User_Email"]</label>
        <input type="email" id="email" placeholder="john@example.com"
               class="w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
        <span id="emailError" class="mt-1 hidden text-xs text-red-600"></span>
      </div>
    </div>

    <div>
      <label for="reason" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Contact_Reason"]</label>
      <select id="reason"
              class="w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
        <option value="Auction Inquiry">@Localizer["Contact_Reason_Auction"]</option>
        <option value="Private Sale">@Localizer["Contact_Reason_PrivateSale"]</option>
        <option value="Account Support">@Localizer["Contact_Reason_Account"]</option>
        <option value="Shipping & Insurance">@Localizer["Contact_Reason_Shipping"]</option>
        <option value="Other">@Localizer["Contact_Reason_Other"]</option>
      </select>
    </div>

    <div>
      <label for="message" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Contact_Message"]</label>
      <textarea id="message" rows="6" placeholder="@Localizer["Contact_Message_Placeholder"]"
                class="w-full resize-none rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition placeholder:text-slate-400 focus:border-blue-500 focus:ring-2 focus:ring-blue-100"></textarea>
      <span id="messageError" class="mt-1 hidden text-xs text-red-600"></span>
    </div>

    <div class="flex flex-col gap-4 border-t border-slate-100 pt-5 sm:flex-row sm:items-center sm:justify-between">
      <p class="flex items-center gap-2 text-xs text-slate-400">
        <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"/>
        </svg>
        @Localizer["Contact_SecurityNote"]
      </p>
      <button type="submit"
              class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-blue-700 px-6 py-2.5 text-xs font-bold uppercase tracking-wide text-white transition hover:bg-blue-800">
        @Localizer["Contact_Submit"]
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
        </svg>
      </button>
    </div>
  </form>
</div>
