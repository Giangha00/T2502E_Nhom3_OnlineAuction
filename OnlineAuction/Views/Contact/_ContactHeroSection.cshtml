@using OnlineAuction.Data

<section class="site-shell px-4 pt-10 pb-12 sm:px-6 sm:pt-12 lg:pt-14">
  <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-16">
    <div>
      <span class="inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-blue-700">
        @Localizer["Contact_Hero_Label"]
      </span>
      <h1 class="mt-4 text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-[2.75rem]">
        @Localizer["Contact_Hero_TitleLine1"]<br/>
        <span class="text-blue-700">@Localizer["Contact_Hero_TitleAccent"]</span>
      </h1>
      <p class="mt-5 max-w-lg text-base leading-relaxed text-slate-500">
        @Localizer["Contact_Hero_Desc"]
      </p>
    </div>
    <div class="overflow-hidden rounded-2xl shadow-md">
      <img src="@PageBannerImages.ContactHero" alt="@Localizer["Contact_Hero_Alt"]"
           class="h-full w-full object-cover" loading="lazy"/>
    </div>
  </div>
</section>
