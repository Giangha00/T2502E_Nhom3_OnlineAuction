<section class="relative overflow-hidden border-b border-slate-200/80 bg-gradient-to-b from-blue-50/80 via-white to-slate-50">
  <div class="pointer-events-none absolute -left-24 top-0 h-64 w-64 rounded-full bg-blue-200/30 blur-3xl" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -right-16 bottom-0 h-48 w-48 rounded-full bg-indigo-100/40 blur-3xl" aria-hidden="true"></div>

  <div class="site-shell relative px-4 py-14 text-center sm:px-6 sm:py-16 lg:py-20">
    <h1 class="mx-auto max-w-3xl text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
      @Localizer["Contact_Hero_TitleLine1"]
      <span class="bg-gradient-to-r from-blue-700 to-indigo-600 bg-clip-text text-transparent">@Localizer["Contact_Hero_TitleAccent"]</span>
    </h1>
    <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-slate-500 sm:text-lg">
      @Localizer["Contact_Hero_Desc"]
    </p>
  </div>
</section>
