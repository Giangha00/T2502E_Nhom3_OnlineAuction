@using System.Text.Json
@model OnlineAuction.Models.ContactPageViewModel
@{
    ViewData["Title"] = Localizer["Contact_PageTitle"];
    var contactI18n = new Dictionary<string, string>
    {
        ["required"] = Localizer["Js_Contact_Required"].Value,
        ["emailInvalid"] = Localizer["Js_Contact_EmailInvalid"].Value,
        ["submitted"] = Localizer["Js_Contact_Submitted"].Value
    };
}
<div class="contact-page bg-slate-50">
  <partial name="_ContactHeroSection" />

  <section class="site-shell px-4 pb-16 sm:px-6 lg:pb-20">
    <div class="grid gap-8 lg:grid-cols-[340px_1fr] xl:grid-cols-[380px_1fr] xl:gap-10">
      <partial name="_ContactInfoSection" model="Model" />
      <partial name="_ContactFormSection" />
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white px-4 py-14 sm:px-6 sm:py-16">
    <div class="site-shell mx-auto max-w-2xl text-center">
      <h2 class="text-xl font-bold text-slate-900 sm:text-2xl">@Localizer["Contact_FaqTitle"]</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-500 sm:text-base">
        @Localizer["Contact_FaqDesc"]
      </p>
      <a asp-controller="Faq" asp-action="Index"
         class="mt-6 inline-flex items-center gap-2 rounded-lg border border-blue-700 px-6 py-2.5 text-sm font-semibold text-blue-700 transition hover:bg-blue-50">
        @Localizer["Contact_ExploreFaqs"]
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H6v12h12V8.625M10.5 13.5 21 3m0 0h-5.25M21 3v5.25"/>
        </svg>
      </a>
    </div>
  </section>
</div>

@section Scripts {
  <script>
    window.contactConfig = {
      i18n: @Html.Raw(JsonSerializer.Serialize(contactI18n))
    };
  </script>
  <script src="~/js/contact.js" asp-append-version="true"></script>
}