@{
    ViewData["Title"] = Localizer["AboutUs_PageTitle"];
    const string heroCard = "/images/cards/sports/02-mantle-1952-topps.jpg";
    const string missionCard = "/images/cards/sports/02-mantle-1952-topps.jpg";
    const string trustThumbPokemon = "/images/categories/pokemon.png";
    const string trustThumbJordan = "/images/cards/sports/01-jordan-1986-fleer.jpg";
    const string psaCardThumb = "/images/cards/sports/baseball-mantle.jpg";
    const string psaCardThumb2 = "/images/cards/sports/basketball-jordan.jpg";
    var teamMembers = new[]
    {
        new { Name = "Julian Thorne", TitleKey = "AboutUs_Team_Member1_Title", BioKey = "AboutUs_Team_Member1_Bio", PhotoUrl = "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=600&h=800&fit=crop&q=80" },
        new { Name = "Elena Vasquez", TitleKey = "AboutUs_Team_Member2_Title", BioKey = "AboutUs_Team_Member2_Bio", PhotoUrl = "https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=600&h=800&fit=crop&q=80" },
        new { Name = "Marcus Chen", TitleKey = "AboutUs_Team_Member3_Title", BioKey = "AboutUs_Team_Member3_Bio", PhotoUrl = "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=600&h=800&fit=crop&q=80" },
    };
}

<div class="about-page">
  <section class="about-section about-section--muted about-story">
    <div class="about-wrap">
      <div class="about-story__grid">
        <div class="about-story__copy">
          <p class="about-kicker">@Localizer["AboutUs_Story_Eyebrow"]</p>
          <h1 class="about-display">@Localizer["AboutUs_Story_Title"]</h1>
          <div class="about-lead">
            <p>@Localizer["AboutUs_Story_P1"]</p>
            <p>@Localizer["AboutUs_Story_P2"]</p>
            <p>@Localizer["AboutUs_Story_P3"]</p>
          </div>
          <div class="about-actions">
            <a asp-controller="Auction" asp-action="Index" class="about-btn about-btn--dark">@Localizer["AboutUs_Story_BrowseAuctions"]</a>
            <a asp-controller="Contact" asp-action="Index" class="about-btn about-btn--light">@Localizer["AboutUs_Story_ContactUs"]</a>
          </div>
        </div>

        <aside class="about-panel">
          <div class="about-panel__top">
            <div>
              <p class="about-panel__kicker">@Localizer["AboutUs_Trust_Eyebrow"]</p>
              <h2 class="about-panel__title">@Localizer["AboutUs_Trust_Title"]</h2>
            </div>
            <span class="about-panel__verified">@Localizer["AboutUs_Trust_Verified"]</span>
          </div>

          <div class="about-panel__stats">
            <div class="about-panel__stat">
              <strong>30+</strong>
              <span>@Localizer["AboutUs_Trust_Stat1_Label"]</span>
            </div>
            <div class="about-panel__stat">
              <strong>10K+</strong>
              <span>@Localizer["AboutUs_Trust_Stat2_Label"]</span>
            </div>
            <div class="about-panel__stat">
              <strong>PSA</strong>
              <span>@Localizer["AboutUs_Trust_Stat3_Label"]</span>
            </div>
          </div>

          <div class="about-panel__gallery">
            <div class="about-panel__hero-card">
              <img src="@heroCard" alt="@Localizer["AboutUs_Mission_CardAlt"]" loading="lazy"/>
            </div>
            <div class="about-panel__stack">
              <div class="about-panel__psa">
                <span class="about-panel__psa-mark">PSA</span>
                <span>@Localizer["AboutUs_Trust_PsaTagline"]</span>
              </div>
              <div class="about-panel__mini">
                <img src="@trustThumbPokemon" alt="" loading="lazy"/>
                <img src="@trustThumbJordan" alt="" loading="lazy"/>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="about-section about-mission">
    <div class="about-wrap">
      <div class="about-mission__grid">
        <div class="about-mission__copy">
          <p class="about-kicker">@Localizer["AboutUs_Mission_Eyebrow"]</p>
          <h2 class="about-display about-display--sm">@Localizer["AboutUs_Mission_Title"]</h2>
          <p class="about-lead about-lead--single">@Localizer["AboutUs_Mission_Desc"]</p>
          <div class="about-mission__features">
            <article class="about-mini-card">
              <div class="about-mini-card__icon" aria-hidden="true">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/></svg>
              </div>
              <h3>@Localizer["AboutUs_Mission_Integrity_Title"]</h3>
              <p>@Localizer["AboutUs_Mission_Integrity_Desc"]</p>
            </article>
            <article class="about-mini-card">
              <div class="about-mini-card__icon" aria-hidden="true">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20.25 6.375c0 2.278-3.694 4.125-8.25 4.125S3.75 8.653 3.75 6.375m16.5 0c0-2.278-3.694-4.125-8.25-4.125S3.75 4.097 3.75 6.375m16.5 0v11.25c0 2.278-3.694 4.125-8.25 4.125s-8.25-1.847-8.25-4.125V6.375m16.5 0v3.75m-16.5-3.75v3.75m16.5 0v3.75C20.696 13.653 17.002 15.5 12.75 15.5s-8.25-1.847-8.25-4.125v-3.75"/></svg>
              </div>
              <h3>@Localizer["AboutUs_Mission_Custodians_Title"]</h3>
              <p>@Localizer["AboutUs_Mission_Custodians_Desc"]</p>
            </article>
          </div>
        </div>

        <div class="about-mission__frame">
          <img src="@missionCard" alt="@Localizer["AboutUs_Mission_CardAlt"]" loading="lazy"/>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section about-section--muted about-grading">
    <div class="about-wrap">
      <div class="about-grading__intro">
        <p class="about-kicker">@Localizer["AboutUs_TrustGrading_Eyebrow"]</p>
        <h2 class="about-display about-display--sm">@Localizer["AboutUs_TrustGrading_Title"]</h2>
        <p class="about-lead about-lead--center">@Localizer["AboutUs_TrustGrading_Desc"]</p>
      </div>

      <div class="about-grading__grid">
        <article class="about-grade-card about-grade-card--wide">
          <span class="about-grade-card__tag">@Localizer["AboutUs_TrustGrading_PsaBadge"]</span>
          <h3>@Localizer["AboutUs_TrustGrading_PsaTitle"]</h3>
          <p>@Localizer["AboutUs_TrustGrading_PsaDesc"]</p>
          <div class="about-grade-card__shots">
            <img src="@psaCardThumb" alt="" loading="lazy"/>
            <img src="@psaCardThumb2" alt="" loading="lazy"/>
          </div>
        </article>

        <article class="about-grade-card about-grade-card--accent">
          <div class="about-grade-card__icon" aria-hidden="true">
            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 0 0 2.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 0 0-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 0 0 .75-.75 2.25 2.25 0 0 0-.1-.664m-5.8 0A2.251 2.251 0 0 1 13.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25ZM6.75 12h.008v.008H6.75V12Zm0 3h.008v.008H6.75V15Zm0 3h.008v.008H6.75V18Z"/></svg>
          </div>
          <h3>@Localizer["AboutUs_TrustGrading_MultiTitle"]</h3>
          <p>@Localizer["AboutUs_TrustGrading_MultiDesc"]</p>
        </article>

        <article class="about-grade-card">
          <h3>@Localizer["AboutUs_TrustGrading_BgsTitle"]</h3>
          <p>@Localizer["AboutUs_TrustGrading_BgsDesc"]</p>
          <a asp-controller="Faq" asp-action="Index" class="about-grade-card__link">@Localizer["AboutUs_TrustGrading_BgsLink"] <span aria-hidden="true">→</span></a>
        </article>

        <article class="about-grade-card about-grade-card--vault about-grade-card--wide">
          <div class="about-grade-card__mesh" aria-hidden="true"></div>
          <h3>@Localizer["AboutUs_TrustGrading_VaultTitle"]</h3>
          <p>@Localizer["AboutUs_TrustGrading_VaultDesc"]</p>
        </article>
      </div>
    </div>
  </section>

  <section class="about-section about-team">
    <div class="about-wrap">
      <div class="about-team__head">
        <h2 class="about-display about-display--sm">@Localizer["AboutUs_Team_Title"]</h2>
        <p class="about-lead about-lead--single">@Localizer["AboutUs_Team_Desc"]</p>
      </div>

      <div class="about-team__grid">
        @foreach (var member in teamMembers)
        {
          <article class="about-person">
            <div class="about-person__photo">
              <img src="@member.PhotoUrl" alt="@member.Name" loading="lazy"/>
            </div>
            <h3>@member.Name</h3>
            <p class="about-person__role">@Localizer[member.TitleKey]</p>
            <p class="about-person__bio">@Localizer[member.BioKey]</p>
          </article>
        }
      </div>
    </div>
  </section>

  <section class="about-section about-section--cta">
    <div class="about-wrap">
      <div class="about-cta">
        <h2>@Localizer["AboutUs_Newsletter_Title"]</h2>
        <p>@Localizer["AboutUs_Newsletter_Desc"]</p>
        <form class="about-cta__form" onsubmit="return false;">
          <input type="email" placeholder="@Localizer["AboutUs_Newsletter_Placeholder"]" aria-label="@Localizer["AboutUs_Newsletter_Placeholder"]"/>
          <button type="submit">@Localizer["AboutUs_Newsletter_Subscribe"]</button>
        </form>
      </div>
    </div>
  </section>
</div>
