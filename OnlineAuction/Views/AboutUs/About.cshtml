@{
    ViewData["Title"] = "About Us";
}

<div class="rarecard-page bg-white">
<partial name="_PageHero" model='new PageHeroViewModel {
    Label = "RareCard",
    Title = "About RareCard",
    Description = "A trusted online auction platform for authenticated trading cards — discover premium collectibles, place bids confidently, and complete transactions in a transparent environment.",
    Centered = true
}' />

<section class="px-4 py-12 sm:px-8 lg:px-12 lg:py-16">
    <div class="grid grid-cols-1 gap-7 lg:grid-cols-[1.3fr_1fr]">
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">Project Introduction</p>
            <h2 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">Built for modern online auctions</h2>
            <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">
                RareCard is designed to connect sellers and collectors in one reliable digital marketplace.
                The platform helps users create auction listings, join live bidding sessions, and finalize deals smoothly.
            </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-2xl font-semibold text-slate-900">Who we build for</h3>
            <ul class="mt-4 list-disc space-y-2 pl-5 text-slate-600 leading-7">
                <li>Sellers who want to reach more collectors.</li>
                <li>Buyers searching for valuable graded cards.</li>
                <li>Communities that need a secure and transparent bidding process.</li>
            </ul>
        </div>
    </div>
</section>

<section class="border-t border-slate-200 bg-slate-50 px-4 py-12 sm:px-8 lg:px-12 lg:py-16">
    <div class="grid grid-cols-1 items-center gap-6 md:grid-cols-[auto_1fr]">
        <div class="grid h-28 w-28 place-items-center rounded-full bg-gradient-to-br from-blue-600 to-slate-900 shadow-lg shadow-blue-200" aria-hidden="true">
            <div class="text-3xl font-semibold text-white">RC</div>
        </div>
        <div>
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">Our Mission</p>
            <h2 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">Create a transparent and secure auction environment</h2>
            <p class="mt-4 text-base leading-7 text-slate-600 sm:text-lg">
                We focus on building trust in every auction by delivering clear bidding flows,
                reliable transaction tracking, and a user experience that is simple for everyone.
            </p>
        </div>
    </div>
</section>

<section class="px-4 py-12 sm:px-8 lg:px-12 lg:py-16">
    <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">How RareCard Works</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">Simple, clear, and reliable process</h2>

        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
            @foreach (var step in new[] {
                new { Num = "Step 1", Title = "User creates auction", Desc = "Seller posts card details, starting price, and auction timeline." },
                new { Num = "Step 2", Title = "Other users place bids", Desc = "Interested buyers join and submit competitive bids in real time." },
                new { Num = "Step 3", Title = "Highest bidder wins", Desc = "When the auction closes, the highest valid bid is selected automatically." },
                new { Num = "Step 4", Title = "Complete transaction", Desc = "Buyer and seller complete payment and delivery with status tracking." }
            })
            {
                <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md">
                    <span class="inline-block rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">@step.Num</span>
                    <h3 class="mt-3 text-xl font-semibold text-slate-900">@step.Title</h3>
                    <p class="mt-2 text-sm leading-7 text-slate-600">@step.Desc</p>
                </article>
            }
        </div>
    </div>
</section>

<section class="border-t border-slate-200 bg-slate-50 px-4 py-12 sm:px-8 lg:px-12 lg:py-16">
    <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">Core Features</p>
        <h2 class="mt-2 text-3xl font-bold text-slate-900 sm:text-4xl">Everything needed for online auction operations</h2>

        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-2">
            @foreach (var feature in new[] {
                new { Title = "Online Auction", Desc = "Users can participate in live online auctions from anywhere." },
                new { Title = "Secure Bidding", Desc = "Bidding activities are visible and consistent to improve transparency." },
                new { Title = "Seller Management", Desc = "Manage product listings, auction sessions, and bidder participation." },
                new { Title = "Transaction Tracking", Desc = "Track each transaction stage from winning bid to completion." }
            })
            {
                <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md">
                    <h3 class="text-xl font-semibold text-slate-900">@feature.Title</h3>
                    <p class="mt-2 text-sm leading-7 text-slate-600">@feature.Desc</p>
                </article>
            }
        </div>
    </div>
</section>
</div>
