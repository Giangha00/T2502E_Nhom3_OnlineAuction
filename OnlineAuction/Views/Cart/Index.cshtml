@model OnlineAuction.Models.CartViewModel
@{
    ViewData["Title"] = "My Auction Cart";
    var auctionsJson = System.Text.Json.JsonSerializer.Serialize(Model.AllAuctions);
}

<!-- Hero -->
<section class="relative overflow-hidden bg-gradient-to-br from-amber-600 via-amber-700 to-stone-900 py-12 sm:py-16">
    <div class="absolute inset-0 overflow-hidden">
        <div class="absolute -right-40 -top-40 h-80 w-80 rounded-full bg-amber-400/10 blur-3xl"></div>
        <div class="absolute -left-40 bottom-0 h-80 w-80 rounded-full bg-orange-400/10 blur-3xl"></div>
    </div>
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-widest text-amber-100">Bid Smart · Pay Secure</p>
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-white sm:text-4xl">Your Auction Cart</h1>
        <p class="mt-3 max-w-2xl text-amber-50">
            Keep tabs on live lots you love, and when the hammer falls in your favor — complete payment right here, on time.
        </p>
    </div>
</section>

<section class="py-10 lg:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_340px] lg:gap-12">
            <div class="space-y-8">
                <!-- Watching Section -->
                <div class="rounded-2xl border border-stone-200 bg-white/80 shadow-sm">
                    <div class="flex items-center justify-between border-b border-stone-100 px-6 py-5">
                        <div>
                            <h2 class="text-lg font-semibold text-stone-900">Watching — Live Auctions</h2>
                            <p class="mt-0.5 text-sm text-stone-500">Auctions you saved to bid on later</p>
                        </div>
                        <span id="watchingCountBadge" class="rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">0 items</span>
                    </div>

                    <div id="watchingList" class="divide-y divide-stone-100"></div>

                    <div id="watchingEmpty" class="hidden px-6 py-14 text-center">
                        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-amber-50">
                            <svg class="h-7 w-7 text-amber-700" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12.76c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z"/>
                            </svg>
                        </div>
                        <p class="mt-4 text-base font-semibold text-stone-800">No auctions in your watchlist</p>
                        <p class="mt-2 text-sm text-stone-500">Browse live auctions and click <strong>Add to Cart</strong> to save items you want to bid on.</p>
                        <a asp-controller="Auction" asp-action="Index"
                           class="mt-6 inline-flex rounded-xl bg-amber-700 px-6 py-2.5 text-sm font-semibold text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800">
                            Browse Auctions
                        </a>
                    </div>
                </div>

                <!-- Won Items Section -->
                <div class="rounded-2xl border border-stone-200 bg-white/80 shadow-sm">
                    <div class="flex items-center justify-between border-b border-stone-100 px-6 py-5">
                        <div>
                            <h2 class="text-lg font-semibold text-stone-900">Won — Pending Payment</h2>
                            <p class="mt-0.5 text-sm text-stone-500">Items you won and must pay for within the deadline</p>
                        </div>
                        <span class="rounded-full bg-green-100 px-3 py-1 text-xs font-semibold text-green-800">@Model.WonCount items</span>
                    </div>

                    @if (Model.WonItems.Count == 0)
                    {
                        <div class="px-6 py-14 text-center">
                            <p class="text-base font-semibold text-stone-800">No won items awaiting payment</p>
                            <p class="mt-2 text-sm text-stone-500">When you win an auction, it will appear here for checkout.</p>
                        </div>
                    }
                    else
                    {
                        <div class="divide-y divide-stone-100">
                            @foreach (var item in Model.WonItems)
                            {
                                <div class="flex flex-col gap-4 p-6 sm:flex-row sm:items-center">
                                    <div class="h-24 w-24 shrink-0 overflow-hidden rounded-xl border border-stone-200">
                                        <img src="@item.Auction.ImageUrl" alt="@item.Auction.Name" class="h-full w-full object-cover"/>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-[10px] font-semibold uppercase tracking-widest text-stone-400">@item.Auction.Category</p>
                                        <h3 class="mt-1 font-semibold text-stone-900">@item.Auction.Name</h3>
                                        <div class="mt-2 flex flex-wrap items-center gap-3 text-sm">
                                            <span class="rounded-full bg-green-100 px-2.5 py-0.5 text-xs font-semibold text-green-700">Won</span>
                                            <span class="text-stone-500">Winning bid: <strong class="text-amber-700">$@item.Auction.CurrentPrice.ToString("N0")</strong></span>
                                            @if (item.PaymentDeadline.HasValue)
                                            {
                                                <span class="text-stone-500">Pay by: <strong class="text-stone-800">@item.PaymentDeadline.Value.ToString("MMM dd, yyyy")</strong></span>
                                            }
                                        </div>
                                        <p class="mt-1 text-xs text-stone-400">
                                            Total due: $@item.TotalDue.ToString("N2") (incl. fee + shipping)
                                        </p>
                                    </div>
                                    <div class="flex shrink-0 flex-col gap-2 sm:items-end">
                                        <a asp-controller="Payment" asp-action="Checkout" asp-route-auctionId="@item.Auction.Id"
                                           class="rounded-xl bg-amber-700 px-5 py-2.5 text-center text-sm font-semibold text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800">
                                            Pay Now
                                        </a>
                                        <button type="button" class="text-xs text-stone-400 hover:text-red-600" disabled title="Cannot remove won items">
                                            Awaiting payment
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <!-- Summary Sidebar -->
            <aside class="lg:sticky lg:top-24 lg:self-start">
                <div class="rounded-2xl border border-stone-200 bg-white p-6 shadow-sm">
                    <h2 class="text-lg font-semibold text-stone-900">Cart Summary</h2>

                    <dl class="mt-5 space-y-3 text-sm">
                        <div class="flex justify-between gap-4">
                            <dt class="text-stone-500">Watching (live)</dt>
                            <dd id="summaryWatching" class="font-medium text-stone-900">0</dd>
                        </div>
                        <div class="flex justify-between gap-4">
                            <dt class="text-stone-500">Won (pending payment)</dt>
                            <dd class="font-medium text-stone-900">@Model.WonCount</dd>
                        </div>
                        <div class="flex justify-between gap-4 border-t border-stone-100 pt-3">
                            <dt class="font-semibold text-stone-900">Total items</dt>
                            <dd id="summaryTotal" class="font-bold text-stone-900">@Model.WonCount</dd>
                        </div>
                        @if (Model.TotalPendingPayment > 0)
                        {
                            <div class="flex justify-between gap-4 border-t border-stone-100 pt-3">
                                <dt class="font-semibold text-stone-900">Amount due</dt>
                                <dd class="text-lg font-bold text-amber-700">$@Model.TotalPendingPayment.ToString("N2")</dd>
                            </div>
                        }
                    </dl>

                    <div class="mt-6 rounded-xl bg-amber-50 p-4 text-xs leading-5 text-amber-900">
                        <p class="font-semibold">How auction cart works</p>
                        <ul class="mt-2 list-inside list-disc space-y-1 text-amber-800">
                            <li><strong>Watching</strong> — save live auctions to track before bidding.</li>
                            <li><strong>Won</strong> — pay within the deadline to secure your item.</li>
                            <li>Outbid items are removed automatically when auction ends.</li>
                        </ul>
                    </div>

                    <a asp-controller="Auction" asp-action="Index"
                       class="mt-6 block w-full rounded-xl border border-amber-700 py-3 text-center text-sm font-semibold text-amber-700 transition hover:bg-amber-50">
                        Continue Browsing
                    </a>
                </div>
            </aside>
        </div>
    </div>
</section>

<script id="auctionCatalog" type="application/json">@Html.Raw(auctionsJson)</script>

@section Scripts {
    <script>
        window.cartPageConfig = {
            wonCount: @Model.WonCount,
            totalPending: @Model.TotalPendingPayment
        };
    </script>
    <script src="~/js/cart.js" asp-append-version="true"></script>
}
