@using System.Text.Json
@model OnlineAuction.Models.RefundPageViewModel
@{
    ViewData["Title"] = Localizer["Refund_PageTitle"];
    var refundI18n = new Dictionary<string, string>
    {
        ["orderRequired"] = Localizer["Js_Refund_OrderRequired"].Value,
        ["manualRequired"] = Localizer["Js_Refund_ManualRequired"].Value,
        ["fullNameRequired"] = Localizer["Js_Refund_FullNameRequired"].Value,
        ["emailInvalid"] = Localizer["Js_Refund_EmailInvalid"].Value,
        ["reasonRequired"] = Localizer["Js_Refund_ReasonRequired"].Value,
        ["descriptionRequired"] = Localizer["Js_Refund_DescriptionRequired"].Value,
        ["policyRequired"] = Localizer["Js_Refund_PolicyRequired"].Value,
        ["submitFailed"] = Localizer["Js_Refund_SubmitFailed"].Value,
        ["loginRequired"] = Localizer["Js_Refund_LoginRequired"].Value
    };
}

<div class="rarecard-page bg-white">
<partial name="_PageHero" model='new PageHeroViewModel {
    Label = Localizer["Refund_Label"].Value,
    Title = Localizer["Refund_PageTitle"].Value,
    Description = Localizer["Refund_Description"].Value
}' />

<!-- Steps -->
<section class="border-b border-blue-200/40 bg-blue-50/30">
    <div class="mx-auto max-w-7xl px-4 py-6 sm:px-6 lg:px-8">
        <ol class="flex flex-wrap items-center justify-center gap-4 sm:gap-8">
            <li class="flex items-center gap-2 text-sm font-medium text-blue-700">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">1</span>
                @Localizer["Refund_Step_Policy"]
            </li>
            <li class="hidden h-px w-8 bg-stone-300 sm:block"></li>
            <li class="flex items-center gap-2 text-sm font-medium text-blue-700">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">2</span>
                @Localizer["Refund_Step_Submit"]
            </li>
            <li class="hidden h-px w-8 bg-stone-300 sm:block"></li>
            <li class="flex items-center gap-2 text-sm font-medium text-slate-400">
                <span class="flex h-7 w-7 items-center justify-center rounded-full border border-slate-300 text-xs font-bold">3</span>
                @Localizer["Refund_Step_Confirmation"]
            </li>
        </ol>
    </div>
</section>

<section class="py-10 lg:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2 lg:gap-12">
            <!-- Policy -->
            <div class="space-y-6">
                <div>
                    <h2 class="text-2xl font-bold text-slate-900">@Localizer["Refund_PolicyTitle"]</h2>
                    <p class="mt-2 text-sm text-slate-600">
                        @Localizer["Refund_PolicyDesc"]
                    </p>
                </div>

                <div class="space-y-4">
                    @foreach (var item in Model.PolicyItems)
                    {
                        <article class="rounded-2xl border border-slate-200 bg-white/80 p-5 shadow-sm">
                            <h3 class="font-semibold text-slate-900">@item.Title</h3>
                            <p class="mt-2 text-sm leading-6 text-slate-600">@item.Description</p>
                        </article>
                    }
                </div>

                <div class="rounded-2xl border border-blue-200 bg-blue-50 p-5">
                    <p class="text-sm font-semibold text-blue-900">@Localizer["Refund_BeforeSubmit"]</p>
                    <ul class="mt-2 list-inside list-disc space-y-1 text-sm text-blue-800">
                        <li>@Localizer["Refund_BeforeTip1"]</li>
                        <li>@Localizer["Refund_BeforeTip2"]</li>
                        <li>@Html.Raw(Localizer["Refund_BeforeTip3"].Value)</li>
                    </ul>
                </div>

                <p class="text-sm text-slate-500">
                    @Localizer["Refund_ReadFullTerms"]
                    <a asp-controller="Policy" asp-action="Index" asp-fragment="payment-policy" class="font-medium text-blue-700 visited:text-blue-700 hover:text-blue-800">@Localizer["Checkout_PaymentPolicy"]</a>.
                </p>
            </div>

            <!-- Form -->
            <div class="rounded-2xl border border-slate-200 bg-white/80 p-6 shadow-sm sm:p-8">
                <h2 class="text-xl font-semibold text-slate-900">@Localizer["Refund_FormTitle"]</h2>
                <p class="mt-1 text-sm text-slate-500">@Localizer["Refund_FormDesc"] <span class="text-red-500">*</span>.</p>

                @if (!Model.IsAuthenticated)
                {
                    <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
                        @Localizer["Refund_LoginRequired"]
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="/Refund" class="font-semibold underline">@Localizer["Login"]</a>
                    </div>
                }

                <form id="refundForm" class="mt-6 space-y-5">
                    @Html.AntiForgeryToken()
                    <div>
                        <label for="orderReference" class="block text-sm font-medium text-slate-900">@Localizer["Refund_OrderReference"] <span class="text-red-500">*</span></label>
                        <select id="orderReference"
                                class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                            <option value="">@Localizer["Refund_SelectOrder"]</option>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <option value="@order.OrderReference"
                                        data-order-id="@order.OrderId"
                                        data-amount="@order.AmountPaid"
                                        data-name="@order.AuctionName">
                                    @order.OrderReference — @order.AuctionName ($@order.AmountPaid.ToString("N2"))
                                </option>
                            }
                            <option value="other">@Localizer["Refund_OtherOrder"]</option>
                        </select>
                        <span id="orderReferenceError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div id="manualOrderField" class="hidden">
                        <label for="manualOrderRef" class="block text-sm font-medium text-slate-900">@Localizer["Refund_ManualOrderRef"]</label>
                        <input type="text" id="manualOrderRef" placeholder="AH-YYYYMMDD-0000"
                               class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                    </div>

                    <div>
                        <label for="fullName" class="block text-sm font-medium text-slate-900">@Localizer["User_FullName"] <span class="text-red-500">*</span></label>
                        <input type="text" id="fullName" placeholder="John Doe"
                               class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                        <span id="fullNameError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-medium text-slate-900">@Localizer["User_Email"] <span class="text-red-500">*</span></label>
                        <input type="email" id="email" placeholder="john@example.com"
                               class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                        <span id="emailError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label for="refundReason" class="block text-sm font-medium text-slate-900">@Localizer["Refund_Reason"] <span class="text-red-500">*</span></label>
                        <select id="refundReason"
                                class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
                            <option value="">@Localizer["Refund_SelectReason"]</option>
                            @foreach (var reason in Model.RefundReasons)
                            {
                                <option value="@reason.Id">@reason.Label</option>
                            }
                        </select>
                        <span id="refundReasonError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label for="description" class="block text-sm font-medium text-slate-900">@Localizer["Refund_DescriptionLabel"] <span class="text-red-500">*</span></label>
                        <textarea id="description" rows="4" placeholder="@Localizer["Refund_DescriptionPlaceholder"]"
                                  class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none"></textarea>
                        <span id="descriptionError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label for="evidenceLinks" class="block text-sm font-medium text-slate-900">Evidence links</label>
                        <textarea id="evidenceLinks" rows="3" placeholder="https://example.com/photo-or-video"
                                  class="w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500 resize-none"></textarea>
                        <p class="mt-1 text-xs text-slate-400">Optional. Add up to 5 image, video, or document links, one per line.</p>
                        <span id="evidenceLinksError" class="mt-1 block text-sm text-red-600"></span>
                    </div>

                    <div>
                        <label for="refundAmount" class="block text-sm font-medium text-slate-900">@Localizer["Refund_AmountLabel"]</label>
                        <input type="number" id="refundAmount" min="0" step="0.01" placeholder="0.00"
                               class="mt-2 w-full rounded-lg border border-slate-300 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-1 focus:ring-blue-500"/>
                        <p class="mt-1 text-xs text-slate-400">@Localizer["Refund_AmountHint"]</p>
                    </div>

                    <label class="flex cursor-pointer items-start gap-3">
                        <input type="checkbox" id="agreePolicy"
                               class="mt-1 h-4 w-4 rounded border-slate-300 text-blue-700 focus:ring-blue-500"/>
                        <span class="text-sm text-slate-600">
                            @Localizer["Refund_AgreePolicy"]
                            <a asp-controller="Policy" asp-action="Index" class="font-medium text-blue-700 visited:text-blue-700 hover:text-blue-800">@Localizer["Refund_PolicyLink"]</a>.
                        </span>
                    </label>
                    <span id="agreePolicyError" class="block text-sm text-red-600"></span>
                    <span id="formError" class="block text-sm text-red-600"></span>

                    <button type="submit"
                            @(!Model.IsAuthenticated ? "disabled" : null)
                            class="w-full rounded-xl bg-blue-700 px-6 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-700/20 transition hover:bg-blue-800 focus:ring-2 focus:ring-blue-700 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-60">
                        @Localizer["Refund_Submit"]
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        window.refundConfig = {
            submitUrl: '@Url.Action("Submit", "Refund")',
            loginUrl: '@Url.Action("Login", "Auth", new { returnUrl = "/Refund" })',
            isAuthenticated: @(Model.IsAuthenticated ? "true" : "false"),
            i18n: @Html.Raw(JsonSerializer.Serialize(refundI18n))
        };
    </script>
    <script src="~/js/refund.js" asp-append-version="true"></script>
}
</div>
