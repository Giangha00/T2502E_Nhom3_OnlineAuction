@model OnlineAuction.Models.RefundConfirmationViewModel
@{
    ViewData["Title"] = "Refund Request Submitted";
}

<div class="rarecard-page bg-white">
<section class="py-16 lg:py-24">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
        <div class="rounded-3xl border border-slate-200 bg-white/90 p-8 text-center shadow-lg sm:p-12">
            <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-blue-100">
                <svg class="h-8 w-8 text-blue-700" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                </svg>
            </div>

            <h1 class="mt-6 text-3xl font-bold text-slate-900">Refund Request Received</h1>
            <p class="mt-3 text-slate-600">
                Thank you. Your request has been submitted and is now under review by our support team.
            </p>

            <div class="mt-8 rounded-2xl border border-slate-100 bg-stone-50/80 p-6 text-left">
                <dl class="space-y-4 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">Request ID</dt>
                        <dd class="font-mono font-semibold text-slate-900">@Model.RequestId</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">Order Reference</dt>
                        <dd class="font-mono font-medium text-slate-900">@Model.OrderReference</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-slate-500">Reason</dt>
                        <dd class="max-w-[60%] text-right font-medium text-slate-900">@Model.Reason</dd>
                    </div>
                    <div class="flex justify-between gap-4 border-t border-slate-200 pt-4">
                        <dt class="font-semibold text-slate-900">Estimated Review</dt>
                        <dd class="font-medium text-blue-700">@Model.EstimatedReviewDays</dd>
                    </div>
                </dl>
            </div>

            <div class="mt-8 rounded-xl bg-blue-50 p-4 text-left text-sm text-blue-900">
                <p class="font-medium">What happens next?</p>
                <ul class="mt-2 list-inside list-disc space-y-1 text-blue-800">
                    <li>Our team will verify your order and review submitted evidence.</li>
                    <li>You will receive an email update once a decision is made.</li>
                    <li>Approved refunds are processed within 7–14 business days.</li>
                </ul>
            </div>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center">
                <a asp-controller="Contact" asp-action="Index"
                   class="rounded-xl border border-amber-700 px-6 py-3 text-sm font-semibold text-blue-700 transition hover:bg-blue-50">
                    Contact Support
                </a>
                <a asp-controller="Home" asp-action="Index"
                   class="rounded-xl bg-blue-700 px-6 py-3 text-sm font-semibold text-white shadow-lg shadow-blue-700/20 transition hover:bg-blue-800">
                    Back to Home
                </a>
            </div>
        </div>
    </div>
</section>
</div>
