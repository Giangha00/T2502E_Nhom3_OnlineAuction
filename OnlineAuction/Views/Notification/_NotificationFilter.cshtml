<section class="rounded-2xl border border-stone-200 bg-white/90 p-4 shadow-sm">
    <div class="grid gap-3 md:grid-cols-[1fr_180px_180px_auto] md:items-end">
        <div>
            <label for="notificationSearch" class="text-xs font-semibold uppercase tracking-wide text-stone-500">Search</label>
            <input id="notificationSearch"
                   type="search"
                   placeholder="Search notification..."
                   class="mt-2 w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"
                   data-notification-search />
        </div>

        <div>
            <label for="notificationTypeFilter" class="text-xs font-semibold uppercase tracking-wide text-stone-500">Type</label>
            <select id="notificationTypeFilter"
                    class="mt-2 w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"
                    data-notification-type-filter>
                <option value="all">All</option>
                <option value="auction">Auction</option>
                <option value="winning">Winning</option>
                <option value="payment">Payment</option>
                <option value="refund">Refund</option>
                <option value="system">System</option>
            </select>
        </div>

        <div>
            <label for="notificationReadFilter" class="text-xs font-semibold uppercase tracking-wide text-stone-500">Status</label>
            <select id="notificationReadFilter"
                    class="mt-2 w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm text-stone-800 outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"
                    data-notification-read-filter>
                <option value="all">All</option>
                <option value="read">Read</option>
                <option value="unread">Unread</option>
            </select>
        </div>

        <button type="button"
                class="rounded-xl bg-amber-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-700 focus:ring-offset-2"
                data-page-mark-all-read>
            Mark all as read
        </button>
    </div>
</section>
