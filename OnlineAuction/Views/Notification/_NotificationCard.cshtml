@model OnlineAuction.Models.NotificationItemViewModel
@{
    var typeValue = Model.Type.ToString().ToLowerInvariant();
}

<article class="notification-card rounded-2xl border border-stone-200 bg-white/90 p-4 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md @(Model.IsRead ? "" : "ring-2 ring-amber-200")"
         data-notification-card
         data-id="@Model.Id"
         data-type="@typeValue"
         data-read="@Model.IsRead.ToString().ToLowerInvariant()"
         data-search="@($"{Model.Title} {Model.Description} {Model.FullMessage}").ToLowerInvariant()">
    <div class="flex gap-4">
        <div class="relative shrink-0">
            <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-amber-50 text-2xl ring-1 ring-amber-100">@Model.Icon</span>
            @if (!Model.IsRead)
            {
                <span class="absolute -right-1 -top-1 h-3 w-3 rounded-full bg-amber-700 ring-2 ring-white" data-unread-dot></span>
            }
        </div>

        <div class="min-w-0 flex-1">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                    <p class="text-xs font-semibold uppercase tracking-wide text-amber-700">@Model.TypeLabel</p>
                    <a href="/notifications/@Model.Id"
                       class="mt-1 block text-base font-semibold text-stone-950 visited:text-stone-950 hover:text-amber-800">
                        @if (!Model.IsRead)
                        {
                            <span class="mr-1 text-amber-700" data-unread-bullet>●</span>
                        }
                        <span data-card-title>@Model.Title</span>
                    </a>
                    <p class="mt-2 text-sm leading-6 text-stone-600">@Model.Description</p>
                </div>

                <time class="shrink-0 text-xs font-medium text-stone-400">@Model.TimeAgo</time>
            </div>

            <div class="mt-4 flex flex-wrap items-center gap-2">
                <button type="button"
                        class="rounded-full border border-stone-200 px-3 py-1.5 text-xs font-semibold text-stone-700 transition hover:border-amber-300 hover:bg-amber-50 hover:text-amber-800 disabled:cursor-not-allowed disabled:opacity-50"
                        data-mark-read
                        disabled="@Model.IsRead">
                    Mark as read
                </button>
                <a href="@Model.RelatedUrl"
                   class="rounded-full bg-stone-950 px-3 py-1.5 text-xs font-semibold text-white transition hover:bg-stone-800">
                    @Model.ActionLabel
                </a>
                <button type="button"
                        class="rounded-full border border-red-200 px-3 py-1.5 text-xs font-semibold text-red-700 transition hover:bg-red-50"
                        data-delete-notification>
                    Delete
                </button>
            </div>
        </div>
    </div>
</article>
