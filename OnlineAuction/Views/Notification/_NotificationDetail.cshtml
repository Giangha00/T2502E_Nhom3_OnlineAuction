@model OnlineAuction.Models.NotificationItemViewModel

<article class="rounded-2xl border border-stone-200 bg-white/90 p-6 shadow-sm sm:p-8">
    <div class="flex flex-col gap-5 sm:flex-row sm:items-start">
        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-amber-50 text-3xl ring-1 ring-amber-100">@Model.Icon</span>
        <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold uppercase tracking-wide text-amber-700">@Model.TypeLabel</p>
            <h1 class="mt-2 text-2xl font-bold tracking-tight text-stone-950 sm:text-3xl">@Model.Title</h1>
            <p class="mt-4 text-base leading-8 text-stone-700">@Model.FullMessage</p>

            <dl class="mt-6 grid gap-4 rounded-2xl bg-stone-50 p-4 sm:grid-cols-2">
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-stone-500">Date</dt>
                    <dd class="mt-1 text-sm font-medium text-stone-900">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-stone-500">Related object</dt>
                    <dd class="mt-1 text-sm font-medium text-stone-900">@Model.RelatedObjectLabel</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-stone-500">Status</dt>
                    <dd class="mt-1 text-sm font-medium @(Model.IsRead ? "text-stone-700" : "text-amber-700")">@(Model.IsRead ? "Read" : "Unread")</dd>
                </div>
                <div>
                    <dt class="text-xs font-semibold uppercase tracking-wide text-stone-500">Time</dt>
                    <dd class="mt-1 text-sm font-medium text-stone-900">@Model.TimeAgo</dd>
                </div>
            </dl>

            <div class="mt-6 flex flex-wrap gap-3">
                <a href="@Model.RelatedUrl"
                   class="rounded-full bg-amber-700 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-amber-700/20 transition hover:bg-amber-800">
                    @Model.ActionLabel
                </a>
                <a href="/notifications"
                   class="rounded-full border border-stone-300 px-5 py-3 text-sm font-semibold text-stone-700 transition hover:border-amber-300 hover:bg-amber-50 hover:text-amber-800">
                    Back to notifications
                </a>
            </div>
        </div>
    </div>
</article>
