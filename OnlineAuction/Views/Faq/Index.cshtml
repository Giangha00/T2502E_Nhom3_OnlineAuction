@{
    ViewData["Title"] = Localizer["Faq_PageTitle"];

    var faqSections = new Dictionary<string, (string Title, string Icon, (string Question, string Answer)[] Items)>
    {
        ["buying"] = ("Buying", "cart", new[]
        {
            ("How to bid?", "Create your RareCard account, browse active auctions, and enter a bid amount higher than the current price. You'll receive instant confirmation and notifications if you're outbid."),
            ("What are the shipping fees?", "Shipping fees are calculated at checkout based on item value, destination, and insurance level. Domestic orders typically range from $15–$45 for standard insured delivery."),
            ("International bidding?", "Yes — international bidding is available in select regions. Import duties and customs fees may apply and are the buyer's responsibility. Contact support for country-specific details.")
        }),
        ["selling"] = ("Selling", "tag", new[]
        {
            ("What fees does the platform charge?", "Three marketplace charges: (1) auction registration deposit for bidders — refunded to losers, applied at checkout for the winner; (2) buyer checkout fee on the order subtotal; (3) seller success fee deducted from the item subtotal when the order is paid. Seller net proceeds = Subtotal − seller success fee. Shipping and vault insurance are separate and do not go to the seller ledger. There is no listing fee. Rates are configured under PlatformFee. Phase 1 records proceeds on the order for reporting; automatic seller PayPal payout is Phase 2 (manual payout for now)."),
            ("How do I ship my cards to RareCard?", "After your listing is approved, generate a prepaid insured shipping label from your seller dashboard. Cards must be sent in a rigid mailer or slab case with tracking enabled.")
        }),
        ["security"] = ("Security", "shield", new[]
        {
            ("Is my card insured?", "Every card held in our vault and in transit is fully insured up to its listed value. Coverage begins the moment we receive your item and continues through delivery to the buyer."),
            ("How do you verify authenticity?", "We use direct PSA and BGS API integration for real-time slab verification, plus a secondary 10-point physical inspection by our specialist curators before any listing goes live.")
        })
    };
}

<div class="faq-page min-h-screen bg-slate-50">
  <section class="relative overflow-hidden border-b border-slate-200/80 bg-gradient-to-b from-blue-50/80 via-white to-slate-50">
    <div class="pointer-events-none absolute -left-24 top-0 h-64 w-64 rounded-full bg-blue-200/30 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -right-16 bottom-0 h-48 w-48 rounded-full bg-indigo-100/40 blur-3xl" aria-hidden="true"></div>

    <div class="site-shell relative px-4 py-10 text-center sm:px-6 sm:py-12">
      <h1 class="mx-auto max-w-3xl text-3xl font-bold leading-tight tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
        @Localizer["Faq_PageTitle"]
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-slate-500 sm:text-base">
        Find answers about bidding, selling, grading, and security at RareCard Auctions.
      </p>
    </div>
  </section>

  <section class="site-shell px-4 py-8 sm:px-6 sm:py-10 lg:py-12">
    <div class="mx-auto max-w-4xl space-y-6">
      @{
        var questionNumber = 0;
      }
      @foreach (var faqGroup in faqSections)
      {
        var meta = faqGroup.Value;
        <div id="faq-@faqGroup.Key" class="faq-section scroll-mt-header" data-faq-section="@faqGroup.Key">
          <article class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">
            <header class="flex items-center gap-3 border-b border-slate-100 bg-gradient-to-r from-slate-50 to-blue-50/50 px-5 py-4 sm:px-6 sm:py-5">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-700 text-white shadow-sm">
                @if (meta.Icon == "cart")
                {
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25a3 3 0 0 0-3 3h15.75m-12.75-3h11.218c1.121-2.3 2.1-4.684 2.924-7.138a60.114 60.114 0 0 0-16.536-1.84M7.5 14.25 5.106 5.272M6 20.25a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z"/>
                  </svg>
                }
                else if (meta.Icon == "tag")
                {
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.568 3H5.25A2.25 2.25 0 0 0 3 5.25v4.318c0 .597.237 1.17.659 1.591l9.581 9.581c.699.699 1.78.872 2.607.33a18.095 18.095 0 0 0 5.223-5.223c.542-.827.369-1.908-.33-2.607L11.16 3.66A2.25 2.25 0 0 0 9.568 3Z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 6h.008v.008H6V6Z"/>
                  </svg>
                }
                else
                {
                  <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
                  </svg>
                }
              </div>
              <div>
                <h2 class="text-lg font-bold text-slate-900 sm:text-xl">@meta.Title</h2>
                <p class="mt-0.5 text-xs text-slate-500 sm:text-sm">@meta.Items.Length question@(meta.Items.Length == 1 ? "" : "s")</p>
              </div>
            </header>

            <div class="divide-y divide-slate-100">
              @foreach (var item in meta.Items)
              {
                questionNumber++;
                <div class="faq-item" data-faq-question="@item.Question.ToLowerInvariant()">
                  <button type="button" class="faq-question flex w-full items-center justify-between gap-4 px-5 py-4 text-left transition hover:bg-slate-50/80 sm:px-6 sm:py-5">
                    <span class="flex min-w-0 items-start gap-3 text-sm font-medium text-slate-900 sm:text-base">
                      <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-blue-50 text-xs font-semibold text-blue-700">@questionNumber</span>
                      <span>@item.Question</span>
                    </span>
                    <svg class="faq-chevron h-4 w-4 shrink-0 text-slate-400 transition-transform" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5"/>
                    </svg>
                  </button>
                  <div class="faq-answer hidden px-5 pb-5 sm:px-6 sm:pb-6">
                    <p class="pl-9 text-sm leading-relaxed text-slate-600 sm:text-[0.9375rem]">@item.Answer</p>
                  </div>
                </div>
              }
            </div>
          </article>
        </div>
      }

      <div class="rounded-2xl bg-gradient-to-br from-blue-700 via-blue-800 to-indigo-900 px-6 py-8 text-center shadow-lg sm:px-10 sm:py-10">
        <h3 class="text-lg font-bold text-white sm:text-xl">Still need help?</h3>
        <p class="mx-auto mt-2 max-w-md text-sm leading-relaxed text-blue-100">
          Can't find what you're looking for? Contact our team or submit a refund request.
        </p>
        <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a asp-controller="Contact" asp-action="Index"
             class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-white px-5 py-2.5 text-sm font-semibold text-blue-800 transition hover:bg-blue-50 sm:w-auto">
            @Localizer["Layout_Footer_ContactUs"]
          </a>
          <a asp-controller="Refund" asp-action="Index"
             class="inline-flex w-full items-center justify-center gap-2 rounded-xl border border-white/30 bg-white/10 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/20 sm:w-auto">
            @Localizer["Layout_Footer_RefundRequest"]
          </a>
        </div>
      </div>
    </div>
  </section>
</div>

@section Scripts {
  <script src="~/js/faq.js" asp-append-version="true"></script>
}
