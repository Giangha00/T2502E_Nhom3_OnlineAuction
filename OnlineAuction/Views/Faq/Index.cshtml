@{
    ViewData["Title"] = "FAQ";
}

<div class="rarecard-page bg-white">
<partial name="_PageHero" model='new PageHeroViewModel {
    Label = "Help Center",
    Title = "Frequently Asked Questions",
    Description = "Find answers to common questions about RareCard, bidding, payments, security, and account management.",
    Centered = true
}' />

<div class="w-full text-slate-800">
    <section class="border-b border-slate-200 px-4 py-8 sm:px-8 lg:px-12">
        <div class="mx-auto flex max-w-2xl items-center gap-3 rounded-full border border-slate-200 bg-slate-50 p-2">
            <span class="pl-4 text-slate-400">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8"></circle>
                    <path d="m21 21-4.3-4.3"></path>
                </svg>
            </span>
            <input type="search"
                   placeholder="Search frequently asked questions..."
                   class="w-full bg-transparent py-3 text-sm text-slate-700 placeholder:text-slate-400 outline-none" />
            <button type="button"
                    class="hidden rounded-full bg-blue-700 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-800 sm:inline-block">
                Search
            </button>
        </div>
    </section>

    <section class="px-4 py-12 sm:px-8 lg:px-12 lg:py-16">
        <div>
            <div class="mb-8">
                <p class="mb-3 text-xs font-bold uppercase tracking-[0.2em] text-blue-700">FAQ Categories</p>
                <h2 class="text-3xl font-semibold md:text-5xl">Browse by topic</h2>
            </div>

            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                <button type="button" class="faq-category rounded-2xl border border-slate-200 bg-white p-5 text-left shadow-sm transition hover:-translate-y-1 hover:border-blue-400 hover:shadow-md">
                    <span class="mb-4 grid h-11 w-11 place-items-center rounded-xl bg-blue-50 text-blue-700">A</span>
                    <h3 class="text-xl font-semibold">Account</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Registration, login, and profile management.</p>
                </button>

                <button type="button" class="faq-category rounded-2xl border border-slate-200 bg-white p-5 text-left shadow-sm transition hover:-translate-y-1 hover:border-blue-400 hover:shadow-md">
                    <span class="mb-4 grid h-11 w-11 place-items-center rounded-xl bg-blue-50 text-blue-700">B</span>
                    <h3 class="text-xl font-semibold">Auction</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Create auctions, join bidding, and place bids.</p>
                </button>

                <button type="button" class="faq-category rounded-2xl border border-slate-200 bg-white p-5 text-left shadow-sm transition hover:-translate-y-1 hover:border-blue-400 hover:shadow-md">
                    <span class="mb-4 grid h-11 w-11 place-items-center rounded-xl bg-blue-50 text-blue-700">P</span>
                    <h3 class="text-xl font-semibold">Payment</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Payments, transactions, and order status.</p>
                </button>

                <button type="button" class="faq-category rounded-2xl border border-slate-200 bg-white p-5 text-left shadow-sm transition hover:-translate-y-1 hover:border-blue-400 hover:shadow-md">
                    <span class="mb-4 grid h-11 w-11 place-items-center rounded-xl bg-blue-50 text-blue-700">S</span>
                    <h3 class="text-xl font-semibold">Security</h3>
                    <p class="mt-2 text-sm leading-6 text-slate-600">Account protection, privacy, and safe bidding.</p>
                </button>
            </div>
        </div>
    </section>

    <section class="px-4 pb-16 sm:px-8 md:pb-20 lg:px-12">
        <div class="grid gap-8 lg:grid-cols-[0.8fr_1.5fr]">
            <aside class="h-fit rounded-3xl border border-slate-200 bg-white p-6 shadow-sm">
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">Quick Guide</p>
                <h2 class="mt-3 text-3xl font-semibold">Need help using RareCard?</h2>
                <p class="mt-4 leading-7 text-slate-600">
                    These questions cover the most common actions users perform on the platform.
                </p>
                <div class="mt-6 space-y-3 text-sm text-slate-600">
                    <div class="rounded-2xl bg-blue-50 p-4">Create an account before joining auctions.</div>
                    <div class="rounded-2xl bg-blue-50 p-4">Bid amount must be higher than the current price.</div>
                    <div class="rounded-2xl bg-blue-50 p-4">Winner is notified when the auction ends.</div>
                </div>
            </aside>

            <div class="space-y-4">
                @{
                    var faqItems = new[]
                    {
                        new { Question = "How do I create an account?", Answer = "Click Register, fill in your personal information, and create your account before joining the auction system." },
                        new { Question = "How do I place a bid?", Answer = "Select an active auction, enter your bid amount, and submit your bid. Your bid must be higher than the current price." },
                        new { Question = "How can I create an auction?", Answer = "Create an account, submit product information, upload images or documents, and wait for the product to be approved." },
                        new { Question = "Can I bid on my own product?", Answer = "No. Sellers are not allowed to place bids on their own auction items." },
                        new { Question = "How do I know if I win an auction?", Answer = "When the auction ends, the system sends a notification to the winning bidder and the seller." },
                        new { Question = "What happens after payment?", Answer = "After payment and transaction confirmation, the buyer and seller continue with the delivery process based on the auction result." },
                        new { Question = "How is my account protected?", Answer = "Users should keep their login information private and use accurate personal information to protect their account." },
                        new { Question = "Where can I view my auction history?", Answer = "You can open the product detail page and view previous bid history for that auction." }
                    };
                }

                @foreach (var item in faqItems)
                {
                    <article class="faq-item overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
                        <button type="button" class="faq-question flex w-full items-center justify-between gap-4 px-5 py-5 text-left">
                            <span class="text-base font-semibold text-slate-900 md:text-lg">@item.Question</span>
                            <span class="faq-icon grid h-8 w-8 shrink-0 place-items-center rounded-full bg-blue-50 text-blue-700 transition">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="m6 9 6 6 6-6"></path>
                                </svg>
                            </span>
                        </button>
                        <div class="faq-answer hidden border-t border-slate-100 px-5 pb-5 pt-0">
                            <p class="pt-4 leading-7 text-slate-600">@item.Answer</p>
                        </div>
                    </article>
                }
            </div>
        </div>
    </section>

    <section class="px-4 pb-20 sm:px-8 lg:px-12">
        <div class="mx-auto max-w-6xl overflow-hidden rounded-3xl border border-slate-200 bg-slate-50 p-8 text-center md:p-12">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">Support</p>
            <h2 class="mt-3 text-3xl font-bold md:text-4xl">Can't find your answer?</h2>
            <p class="mx-auto mt-4 max-w-2xl leading-7 text-slate-600">
                Contact our support team and we will help you understand the auction process clearly.
            </p>
            <a asp-controller="Contact" asp-action="Index"
               class="mt-8 inline-flex rounded-lg bg-blue-700 px-7 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-blue-800">
                Contact Us
            </a>
        </div>
    </section>
</div>
</div>

@section Scripts {
    <script>
        (function () {
            var questions = document.querySelectorAll('.faq-question');

            questions.forEach(function (question) {
                question.addEventListener('click', function () {
                    var item = question.closest('.faq-item');
                    var answer = item.querySelector('.faq-answer');
                    var icon = item.querySelector('.faq-icon');

                    answer.classList.toggle('hidden');
                    icon.classList.toggle('rotate-180');
                });
            });
        })();
    </script>
}
