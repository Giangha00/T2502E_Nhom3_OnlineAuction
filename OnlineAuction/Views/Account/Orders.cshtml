@model OnlineAuction.Models.AccountShellViewModel
@{
    ViewData["Title"] = Localizer["Account_Orders"];
}

<div class="account-dashboard min-h-screen bg-slate-50">
  <div class="site-shell account-dashboard__layout px-4 py-8 sm:px-6 lg:py-10">
    <partial name="Partials/_AccountSidebar" model="Model"/>

    <div class="account-dashboard__main">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">@Localizer["Account_Orders"]</h1>
      <p class="mt-2 text-sm text-slate-500">@Localizer["Account_Orders_Desc"]</p>

      <div class="account-empty mt-16">
        <h2 class="text-xl font-bold text-slate-900">@Localizer["Account_Orders_WonTitle"]</h2>
        <p class="mt-2 max-w-md text-sm text-slate-500">@Localizer["Account_Orders_WonDesc"]</p>
        <a asp-controller="Order" asp-action="Index"
           class="mt-8 inline-flex rounded-full bg-slate-900 px-8 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
          @Localizer["Account_Orders_GoToWon"]
        </a>
      </div>
    </div>
  </div>
</div>
