@model OnlineAuction.Models.AccountSellingCreateButtonViewModel

@if (Model.IsAuctionChannel)
{
  <a asp-controller="Sell" asp-action="Create" class="account-sell-action is-active">
    <span class="account-sell-action__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M14.121 15.536c-1.171 1.952-3.07 1.952-4.242 0-1.172-1.953-1.172-5.119 0-7.072 1.171-1.952 3.07-1.952 4.242 0M8 10.5h4m-4 3h4m9-1.5a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
    </span>
    <span class="account-sell-action__content">
      <span class="account-sell-action__label">@Localizer["Account_Selling_CreateListing"]</span>
      <span class="account-sell-action__type">@Localizer["Auction"]</span>
    </span>
    @if (Model.ShowArrow)
    {
      <svg class="account-sell-action__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
      </svg>
    }
  </a>
}
else
{
  <a asp-controller="Sell" asp-action="BuyNow" class="account-sell-action is-active">
    <span class="account-sell-action__icon" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 3h1.386c.51 0 .955.343 1.087.835l.383 1.437M7.5 14.25h9.75M7.5 14.25 6.106 5.272M7.5 14.25l-1.086 4.77M16.5 14.25l1.086 4.77M16.5 14.25V9.75a2.25 2.25 0 0 0-2.25-2.25h-4.5A2.25 2.25 0 0 0 7.5 9.75v4.5"/>
      </svg>
    </span>
    <span class="account-sell-action__content">
      <span class="account-sell-action__label">@Localizer["Account_Selling_CreateListing"]</span>
      <span class="account-sell-action__type">@Localizer["BuyNow"]</span>
    </span>
    @if (Model.ShowArrow)
    {
      <svg class="account-sell-action__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"/>
      </svg>
    }
  </a>
}
