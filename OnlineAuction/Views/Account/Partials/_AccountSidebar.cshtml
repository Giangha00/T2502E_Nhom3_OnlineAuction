@model OnlineAuction.Models.AccountShellViewModel
@{
    var sections = new (string Key, string Controller, string Action)[]
    {
        ("orders", "Order", "Index"),
        ("bids", "Account", "Bids"),
        ("watchlist", "Account", "Watchlist"),
        ("offers", "Account", "Offers"),
        ("selling", "Account", "Selling"),
        ("submissions", "Account", "Submissions")
    };

    string SectionLabelKey(string key) =>
        $"Account_{char.ToUpperInvariant(key[0])}{key[1..]}";
}

<aside class="account-sidebar">
  <div class="account-sidebar__profile">
    <span class="account-sidebar__avatar">@Model.Initials</span>
    <div class="min-w-0">
      <p class="truncate text-sm font-semibold text-slate-900">@Model.DisplayName</p>
    </div>
  </div>

  <nav class="account-sidebar__nav" aria-label="Account navigation">
    @foreach (var navItem in sections)
    {
      var isActive = string.Equals(Model.ActiveSection, navItem.Key, StringComparison.OrdinalIgnoreCase);
      <a asp-controller="@navItem.Controller" asp-action="@navItem.Action"
         class="account-sidebar__link @(isActive ? "is-active" : "")">
        <span class="account-sidebar__icon" aria-hidden="true">
          @switch (navItem.Key)
          {
            case "orders":
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M6 6h15l-1.5 9H7.5L6 6Z"/><path d="M6 6 5 3H2"/><circle cx="9" cy="20" r="1"/><circle cx="18" cy="20" r="1"/></svg>
              break;
            case "bids":
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="m14 13 6-6-2-2-6 6"/><path d="M16 5l3 3"/><path d="M8 21l-5-2 10-10 5 5-10 10Z"/></svg>
              break;
            case "watchlist":
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
              break;
            case "offers":
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M20 12V8H6a2 2 0 0 1-2-2"/><path d="M4 6v12a2 2 0 0 0 2 2h14"/><path d="M20 12H8a2 2 0 0 0-2 2v0a2 2 0 0 0 2 2h12"/></svg>
              break;
            case "selling":
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M12 3 2 9l10 6 10-6-10-6Z"/><path d="m2 15 10 6 10-6"/><path d="m2 9 10 6 10-6"/></svg>
              break;
            case "submissions":
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/></svg>
              break;
            default:
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"><circle cx="12" cy="12" r="3"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg>
              break;
          }
        </span>
        <span class="account-sidebar__label">@Localizer[SectionLabelKey(navItem.Key)]</span>
        @if (isActive)
        {
          <svg class="account-sidebar__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        }
      </a>
    }
  </nav>
</aside>
