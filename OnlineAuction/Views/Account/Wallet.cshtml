@model OnlineAuction.Models.AccountShellViewModel
@{
    ViewData["Title"] = "Wallet";
}

<div class="account-dashboard min-h-screen bg-slate-50">
  <div class="site-shell account-dashboard__layout px-4 py-8 sm:px-6 lg:py-10">
    <partial name="Partials/_AccountSidebar" model="Model"/>

    <div class="account-dashboard__main">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">Wallet</h1>
      <p class="mt-2 text-sm text-slate-500">Manage your payment methods and balances.</p>

      <div class="account-wallet-card mt-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="text-lg font-semibold text-white">Wallet</p>
            <p class="mt-1 text-sm text-white/70">Manage your payment methods and balances</p>
          </div>
          <svg class="h-5 w-5 shrink-0 text-white/80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
        </div>
        <p class="account-wallet-card__balance mt-8">$@Model.WalletBalance.ToString("N2")</p>
        <p class="mt-1 text-xs text-white/60">Available balance</p>
      </div>

      <div class="account-empty mt-16">
        <h2 class="text-xl font-bold text-slate-900">No payment methods yet.</h2>
        <p class="mt-2 text-sm text-slate-500">Add a card or bank account to receive payouts from your sales.</p>
        <a asp-controller="Payment" asp-action="Index"
           class="mt-8 inline-flex rounded-full bg-slate-900 px-8 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
          Add payment method
        </a>
      </div>
    </div>
  </div>
</div>
