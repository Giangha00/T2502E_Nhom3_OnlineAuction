
<div class="sell-section overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-100 px-6 py-5">
    <h2 class="flex items-center gap-3 text-base font-semibold text-slate-900">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">2</span>
      @Localizer["Sell_Section2_Title"]
    </h2>
    <p class="mt-1 pl-10 text-sm text-slate-500">@Localizer["Sell_Section2_Desc"]</p>
  </div>

  <div class="p-6">
    <div id="imageDropZone"
         class="flex cursor-pointer flex-col items-center justify-center rounded-xl border-2 border-dashed border-slate-200 bg-slate-50/60 px-6 py-10 transition hover:border-blue-400 hover:bg-blue-50/40">
      <svg class="h-10 w-10 text-blue-600" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"/>
      </svg>
      <p class="mt-3 text-sm font-semibold text-slate-800">@Localizer["Sell_UploadImages_Title"]</p>
      <p class="mt-1 text-sm text-slate-500">@Localizer["Sell_UploadImages_DragDrop"]</p>
      <p class="mt-2 text-xs text-slate-400">@Localizer["Sell_UploadImages_CloudinaryNote"]</p>
      <input type="file" id="imageInput" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple class="sr-only"/>
    </div>
    <p class="field-error mt-2 hidden text-xs text-red-600" data-for="images"></p>

    <div id="imagePreviewGrid" class="mt-6 hidden">
      <div class="mb-3 flex items-center justify-between">
        <p class="text-sm font-medium text-slate-700">@Localizer["Sell_UploadedImages"] <span id="imageCount" class="text-slate-400">(0)</span></p>
        <button type="button" id="clearAllImages" class="cursor-pointer text-xs font-semibold text-red-600 hover:text-red-700">@Localizer["Sell_RemoveAll"]</button>
      </div>
      <div id="imagePreviewList" class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4"></div>
    </div>
  </div>
</div>
