<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white/90 shadow-sm">
  <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-blue-50/50 px-6 py-4">
    <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-700 text-sm font-bold text-white">3</span>
      Product Images
    </h2>
    <p class="mt-1 pl-10 text-sm text-slate-500">Upload multiple images — JPG, PNG, WEBP (max 5MB each)</p>
  </div>

  <div class="p-6">
    <div id="imageDropZone"
         class="flex cursor-pointer flex-col items-center justify-center rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50 px-6 py-12 transition hover:border-blue-400 hover:bg-blue-50/40">
      <div class="flex h-14 w-14 items-center justify-center rounded-full bg-blue-100 text-2xl font-light text-blue-700">+</div>
      <p class="mt-4 text-base font-semibold text-slate-700">Upload Product Images</p>
      <p class="mt-1 text-sm text-slate-500">Drag &amp; Drop files here or click to browse</p>
      <p class="mt-3 text-xs text-slate-400">JPG · PNG · WEBP · up to 5MB per image</p>
      <input type="file" id="imageInput" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" multiple class="sr-only"/>
    </div>
    <p class="field-error mt-2 hidden text-xs text-red-600" data-for="images"></p>

    <div id="imagePreviewGrid" class="mt-6 hidden">
      <div class="mb-3 flex items-center justify-between">
        <p class="text-sm font-medium text-slate-700">Uploaded Images <span id="imageCount" class="text-slate-400">(0)</span></p>
        <button type="button" id="clearAllImages" class="text-xs font-semibold text-red-600 hover:text-red-700">Remove all</button>
      </div>
      <div id="imagePreviewList" class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4"></div>
    </div>
  </div>
</div>
