@model OnlineAuction.Models.CreateAuctionViewModel

  <div class="sell-section overflow-hidden rounded-2xl border border-slate-200 bg-white/90 shadow-sm">
  <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-blue-50/50 px-6 py-5">
    <h2 class="flex items-center gap-3 text-base font-semibold text-slate-900">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">3</span>
      @Localizer["Sell_Grading_Title"]
    </h2>
    <p class="mt-1 pl-10 text-sm text-slate-500">@Localizer["Sell_Grading_Desc"]</p>
  </div>

  <div class="grid grid-cols-2 gap-5 p-6 sm:grid-cols-4">
    <div>
      <label for="gradingCentering" class="mb-2 block text-sm font-medium text-slate-700">@Localizer["Product_Centering"]</label>
      <input type="text" id="gradingCentering" name="GradingCentering" value="@Model.GradingCentering" placeholder="10"
             class="field-input w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"/>
    </div>
    <div>
      <label for="gradingCorners" class="mb-2 block text-sm font-medium text-slate-700">@Localizer["Product_Corners"]</label>
      <input type="text" id="gradingCorners" name="GradingCorners" value="@Model.GradingCorners" placeholder="10"
             class="field-input w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"/>
    </div>
    <div>
      <label for="gradingEdges" class="mb-2 block text-sm font-medium text-slate-700">@Localizer["Product_Edges"]</label>
      <input type="text" id="gradingEdges" name="GradingEdges" value="@Model.GradingEdges" placeholder="10"
             class="field-input w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"/>
    </div>
    <div>
      <label for="gradingSurface" class="mb-2 block text-sm font-medium text-slate-700">@Localizer["Product_Surface"]</label>
      <input type="text" id="gradingSurface" name="GradingSurface" value="@Model.GradingSurface" placeholder="10"
             class="field-input w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"/>
    </div>
  </div>
</div>
