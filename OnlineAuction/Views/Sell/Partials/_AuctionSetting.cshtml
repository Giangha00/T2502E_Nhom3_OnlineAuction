@model OnlineAuction.Models.CreateAuctionViewModel

<div class="sell-section overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-100 px-6 py-5">
    <h2 class="flex items-center gap-3 text-base font-semibold text-slate-900">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">3</span>
      @Localizer["Sell_Section3_Title"]
    </h2>
    <p class="mt-1 pl-10 text-sm text-slate-500">@Localizer["Sell_Section3_Desc"]</p>
  </div>

  <div class="space-y-6 p-6">
    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <label for="startingPrice" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_StartingPrice"] <span class="text-red-500">*</span></label>
        <div class="relative">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400">$</span>
          <input type="number" id="startingPrice" name="StartingPrice" value="@(Model.StartingPrice > 0 ? Model.StartingPrice : "")" step="0.01" min="0" placeholder="500"
                 class="field-input w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-7 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
        </div>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="startingPrice"></p>
      </div>
      <div>
        <label for="bidStep" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_BidStep"] <span class="text-red-500">*</span></label>
        <div class="relative">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400">$</span>
          <input type="number" id="bidStep" name="BidStep" value="@(Model.BidStep > 0 ? Model.BidStep : 50)" step="0.01" min="0" placeholder="50"
                 class="field-input w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-7 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
        </div>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="bidStep"></p>
      </div>
      <div>
        <label for="buyNowPrice" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_BuyNowPrice"]</label>
        <div class="relative">
          <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-sm text-slate-400">$</span>
          <input type="number" id="buyNowPrice" name="BuyNowPrice" value="@(Model.BuyNowPrice.HasValue && Model.BuyNowPrice > 0 ? Model.BuyNowPrice : "")" step="0.01" min="0" placeholder="2000"
                 class="field-input w-full rounded-lg border border-slate-200 bg-white py-2.5 pl-7 pr-4 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
        </div>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="buyNowPrice"></p>
      </div>
    </div>

    <div>
      <span class="mb-3 block text-sm font-medium text-slate-700">@Localizer["Sell_AuctionType"] <span class="text-red-500">*</span></span>
      <div class="grid gap-4 sm:grid-cols-2">
        <label class="auction-type-card group cursor-pointer">
          <input type="radio" name="AuctionType" value="Normal" class="peer sr-only" @(Model.AuctionType != "Featured" ? "checked=\"checked\"" : null)/>
          <div class="rounded-xl border-2 border-slate-200 bg-white p-4 transition peer-checked:border-blue-600 peer-checked:bg-blue-50/60">
            <p class="text-sm font-semibold text-slate-900">@Localizer["Sell_AuctionType_Normal"]</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">@Localizer["Sell_AuctionType_Normal_Desc"]</p>
          </div>
        </label>
        <label class="auction-type-card group cursor-pointer">
          <input type="radio" name="AuctionType" value="Featured" class="peer sr-only" @(Model.AuctionType == "Featured" ? "checked=\"checked\"" : null)/>
          <div class="rounded-xl border-2 border-slate-200 bg-white p-4 transition peer-checked:border-blue-600 peer-checked:bg-blue-50/60">
            <p class="text-sm font-semibold text-slate-900">@Localizer["Sell_AuctionType_Featured"]</p>
            <p class="mt-1 text-xs leading-relaxed text-slate-500">@Localizer["Sell_AuctionType_Featured_Desc"]</p>
          </div>
        </label>
      </div>
      <p class="field-error mt-1 hidden text-xs text-red-600" data-for="AuctionType"></p>
    </div>
  </div>
</div>
