@model OnlineAuction.Models.CreateAuctionViewModel

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white/90 shadow-sm">
  <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 to-blue-50/50 px-6 py-4">
    <h2 class="flex items-center gap-2 text-lg font-semibold text-slate-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-700 text-sm font-bold text-white">4</span>
      Auction &amp; Pricing
    </h2>
    <p class="mt-1 pl-10 text-sm text-slate-500">Pricing and event info shown on the bid panel</p>
  </div>

  <div class="space-y-5 p-6">
    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <label for="startingPrice" class="mb-2 block text-sm font-medium text-slate-700">Starting Price <span class="text-red-500">*</span></label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-slate-400">$</span>
          <input type="number" id="startingPrice" name="StartingPrice" value="@(Model.StartingPrice > 0 ? Model.StartingPrice : "")" step="0.01" min="0" placeholder="85000"
                 class="field-input w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-8 pr-4 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"/>
        </div>
        <p class="mt-1 text-xs text-slate-400">Opens as the current bid on the detail page</p>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="startingPrice"></p>
      </div>
      <div>
        <label for="bidStep" class="mb-2 block text-sm font-medium text-slate-700">Bid Step <span class="text-red-500">*</span></label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-slate-400">$</span>
          <input type="number" id="bidStep" name="BidStep" value="@(Model.BidStep > 0 ? Model.BidStep : 50)" step="0.01" min="0" placeholder="500"
                 class="field-input w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-8 pr-4 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"/>
        </div>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="bidStep"></p>
      </div>
      <div>
        <label for="estimatedValue" class="mb-2 block text-sm font-medium text-slate-700">Estimated Value <span class="text-red-500">*</span></label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-slate-400">$</span>
          <input type="number" id="estimatedValue" name="EstimatedValue" value="@(Model.EstimatedValue > 0 ? Model.EstimatedValue : "")" step="0.01" min="0" placeholder="150000"
                 class="field-input w-full rounded-xl border border-slate-200 bg-slate-50 py-3 pl-8 pr-4 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"/>
        </div>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="estimatedValue"></p>
      </div>
    </div>

    <div>
      <label for="auctionEventName" class="mb-2 block text-sm font-medium text-slate-700">Auction Event <span class="text-red-500">*</span></label>
      <input type="text" id="auctionEventName" name="AuctionEventName" value="@Model.AuctionEventName"
             class="field-input w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm outline-none transition focus:border-blue-500 focus:bg-white focus:ring-4 focus:ring-blue-100"/>
      <p class="mt-1 text-xs text-slate-400">Shown at the bottom of the bid panel on the detail page</p>
      <p class="field-error mt-1 hidden text-xs text-red-600" data-for="auctionEventName"></p>
    </div>
  </div>
</div>
