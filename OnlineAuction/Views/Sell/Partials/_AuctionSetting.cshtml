@model OnlineAuction.Models.CreateAuctionViewModel

<div class="overflow-hidden rounded-2xl border border-stone-200 bg-white/90 shadow-sm">
  <div class="border-b border-stone-100 bg-gradient-to-r from-stone-50 to-amber-50/50 px-6 py-4">
    <h2 class="flex items-center gap-2 text-lg font-semibold text-stone-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-700 text-sm font-bold text-white">3</span>
      Auction Settings
    </h2>
    <p class="mt-1 pl-10 text-sm text-stone-500">Set pricing rules and auction type</p>
  </div>

  <div class="space-y-5 p-6">
    <div class="grid gap-5 sm:grid-cols-3">
      <div>
        <label for="startingPrice" class="mb-2 block text-sm font-medium text-stone-700">Starting Price <span class="text-red-500">*</span></label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-stone-400">$</span>
          <input type="number" id="startingPrice" name="StartingPrice" value="@(Model.StartingPrice > 0 ? Model.StartingPrice : "")" step="0.01" min="0" placeholder="500"
                 class="field-input w-full rounded-xl border border-stone-200 bg-stone-50 py-3 pl-8 pr-4 text-sm outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"/>
        </div>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="startingPrice"></p>
      </div>
      <div>
        <label for="bidStep" class="mb-2 block text-sm font-medium text-stone-700">Bid Step <span class="text-red-500">*</span></label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-stone-400">$</span>
          <input type="number" id="bidStep" name="BidStep" value="@(Model.BidStep > 0 ? Model.BidStep : 50)" step="0.01" min="0" placeholder="50"
                 class="field-input w-full rounded-xl border border-stone-200 bg-stone-50 py-3 pl-8 pr-4 text-sm outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"/>
        </div>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="bidStep"></p>
      </div>
      <div>
        <label for="buyNowPrice" class="mb-2 block text-sm font-medium text-stone-700">Buy Now Price</label>
        <div class="relative">
          <span class="pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-sm text-stone-400">$</span>
          <input type="number" id="buyNowPrice" name="BuyNowPrice" value="@Model.BuyNowPrice" step="0.01" min="0" placeholder="2000"
                 class="field-input w-full rounded-xl border border-stone-200 bg-stone-50 py-3 pl-8 pr-4 text-sm outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"/>
        </div>
        <p class="field-error mt-1 hidden text-xs text-red-600" data-for="buyNowPrice"></p>
      </div>
    </div>

    <div>
      <span class="mb-3 block text-sm font-medium text-stone-700">Auction Type <span class="text-red-500">*</span></span>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 transition has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50 has-[:checked]:ring-2 has-[:checked]:ring-amber-100">
          <input type="radio" name="AuctionType" value="Normal" class="mt-0.5 h-4 w-4 border-stone-300 text-amber-700 focus:ring-amber-500" @(Model.AuctionType == "Normal" ? "checked=\"checked\"" : null)/>
          <div>
            <span class="block text-sm font-semibold text-stone-800">Normal Auction</span>
            <span class="mt-0.5 block text-xs text-stone-500">Standard listing visible in browse results</span>
          </div>
        </label>
        <label class="flex cursor-pointer items-start gap-3 rounded-xl border border-stone-200 bg-stone-50 p-4 transition has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50 has-[:checked]:ring-2 has-[:checked]:ring-amber-100">
          <input type="radio" name="AuctionType" value="Featured" class="mt-0.5 h-4 w-4 border-stone-300 text-amber-700 focus:ring-amber-500" @(Model.AuctionType == "Featured" ? "checked=\"checked\"" : null)/>
          <div>
            <span class="block text-sm font-semibold text-stone-800">Featured Auction</span>
            <span class="mt-0.5 block text-xs text-stone-500">Highlighted placement on homepage</span>
          </div>
        </label>
      </div>
    </div>
  </div>
</div>
