
<div class="space-y-4">
  <div>
    <div class="mb-3 px-1">
      <h2 class="text-sm font-semibold text-slate-900">@Localizer["SellBuyNow_Preview_Title"]</h2>
      <p class="mt-0.5 text-xs text-slate-500">@Localizer["SellBuyNow_Preview_Desc"]</p>
    </div>

    <article class="rarecard-card rarecard-card--grid sell-preview-card group h-full">
      <div class="rarecard-card__shell pointer-events-none overflow-hidden rounded-2xl border border-stone-200 bg-white shadow-sm transition hover:shadow-lg">
        <div class="flex flex-1 flex-col">
          <div class="rarecard-card__image-wrap relative bg-stone-50">
            <img id="previewImage"
                 src=""
                 alt="@Localizer["SellBuyNow_Preview_Title"]"
                 class="rarecard-card__image hidden object-contain transition duration-500 group-hover:scale-[1.03]"/>
            <div id="previewImagePlaceholder" class="flex flex-col items-center justify-center text-stone-400">
              <svg class="mb-2 h-10 w-10" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"/>
              </svg>
              <span class="text-xs">@Localizer["Sell_Preview_NoImage"]</span>
            </div>
            <span id="previewBadge"
                  class="absolute left-3 top-3 rounded-md bg-emerald-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">
              @Localizer["BuyNow_InStock"]
            </span>
            <span class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full border border-stone-200 bg-white/95 text-stone-400 shadow-sm"
                  aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </span>
          </div>

          <div class="rarecard-card__body flex flex-1 flex-col p-3 sm:p-4">
            <p id="previewCategory" class="text-[10px] font-bold uppercase tracking-wide text-blue-700">—</p>
            <h3 id="previewName" class="mt-1 line-clamp-2 min-h-[2.5rem] text-sm font-semibold leading-snug text-stone-900">@Localizer["Sell_Preview_ProductNameDefault"]</h3>
            <p id="previewSubtitle" class="mt-1 line-clamp-1 min-h-[1.125rem] text-xs text-stone-500">@Html.Raw("&nbsp;")</p>

            <div class="rarecard-card__price-row mt-auto flex items-end justify-between gap-2 border-t border-stone-100 pt-3">
              <div>
                <p class="text-[10px] font-semibold uppercase tracking-wider text-stone-400">@Localizer["BuyNow_Price"]</p>
                <p id="previewPrice" class="text-xl font-bold tabular-nums text-blue-700">$ —</p>
              </div>
              <p id="previewAvailability" class="text-right text-xs font-semibold text-emerald-700">@Localizer["BuyNow_InStock"]</p>
            </div>
          </div>
        </div>
      </div>
    </article>
  </div>

  <div class="flex items-start gap-3 rounded-xl border border-blue-100 bg-blue-50 px-4 py-3.5">
    <svg class="mt-0.5 h-5 w-5 shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
    </svg>
    <p class="text-xs leading-relaxed text-blue-800">@Localizer["SellBuyNow_Preview_ReviewNote"]</p>
  </div>
</div>
