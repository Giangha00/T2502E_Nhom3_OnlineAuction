@model OnlineAuction.Models.CreateBuyNowViewModel

<div>
  <label for="category" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_Category"] <span class="text-red-500">*</span></label>
  <select id="category" name="Category"
          class="field-input w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">
    <option value="">@Localizer["Sell_Category_Placeholder"]</option>
    @foreach (var category in Model.Categories)
    {
      if (Model.Category == category)
      {
        <option value="@category" selected="selected">@category</option>
      }
      else
      {
        <option value="@category">@category</option>
      }
    }
  </select>
  <p class="field-error mt-1 hidden text-xs text-red-600" data-for="category"></p>
</div>
