@model OnlineAuction.Models.CreateAuctionViewModel
@{
    var registrationStartValue = Model.RegistrationStartDate.ToString("yyyy-MM-ddTHH:mm");
    var registrationEndValue = Model.RegistrationEndDate.ToString("yyyy-MM-ddTHH:mm");
    var liveStartValue = Model.StartDate.ToString("yyyy-MM-ddTHH:mm");
    var liveEndValue = Model.EndDate.ToString("yyyy-MM-ddTHH:mm");
}

<div class="sell-section overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-100 px-6 py-5">
    <h2 class="flex items-center gap-3 text-base font-semibold text-slate-900">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">5</span>
      @Localizer["Sell_Section4_Title"]
    </h2>
    <p class="mt-1 pl-10 text-sm text-slate-500">@Localizer["Sell_Section4_Desc"]</p>
  </div>

  <div class="space-y-6 p-6">
    <div>
      <h3 class="mb-3 text-sm font-semibold text-slate-800">@Localizer["Sell_RegistrationPeriodTitle"]</h3>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="registrationStartDate" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_RegistrationStartDate"] <span class="text-red-500">*</span></label>
          <input type="datetime-local" id="registrationStartDate" name="RegistrationStartDate" value="@registrationStartValue"
                 class="field-input w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
          <p class="field-error mt-1 hidden text-xs text-red-600" data-for="registrationStartDate"></p>
        </div>
        <div>
          <label for="registrationEndDate" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_RegistrationEndDate"] <span class="text-red-500">*</span></label>
          <input type="datetime-local" id="registrationEndDate" name="RegistrationEndDate" value="@registrationEndValue"
                 class="field-input w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
          <p class="field-error mt-1 hidden text-xs text-red-600" data-for="registrationEndDate"></p>
        </div>
      </div>
    </div>

    <div>
      <h3 class="mb-3 text-sm font-semibold text-slate-800">@Localizer["Sell_LivePeriodTitle"]</h3>
      <p class="mb-3 text-xs text-slate-500">@Localizer["Sell_LivePeriodDesc"]</p>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="startDate" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_LiveStartDate"] <span class="text-red-500">*</span></label>
          <input type="datetime-local" id="startDate" name="StartDate" value="@liveStartValue"
                 class="field-input w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
          <p class="field-error mt-1 hidden text-xs text-red-600" data-for="startDate"></p>
        </div>
        <div>
          <label for="endDate" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_LiveEndDate"] <span class="text-red-500">*</span></label>
          <input type="datetime-local" id="endDate" name="EndDate" value="@liveEndValue"
                 class="field-input w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
          <p class="field-error mt-1 hidden text-xs text-red-600" data-for="endDate"></p>
        </div>
      </div>
    </div>
  </div>
</div>
