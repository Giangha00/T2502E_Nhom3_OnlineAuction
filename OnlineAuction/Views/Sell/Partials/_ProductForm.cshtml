@model OnlineAuction.Models.SellProductFormViewModel

<div class="sell-section overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm">
  <div class="border-b border-slate-100 px-6 py-5">
    <h2 class="flex items-center gap-3 text-base font-semibold text-slate-900">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue-700 text-xs font-bold text-white">1</span>
      @Localizer["Sell_Section1_Title"]
    </h2>
    <p class="mt-1 pl-10 text-sm text-slate-500">@Localizer["Sell_Section1_Desc"]</p>
  </div>

  <div class="space-y-5 p-6">
    <div>
      <label for="productName" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_ProductName"] <span class="text-red-500">*</span></label>
      <input type="text" id="productName" name="ProductName" value="@Model.ProductName" placeholder="@Localizer["Sell_ProductName_Placeholder"]"
             class="field-input w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100"/>
      <p class="field-error mt-1 hidden text-xs text-red-600" data-for="productName"></p>
    </div>

    @await Html.PartialAsync("Partials/_CategorySelect", Model)

    <div>
      <label for="shortDescription" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_ShortDescription"]</label>
      <textarea id="shortDescription" name="ShortDescription" rows="2" maxlength="300" placeholder="@Localizer["Sell_ShortDescription_Placeholder"]"
                class="field-input w-full rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-sm outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-100">@Model.ShortDescription</textarea>
      <p class="field-error mt-1 hidden text-xs text-red-600" data-for="shortDescription"></p>
    </div>

    <div>
      <label for="productDescription" class="mb-1.5 block text-sm font-medium text-slate-700">@Localizer["Sell_ProductDescription"]</label>
      <textarea id="productDescription" name="ProductDescription" class="hidden">@Model.ProductDescription</textarea>
      <div id="descriptionEditor" class="ckeditor-wrapper overflow-hidden rounded-lg border border-slate-200 bg-white"></div>
      <p class="field-error mt-1 hidden text-xs text-red-600" data-for="productDescription"></p>
    </div>
  </div>
</div>
