@model OnlineAuction.Models.CreateAuctionViewModel

<div class="overflow-hidden rounded-2xl border border-stone-200 bg-white/90 shadow-sm">
  <div class="border-b border-stone-100 bg-gradient-to-r from-stone-50 to-amber-50/50 px-6 py-4">
    <h2 class="flex items-center gap-2 text-lg font-semibold text-stone-900">
      <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-amber-700 text-sm font-bold text-white">1</span>
      Product Information
    </h2>
    <p class="mt-1 pl-10 text-sm text-stone-500">Basic details about the item you want to auction</p>
  </div>

  <div class="space-y-5 p-6">
    <div>
      <label for="productName" class="mb-2 block text-sm font-medium text-stone-700">Product Name <span class="text-red-500">*</span></label>
      <input type="text" id="productName" name="ProductName" value="@Model.ProductName" placeholder="Vintage Watch"
             class="field-input w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"/>
      <p class="field-error mt-1 hidden text-xs text-red-600" data-for="productName"></p>
    </div>

  @await Html.PartialAsync("Partials/_CategorySelect", Model)

    <div>
      <label for="productDescription" class="mb-2 block text-sm font-medium text-stone-700">Product Description</label>
      <textarea id="productDescription" name="ProductDescription" class="hidden">@Model.ProductDescription</textarea>
      <div id="descriptionEditor" class="ckeditor-wrapper overflow-hidden rounded-xl border border-stone-200 bg-white"></div>
      <p class="mt-1 text-xs text-stone-400">Rich text supported — bullets, links, and formatting</p>
      <p class="field-error mt-1 hidden text-xs text-red-600" data-for="productDescription"></p>
    </div>

    <div>
      <span class="mb-3 block text-sm font-medium text-stone-700">Condition <span class="text-red-500">*</span></span>
      <div class="flex flex-wrap gap-4">
        @foreach (var condition in Model.Conditions)
        {
          var id = $"condition_{condition.Replace(" ", "")}";
          <label class="flex cursor-pointer items-center gap-2.5 rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm transition has-[:checked]:border-amber-500 has-[:checked]:bg-amber-50 has-[:checked]:ring-2 has-[:checked]:ring-amber-100">
            <input type="radio" name="Condition" value="@condition" id="@id" class="h-4 w-4 border-stone-300 text-amber-700 focus:ring-amber-500" @(Model.Condition == condition ? "checked=\"checked\"" : null)/>
            <span class="font-medium text-stone-700">@condition</span>
          </label>
        }
      </div>
      <p class="field-error mt-1 hidden text-xs text-red-600" data-for="Condition"></p>
    </div>

    <div>
      <label for="productOrigin" class="mb-2 block text-sm font-medium text-stone-700">Product Origin</label>
      <input type="text" id="productOrigin" name="ProductOrigin" value="@Model.ProductOrigin" placeholder="Japan"
             class="field-input w-full rounded-xl border border-stone-200 bg-stone-50 px-4 py-3 text-sm outline-none transition focus:border-amber-500 focus:bg-white focus:ring-4 focus:ring-amber-100"/>
    </div>
  </div>
</div>
