<div class="space-y-4">
  <div class="max-h-[calc(100vh-8rem)] overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-md">
    <div class="bg-blue-700 px-5 py-4 text-white">
      <h2 class="text-base font-semibold">Auction Preview</h2>
      <p class="mt-0.5 text-xs text-blue-100">Live preview of your listing</p>
    </div>

    <div class="p-5">
      <div id="previewImageWrap" class="relative mb-4 aspect-square overflow-hidden rounded-lg bg-slate-100">
        <img id="previewImage" src="" alt="Product preview" class="hidden h-full w-full object-contain"/>
        <div id="previewImagePlaceholder" class="flex h-full flex-col items-center justify-center text-slate-400">
          <svg class="mb-2 h-10 w-10" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"/>
          </svg>
          <span class="text-xs">No image yet</span>
        </div>
      </div>

      <p id="previewName" class="text-base font-semibold text-slate-900">Product Name</p>
      <p id="previewCondition" class="mt-1 text-sm text-slate-500">Condition: —</p>

      <p id="previewDescription" class="mt-3 line-clamp-3 text-sm leading-relaxed text-slate-600">No description yet.</p>

      <div class="mt-4 grid gap-2 rounded-lg bg-slate-50 px-4 py-3 text-xs text-slate-600">
        <div class="flex items-center justify-between gap-3">
          <span>Category</span>
          <span id="previewCategory" class="text-right font-medium text-slate-800">--</span>
        </div>
        <div class="flex items-center justify-between gap-3">
          <span>Origin</span>
          <span id="previewOrigin" class="text-right font-medium text-slate-800">--</span>
        </div>
        <div class="flex items-center justify-between gap-3">
          <span>Auction Type</span>
          <span id="previewAuctionType" class="text-right font-medium text-slate-800">--</span>
        </div>
      </div>

      <div class="mt-4 space-y-2 border-t border-slate-100 pt-4 text-sm">
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Starting Price</span>
          <span id="previewStartingPrice" class="font-semibold text-slate-900">$ —</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Current Bid</span>
          <span id="previewCurrentBid" class="font-semibold text-slate-900">—</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Bid Step</span>
          <span id="previewBidStep" class="font-semibold text-slate-900">$ --</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Buy Now</span>
          <span id="previewBuyNowPrice" class="font-semibold text-slate-900">--</span>
        </div>
      </div>

      <div class="mt-4 rounded-lg bg-slate-50 px-4 py-3">
        <div class="flex items-center gap-2 text-sm font-medium text-slate-700">
          <svg class="h-4 w-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5"/>
          </svg>
          Auction Time
        </div>
        <div class="mt-2 space-y-1 text-xs text-slate-500">
          <p>Start: <span id="previewStartDate" class="font-medium text-slate-700">—</span></p>
          <p>End: <span id="previewEndDate" class="font-medium text-slate-700">—</span></p>
        </div>
      </div>

      <div id="previewThumbnails" class="mt-4 hidden flex flex-wrap gap-2"></div>

      <div class="mt-4 rounded-lg border border-slate-100 px-4 py-3 text-xs text-slate-600">
        <div class="flex items-center justify-between">
          <span>Images</span>
          <span id="previewImageCount" class="font-medium text-slate-800">0</span>
        </div>
        <div class="mt-1 flex items-center justify-between">
          <span>Documents</span>
          <span id="previewDocumentCount" class="font-medium text-slate-800">0</span>
        </div>
      </div>
    </div>
  </div>

  <div class="flex items-start gap-3 rounded-xl border border-blue-100 bg-blue-50 px-4 py-3.5">
    <svg class="mt-0.5 h-5 w-5 shrink-0 text-blue-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
    </svg>
    <p class="text-xs leading-relaxed text-blue-800">Your card will be reviewed by our specialists before the auction goes live to ensure authenticity.</p>
  </div>
</div>
