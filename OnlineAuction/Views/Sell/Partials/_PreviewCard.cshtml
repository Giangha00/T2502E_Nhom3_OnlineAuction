<div class="sticky-below-header overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-lg">
  <div class="border-b border-slate-100 bg-gradient-to-r from-slate-900 to-slate-800 px-5 py-4 text-white">
    <h2 class="text-lg font-semibold">Detail Page Preview</h2>
    <p class="mt-0.5 text-xs text-slate-300">How your listing will appear</p>
  </div>

  <div class="p-5">
    <div id="previewImageWrap" class="relative mb-4 aspect-square overflow-hidden bg-slate-50">
      <img id="previewImage" src="" alt="Product preview" class="hidden h-full w-full object-contain"/>
      <div id="previewImagePlaceholder" class="flex h-full flex-col items-center justify-center text-slate-400">
        <svg class="mb-2 h-12 w-12" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"/>
        </svg>
        <span class="text-xs">No image yet</span>
      </div>
    </div>

    <p id="previewLot" class="text-sm text-slate-500">Lot —</p>
    <p id="previewCategory" class="mt-2 text-xl font-bold text-slate-900">Category</p>
    <p id="previewName" class="mt-1 text-base text-slate-800"><em>Card Name</em></p>
    <p id="previewSpecs" class="mt-3 text-sm leading-relaxed text-slate-600">—</p>

    <div class="my-4 border-t border-slate-100"></div>

    <p class="text-sm text-slate-700">
      Estimated value: <span id="previewEstimatedValue" class="font-semibold text-slate-900">$—</span>
    </p>

    <div class="mt-4 flex items-start justify-between gap-4">
      <div>
        <p class="text-sm text-slate-700">Current bid</p>
        <p class="mt-1 text-xs text-slate-500">Opens at starting price</p>
      </div>
      <p id="previewStartingPrice" class="text-2xl font-bold tabular-nums text-slate-900">$—</p>
    </div>

    <p class="mt-3 text-xs text-slate-500">
      Bid step: <span id="previewBidStep" class="font-semibold text-slate-700">$—</span>
    </p>

    <div class="my-4 border-t border-slate-100"></div>

    <div class="space-y-1 text-sm">
      <p id="previewCountdown" class="font-medium text-blue-700">—</p>
      <p id="previewEndDate" class="text-slate-600">Ends —</p>
    </div>

    <div class="my-4 border-t border-slate-100"></div>

    <p id="previewEventName" class="text-sm leading-relaxed text-slate-600">—</p>

    <div class="mt-6 grid grid-cols-2 gap-3 text-xs">
      <div>
        <p class="text-slate-400">Year</p>
        <p id="previewYear" class="mt-0.5 font-medium text-slate-900">—</p>
      </div>
      <div>
        <p class="text-slate-400">Set</p>
        <p id="previewSetName" class="mt-0.5 font-medium text-slate-900">—</p>
      </div>
      <div>
        <p class="text-slate-400">Language</p>
        <p id="previewLanguage" class="mt-0.5 font-medium text-slate-900">—</p>
      </div>
      <div>
        <p class="text-slate-400">Card Number</p>
        <p id="previewCardNumber" class="mt-0.5 font-medium text-slate-900">—</p>
      </div>
    </div>

    <div id="previewThumbnails" class="mt-4 hidden flex flex-wrap gap-2"></div>
  </div>
</div>
