@model OnlineAuction.Models.CreateAuctionViewModel
@{
    ViewData["Title"] = "Create New Auction";
    var successMessage = TempData["SuccessMessage"] as string;
}

<section class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8 lg:py-12">
  @await Html.PartialAsync("Partials/_AuctionHeader")

  <div id="successBanner" class="@(string.IsNullOrEmpty(successMessage) ? "hidden" : "") mb-6 rounded-2xl border border-emerald-200 bg-emerald-50 px-5 py-4 text-sm text-emerald-800">
    <div class="flex items-start gap-3">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/>
      </svg>
      <div>
        <p id="successMessageText" class="font-semibold">@(successMessage ?? "Your auction has been created successfully!")</p>
        <a asp-controller="Auction" asp-action="Index" class="mt-1 inline-block text-emerald-900 underline">View auctions →</a>
      </div>
    </div>
  </div>

  <div id="draftBanner" class="mb-6 hidden rounded-2xl border border-amber-200 bg-amber-50 px-5 py-3 text-sm text-amber-800">
    Draft saved locally. You can continue editing anytime.
  </div>

  <form id="createAuctionForm" asp-action="Create" asp-controller="Sell" method="post" enctype="multipart/form-data" novalidate>
    @Html.AntiForgeryToken()

    <div class="grid gap-8 lg:grid-cols-3">
      <div class="space-y-6 lg:col-span-2">
        @await Html.PartialAsync("Partials/_ProductForm", Model)
        @await Html.PartialAsync("Partials/_ImageUploader")
        @await Html.PartialAsync("Partials/_AuctionSetting", Model)
        @await Html.PartialAsync("Partials/_AuctionDuration", Model)
        @await Html.PartialAsync("Partials/_DocumentUploader")

        <div class="lg:hidden">
          @await Html.PartialAsync("Partials/_PreviewCard")
        </div>

        @await Html.PartialAsync("Partials/_FooterActions")
      </div>

      <div class="hidden lg:col-span-1 lg:block">
        @await Html.PartialAsync("Partials/_PreviewCard")
      </div>
    </div>
  </form>
</section>

@section Scripts {
  <script src="https://cdn.ckeditor.com/ckeditor5/41.4.2/classic/ckeditor.js"></script>
  <script src="~/js/create-auction.js" asp-append-version="true"></script>
}
