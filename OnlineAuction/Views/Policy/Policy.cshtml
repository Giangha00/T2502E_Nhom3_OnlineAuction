@{
    ViewData["Title"] = "Policy & Term of Use";
}

<partial name="_PageHero" model='new OnlineAuction.Models.PageHeroViewModel {
    Label = "Auction House Governance",
    Title = "Policy & Term of Use",
    Description = "Understand our rules and guidelines for using Auction House, including privacy, auction operations, payments, and responsibilities of every member."
}' />

<div class="policy-page text-stone-800">

    <section class="px-4 py-10 md:px-5 md:py-14">
        <div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-6 md:gap-8">
            <aside class="lg:sticky lg:top-6 self-start">
                <div class="rounded-2xl border border-stone-200 bg-white/80 p-4 md:p-5 shadow-sm">
                    <h2 class="text-2xl font-semibold mb-4">Policy Menu</h2>

                    <div class="lg:hidden -mx-1 mb-2 overflow-x-auto">
                        <nav class="flex gap-2 px-1 min-w-max" aria-label="Policy section navigation mobile">
                            <a href="#terms-of-use" class="px-3 py-2 text-sm rounded-full bg-amber-50 text-amber-800 font-semibold whitespace-nowrap">Terms of Use</a>
                            <a href="#privacy-policy" class="px-3 py-2 text-sm rounded-full bg-amber-50 text-amber-800 font-semibold whitespace-nowrap">Privacy Policy</a>
                            <a href="#auction-rules" class="px-3 py-2 text-sm rounded-full bg-amber-50 text-amber-800 font-semibold whitespace-nowrap">Auction Rules</a>
                            <a href="#payment-policy" class="px-3 py-2 text-sm rounded-full bg-amber-50 text-amber-800 font-semibold whitespace-nowrap">Payment Policy</a>
                            <a href="#user-responsibilities" class="px-3 py-2 text-sm rounded-full bg-amber-50 text-amber-800 font-semibold whitespace-nowrap">User Responsibilities</a>
                        </nav>
                    </div>

                    <nav class="hidden lg:block" aria-label="Policy section navigation desktop">
                        <a href="#terms-of-use" class="block px-4 py-3 rounded-xl hover:bg-amber-50 transition text-stone-700 font-medium">Terms of Use</a>
                        <a href="#privacy-policy" class="block px-4 py-3 rounded-xl hover:bg-amber-50 transition text-stone-700 font-medium">Privacy Policy</a>
                        <a href="#auction-rules" class="block px-4 py-3 rounded-xl hover:bg-amber-50 transition text-stone-700 font-medium">Auction Rules</a>
                        <a href="#payment-policy" class="block px-4 py-3 rounded-xl hover:bg-amber-50 transition text-stone-700 font-medium">Payment Policy</a>
                        <a href="#user-responsibilities" class="block px-4 py-3 rounded-xl hover:bg-amber-50 transition text-stone-700 font-medium">User Responsibilities</a>
                    </nav>
                    <p class="mt-4 mb-0 text-sm text-stone-500 leading-6">
                        Tip: Choose any section to jump directly to detailed policy content.
                    </p>
                </div>
            </aside>

            <div class="space-y-6 md:space-y-8">
                <section id="terms-of-use" class="rounded-2xl border border-stone-200 bg-white p-5 md:p-7 shadow-sm scroll-mt-24">
                    <p class="mb-2 text-xs md:text-sm font-bold tracking-[0.2em] uppercase text-amber-700">Section 01</p>
                    <h2 class="text-3xl md:text-4xl font-semibold mb-4">Terms of Use</h2>
                    <p class="text-stone-600 leading-7 mb-5">
                        These terms define how users should access and use Auction House services in a lawful,
                        fair, and transparent way.
                    </p>

                    <div class="space-y-5">
                        <article class="rounded-xl bg-white/80 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Account Usage</h3>
                            <ul class="list-disc pl-5 space-y-2 text-stone-600 leading-7">
                                <li>Users must provide accurate and up-to-date account information.</li>
                                <li>Account credentials must not be shared with others.</li>
                            </ul>
                        </article>

                        <article class="rounded-xl bg-white/80 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Auction Participation</h3>
                            <ul class="list-disc pl-5 space-y-2 text-stone-600 leading-7">
                                <li>Users must comply with all platform auction rules.</li>
                                <li>Creating fake bids is strictly prohibited.</li>
                                <li>Any form of price manipulation is forbidden.</li>
                            </ul>
                        </article>

                        <article class="rounded-xl bg-white/80 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Prohibited Activities</h3>
                            <ul class="list-disc pl-5 space-y-2 text-stone-600 leading-7">
                                <li>Fraudulent behavior in listings, bids, or transactions.</li>
                                <li>Spam or abusive communication within the platform.</li>
                                <li>Submitting false or misleading information.</li>
                            </ul>
                        </article>
                    </div>
                </section>

                <section id="privacy-policy" class="rounded-2xl border border-stone-200 bg-white p-5 md:p-7 shadow-sm scroll-mt-24">
                    <p class="mb-2 text-xs md:text-sm font-bold tracking-[0.2em] uppercase text-amber-700">Section 02</p>
                    <h2 class="text-3xl md:text-4xl font-semibold mb-4">Privacy Policy</h2>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <article class="rounded-xl bg-amber-50/50 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Information Collection</h3>
                            <ul class="list-disc pl-5 space-y-2 text-stone-600 leading-7">
                                <li>Account profile and contact details.</li>
                                <li>Auction activity and transaction records.</li>
                            </ul>
                        </article>

                        <article class="rounded-xl bg-amber-50/50 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Data Usage</h3>
                            <ul class="list-disc pl-5 space-y-2 text-stone-600 leading-7">
                                <li>Operate auction workflows and payment coordination.</li>
                                <li>Improve service quality, security, and user support.</li>
                            </ul>
                        </article>

                        <article class="rounded-xl bg-amber-50/50 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Data Protection</h3>
                            <ul class="list-disc pl-5 space-y-2 text-stone-600 leading-7">
                                <li>User data is protected with controlled access standards.</li>
                                <li>Only authorized personnel can access sensitive information.</li>
                            </ul>
                        </article>
                    </div>
                </section>

                <section id="auction-rules" class="rounded-2xl border border-stone-200 bg-white p-5 md:p-7 shadow-sm scroll-mt-24">
                    <p class="mb-2 text-xs md:text-sm font-bold tracking-[0.2em] uppercase text-amber-700">Section 03</p>
                    <h2 class="text-3xl md:text-4xl font-semibold mb-4">Auction Rules</h2>

                    <div class="space-y-4">
                        <article class="rounded-xl bg-white/80 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Seller Rules</h3>
                            <ul class="list-disc pl-5 space-y-2 text-stone-600 leading-7">
                                <li>Provide complete and accurate product information.</li>
                                <li>Do not list restricted or policy-violating items.</li>
                            </ul>
                        </article>

                        <article class="rounded-xl bg-white/80 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Bidder Rules</h3>
                            <ul class="list-disc pl-5 space-y-2 text-stone-600 leading-7">
                                <li>Place bids responsibly and with payment intent.</li>
                                <li>Do not cancel bids in violation of auction rules.</li>
                            </ul>
                        </article>

                        <article class="rounded-xl bg-white/80 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Auction Result</h3>
                            <p class="text-stone-600 leading-7 mb-0">
                                The winning bidder is responsible for completing the transaction within the specified timeframe.
                            </p>
                        </article>
                    </div>
                </section>

                <section id="payment-policy" class="rounded-2xl border border-stone-200 bg-white p-5 md:p-7 shadow-sm scroll-mt-24">
                    <p class="mb-2 text-xs md:text-sm font-bold tracking-[0.2em] uppercase text-amber-700">Section 04</p>
                    <h2 class="text-3xl md:text-4xl font-semibold mb-4">Payment Policy</h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <article class="rounded-xl bg-amber-50/50 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Payment Methods</h3>
                            <p class="text-stone-600 leading-7 mb-0">Bank transfer, card payments, and supported e-wallet gateways.</p>
                        </article>

                        <article class="rounded-xl bg-amber-50/50 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Payment Timeline</h3>
                            <p class="text-stone-600 leading-7 mb-0">Winning users must complete payment within the required deadline.</p>
                        </article>

                        <article class="rounded-xl bg-amber-50/50 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Failed Transactions</h3>
                            <p class="text-stone-600 leading-7 mb-0">The system records failed attempts and may request re-verification or retry.</p>
                        </article>

                        <article class="rounded-xl bg-amber-50/50 border border-stone-200 p-4 md:p-5">
                            <h3 class="text-2xl font-semibold mb-2">Refund Policy</h3>
                            <p class="text-stone-600 leading-7 mb-0">Refund eligibility is reviewed based on transaction evidence and platform policy.</p>
                        </article>
                    </div>
                </section>

                <section id="user-responsibilities" class="rounded-2xl border border-stone-200 bg-white p-5 md:p-7 shadow-sm scroll-mt-24">
                    <p class="mb-2 text-xs md:text-sm font-bold tracking-[0.2em] uppercase text-amber-700">Section 05</p>
                    <h2 class="text-3xl md:text-4xl font-semibold mb-4">User Responsibilities</h2>

                    <div class="rounded-xl bg-white/80 border border-stone-200 p-4 md:p-6">
                        <ul class="list-disc pl-5 space-y-3 text-stone-600 leading-7 mb-0">
                            <li>Protect your account credentials and login activity.</li>
                            <li>Provide truthful and complete information at all times.</li>
                            <li>Comply with all Auction House rules during listing, bidding, and payment.</li>
                        </ul>
                    </div>
                </section>
            </div>
        </div>
    </section>
</div>
